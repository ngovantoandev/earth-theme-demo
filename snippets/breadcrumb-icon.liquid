{% doc %}
  Renders a decorative breadcrumb icon (inline SVG, hidden from assistive tech).

  @param {string} icon - arrow | chevron | caret | slash | dot
  @param {string} [direction] - next (default) | previous

  @example
  {% render 'breadcrumb-icon', icon: 'chevron', direction: 'next' %}
{% enddoc %}

{%- liquid
  # Directional icons are mirrored for "previous" and for RTL (see block CSS)
  assign vt_icon_directional = false
  if icon == 'arrow' or icon == 'chevron' or icon == 'caret'
    assign vt_icon_directional = true
  endif

  assign vt_icon_class = 'vt-breadcrumbs__icon'
  if vt_icon_directional
    assign vt_icon_class = vt_icon_class | append: ' vt-breadcrumbs__icon--directional'
    if direction == 'previous'
      assign vt_icon_class = vt_icon_class | append: ' vt-breadcrumbs__icon--previous'
    else
      assign vt_icon_class = vt_icon_class | append: ' vt-breadcrumbs__icon--next'
    endif
  endif
-%}

<svg
  class="{{ vt_icon_class }}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'arrow' -%}
      <path d="M2 8h11M9 4l4 4-4 4"/>
    {%- when 'caret' -%}
      <path d="M5 3l6 5-6 5z" fill="currentColor" stroke="none"/>
    {%- when 'slash' -%}
      <path d="M10.5 2.5l-5 11"/>
    {%- when 'dot' -%}
      <circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"/>
    {%- else -%}
      <path d="M6 3l5 5-5 5"/>
  {%- endcase -%}
</svg>
