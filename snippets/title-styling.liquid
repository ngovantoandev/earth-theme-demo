{% comment %}
  Unified Section Header Component
  Accepts:
  - layout: {String} 'stacked_left' | 'centered' | 'split' | 'split_btn' (default: 'stacked_left')
  - title: {String} Section heading title
  - title_color: {String} Heading text color
  - title_size: {Number} Desktop title font size in px
  
  - eyebrow: {String} Optional eyebrow or category sub-tag (e.g. "Education & Ethos")
  - eyebrow_icon: {String} Optional icon before eyebrow text (e.g. "✨", "🌱", "icon-leaf-2.svg", or custom text)
  - eyebrow_color: {String} Independent color for Eyebrow
  - eyebrow_size: {Number} Font size for Eyebrow (default: 14)
  
  - subtitle: {String|Object} Section subtitle or rich-text description
  - subtitle_color: {String} Subtitle text color
  - subtitle_size_desktop: {Number} Subtitle font size on desktop (default: 21)
  - subtitle_size_mobile: {Number} Subtitle font size on mobile (default: 18)
  
  - show_leaf: {Boolean} Whether to show decorative leaf icon(s) (default: true)
  - leaf_position: {String} 'left' | 'top' | 'both_sides' | 'right' | 'none' (default varies by layout)
  - leaf_color: {String} Color override for leaf icon (default: #71CC3B)
  - leaf_size: {Number} Leaf icon width in px (default: 34)
  - leaf_gap: {Number} Spacing between leaf icon and title in px (default: 12)
  
  - btn_text: {String} Action button label
  - btn_url: {String} Action button link
  - btn_type: {String} 'arrow' | 'solid' | 'outline' (default: 'arrow')
  - btn_theme: {String} 'dark' | 'light' (default: 'dark')
  - btn_color: {String} Custom button color override
  - btn_block: {Object} Optional Theme 2.0 block passed to render
  
  - class: {String} Additional CSS class
{% endcomment %}

{%- liquid
  assign header_layout = layout | default: 'stacked_left'
  assign show_leaf_icon = true
  if show_leaf == false or leaf_position == 'none'
    assign show_leaf_icon = false
  endif

  assign pos = leaf_position
  if pos == blank
    case header_layout
      when 'centered'
        assign pos = 'both_sides'
      when 'stacked_left'
        assign pos = 'top'
      when 'split', 'split_btn'
        assign pos = 'left'
      else
        assign pos = 'left'
    endcase
  endif

  assign render_leaf_top = false
  assign render_leaf_left = false
  assign render_leaf_right = false

  if show_leaf_icon
    if pos == 'top'
      assign render_leaf_top = true
    elsif pos == 'left'
      assign render_leaf_left = true
    elsif pos == 'right'
      assign render_leaf_right = true
    elsif pos == 'both_sides'
      assign render_leaf_left = true
      assign render_leaf_right = true
    endif
  endif

  assign sub_size_d = subtitle_size_desktop | default: 21
  assign sub_size_m = subtitle_size_mobile | default: 18
  assign leaf_sz = leaf_size | default: 34
  assign leaf_spacing = leaf_gap | default: 12
  assign eye_sz_d = eyebrow_size_desktop | default: eyebrow_size | default: 16
  assign eye_sz_m = eyebrow_size_mobile | default: 15
-%}

{%- capture leaf_svg -%}
  <svg class="earth-section-header__leaf" width="{{ leaf_sz }}" height="{{ leaf_sz | times: 30 | divided_by: 34 }}" viewBox="0 0 41 37" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M36.5053 0C31.3399 8.60515 23.6183 8.25605 18.7209 16.5435C18.1501 17.5098 17.7216 18.4694 17.4006 19.4141C17.9201 19.9982 18.4198 20.6252 18.8896 21.3102C21.8992 25.6864 22.0051 29.5861 21.469 32.2433C28.2393 23.9243 33.6728 14.439 36.3796 4.02875C33.8597 15.1885 28.2277 25.4233 21.1299 34.3842C24.0269 34.7664 31.8942 34.8442 37.1803 25.7609C44.5942 13.0194 36.5053 0 36.5053 0Z" fill="currentColor"/>
    <path d="M18.1567 21.8148C12.4933 13.5753 2.73161 13.3403 0 13.4462C1.99535 16.7238 2.37093 19.7351 2.73492 22.652C3.11711 25.7112 3.4778 28.6 5.61213 31.7518C9.73022 37.8305 16.8298 37.081 18.3536 36.8378C14.5465 28.4031 9.27192 20.5375 2.15915 14.5548C9.4109 20.1818 14.9651 27.7198 19.1229 35.9047C20.435 33.7439 22.6801 28.3931 18.1567 21.8148Z" fill="currentColor"/>
  </svg>
{%- endcapture -%}

{%- capture eyebrow_markup -%}
  {%- if eyebrow != blank -%}
    <div class="earth-section-header__eyebrow" style="{% if eyebrow_color != blank and eyebrow_color != 'rgba(0,0,0,0)' %}color: {{ eyebrow_color }} !important;{% endif %}">
      {%- if show_eyebrow_icon != false -%}
        <span class="earth-section-header__eyebrow-icon" aria-hidden="true">✨</span>
      {%- endif -%}
      <span>{{ eyebrow }}</span>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture button_markup -%}
  {%- if btn_block != blank -%}
    {{ btn_block }}
  {%- elsif btn_text != blank and btn_url != blank -%}
    {%- assign b_type = btn_type | default: 'arrow' -%}
    {%- assign b_theme = btn_theme | default: 'dark' -%}
    <div class="earth-section-header__btn-wrap">
      {%- if b_type == 'arrow' -%}
        {% render 'btn-arrow', text: btn_text, url: btn_url, theme: b_theme, color: btn_color %}
      {%- else -%}
        {% render 'btn-action', text: btn_text, url: btn_url, variant: b_type, custom_bg: btn_color %}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div 
  class="earth-section-header earth-section-header--{{ header_layout }} earth-section-header--leaf-{{ pos }}{% if class != blank %} {{ class }}{% endif %}"
  style="
    --header-eyebrow-size-desktop: {{ eye_sz_d }}px;
    --header-eyebrow-size-mobile: {{ eye_sz_m }}px;
    --header-sub-size-desktop: {{ sub_size_d }}px;
    --header-sub-size-mobile: {{ sub_size_m }}px;
    --header-leaf-size: {{ leaf_sz }}px;
    --header-leaf-gap: {{ leaf_spacing }}px;
    {%- if text_color != blank %}--header-text: {{ text_color }};{% endif -%}
    {%- if title_color != blank %}--header-title: {{ title_color }};{% endif -%}
    {%- if subtitle_color != blank %}--header-subtitle: {{ subtitle_color }};{% endif -%}
    {%- if leaf_color != blank %}--header-leaf: {{ leaf_color }};{% endif -%}
    {%- if eyebrow_color != blank %}--header-eyebrow: {{ eyebrow_color }};{% endif -%}
  "
>
  {%- case header_layout -%}
    {%- when 'centered' -%}
      <!-- 1. Centered Header -->
      <div class="earth-section-header__centered">
        {{ eyebrow_markup }}

        {%- if render_leaf_top -%}
          <div class="earth-section-header__leaf-top" aria-hidden="true">{{ leaf_svg }}</div>
        {%- endif -%}

        {%- if title != blank -%}
          <h2 class="earth-section-header__title earth-section-header__title--centered">
            {%- if render_leaf_left -%}
              <span class="earth-section-header__leaf-wrap earth-section-header__leaf-wrap--left" aria-hidden="true">{{ leaf_svg }}</span>
            {%- endif -%}
            <span class="earth-section-header__title-text">{{ title }}</span>
            {%- if render_leaf_right -%}
              <span class="earth-section-header__leaf-wrap earth-section-header__leaf-wrap--right" aria-hidden="true">{{ leaf_svg }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if subtitle != blank -%}
          <div class="earth-section-header__subtitle earth-section-header__subtitle--centered">
            {{ subtitle }}
          </div>
        {%- endif -%}

        {{ button_markup }}
      </div>

    {%- when 'split' -%}
      <!-- 2. Split Columns (Title Left, Subtitle Right 1/3) -->
      <div class="earth-section-header__split">
        <div class="earth-section-header__split-left">
          {{ eyebrow_markup }}

          {%- if render_leaf_top -%}
            <div class="earth-section-header__leaf-top" aria-hidden="true">{{ leaf_svg }}</div>
          {%- endif -%}

          {%- if title != blank -%}
            <h2 class="earth-section-header__title">
              {%- if render_leaf_left -%}
                <span class="earth-section-header__leaf-wrap earth-section-header__leaf-wrap--left" aria-hidden="true">{{ leaf_svg }}</span>
              {%- endif -%}
              <span class="earth-section-header__title-text">{{ title }}</span>
              {%- if render_leaf_right -%}
                <span class="earth-section-header__leaf-wrap earth-section-header__leaf-wrap--right" aria-hidden="true">{{ leaf_svg }}</span>
              {%- endif -%}
            </h2>
          {%- endif -%}
        </div>

        {%- if subtitle != blank -%}
          <div class="earth-section-header__split-right">
            <div class="earth-section-header__subtitle">
              {{ subtitle }}
            </div>
          </div>
        {%- endif -%}
      </div>

    {%- when 'split_btn' -%}
      <!-- 3. Split Columns with CTA Button (Title Left, Subtitle & Button Right 1/3) -->
      <div class="earth-section-header__split earth-section-header__split--with-btn">
        <div class="earth-section-header__split-left">
          {{ eyebrow_markup }}

          {%- if render_leaf_top -%}
            <div class="earth-section-header__leaf-top" aria-hidden="true">{{ leaf_svg }}</div>
          {%- endif -%}

          {%- if title != blank -%}
            <h2 class="earth-section-header__title">
              {%- if render_leaf_left -%}
                <span class="earth-section-header__leaf-wrap earth-section-header__leaf-wrap--left" aria-hidden="true">{{ leaf_svg }}</span>
              {%- endif -%}
              <span class="earth-section-header__title-text">{{ title }}</span>
              {%- if render_leaf_right -%}
                <span class="earth-section-header__leaf-wrap earth-section-header__leaf-wrap--right" aria-hidden="true">{{ leaf_svg }}</span>
              {%- endif -%}
            </h2>
          {%- endif -%}
        </div>

        <div class="earth-section-header__split-right">
          {%- if subtitle != blank -%}
            <div class="earth-section-header__subtitle">
              {{ subtitle }}
            </div>
          {%- endif -%}

          {{ button_markup }}
        </div>
      </div>

    {%- else -%}
      <!-- 4. Stacked Left -->
      <div class="earth-section-header__stacked">
        {{ eyebrow_markup }}

        {%- if render_leaf_top -%}
          <div class="earth-section-header__leaf-top" aria-hidden="true">{{ leaf_svg }}</div>
        {%- endif -%}

        {%- if title != blank -%}
          <h2 class="earth-section-header__title">
            {%- if render_leaf_left -%}
              <span class="earth-section-header__leaf-wrap earth-section-header__leaf-wrap--left" aria-hidden="true">{{ leaf_svg }}</span>
            {%- endif -%}
            <span class="earth-section-header__title-text">{{ title }}</span>
            {%- if render_leaf_right -%}
              <span class="earth-section-header__leaf-wrap earth-section-header__leaf-wrap--right" aria-hidden="true">{{ leaf_svg }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if subtitle != blank -%}
          <div class="earth-section-header__subtitle">
            {{ subtitle }}
          </div>
        {%- endif -%}

        {{ button_markup }}
      </div>
  {%- endcase -%}
</div>

<style>
  .earth-section-header {
    width: 100%;
    color: var(--header-text, var(--color-black, #003225));
    box-sizing: border-box;
  }

  .earth-section-header__eyebrow {
    font-size: var(--header-eyebrow-size-desktop, 16px);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--header-eyebrow, var(--color-primary, #003225));
    margin-bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    line-height: 1.3;
  }

  .earth-section-header__eyebrow-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-size: 1.1em;
    flex-shrink: 0;
  }
  .earth-section-header__eyebrow-icon svg {
    width: 1.1em;
    height: 1.1em;
    fill: currentColor;
    display: block;
  }

  .earth-section-header__title {
    font-size: var(--type-section-title, 2.625rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--header-title, var(--header-text, var(--color-black, #003225)));
    margin: 0 0 12px;
    display: block;
  }
  .earth-section-header__title-text {
    display: inline;
  }

  .earth-section-header__subtitle {
    font-size: var(--header-sub-size-desktop, 21px);
    line-height: 1.5;
    color: var(--header-subtitle, var(--header-text, var(--color-black, #003225)));
    opacity: 0.9;
    margin: 0;
  }
  .earth-section-header__subtitle p {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  /* Leaves & Position Modifiers */
  .earth-section-header__leaf {
    color: var(--header-leaf, var(--color-secondary, #71CC3B));
    width: var(--header-leaf-size, 34px);
    height: auto;
    display: inline-block;
    flex-shrink: 0;
  }
  .earth-section-header__leaf-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: -0.08em;
    flex-shrink: 0;
    line-height: 1;
  }
  .earth-section-header__leaf-wrap--left {
    margin-right: var(--header-leaf-gap, 12px);
  }
  .earth-section-header__leaf-wrap--right {
    margin-left: var(--header-leaf-gap, 12px);
  }
  .earth-section-header__leaf-top {
    margin-bottom: var(--header-leaf-gap, 12px);
    display: block;
  }

  /* 1. Centered Layout */
  .earth-section-header--centered .earth-section-header__centered {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .earth-section-header__title--centered {
    text-align: center;
  }
  .earth-section-header__subtitle--centered {
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  /* 2 & 3. Split Layouts (Left Title ~2/3, Right 1/3 column with Left-Aligned Subtitle & Button) */
  .earth-section-header__split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
    align-items: flex-start;
    gap: clamp(32px, 5vw, 64px);
    width: 100%;
    box-sizing: border-box;
  }

  .earth-section-header__split-left {
    min-width: 0;
  }

  .earth-section-header__split-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 16px;
    max-width: 440px;
  }

  .earth-section-header__btn-wrap {
    margin-top: 4px;
    display: inline-flex;
  }

  /* 4. Stacked Left Layout */
  .earth-section-header--stacked_left .earth-section-header__stacked {
    max-width: 680px;
    text-align: left;
  }

  /* Responsive Breakpoints */
  @media (max-width: 768px) {
    .earth-section-header__eyebrow {
      font-size: var(--header-eyebrow-size-mobile, 15px);
    }
    .earth-section-header__split {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .earth-section-header__split-right {
      max-width: 100%;
    }
    .earth-section-header__title {
      font-size: 2.125rem !important;
    }
    .earth-section-header__subtitle {
      font-size: var(--header-sub-size-mobile, 18px);
    }
    .earth-section-header__leaf-top {
      margin-bottom: 8px;
    }
  }
</style>
