{% comment %}
  Reusable Earth Product Card Component
  Accepts:
  - product: {Object} Shopify Product drop
  - fallback_image: {String} Fallback asset filename (e.g. 'prod-denim.jpg')
  - title: {String} Custom title if product is blank
  - material: {String} Material subtitle
  - impact_score: {String} e.g. '97% Impact'
  - water_saved: {String} e.g. '3,200 L'
  - co2_saved: {String} e.g. '5.5 kg'
  - origin: {String} e.g. 'Vietnam'
  - badges: {Array or String} Comma-separated badges (e.g. 'Organic Cotton, Recycled Materials')
  - discount_text: {String} e.g. '52% Off (Price as Marked)'
  - price: {Number or String} Custom price if product is blank
  - compare_price: {Number or String} Custom compare price if product is blank
{% endcomment %}

{%- assign prod_title = product.title | default: title | default: 'Sustainable Essential' -%}
{%- assign prod_url = product.url | default: '#' -%}
{%- assign prod_variant = product.selected_or_first_available_variant -%}
{%- assign prod_material = product.metafields.custom.material.value | default: product.type | default: material | default: '100% Organic Cotton' -%}
{%- assign prod_origin = product.metafields.custom.origin.value | default: origin | default: 'Vietnam' -%}

{%- if product != blank -%}
  {%- assign mod_score = product.id | modulo: 8 | plus: 92 -%}
  {%- assign prod_impact_def = mod_score | append: '% Impact' -%}
  {%- assign prod_impact = product.metafields.custom.impact_score.value | default: impact_score | default: prod_impact_def -%}

  {%- assign mod_water = product.id | modulo: 1500 | plus: 1800 -%}
  {%- assign prod_water_def = mod_water | append: ' L' -%}
  {%- assign prod_water = product.metafields.custom.water_saved.value | default: water_saved | default: prod_water_def -%}

  {%- assign mod_co2 = product.id | modulo: 4 | plus: 3 | append: '.5 kg' -%}
  {%- assign prod_co2 = product.metafields.custom.co2_saved.value | default: co2_saved | default: mod_co2 -%}
{%- else -%}
  {%- assign prod_impact = impact_score | default: '95% Impact' -%}
  {%- assign prod_water = water_saved | default: '2,100 L' -%}
  {%- assign prod_co2 = co2_saved | default: '3.8 kg' -%}
{%- endif -%}

{%- assign card_aspect = aspect_ratio | default: 'portrait' -%}
<div class="earth-prod-card">
  <!-- 1. Product Image & Badges -->
  <div class="earth-prod-card__media earth-prod-card__media--aspect-{{ card_aspect }}">
    <a href="{{ prod_url }}" class="earth-prod-card__image-link" aria-label="{{ prod_title }}">
      {%- if product.featured_image != blank -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: class: 'earth-prod-card__img', loading: 'lazy', alt: prod_title }}
      {%- elsif fallback_image != blank -%}
        <img src="{{ fallback_image | asset_url }}" width="600" height="800" alt="{{ prod_title }}" class="earth-prod-card__img" loading="lazy">
      {%- else -%}
        <img src="{{ 'prod-denim.jpg' | asset_url }}" width="600" height="800" alt="{{ prod_title }}" class="earth-prod-card__img" loading="lazy">
      {%- endif -%}
    </a>

    <!-- Dark Hover Overlay -->
    <div class="earth-prod-card__overlay" aria-hidden="true"></div>

    <!-- Top Left Impact Score Badge -->
    {%- if show_impact_badge != false -%}
      <div class="earth-prod-card__impact-badge">
        <span class="earth-prod-card__badge-icon" aria-hidden="true">{{ 'icon-sustainability.svg' | inline_asset_content }}</span>
        <span>{{ prod_impact }}</span>
      </div>
    {%- endif -%}

    <!-- Bottom Left Metric Badges (Water & CO2) -->
    {%- if show_metrics != false -%}
      <div class="earth-prod-card__metrics">
        <span class="earth-prod-card__metric-pill">
          <span class="earth-prod-card__metric-icon" aria-hidden="true">{{ 'icon-Drop.svg' | inline_asset_content }}</span>
          <span>{{ prod_water }}</span>
        </span>
        <span class="earth-prod-card__metric-pill">
          <span class="earth-prod-card__metric-icon" aria-hidden="true">{{ 'icon-windy.svg' | inline_asset_content }}</span>
          <span>{{ prod_co2 }}</span>
        </span>
      </div>
    {%- endif -%}

    <!-- Center Hover Quick View Button -->
    {%- if show_quick_view != false -%}
      <a href="{{ prod_url }}" class="earth-prod-card__quick-view" aria-label="Quick View {{ prod_title }}">
        <span class="earth-prod-card__quick-view-icon" aria-hidden="true">{{ 'icon-quick-view.svg' | inline_asset_content }}</span>
        <span>QUICK VIEW</span>
      </a>
    {%- endif -%}
  </div>

  <!-- 2. Product Information -->
  <div class="earth-prod-card__content">
    <h3 class="earth-prod-card__title">
      <a href="{{ prod_url }}">{{ prod_title }}</a>
    </h3>

    {%- if show_material != false and prod_material != blank -%}
      <p class="earth-prod-card__material">{{ prod_material }}</p>
    {%- endif -%}

    <!-- Material & Quality Tag Pills -->
    {%- if show_tags != false -%}
      <div class="earth-prod-card__tags">
        {%- if badges != blank -%}
          {%- assign badge_list = badges | split: ',' -%}
          {%- for b in badge_list -%}
            {%- assign clean_badge = b | strip -%}
            {%- if clean_badge != blank -%}
              <span class="earth-prod-card__tag-pill">{{ clean_badge }}</span>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif product.tags.size > 0 -%}
          {%- for tag in product.tags limit: 2 -%}
            <span class="earth-prod-card__tag-pill">{{ tag }}</span>
          {%- endfor -%}
        {%- else -%}
          <span class="earth-prod-card__tag-pill">Organic Cotton</span>
          <span class="earth-prod-card__tag-pill">Recycled Materials</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Origin & Promotion Meta -->
    {%- if show_origin != false or show_discount != false -%}
      <div class="earth-prod-card__meta-row">
        {%- if show_origin != false -%}
          <div class="earth-prod-card__origin">
            <span class="earth-prod-card__meta-icon" aria-hidden="true">{{ 'icon-location.svg' | inline_asset_content }}</span>
            <span>Made in {{ prod_origin }}</span>
          </div>
        {%- endif -%}

        {%- if show_discount != false -%}
          {%- if discount_text != blank -%}
            <div class="earth-prod-card__discount">
              <span class="earth-prod-card__discount-icon" aria-hidden="true">{{ 'icon-marketing.svg' | inline_asset_content }}</span>
              <span>{{ discount_text }}</span>
            </div>
          {%- elsif product.compare_at_price > product.price -%}
            {%- assign saved_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
            <div class="earth-prod-card__discount">
              <span class="earth-prod-card__discount-icon" aria-hidden="true">{{ 'icon-marketing.svg' | inline_asset_content }}</span>
              <span>{{ saved_percent }}% Off (Price as Marked)</span>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- 3. Integrated Action Unit (Price Box + Add to Cart) -->
    <div class="earth-prod-card__action-group">
      <!-- Price Display Box -->
      <div class="earth-prod-card__price-box">
        {%- if product != blank -%}
          {%- if product.compare_at_price > product.price -%}
            <span class="earth-prod-card__compare-price">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
            <span class="earth-prod-card__price">{{ product.price | money_without_trailing_zeros }}</span>
          {%- else -%}
            <span class="earth-prod-card__price">{{ product.price | money_without_trailing_zeros }}</span>
          {%- endif -%}
        {%- elsif compare_price != blank -%}
          <span class="earth-prod-card__compare-price">${{ compare_price }}</span>
          <span class="earth-prod-card__price">${{ price | default: '68' }}</span>
        {%- else -%}
          <span class="earth-prod-card__price">${{ price | default: '110' }}</span>
        {%- endif -%}
      </div>

      <!-- Add to Cart Form Button -->
      {%- if product != blank and prod_variant != blank -%}
        <form method="post" action="{{ routes.cart_add_url }}" class="earth-prod-card__form">
          <input type="hidden" name="id" value="{{ prod_variant.id }}">
          <button type="submit" class="earth-prod-card__add-btn" aria-label="Add {{ prod_title }} to cart" {% unless prod_variant.available %}disabled{% endunless %}>
            <span class="earth-prod-card__add-icon" aria-hidden="true">{{ 'icon-add-icon.svg' | inline_asset_content }}</span>
            <span>{% if prod_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</span>
          </button>
        </form>
      {%- else -%}
        <a href="{{ prod_url }}" class="earth-prod-card__add-btn">
          <span class="earth-prod-card__add-icon" aria-hidden="true">{{ 'icon-add-icon.svg' | inline_asset_content }}</span>
          <span>ADD TO CART</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
