{% stylesheet %}
  /* =========================================================
     Animation Base
     ========================================================= */

  .vt-animate {
    --vt-duration: 1.2s;
    --vt-delay: 0s;
    --vt-easing: cubic-bezier(0.61, 1, 0.88, 1);
    --vt-blur: 5px;
    --vt-offset: 40px;

    will-change: opacity, transform, filter;
  }

  /* =========================================================
     Fade
     ========================================================= */

  .vt-animate--fade {
    opacity: 0;
    transition: opacity var(--vt-duration) ease var(--vt-delay);
  }

  .vt-animate--fade.vt-in-view {
    opacity: 1;
  }

  /* =========================================================
     Slide
     ========================================================= */

  .vt-animate--slide {
    opacity: 0;

    transition: opacity var(--vt-duration) var(--vt-easing) var(--vt-delay),
      transform var(--vt-duration) var(--vt-easing) var(--vt-delay);
  }

  .vt-animate--slide.vt-animate--dir-from-bottom {
    transform: translateY(var(--vt-offset));
  }

  .vt-animate--slide.vt-animate--dir-from-top {
    transform: translateY(calc(var(--vt-offset) * -1));
  }

  .vt-animate--slide.vt-animate--dir-from-left {
    transform: translateX(calc(var(--vt-offset) * -1));
  }

  .vt-animate--slide.vt-animate--dir-from-right {
    transform: translateX(var(--vt-offset));
  }

  .vt-animate--slide.vt-animate--dir-from-bottom.vt-in-view,
  .vt-animate--slide.vt-animate--dir-from-top.vt-in-view,
  .vt-animate--slide.vt-animate--dir-from-left.vt-in-view,
  .vt-animate--slide.vt-animate--dir-from-right.vt-in-view {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* =========================================================
     Float
     ========================================================= */

  .vt-animate--float {
    opacity: 0;

    transition: opacity var(--vt-duration) var(--vt-easing) var(--vt-delay),
      transform var(--vt-duration) var(--vt-easing) var(--vt-delay);
  }

  .vt-animate--float.vt-animate--dir-from-bottom {
    transform: translateY(var(--vt-offset));
  }

  .vt-animate--float.vt-animate--dir-from-top {
    transform: translateY(calc(var(--vt-offset) * -1));
  }

  .vt-animate--float.vt-animate--dir-from-left {
    transform: translateX(calc(var(--vt-offset) * -1));
  }

  .vt-animate--float.vt-animate--dir-from-right {
    transform: translateX(var(--vt-offset));
  }

  .vt-animate--float.vt-animate--dir-from-bottom.vt-in-view,
  .vt-animate--float.vt-animate--dir-from-top.vt-in-view,
  .vt-animate--float.vt-animate--dir-from-left.vt-in-view,
  .vt-animate--float.vt-animate--dir-from-right.vt-in-view {
    opacity: 1;
    transform: translate(0, 0);
  }

  @keyframes vt-float-bob {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-10px);
    }
  }

  .vt-animate--float.vt-float-loop {
    animation: vt-float-bob 2.6s var(--vt-easing) infinite alternate;
  }

  /* =========================================================
     Blur
     ========================================================= */

  .vt-animate--blur {
    opacity: 0;
    filter: blur(var(--vt-blur));

    transition: opacity var(--vt-duration) var(--vt-easing) var(--vt-delay),
      filter var(--vt-duration) var(--vt-easing) var(--vt-delay);
  }

  .vt-animate--blur.vt-in-view {
    opacity: 1;
    filter: blur(0);
  }

  /* =========================================================
     Reduced Motion
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .vt-animate {
      transition: none !important;
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!window.vtAnimateObserverInit) {
    window.vtAnimateObserverInit = true;

    const vtParseSeconds = (value, fallback) => {
      const parsed = parseFloat(value);

      return Number.isNaN(parsed) ? fallback : parsed;
    };

    const vtInitAnimations = (root = document) => {
      const targets = root.querySelectorAll('.vt-animate:not(.vt-observed)');

      if (!targets.length) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const vtActivate = (element) => {
        element.classList.add('vt-in-view');

        if (element.classList.contains('vt-animate--float')) {
          const styles = getComputedStyle(element);

          const duration = vtParseSeconds(styles.getPropertyValue('--vt-duration'), 1.2);

          const delay = vtParseSeconds(styles.getPropertyValue('--vt-delay'), 0);

          window.setTimeout(() => {
            element.classList.add('vt-float-loop');
          }, (duration + delay) * 1000);
        }
      };

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            vtActivate(entry.target);
            obs.unobserve(entry.target);
          });
        },
        {
          threshold: 0.15,
        }
      );

      targets.forEach((element) => {
        element.classList.add('vt-observed');

        if (prefersReducedMotion) {
          vtActivate(element);
        } else {
          observer.observe(element);
        }
      });
    };

    document.addEventListener('DOMContentLoaded', () => vtInitAnimations());

    document.addEventListener('shopify:section:load', (event) => vtInitAnimations(event.target));
  }
{% endjavascript %}
