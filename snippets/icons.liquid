{% comment %}
  Accepts:
  - icon: {String} icon key (required). One of: arrow-left, arrow-right,
    close, leaf, carbon, cotton-plant, tree, zero-emissions, quality, drop,
    ecology, eco-friendly, flower, sparkle, eye, cart-quick, check, add-to-cart,
    sold-out, star, location, discount, arrow-next, arrow-previous, handshake,
    organic-cotton, recycled-materials, vegan-cruelty-free, play, pause,
    dropdown, search, account, shopping-cart, eco, certificate-regulation,
    shake-hand-cooperate, heart, calculator, close-circle, check-circle,
    info-circle, washing, get-dressed, hands-light, materials, partners,
    recycle, honest-progress, location-map, mail, telephone-call, facebook,
    instagram, twitter, youtube, tiktok, pinterest, linkedin, threads, snapchat,
    arrow-down-right.

  Usage:
  {% render 'icons', icon: block.settings.icon %}
{% endcomment %}

