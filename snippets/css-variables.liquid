{% style %}  
	{% # Loads all font variantions with display: swap %}
	{{ settings.heading_font_family | font_face: font_display: 'swap' }}
	{{ settings.heading_font_family | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
	{{ settings.heading_font_family | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
	{{ settings.heading_font_family | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

	{% if settings.type_body_font and settings.type_body_font.family != settings.heading_font_family.family %}
		{{ settings.type_body_font | font_face: font_display: 'swap' }}
		{{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
		{{ settings.type_body_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
		{{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
	{% endif %}
  

    {% comment %}
    ==========================================
    FLUID TYPOGRAPHY
    Mobile endpoint: 375px
    Desktop endpoint: 1440px
    ==========================================
    {% endcomment %}

    {% assign fluid_viewport_start = 375 %}
    {% assign fluid_viewport_end = 1440 %}
    {% assign fluid_viewport_range = fluid_viewport_end | minus: fluid_viewport_start %}

    {% comment %}
    ==========================================
    BODY
    ==========================================
    {% endcomment %}

    {% assign body_mobile = settings.body_base_size_mobile %}
    {% assign body_desktop = settings.body_base_size %}
    {% assign body_font_range = body_desktop | minus: body_mobile %}
    {% assign body_vw = body_font_range | times: 100.0 | divided_by: fluid_viewport_range %}
    {% assign body_offset = body_font_range | times: fluid_viewport_start | divided_by: fluid_viewport_range %}
    {% assign body_base = body_mobile | minus: body_offset %}


