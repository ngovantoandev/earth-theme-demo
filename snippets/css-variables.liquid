{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    /* Fonts & Core */
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width | default: '1440px' }};
    --page-margin: {{ settings.min_page_margin | default: 0 }}px;

    /* ==========================================================================
       Earth Theme Official Color Palette (from Theme Settings)
       ========================================================================== */
    --color-primary: {{ settings.color_primary | default: '#224E09' }};
    --color-secondary: {{ settings.color_secondary | default: '#71CC3B' }};
    --color-accent: {{ settings.color_accent | default: '#EAE060' }};
    --color-white: {{ settings.color_white | default: '#F8F9DC' }};
    --color-black: {{ settings.color_black | default: '#003225' }};

    /* Gray Scale */
    --color-gray-50: #EBF7BE;
    --color-gray-100: #E7E7E7;
    --color-gray-200: #D1D1D1;
    --color-gray-300: #B0B0B0;
    --color-gray-400: #888888;
    --color-gray-500: #B4C919;
    --color-gray-600: #8EA10F;
    --color-gray-700: #6B7B10;
    --color-gray-800: #556113;
    --color-gray-900: #34601B;

    /* Semantic Defaults */
    --color-background: {{ settings.background_color | default: settings.color_black | default: '#003225' }};
    --color-foreground: {{ settings.foreground_color | default: settings.color_white | default: '#F8F9DC' }};
    --color-text-main: var(--color-primary);
  }
{% endstyle %}
