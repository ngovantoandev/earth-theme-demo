{% doc %}
  Divider line between blocks: horizontal or vertical, optionally with content
  (text or an icon from child blocks) on the line.

  A plain divider is an <hr>, so assistive tech announces a separator. With
  content it is a <div>: role="separator" would hide its text from screen
  readers, so the lines are decorative and the content is read as normal text.
  The content comes from child blocks (icon, sub-heading, paragraph, heading).

  @example
  {% content_for 'block', type: 'divider', id: 'divider' %}
{% enddoc %}

{%- liquid
  assign variant = block.settings.variant
  assign is_vertical = false
  if variant == 'vertical' or variant == 'vertical_content'
    assign is_vertical = true
  endif

  assign has_content = false
  if variant contains '_content' and block.blocks.size > 0
    assign has_content = true
  endif

  if is_vertical
    assign position = block.settings.content_position_vertical
  else
    assign position = block.settings.content_position_horizontal
  endif

  assign color = 'currentColor'
  if block.settings.color_source == 'custom' and block.settings.color != blank
    assign color = block.settings.color
  endif

  assign direction_class = 'vt-divider--horizontal'
  if is_vertical
    assign direction_class = 'vt-divider--vertical'
  endif

  # Animation: the theme-wide options from snippets/animate.liquid (Theme settings > Animations)
  assign animation_type = block.settings.animation_type
  assign animate_class = ''
  unless animation_type == 'none' or request.visual_preview_mode or section.index == 1 and section.location == 'template'
    assign animate_class = ' vt-animate vt-animate--' | append: animation_type
    if animation_type == 'slide' or animation_type == 'reveal'
      assign animate_class = animate_class | append: ' vt-animate--dir-' | append: block.settings.animation_direction
    endif
  endunless

  case block.settings.animation_easing
    when 'linear'
      assign vt_easing = 'linear'
    when 'ease-in-sine'
      assign vt_easing = 'cubic-bezier(0.12, 0, 0.39, 0)'
    when 'ease-in-out-sine'
      assign vt_easing = 'cubic-bezier(0.37, 0, 0.63, 1)'
    when 'ease-in-cubic'
      assign vt_easing = 'cubic-bezier(0.32, 0, 0.67, 0)'
    when 'ease-out-cubic'
      assign vt_easing = 'cubic-bezier(0.33, 1, 0.68, 1)'
    when 'ease-in-out-cubic'
      assign vt_easing = 'cubic-bezier(0.65, 0, 0.35, 1)'
    else
      assign vt_easing = 'cubic-bezier(0.61, 1, 0.88, 1)'
  endcase
-%}

{%- capture divider_style -%}
  --vt-divider-color: {% if block.settings.opacity < 100 %}color-mix(in srgb, {{ color }} {{ block.settings.opacity }}%, transparent){% else %}{{ color }}{% endif %};
  --vt-divider-thickness: {{ block.settings.thickness }}px;
  --vt-divider-style: {{ block.settings.style }};
  --vt-divider-space-start: {% render 'fluid-clamp', min_px: block.settings.margin_top_mobile, max_px: block.settings.margin_top_desktop %};
  --vt-divider-space-end: {% render 'fluid-clamp', min_px: block.settings.margin_bottom_mobile, max_px: block.settings.margin_bottom_desktop %};
  {%- if animate_class != blank %}
  --vt-duration: {{ block.settings.animation_duration }}s;
  --vt-delay: {{ block.settings.animation_delay }}s;
  --vt-easing: {{ vt_easing }};
  --vt-blur: {{ block.settings.animation_blur_intensity }}px;
  {%- endif %}
{%- endcapture -%}

{%- if has_content -%}
  <div
    class="vt-divider vt-divider--content {{ direction_class }} flex items-center gap-3 md:gap-4{% if is_vertical %} flex-col self-stretch{% endif %}{{ animate_class }}"
    style="{{ divider_style | strip_newlines }}"
    {{ block.shopify_attributes }}
  >
    {%- unless position == 'start' -%}
      <span class="vt-divider__line grow" aria-hidden="true"></span>
    {%- endunless -%}
    <div class="vt-divider__content">
      {% content_for 'blocks' %}
    </div>
    {%- unless position == 'end' -%}
      <span class="vt-divider__line grow" aria-hidden="true"></span>
    {%- endunless -%}
  </div>
{%- else -%}
  <hr
    class="vt-divider {{ direction_class }}{% if is_vertical %} self-stretch{% endif %}{{ animate_class }}"
    {% if is_vertical %}
      aria-orientation="vertical"
    {% endif %}
    style="{{ divider_style | strip_newlines }}"
    {{ block.shopify_attributes }}
  >
{%- endif -%}

{% stylesheet %}
  .vt-divider {
    box-sizing: border-box;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: inherit;
  }

  /* Horizontal: full width, spacing above and below */
  .vt-divider--horizontal {
    width: 100%;
    margin-block: var(--vt-divider-space-start) var(--vt-divider-space-end);
  }

  /* Vertical: full height of a row (e.g. a horizontal stack), spacing on the left and right */
  .vt-divider--vertical {
    min-block-size: 1.5rem;
    margin-inline: var(--vt-divider-space-start) var(--vt-divider-space-end);
  }

  .vt-divider--vertical.vt-divider--content {
    min-block-size: 6rem;
  }

  /* The line: the plain <hr> itself, or the lines beside the content */
  hr.vt-divider,
  .vt-divider__line {
    height: auto;
    border: 0;
  }

  hr.vt-divider--horizontal,
  .vt-divider--horizontal .vt-divider__line {
    border-block-start: var(--vt-divider-thickness) var(--vt-divider-style) var(--vt-divider-color);
  }

  hr.vt-divider--vertical,
  .vt-divider--vertical .vt-divider__line {
    width: 0;
    border-inline-start: var(--vt-divider-thickness) var(--vt-divider-style) var(--vt-divider-color);
  }

  .vt-divider__line {
    min-inline-size: 1.5rem;
  }

  .vt-divider--vertical .vt-divider__line {
    min-inline-size: 0;
    min-block-size: 1.5rem;
  }

  /* Content keeps its natural size, wrapping before it squeezes the lines away */
  .vt-divider__content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-inline-size: 75%;
    text-align: center;
  }

  .vt-divider--vertical .vt-divider__content {
    flex-direction: column;
    max-inline-size: none;    
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Divider",
  "tag": null,
  "blocks": [{ "type": "icons" }, { "type": "sub-heading" }, { "type": "paragraph" }, { "type": "heading" }],
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" },
        { "value": "horizontal_content", "label": "Horizontal with content" },
        { "value": "vertical_content", "label": "Vertical with content" }
      ],
      "default": "horizontal",
      "info": "Vertical fills the height of a horizontal stack. With content shows text or icon blocks on the line."
    },
    {
      "type": "select",
      "id": "content_position_horizontal",
      "label": "Content position",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.variant == 'horizontal_content' }}"
    },
    {
      "type": "select",
      "id": "content_position_vertical",
      "label": "Content position",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.variant == 'vertical_content' }}"
    },
    {
      "type": "header",
      "content": "Line"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Thickness",
      "default": 1
    },
    {
      "type": "select",
      "id": "color_source",
      "label": "Color",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "inherit",
      "info": "Inherit matches the text color."
    },
    {
      "type": "color",
      "id": "color",
      "label": "Custom color",
      "default": "{{ settings.color_palette.foreground }}",
      "visible_if": "{{ block.settings.color_source == 'custom' }}"
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top (desktop)",
      "default": 32,
      "info": "On a vertical divider, top and bottom are the left and right spacing."
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom (desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom (mobile)",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:blocks.icon.settings.icon_animation.content"
    },
    {
      "type": "select",
      "id": "animation_type",
      "info": "Turned off in the first section of a page, so it loads faster.",
      "options": [
        { "value": "none", "label": "t:blocks.icon.settings.animation_type.options__1.label" },
        { "value": "fade", "label": "t:blocks.icon.settings.animation_type.options__2.label" },
        { "value": "slide", "label": "t:blocks.icon.settings.animation_type.options__3.label" },
        { "value": "reveal", "label": "t:blocks.icon.settings.animation_type.options__4.label" },
        { "value": "blur", "label": "t:blocks.icon.settings.animation_type.options__5.label" }
      ],
      "default": "none",
      "label": "t:blocks.icon.settings.animation_type.label"
    },
    {
      "type": "select",
      "id": "animation_direction",
      "options": [
        { "value": "from-left", "label": "t:blocks.icon.settings.animation_direction.options__1.label" },
        { "value": "from-right", "label": "t:blocks.icon.settings.animation_direction.options__2.label" },
        { "value": "from-top", "label": "t:blocks.icon.settings.animation_direction.options__3.label" },
        { "value": "from-bottom", "label": "t:blocks.icon.settings.animation_direction.options__4.label" }
      ],
      "default": "from-bottom",
      "label": "t:blocks.icon.settings.animation_direction.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'reveal' }}"
    },
    {
      "type": "range",      
      "id": "animation_duration",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "unit": "s",
      "default": 1,
      "label": "t:blocks.icon.settings.animation_duration.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "default": 0.1,
      "label": "t:blocks.icon.settings.animation_delay.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "select",
      "id": "animation_easing",
      "options": [
        { "value": "linear", "label": "t:blocks.icon.settings.animation_easing.options__1.label" },
        { "value": "ease-out-sine", "label": "t:blocks.icon.settings.animation_easing.options__2.label" },
        { "value": "ease-in-sine", "label": "t:blocks.icon.settings.animation_easing.options__3.label" },
        { "value": "ease-in-out-sine", "label": "t:blocks.icon.settings.animation_easing.options__4.label" },
        { "value": "ease-in-cubic", "label": "t:blocks.icon.settings.animation_easing.options__5.label" },
        { "value": "ease-out-cubic", "label": "t:blocks.icon.settings.animation_easing.options__6.label" },
        { "value": "ease-in-out-cubic", "label": "t:blocks.icon.settings.animation_easing.options__7.label" }
      ],
      "default": "ease-out-sine",
      "label": "t:blocks.icon.settings.animation_easing.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'reveal' or block.settings.animation_type == 'blur' }}"
    },
    {
      "type": "range",
      "id": "animation_blur_intensity",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 5,
      "label": "t:blocks.icon.settings.animation_blur_intensity.label",
      "visible_if": "{{ block.settings.animation_type == 'blur' }}"
    }
  ],
  "presets": [
    {
      "name": "Divider",
      "category": "t:general.categories.basic"
    },
    {
      "name": "Divider with text",
      "category": "t:general.categories.basic",
      "settings": {
        "variant": "horizontal_content"
      },
      "blocks": [
        {
          "type": "sub-heading",
          "settings": {
            "sub_heading": "Add a short label"
          }
        }
      ]
    }
  ]
}
{% endschema %}
