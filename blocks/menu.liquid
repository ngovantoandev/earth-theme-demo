  "presets": [
    {
      "name": "Menu"
    },
    {
      "name": "Policy links",
      "settings": {
        "source": "policies",
        "show_heading": false,
        "layout": "horizontal",
        "separator": "dot",
        "link_style": "vt-paragraph-medium",
        "link_gap_desktop": 16,
        "link_gap_mobile": 12
      }
    }
  ]
}
{% endschema %}
