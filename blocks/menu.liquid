          "label": "t:blocks.paragraph.settings.paragraph_size.options__2.label"
        },
        {
          "value": "vt-paragraph-medium",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__3.label"
        },
        {
          "value": "vt-paragraph-large",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__4.label"
        },
        {
          "value": "vt-heading-h4",
          "label": "t:blocks.heading.settings.heading_size.options__5.label"
        },
        {
          "value": "vt-heading-h5",
          "label": "t:blocks.heading.settings.heading_size.options__6.label"
        },
        {
          "value": "vt-heading-h6",
          "label": "t:blocks.heading.settings.heading_size.options__7.label"
        }
      ],
      "default": "vt-paragraph-medium",
      "info": "The hover effect follows Theme settings > Typography > Link hover effect."
    },
    {
      "type": "select",
      "id": "link_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "300",
          "label": "t:general.typography.font_weight.options__1.label"
        },
        {
          "value": "400",
          "label": "t:general.typography.font_weight.options__2.label"
        },
        {
          "value": "500",
          "label": "t:general.typography.font_weight.options__3.label"
        },
        {
          "value": "600",
          "label": "t:general.typography.font_weight.options__4.label"
        },
        {
          "value": "700",
          "label": "t:general.typography.font_weight.options__5.label"
        },
        {
          "value": "800",
          "label": "t:general.typography.font_weight.options__6.label"
        }
      ],
      "default": "600",
      "info": "Default uses the weight of the text style in Theme settings > Typography."
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "info": "Leave empty to use the section's paragraph color."
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover effect color",
      "info": "Leave empty to use the link color."
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color on mobile",
      "info": "Leave empty to use the heading color.",
      "visible_if": "{{ block.settings.layout == 'vertical' and block.settings.show_heading and block.settings.collapse_on_mobile }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "heading_gap_desktop",
      "label": "Below heading (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.show_heading }}"
    },
    {
      "type": "range",
      "id": "heading_gap_mobile",
      "label": "Below heading (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.show_heading }}"
    },
    {
      "type": "range",
      "id": "link_gap_desktop",
      "label": "Gap links (desktop)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
