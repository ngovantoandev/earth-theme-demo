{% doc %}
  Renders a footer menu column with link_list data binding.
  Supports desktop column view and mobile accordion with arrow indicator,
  optional contact info (email, phone, address), interactive hover effects, and theme color tokens.
  @example
  {% content_for 'block', type: 'menu', id: 'menu' %}
{% enddoc %}

{%- liquid
  assign menu_handle = block.settings.menu
  assign link_list = linklists[menu_handle]
  assign title_override = block.settings.title
  assign show_contact = block.settings.show_contact_info

  # Determine display title
  assign display_title = title_override
  if display_title == blank and link_list != blank and link_list.title != blank
    assign display_title = link_list.title
  endif
  if display_title == blank
    assign display_title = 'Menu Title'
  endif

  # Fallback links if menu is empty
  assign has_links = false
  if link_list != blank and link_list.links.size > 0
    assign has_links = true
  endif

  # Contextual fallback based on handle or title
  assign handle_lower = menu_handle | downcase
  assign title_lower = display_title | downcase
  assign title_setting = block.settings.title_color
  if title_setting != blank and title_setting != 'rgba(0,0,0,0)' and title_setting != '#00000000' and title_setting != 'transparent'
    assign final_title_color = title_setting
  else
    assign final_title_color = 'var(--vt-footer-color, var(--vt-foreground-color, #003225))'
  endif

  assign link_setting = block.settings.link_color
  if link_setting != blank and link_setting != 'rgba(0,0,0,0)' and link_setting != '#00000000' and link_setting != 'transparent'
    assign final_link_color = link_setting
  else
    assign final_link_color = 'var(--vt-footer-color, var(--vt-foreground-color, #003225))'
  endif

  # Hover effect & color configuration (matches breadcrumbs.liquid)
  assign hover_effect = block.settings.hover_effect | default: 'underline'
  assign hover_color_setting = block.settings.hover_color
  assign hover_color = ''
  if hover_color_setting != blank and hover_color_setting != 'rgba(0,0,0,0)' and hover_color_setting != '#00000000' and hover_color_setting != 'transparent'
    assign hover_color = hover_color_setting
  endif

  # For wave fade: avoid identical colors so the wave remains vibrant
  assign hover_color_wave = ''
  if hover_color != blank and hover_color != final_link_color
    assign hover_color_wave = hover_color
  endif
-%}

<div
  id="menu-block-{{ block.id }}"
  class="vt-footer-menu vt-footer-menu--hover-{{ hover_effect }}"
  style="
    --vt-menu-title-color: {{ final_title_color }};
    --vt-menu-link-color: {{ final_link_color }};
    --vt-menu-link-gap: {{ block.settings.link_gap }}px;
    {%- if hover_color != blank -%}
      --vt-menu-hover-color: {{ hover_color }};
    {%- endif -%}
    {%- if hover_color_wave != blank -%}
      --vt-menu-hover-color-wave: {{ hover_color_wave }};
    {%- endif -%}
  "
  {{ block.shopify_attributes }}
>
  <details class="vt-footer-menu__details" open>
    <summary class="vt-footer-menu__summary">
      <span class="vt-footer-menu__title">{{ display_title }}</span>
      <span class="vt-footer-menu__arrow" aria-hidden="true">
        <svg class="vt-footer-menu__arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="7" x2="17" y2="17"></line>
          <polyline points="17 7 17 17 7 17"></polyline>
        </svg>
      </span>
    </summary>

    <div class="vt-footer-menu__content">
      <ul class="vt-footer-menu__list" role="list">
        {%- if has_links -%}
          {%- for link in link_list.links -%}
            <li class="vt-footer-menu__item">
              <a href="{{ link.url }}" class="vt-footer-menu__link{% if link.active %} vt-footer-menu__link--active{% endif %}">
                <span class="vt-footer-menu__label">{{ link.title }}</span>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Contextual mock data fallbacks for preview / dev {%- endcomment -%}
          {%- if handle_lower contains 'company' or title_lower contains 'company' -%}
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">About Us</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Our Story</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Sustainability Journey</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Careers</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Blog</span></a></li>
          {%- elsif handle_lower contains 'shop' or title_lower contains 'shop' -%}
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">New Arrivals</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Women's</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Men's</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Essentials</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Limited Edition</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Sale</span></a></li>
          {%- elsif handle_lower contains 'sustain' or title_lower contains 'sustain' -%}
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Impact Tracker</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Transparency</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Carbon Footprint</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Supply Chain</span></a></li>
          {%- elsif handle_lower contains 'support' or title_lower contains 'support' -%}
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Contact Us</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Shipping & Returns</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Size Guide</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">FAQ</span></a></li>
          {%- else -%}
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Menu item 1</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Menu item 2</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Menu item 3</span></a></li>
            <li class="vt-footer-menu__item"><a href="#" class="vt-footer-menu__link"><span class="vt-footer-menu__label">Menu item 4</span></a></li>
          {%- endif -%}
        {%- endif -%}
      </ul>

      {%- if show_contact -%}
        <div class="vt-footer-menu__contact">
          <hr class="vt-footer-menu__contact-divider">
          <ul class="vt-footer-menu__contact-list" role="list">
            {%- if block.settings.contact_email != blank -%}
              <li class="vt-footer-menu__contact-item">
                <a href="mailto:{{ block.settings.contact_email }}" class="vt-footer-menu__contact-link">
                  <span class="vt-footer-menu__contact-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </span>
                  <span class="vt-footer-menu__label">{{ block.settings.contact_email }}</span>
                </a>
              </li>
            {%- endif -%}

            {%- if block.settings.contact_phone != blank -%}
              <li class="vt-footer-menu__contact-item">
                <a href="tel:{{ block.settings.contact_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="vt-footer-menu__contact-link">
                  <span class="vt-footer-menu__contact-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                  </span>
                  <span class="vt-footer-menu__label">{{ block.settings.contact_phone }}</span>
                </a>
              </li>
            {%- endif -%}

            {%- if block.settings.contact_address != blank -%}
              <li class="vt-footer-menu__contact-item">
                <div class="vt-footer-menu__contact-link">
                  <span class="vt-footer-menu__contact-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </span>
                  <span class="vt-footer-menu__label">{{ block.settings.contact_address }}</span>
                </div>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </details>
</div>

{% stylesheet %}
  .vt-footer-menu {
    width: 100%;
    box-sizing: border-box;
    --vt-menu-transition: 0.25s ease-out;
  }

  .vt-footer-menu__details {
    width: 100%;
    border-bottom: 1px solid rgba(0, 50, 37, 0.25);
    padding-bottom: 0.75rem;
  }

  @media screen and (min-width: 769px) {
    .vt-footer-menu__details {
      border-bottom: none;
      padding-bottom: 0;
    }
  }

  .vt-footer-menu__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    padding-block: 0.75rem;
    user-select: none;
  }

  .vt-footer-menu__summary::-webkit-details-marker {
    display: none;
  }

  @media screen and (min-width: 769px) {
    .vt-footer-menu__summary {
      cursor: default;
      pointer-events: none;
      padding-block: 0 1.25rem;
    }
  }

  .vt-footer-menu__title {
    font-size: 0.9375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--vt-menu-title-color);
    margin: 0;
  }

  .vt-footer-menu__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vt-menu-title-color);
    transition: transform 0.25s ease;
  }

  @media screen and (min-width: 769px) {
    .vt-footer-menu__arrow {
      display: none;
    }
  }

  /* Rotate arrow when open on mobile: ↘ becomes ↗ */
  .vt-footer-menu__details[open] .vt-footer-menu__arrow {
    transform: rotate(-90deg);
  }

  .vt-footer-menu__content {
    display: flex;
    flex-direction: column;
    padding-bottom: 0.75rem;
  }

  @media screen and (min-width: 769px) {
    .vt-footer-menu__content {
      padding-bottom: 0;
    }
  }

  .vt-footer-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--vt-menu-link-gap);
  }

  .vt-footer-menu__item {
    margin: 0;
    padding: 0;
    position: relative;
  }

  .vt-footer-menu__link {
    display: inline-flex;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
    color: var(--vt-menu-link-color);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    line-height: 1.4;
    cursor: pointer;
    transition: color var(--vt-menu-transition);
  }

  .vt-footer-menu__label {
    display: inline-block;
  }

  /* ------------------------------------------------------------- */
  /* Hover effect 1: Sliding underline                             */
  /* ------------------------------------------------------------- */
  .vt-footer-menu--hover-underline .vt-footer-menu__label {
    position: relative;
    padding-block-end: 0.15em;
  }

  .vt-footer-menu--hover-underline .vt-footer-menu__label::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--vt-menu-hover-color, currentColor);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--vt-menu-transition);
  }

  .vt-footer-menu--hover-underline .vt-footer-menu__item:hover .vt-footer-menu__label::after,
  .vt-footer-menu--hover-underline .vt-footer-menu__item:focus-within .vt-footer-menu__label::after,
  .vt-footer-menu--hover-underline .vt-footer-menu__link:hover .vt-footer-menu__label::after,
  .vt-footer-menu--hover-underline .vt-footer-menu__link:focus-visible .vt-footer-menu__label::after,
  .vt-footer-menu--hover-underline .vt-footer-menu__link:is(:hover, :focus-visible) .vt-footer-menu__label::after,
  .vt-footer-menu--hover-underline .vt-footer-menu__contact-link:hover .vt-footer-menu__label::after,
  .vt-footer-menu--hover-underline .vt-footer-menu__contact-link:focus-visible .vt-footer-menu__label::after,
  .vt-footer-menu--hover-underline .vt-footer-menu__contact-link:is(:hover, :focus-visible) .vt-footer-menu__label::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__label::after {
    transform-origin: left;
  }

  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__item:hover .vt-footer-menu__label::after,
  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__item:focus-within .vt-footer-menu__label::after,
  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__link:hover .vt-footer-menu__label::after,
  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__link:focus-visible .vt-footer-menu__label::after,
  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__link:is(:hover, :focus-visible) .vt-footer-menu__label::after,
  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__contact-link:hover .vt-footer-menu__label::after,
  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__contact-link:focus-visible .vt-footer-menu__label::after,
  [dir='rtl'] .vt-footer-menu--hover-underline .vt-footer-menu__contact-link:is(:hover, :focus-visible) .vt-footer-menu__label::after {
    transform: scaleX(1);
    transform-origin: right;
  }

  /* ------------------------------------------------------------- */
  /* Hover effect 2: Sliding border (Matches breadcrumbs.liquid)   */
  /* A sharp vertical bar slides in before the text                 */
  /* ------------------------------------------------------------- */
  .vt-footer-menu--hover-border .vt-footer-menu__label {
    position: relative;
    padding-inline-start: 0.65em;
    transition: transform var(--vt-menu-transition);
  }

  .vt-footer-menu--hover-border .vt-footer-menu__label::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    height: 1em;
    width: 2px;
    background: var(--vt-menu-hover-color, currentColor);
    opacity: 0;
    transform: translate(0, -10%);
    transition:
      opacity var(--vt-menu-transition),
      transform var(--vt-menu-transition);
  }

  .vt-footer-menu--hover-border .vt-footer-menu__item:hover .vt-footer-menu__label,
  .vt-footer-menu--hover-border .vt-footer-menu__item:focus-within .vt-footer-menu__label,
  .vt-footer-menu--hover-border .vt-footer-menu__link:hover .vt-footer-menu__label,
  .vt-footer-menu--hover-border .vt-footer-menu__link:focus-visible .vt-footer-menu__label,
  .vt-footer-menu--hover-border .vt-footer-menu__link:is(:hover, :focus-visible) .vt-footer-menu__label,
  .vt-footer-menu--hover-border .vt-footer-menu__contact-link:hover .vt-footer-menu__label,
  .vt-footer-menu--hover-border .vt-footer-menu__contact-link:focus-visible .vt-footer-menu__label,
  .vt-footer-menu--hover-border .vt-footer-menu__contact-link:is(:hover, :focus-visible) .vt-footer-menu__label {
    transform: translateX(4px);
  }

  /* Bar cancels the text shift, so it stays exactly before the text's start */
  .vt-footer-menu--hover-border .vt-footer-menu__item:hover .vt-footer-menu__label::before,
  .vt-footer-menu--hover-border .vt-footer-menu__item:focus-within .vt-footer-menu__label::before,
  .vt-footer-menu--hover-border .vt-footer-menu__link:hover .vt-footer-menu__label::before,
  .vt-footer-menu--hover-border .vt-footer-menu__link:focus-visible .vt-footer-menu__label::before,
  .vt-footer-menu--hover-border .vt-footer-menu__link:is(:hover, :focus-visible) .vt-footer-menu__label::before,
  .vt-footer-menu--hover-border .vt-footer-menu__contact-link:hover .vt-footer-menu__label::before,
  .vt-footer-menu--hover-border .vt-footer-menu__contact-link:focus-visible .vt-footer-menu__label::before,
  .vt-footer-menu--hover-border .vt-footer-menu__contact-link:is(:hover, :focus-visible) .vt-footer-menu__label::before {
    opacity: 1;
    transform: translate(-4px, -50%);
  }

  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__item:hover .vt-footer-menu__label,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__item:focus-within .vt-footer-menu__label,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__link:hover .vt-footer-menu__label,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__link:focus-visible .vt-footer-menu__label,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__link:is(:hover, :focus-visible) .vt-footer-menu__label,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__contact-link:hover .vt-footer-menu__label,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__contact-link:focus-visible .vt-footer-menu__label {
    transform: translateX(-4px);
  }

  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__item:hover .vt-footer-menu__label::before,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__item:focus-within .vt-footer-menu__label::before,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__link:hover .vt-footer-menu__label::before,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__link:focus-visible .vt-footer-menu__label::before,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__link:is(:hover, :focus-visible) .vt-footer-menu__label::before,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__contact-link:hover .vt-footer-menu__label::before,
  [dir='rtl'] .vt-footer-menu--hover-border .vt-footer-menu__contact-link:focus-visible .vt-footer-menu__label::before {
    transform: translate(4px, -50%);
  }

  /* ------------------------------------------------------------- */
  /* Hover effect 3: Wave fade (Matches breadcrumbs.liquid)        */
  /* A second color sweeps across the text                         */
  /* ------------------------------------------------------------- */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) and (color: color-mix(in srgb, red, blue)) {
    .vt-footer-menu--hover-wave_fade .vt-footer-menu__label {
      background-image: linear-gradient(
        90deg,
        var(--vt-menu-hover-color-wave, color-mix(in srgb, var(--vt-menu-link-color, currentColor) 50%, transparent)) 35%,
        var(--vt-menu-link-color, currentColor) 65%
      );
      background-size: 300% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      transition: background-position var(--vt-menu-transition);
    }

    .vt-footer-menu--hover-wave_fade .vt-footer-menu__item:hover .vt-footer-menu__label,
    .vt-footer-menu--hover-wave_fade .vt-footer-menu__item:focus-within .vt-footer-menu__label,
    .vt-footer-menu--hover-wave_fade .vt-footer-menu__link:hover .vt-footer-menu__label,
    .vt-footer-menu--hover-wave_fade .vt-footer-menu__link:focus-visible .vt-footer-menu__label,
    .vt-footer-menu--hover-wave_fade .vt-footer-menu__link:is(:hover, :focus-visible) .vt-footer-menu__label,
    .vt-footer-menu--hover-wave_fade .vt-footer-menu__contact-link:hover .vt-footer-menu__label,
    .vt-footer-menu--hover-wave_fade .vt-footer-menu__contact-link:focus-visible .vt-footer-menu__label {
      background-position: 0 0;
    }

    [dir='rtl'] .vt-footer-menu--hover-wave_fade .vt-footer-menu__label {
      background-image: linear-gradient(
        270deg,
        var(--vt-menu-hover-color-wave, color-mix(in srgb, var(--vt-menu-link-color, currentColor) 50%, transparent)) 35%,
        var(--vt-menu-link-color, currentColor) 65%
      );
      background-position: 0 0;
    }

    [dir='rtl'] .vt-footer-menu--hover-wave_fade .vt-footer-menu__item:hover .vt-footer-menu__label,
    [dir='rtl'] .vt-footer-menu--hover-wave_fade .vt-footer-menu__item:focus-within .vt-footer-menu__label,
    [dir='rtl'] .vt-footer-menu--hover-wave_fade .vt-footer-menu__link:hover .vt-footer-menu__label,
    [dir='rtl'] .vt-footer-menu--hover-wave_fade .vt-footer-menu__link:focus-visible .vt-footer-menu__label,
    [dir='rtl'] .vt-footer-menu--hover-wave_fade .vt-footer-menu__link:is(:hover, :focus-visible) .vt-footer-menu__label,
    [dir='rtl'] .vt-footer-menu--hover-wave_fade .vt-footer-menu__contact-link:hover .vt-footer-menu__label,
    [dir='rtl'] .vt-footer-menu--hover-wave_fade .vt-footer-menu__contact-link:focus-visible .vt-footer-menu__label {
      background-position: 100% 0;
    }
  }
  

  @media (forced-colors: active) {
    .vt-footer-menu--hover-wave_fade .vt-footer-menu__label {
      background: none;
      -webkit-text-fill-color: currentColor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-footer-menu {
      --vt-menu-transition: 0s;
    }
  }

  .vt-footer-menu__contact {
    margin-top: 1.25rem;
  }

  .vt-footer-menu__contact-divider {
    border: 0;
    height: 1px;
    background-color: rgba(0, 50, 37, 0.2);
    margin: 0 0 1rem 0;
  }

  .vt-footer-menu__contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .vt-footer-menu__contact-item {
    margin: 0;
    padding: 0;
  }

  .vt-footer-menu__contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--vt-menu-link-color);
    font-size: 0.875rem;
    text-decoration: none;
    line-height: 1.4;
    transition: color var(--vt-menu-transition);
  }

  .vt-footer-menu__contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vt-menu-title-color);
    flex-shrink: 0;
  }
{% endstylesheet %}

