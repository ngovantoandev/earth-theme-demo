{% # theme-check-disable UndefinedObject %}
{% # theme-check-disable UnusedAssign %}

{% doc %}
  @example
  {% content_for 'block', type: 'collection-card', id: 'collection-card' %}
{% enddoc %}

{%- liquid
  # ------------------------------------------------------------------
  # 1. Collection resolution
  # ------------------------------------------------------------------
  assign vt_card_collection = closest.collection | default: block.settings.collection
  assign vt_card_is_placeholder = false

  if vt_card_collection == blank
    assign vt_card_is_placeholder = true
    assign vt_card_image = nil
    assign vt_card_image_alt = 'Collection'
  else
    assign vt_card_image = vt_card_collection.featured_image
    assign vt_card_image_alt = vt_card_image.alt | default: vt_card_collection.title
  endif

  # ------------------------------------------------------------------
  # 2. Aspect ratio — per card, desktop + mobile
  # ------------------------------------------------------------------
  case block.settings.aspect_ratio_desktop
    when 'square'
      assign vt_ratio_desktop = '1 / 1'
    when 'portrait'
      assign vt_ratio_desktop = '3 / 4'
    when 'landscape'
      assign vt_ratio_desktop = '4 / 3'
    when 'wide'
      assign vt_ratio_desktop = '16 / 9'
    when 'tall'
      assign vt_ratio_desktop = '2 / 3'
    else
      assign vt_ratio_desktop = '1 / 1'
  endcase

  case block.settings.aspect_ratio_mobile
    when 'square'
      assign vt_ratio_mobile = '1 / 1'
    when 'portrait'
      assign vt_ratio_mobile = '3 / 4'
    when 'landscape'
      assign vt_ratio_mobile = '4 / 3'
    when 'wide'
      assign vt_ratio_mobile = '16 / 9'
    when 'tall'
      assign vt_ratio_mobile = '2 / 3'
    else
      assign vt_ratio_mobile = vt_ratio_desktop
  endcase

  # ------------------------------------------------------------------
  # 3. Colors — block setting wins, palette is fallback
  # ------------------------------------------------------------------
  assign vt_text_color = block.settings.text_color | default: 'var(--vt-foreground-color)'

  if block.settings.background_style == 'overlay'
    assign vt_overlay_bg = block.settings.background_color | default: 'var(--vt-background-color)'
    assign vt_overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
  else
    assign vt_overlay_bg = block.settings.background_gradient
    assign vt_overlay_opacity = 1
  endif

  # ------------------------------------------------------------------
  # 4. Content layout — Tailwind classes from settings
  # ------------------------------------------------------------------
  assign vt_content_classes = 'vt-collection-card__content ' | append: block.settings.position | append: ' ' | append: block.settings.alignment

  # ------------------------------------------------------------------
  # 5. Animation (skipped in theme editor visual preview)
  # ------------------------------------------------------------------
  assign vt_animation_type = block.settings.animation_type
  assign vt_anim_classes = ''

  unless vt_animation_type == 'none' or request.visual_preview_mode
    assign vt_anim_classes = 'vt-animate vt-animate--' | append: vt_animation_type

    if vt_animation_type == 'slide' or vt_animation_type == 'float'
      assign vt_anim_classes = vt_anim_classes | append: ' vt-animate--dir-' | append: block.settings.animation_direction
    endif
  endunless

  assign vt_easing = 'cubic-bezier(0.61, 1, 0.88, 1)'
  case block.settings.animation_easing
    when 'linear'
      assign vt_easing = 'linear'
    when 'ease-in-sine'
      assign vt_easing = 'cubic-bezier(0.12, 0, 0.39, 0)'
    when 'ease-in-out-sine'
      assign vt_easing = 'cubic-bezier(0.37, 0, 0.63, 1)'
    when 'ease-in-cubic'
      assign vt_easing = 'cubic-bezier(0.32, 0, 0.67, 0)'
    when 'ease-out-cubic'
      assign vt_easing = 'cubic-bezier(0.33, 1, 0.68, 1)'
    when 'ease-in-out-cubic'
      assign vt_easing = 'cubic-bezier(0.65, 0, 0.35, 1)'
  endcase
-%}

<li class="vt-collection-card" {{ block.shopify_attributes }}>
  <article
    class="
      vt-collection-card__item
      {%- if vt_card_is_placeholder %} vt-collection-card--placeholder{% endif %}
      {%- if block.settings.enable_hover %} vt-collection-card__item--hover{% endif %}
      {{ vt_anim_classes }}
    "
    style="
      --vt-card-ratio: {{ vt_ratio_desktop }};
      --vt-card-ratio-mobile: {{ vt_ratio_mobile }};
      --vt-card-text-color: {{ vt_text_color }};
      --vt-card-overlay-bg: {{ vt_overlay_bg }};
      --vt-card-overlay-opacity: {{ vt_overlay_opacity }};
      {%- unless vt_animation_type == 'none' or request.visual_preview_mode -%}
        --vt-duration: {{ block.settings.animation_duration }}s;
        --vt-delay: {{ block.settings.animation_delay }}s;
        {%- if vt_animation_type == 'slide' or vt_animation_type == 'float' or vt_animation_type == 'blur' -%}
          --vt-easing: {{ vt_easing }};
        {%- endif -%}
        {%- if vt_animation_type == 'blur' -%}
          --vt-blur: {{ block.settings.animation_blur_intensity }}px;
        {%- endif -%}
      {%- endunless -%}
    "
  >
    <div class="vt-collection-card__media" aria-hidden="true">
      {%- if vt_card_image != blank -%}
        <img
          src="{{ vt_card_image | image_url: width: 800 }}"
          alt="{{ vt_card_image_alt | escape }}"
          width="{{ vt_card_image.width }}"
          height="{{ vt_card_image.height }}"
          loading="lazy"
          class="vt-collection-card__image"
          sizes="(min-width: 768px) 50vw, 100vw"
        >
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'vt-collection-card__image vt-collection-card__image--placeholder' }}
      {%- endif -%}
      <div class="vt-collection-card__overlay"></div>
    </div>

    <div
      class="{{ vt_content_classes }}"
      style="
        --vt-card-gap-mobile: {% render 'fluid-clamp', min_px: block.settings.gap_mobile, max_px: block.settings.gap_mobile, unit: 'rem' %};
        --vt-card-gap-desktop: {% render 'fluid-clamp', min_px: block.settings.gap_desktop, max_px: block.settings.gap_desktop, unit: 'rem' %};
        --vt-card-padding-block-start: {% render 'fluid-clamp', min_px: block.settings.padding_vertical, max_px: block.settings.padding_vertical, unit: 'rem' %};
        --vt-card-padding-inline-start: {% render 'fluid-clamp', min_px: block.settings.padding_horizontal, max_px: block.settings.padding_horizontal, unit: 'rem' %};
        {%- if block.settings.enable_padding_mobile -%}
          --vt-card-padding-block-start-mobile: {% render 'fluid-clamp', min_px: block.settings.padding_vertical_mobile, max_px: block.settings.padding_vertical_mobile, unit: 'rem' %};
          --vt-card-padding-inline-start-mobile: {% render 'fluid-clamp', min_px: block.settings.padding_horizontal_mobile, max_px: block.settings.padding_horizontal_mobile, unit: 'rem' %};
        {%- else -%}
          --vt-card-padding-block-start-mobile: var(--vt-card-padding-block-start);
          --vt-card-padding-inline-start-mobile: var(--vt-card-padding-inline-start);
        {%- endif -%}
      "
    >
      {% content_for 'blocks', closest.collection: vt_card_collection %}
    </div>
  </article>
</li>


