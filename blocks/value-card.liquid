{% doc %}
  Renders a single Value Card slide inside values-tabs.
  - Contains a stack block which in turn contains image and card blocks.
  - Renders a tab button used by parent values-tabs bottom navigation.
{% enddoc %}

{%- liquid
  assign is_preview = false
  if request.visual_preview_mode
    assign is_preview = true
  endif

  assign tab_label = block.settings.tab_label
  if tab_label == blank
    assign tab_label = 'Value'
  endif

  assign tab_id = 'vt-val-tab-' | append: block.id
  assign slide_id = 'vt-val-slide-' | append: block.id
-%}

<div
  class="vt-value-card swiper-slide{% if is_preview %} vt-value-card--preview{% endif %}"
  id="{{ slide_id }}"
  data-block-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <!-- Mountable tab button harvested by values-tabs bottom tablist -->
  <button
    type="button"
    role="tab"
    id="{{ tab_id }}"
    class="vt-values__tab"
    data-block-id="{{ block.id }}"
    data-target-slide="{{ slide_id }}"
    aria-label="{{ tab_label }}"
  >
    <span class="vt-values__tab-indicator" aria-hidden="true"></span>
    <span class="vt-values__tab-text">{{ tab_label }}</span>
  </button>

  <!-- Slide Card Inner Container: Renders stack containing image and card -->
  <div class="vt-value-card__card">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-value-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    min-width: 0;
    user-select: none;
  }

  /* Hidden tab button placeholder in slide DOM (harvested by parent values-tabs) */
  .vt-value-card > .vt-values__tab {
    display: none;
  }

  /* Slide Card Inner Container */
  .vt-value-card__card {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Support Theme Editor wrappers without altering layout */
  .vt-value-card__card > .shopify-block,
  .vt-value-card__card > shopify-block {
    display: contents;
  }

  /* Standalone Preview Mode */
  .vt-value-card--preview {
    max-width: 600px;
    margin: 0 auto;
  }

  /* Top-level stack mobile handling: prevent column blowout */
  @media screen and (max-width: 768px) {
    .vt-value-card__card > .vt-stack--mobile-horizontal > * {
      flex: 1 1 50%;
      min-width: 0;
    }
  }

  /* Keep icons inside value card at natural size instead of stretching */
  .vt-value-card .vt-icon {
    flex-shrink: 0;
    width: auto;
  }

  /* Ensure text inside value card wraps gracefully without overflowing */
  .vt-value-card .vt-paragraph {
    min-width: 0;
    word-break: break-word;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Value card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Tab Navigation"
    },
    {
      "type": "text",
      "id": "tab_label",
      "label": "Tab label",
      "default": "Tab title",
      "info": "Label displayed on the bottom navigation tab"
    }
  ],
  "blocks": [
    {
      "type": "stack"
    }
  ],
  "presets": [
    {
      "name": "Value card",
      "settings": {
        "tab_label": "Tab title"
