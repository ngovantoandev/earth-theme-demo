                {
                  "type": "stack",
                  "settings": {
                    "layout_direction_desktop": "vt-stack--horizontal",
                    "layout_direction_tablet": "vt-stack--horizontal",
                    "layout_direction_mobile": "vt-stack--horizontal",
                    "alignment": "inherit",
                    "position": "center",
                    "width": "fill",
                    "height": "fit",
                    "gap_desktop": 10,
                    "gap_mobile": 8
                  },
                  "blocks": [
                    {
                      "type": "icons",
                      "settings": {
                        "icon": "leaf",
                        "icon_color": "#003225",
                        "icon_size_desktop": 20,
                        "icon_size_mobile": 18
                      }
                    },
                    {
                      "type": "paragraph",
                      "settings": {
                        "text": "<p>Feature description</p>",
                        "paragraph_size": "vt-paragraph-small",
                        "paragraph_alignment": "text-inherit"
                      }
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "settings": {
                    "text": "<p>Paragraph text</p>",
                    "paragraph_size": "vt-paragraph-medium",
                    "paragraph_alignment": "text-inherit"
                  }
                },
                {
                  "type": "button",
                  "settings": {
                    "button_label": "Button label",
                    "button_link": "shopify://collections/all",
                    "button_style": "link"
                  }
                }
