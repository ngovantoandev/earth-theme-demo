                "heading_color": "#003225",
                "text_color": "#003225",
                "position": "middle",
                "alignment": "left",
                "width": "fill",
                "height": "fill",
                "padding_vertical": 48,
                "padding_horizontal": 40,
                "enable_padding_mobile": true,
                "padding_vertical_mobile": 24,
                "padding_horizontal_mobile": 20,
                "gap": 16
              },
              "blocks": [
                {
                  "type": "heading",
                  "settings": {
                    "heading": "Heading",
                    "heading_size": "vt-heading-h2",
                    "heading_alignment": "text-inherit",
                    "heading_tag": "h3"
                  }
                },
                {
