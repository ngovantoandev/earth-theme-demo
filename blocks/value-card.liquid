            "alignment": "flex-start",
            "position": "stretch",
            "width": "fill",
            "height": "fill",
            "gap_desktop": 0,
            "gap_mobile": 0
          },
          "blocks": [
            {
              "type": "image",
              "settings": {
                "image_aspect_ratio": "square",
                "image_desktop_width": "fill",
                "image_mobile_width": "fill"
              }
            },
            {
              "type": "card",
              "settings": {
