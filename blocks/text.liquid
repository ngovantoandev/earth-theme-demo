{% doc %}
  Renders a text block based on snippets/text.liquid.

  @example
  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

<div class="theme-block-text theme-block-text--{{ block.settings.alignment | default: 'left' }}" {{ block.shopify_attributes }}>
  {% render 'text', block: block %}
</div>

{% stylesheet %}
  .theme-block-text {
    width: 100%;
    display: flex;
  }
  .theme-block-text--left {
    justify-content: flex-start;
    text-align: left;
  }
  .theme-block-text--center {
    justify-content: center;
    text-align: center;
  }
  .theme-block-text--right {
    justify-content: flex-end;
    text-align: right;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share information about your brand, materials, or sustainability commitments.</p>"
    },
    {
      "type": "select",
      "id": "text_font",
      "label": "Font Style",
      "options": [
        { "value": "body", "label": "Body (Regular)" },
        { "value": "heading", "label": "Heading (Bold)" },
        { "value": "subheading", "label": "Subheading (Uppercase)" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Size Preset",
      "options": [
        { "value": "custom", "label": "Custom (px - Slider below)" },
        { "value": "small", "label": "Small (14px)" },
        { "value": "medium", "label": "Medium (16px)" },
        { "value": "large", "label": "Large (21px)" },
        { "value": "extra-large", "label": "Extra Large (28px)" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_size",
      "min": 10,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Custom Desktop Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "custom_size_mobile",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Custom Mobile Size",
      "default": 14
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text Color"
    },
    {
      "type": "checkbox",
      "id": "use_secondary_color",
      "label": "Use Secondary Theme Color",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 200,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Max Width",
      "default": 800
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Text",
      "settings": {
        "text": "<p>Share information about your brand, materials, or sustainability commitments.</p>",
        "text_font": "body",
        "text_size": "custom",
        "custom_size": 16,
        "custom_size_mobile": 14
      }
    }
  ]
}
{% endschema %}
