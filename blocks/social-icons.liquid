{% doc %}
  Renders social media buttons (Facebook, Instagram, X/Twitter, YouTube).
  Supports custom button sizing, background color, icon color, and alignment.
  @example
  {% content_for 'block', type: 'social-icons', id: 'social-icons' %}
{% enddoc %}

{%- liquid
  assign bg_setting = block.settings.button_bg_color
  if bg_setting != blank and bg_setting != 'rgba(0,0,0,0)' and bg_setting != '#00000000' and bg_setting != 'transparent'
    assign final_btn_bg = bg_setting
  else
    assign final_btn_bg = 'var(--vt-color-primary, #224E09)'
  endif

  assign icon_setting = block.settings.icon_color
  if icon_setting != blank and icon_setting != 'rgba(0,0,0,0)' and icon_setting != '#00000000' and icon_setting != 'transparent'
    assign final_btn_icon = icon_setting
  else
    assign final_btn_icon = 'var(--vt-color-white, #F8F9DC)'
  endif

  assign alignment = block.settings.alignment | default: 'left'
-%}

<div
  id="social-icons-{{ block.id }}"
  class="vt-social-icons vt-social-icons--align-{{ alignment }}"
  style="
    --vt-si-btn-bg: {{ final_btn_bg }};
    --vt-si-icon-color: {{ final_btn_icon }};
    --vt-si-size: {{ block.settings.button_size }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="vt-social-icons__group">
    <a href="{{ block.settings.facebook_url | default: settings.social_facebook_link | default: '#' }}" class="vt-social-icons__btn" aria-label="Facebook" target="_blank" rel="noopener">
