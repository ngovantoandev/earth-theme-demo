    </a>
  </div>
</div>

{% stylesheet %}
  .vt-social-icons {
    display: flex;
    width: 100%;
    box-sizing: border-box;
  }

  .vt-social-icons--align-left {
    justify-content: flex-start;
  }

  .vt-social-icons--align-center {
    justify-content: center;
  }

  .vt-social-icons--align-right {
    justify-content: flex-end;
  }

  .vt-social-icons__group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .vt-social-icons__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--vt-si-size);
    height: var(--vt-si-size);
    background-color: var(--vt-si-btn-bg);
    color: var(--vt-si-icon-color);
    border-radius: 4px;
    text-decoration: none;
    transition: filter 0.2s ease, transform 0.15s ease;
  }

  .vt-social-icons__btn:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social Icons",
  "tag": null,
  "settings": [
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Button size",
      "default": 44
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#00000000"
    }
  ],
  "presets": [
    {
      "name": "Social Icons",
      "settings": {
        "button_size": 44,
        "alignment": "left"
      }
    }
  ]
}
{% endschema %}
