{% doc %}
  Renders a column-layout of blocks with configurable layout width, gap

  All settings apply to only one dimension to reduce configuration complexity.

  This component is a wrapper concerned only with rendering its children in
  the specified layout direction with appropriate padding and alignment.

  When "Swipeable columns" is enabled, the columns turn into a Swiper.js
  carousel on mobile and tablet only (below 1024px). Desktop always keeps the
  CSS Grid layout. Swiper's CSS/JS are loaded globally in layout/theme.liquid.

  @example
  {% content_for 'block', type: 'column-layout', id: 'column-layout' %}
{% enddoc %}

{%- liquid
  assign desktop_track_list = ''
  for n in (1..block.settings.desktop_column_count)
    assign key = 'desktop_column_' | append: n | append: '_width'
    assign parts = block.settings[key] | split: '|'
    assign desktop_track_list = desktop_track_list | append: parts[1] | append: 'fr '
  endfor

  # The plain share numbers (e.g. "40 60") are also kept for mobile and
  # tablet: the swipe mode uses them as slide widths (share % of the row).
  assign tablet_track_list = ''
  assign tablet_shares = ''
  for n in (1..block.settings.tablet_column_count)
    assign key = 'tablet_column_' | append: n | append: '_width'
    assign parts = block.settings[key] | split: '|'
    assign tablet_track_list = tablet_track_list | append: parts[1] | append: 'fr '
    assign tablet_shares = tablet_shares | append: parts[1] | append: ' '
  endfor

  assign mobile_track_list = ''
  assign mobile_shares = ''
  for n in (1..block.settings.mobile_column_count)
    assign key = 'mobile_column_' | append: n | append: '_width'
    assign parts = block.settings[key] | split: '|'
    assign mobile_track_list = mobile_track_list | append: parts[1] | append: 'fr '
    assign mobile_shares = mobile_shares | append: parts[1] | append: ' '
  endfor

  assign mobile_shares = mobile_shares | strip
  assign tablet_shares = tablet_shares | strip
  assign mobile_first_share = mobile_shares | split: ' ' | first | default: 100
  assign tablet_first_share = tablet_shares | split: ' ' | first | default: 100

  assign gap_classes = block.settings.mobile_gap_x | append: ' ' | append: block.settings.mobile_gap_y | append: ' ' | append: block.settings.tablet_gap_x | append: ' ' | append: block.settings.tablet_gap_y | append: ' ' | append: block.settings.desktop_gap_x | append: ' ' | append: block.settings.desktop_gap_y

  # Swiper positions slides itself, so it needs the horizontal gap as a number
  # (Tailwind spacing scale: 1 unit = 4px, e.g. "md:gap-x-4" -> 16).
  assign mobile_gap_px = block.settings.mobile_gap_x | split: 'gap-x-' | last | times: 4
  assign tablet_gap_px = block.settings.tablet_gap_x | split: 'gap-x-' | last | times: 4

  assign padding_mobile_block_px = block.settings.mobile_padding_block
  assign padding_desktop_block_px = block.settings.padding_block

  assign padding_mobile_inline_px = block.settings.mobile_padding_inline
  assign padding_desktop_inline_px = block.settings.padding_inline

  assign is_swipeable = block.settings.swipe_columns_mobile
  assign is_editor = false
  if request.design_mode or request.visual_preview_mode
    assign is_editor = true
  endif
-%}

<vt-column-layout
  id="vt-column-layout-{{ block.id }}"
  class="vt-column-layout"
  data-swipe="{{ is_swipeable }}"
  data-editor="{{ is_editor }}"
  data-mobile-shares="{{ mobile_shares }}"
  data-tablet-shares="{{ tablet_shares }}"
  data-mobile-gap="{{ mobile_gap_px }}"
  data-tablet-gap="{{ tablet_gap_px }}"
  data-label-carousel="{{ 'accessibility.column_layout.carousel_role_description' | t | escape }}"
  data-label-slide-role="{{ 'accessibility.column_layout.slide_role_description' | t | escape }}"
  data-label-slide="{{ 'accessibility.column_layout.slide_label' | t: index: '__index__', total: '__total__' | escape }}"
  data-label-container="{{ 'accessibility.column_layout.aria_label' | t | escape }}"
  style="--vt-padding-block: {% render 'fluid-clamp', min_px: padding_mobile_block_px, max_px: padding_desktop_block_px %}; --vt-padding-inline: {% render 'fluid-clamp', min_px: padding_mobile_inline_px, max_px: padding_desktop_inline_px %}; --vt-grid-mobile: {{ mobile_track_list }}; --vt-grid-tablet: {{ tablet_track_list }}; --vt-grid-desktop: {{ desktop_track_list }}; --vt-gap-mobile: {{ mobile_gap_px }}px; --vt-gap-tablet: {{ tablet_gap_px }}px; --vt-swipe-share-mobile: {{ mobile_first_share }}; --vt-swipe-share-tablet: {{ tablet_first_share }};"
  role="group"
  aria-label="{{ 'accessibility.column_layout.aria_label' | t }}"
  {{ block.shopify_attributes }}  
>
  {%- comment -%}
    The viewport becomes Swiper's ".swiper" and the list becomes its
    ".swiper-wrapper" only while the carousel is active (see the script below).
    Padding lives on the outer element so Swiper's own "padding: 0" never
    overrides it.
  {%- endcomment -%}
  <div class="vt-column-layout__viewport">
    <div class="vt-column-layout__list grid {{ gap_classes }}" style="--vt-columns-position: {{ block.settings.vertical_alignment }};">
      {%- if block.blocks.size > 0 -%}
        {% content_for "blocks" %}
      {%- elsif is_editor -%}
        {%- comment -%}
          No child blocks yet: show placeholders in the theme editor / AI visual
          preview so the merchant can see the grid shape. Never rendered on the
          live storefront. No width class needed here: the grid tracks defined
          on the parent already size these placeholder divs correctly.
        {%- endcomment -%}
        {%- for i in (1..block.settings.desktop_column_count) -%}
          <div class="vt-column-layout__placeholder" aria-hidden="true">
            <span>{{ 'accessibility.column_layout.column_label' | t: number: i }}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</vt-column-layout>

{% stylesheet %}
  .vt-column-layout {
    display: block;
    width: 100%;
    padding-block: var(--vt-padding-block, 0px);
    padding-inline: var(--vt-padding-inline, 0px);
    box-sizing: border-box;
    --vt-gap: var(--vt-gap-mobile, 0px);
  }

  .vt-column-layout__list {    
    grid-template-columns: var(--vt-grid-mobile, 1fr);
    align-items: var(--vt-columns-position);
  }

  .vt-column-layout__list > * {
    min-width: 0;
    box-sizing: border-box;
    --vt-slide-share: var(--vt-slide-share-mobile, var(--vt-swipe-share-mobile, 100));
  }

  /* Tablet breakpoint mirrors Tailwind's md: (>= 768px). */
  @media (min-width: 768px) {
    .vt-column-layout {
      --vt-gap: var(--vt-gap-tablet, 0px);
    }

    .vt-column-layout__list {
      grid-template-columns: var(--vt-grid-tablet, var(--vt-grid-mobile, 1fr));
    }

    .vt-column-layout__list > * {
      --vt-slide-share: var(--vt-slide-share-tablet, var(--vt-swipe-share-tablet, 100));
    }
  }

  /* Desktop breakpoint mirrors Tailwind's lg: (>= 1024px). */
  @media (min-width: 1024px) {
    .vt-column-layout__list {
      grid-template-columns: var(--vt-grid-desktop, var(--vt-grid-tablet, var(--vt-grid-mobile, 1fr)));
    }
  }

  /*
    Swipe mode: mobile + tablet only (below 1024px). These rules also apply
    before Swiper initialises, so the row already looks like the carousel
    (no layout shift, and it degrades gracefully without JavaScript).
    Slide width = share% of the row, compensated for the gap so that two
    50% columns fit exactly and an 83% column leaves a peek of the next one.
  */
  @media (max-width: 1023.98px) {
    .vt-column-layout[data-swipe='true'] .vt-column-layout__viewport {
      overflow: hidden;
    }

    .vt-column-layout[data-swipe='true'] .vt-column-layout__list {
      display: flex;
      grid-template-columns: none;
    }

    .vt-column-layout[data-swipe='true'] .vt-column-layout__list > * {
      flex: 0 0 auto;
      width: calc((100% + var(--vt-gap)) * var(--vt-slide-share) / 100 - var(--vt-gap));
    }

    /* Swiper applies the gap itself (spaceBetween), so drop the CSS gap. */
    .vt-column-layout[data-swipe='true'] .vt-column-layout__list.swiper-wrapper {
      column-gap: 0;
    }
  }

  .vt-column-layout__placeholder {
    box-sizing: border-box;
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: .0625rem solid rgba(0, 0, 0, 0.25);
    color: rgba(0, 0, 0, 0.45);
    font-size: 0.75rem;
    background-color: rgba(0, 0, 0, 0.03);
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('vt-column-layout')) {
    class VtColumnLayout extends HTMLElement {
      #swiper = null;
      #mediaQuery = window.matchMedia('(max-width: 1023.98px)');

      connectedCallback() {
        if (this.dataset.swipe !== 'true') return;

        this.#mediaQuery.addEventListener('change', this.#sync);

        if (this.dataset.editor === 'true') {
          this.addEventListener('shopify:block:select', this.#onBlockSelect);
        }

        // swiper-bundle.min.js is deferred in theme.liquid: if it has not run
        // yet, it will have by DOMContentLoaded.
        if (typeof window.Swiper === 'function') {
          this.#sync();
        } else {
          document.addEventListener('DOMContentLoaded', this.#sync, { once: true });
        }
      }

      disconnectedCallback() {
        this.#mediaQuery.removeEventListener('change', this.#sync);
        document.removeEventListener('DOMContentLoaded', this.#sync);
        this.removeEventListener('shopify:block:select', this.#onBlockSelect);
        this.#destroy();
      }

      // Carousel only below 1024px; above it the CSS Grid layout is used.
      #sync = () => {
        if (!this.isConnected) return;
        if (this.#mediaQuery.matches) {
          this.#init();
        } else {
          this.#destroy();
        }
      };

      // Swiper's a11y messages use mustache-style placeholders. They are built
      // from single characters so this static JS block never contains a literal
      // double curly brace (theme-check: StaticStylesheetAndJavascriptTags).
      #token(name) {
        return '{'.repeat(2) + name + '}'.repeat(2);
      }

      #toShares(value) {
        const shares = (value || '').split(' ').filter(Boolean);
        return shares.length ? shares : ['100'];
      }

      #init() {
        if (this.#swiper || typeof window.Swiper !== 'function') return;

        const viewport = this.querySelector('.vt-column-layout__viewport');
        const list = this.querySelector('.vt-column-layout__list');
        if (!viewport || !list) return;

        const slides = [...list.children].filter(
          (child) => !child.classList.contains('vt-column-layout__placeholder')
        );
        if (slides.length < 2) return;

        // Column widths repeat per row in the grid; do the same per slide.
        const mobileShares = this.#toShares(this.dataset.mobileShares);
        const tabletShares = this.#toShares(this.dataset.tabletShares);

        viewport.classList.add('swiper');
        list.classList.add('swiper-wrapper');
        slides.forEach((slide, index) => {
          slide.classList.add('swiper-slide');
          slide.style.setProperty('--vt-slide-share-mobile', mobileShares[index % mobileShares.length]);
          slide.style.setProperty('--vt-slide-share-tablet', tabletShares[index % tabletShares.length]);
        });

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.#swiper = new window.Swiper(viewport, {
          slidesPerView: 'auto',
          spaceBetween: Number(this.dataset.mobileGap) || 0,
          breakpoints: {
            768: { spaceBetween: Number(this.dataset.tabletGap) || 0 },
          },
          speed: prefersReducedMotion ? 0 : 300,
          watchOverflow: true,
          a11y: {
            enabled: true,
            containerRole: 'group',
            containerMessage: this.dataset.labelContainer,
            containerRoleDescriptionMessage: this.dataset.labelCarousel,
            itemRoleDescriptionMessage: this.dataset.labelSlideRole,
            slideLabelMessage: (this.dataset.labelSlide || '')
              .replace('__index__', this.#token('index'))
              .replace('__total__', this.#token('slidesLength')),
          },
        });
      }      

      #destroy() {
        if (!this.#swiper) return;

        const { el, wrapperEl, slides } = this.#swiper;
        this.#swiper.destroy(true, true);
        this.#swiper = null;

        el.classList.remove('swiper');
        ['role', 'aria-label', 'aria-roledescription'].forEach((name) => el.removeAttribute(name));

        wrapperEl.classList.remove('swiper-wrapper');
        ['id', 'aria-live', 'aria-atomic'].forEach((name) => wrapperEl.removeAttribute(name));

        slides.forEach((slide) => {
          slide.classList.remove('swiper-slide');
          ['role', 'aria-label', 'aria-roledescription', 'aria-hidden'].forEach((name) =>
            slide.removeAttribute(name)
          );
          slide.style.removeProperty('--vt-slide-share-mobile');
          slide.style.removeProperty('--vt-slide-share-tablet');
        });
      }

      // Theme editor: bring the selected block's slide into view.
      #onBlockSelect = (event) => {
        if (!this.#swiper) return;
        const slide = event.target.closest?.('.swiper-slide');
        const index = slide ? this.#swiper.slides.indexOf(slide) : -1;
        if (index >= 0) this.#swiper.slideTo(index);
      };
    }

    customElements.define('vt-column-layout', VtColumnLayout);
  }
{% endjavascript %}

