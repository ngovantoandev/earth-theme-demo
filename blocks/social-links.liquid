{% doc %}
  Renders the social media links, brand hashtag caption, and country/language selectors.
  Supports responsive flex layout, custom colors, and Shopify localization form.
  @example
  {% content_for 'block', type: 'social-links', id: 'social-links' %}
{% enddoc %}

{%- liquid
  assign title = block.settings.title
  assign caption = block.settings.caption
  assign title_color = block.settings.title_color
  assign btn_bg = block.settings.button_bg_color
  assign btn_icon = block.settings.button_icon_color
-%}

<div
  id="social-links-{{ block.id }}"
  class="vt-social-links"
  style="
    --vt-sl-title-color: {% if title_color != blank and title_color != '#00000000' %}{{ title_color }}{% else %}var(--vt-foreground-color, #003225){% endif %};
    --vt-sl-btn-bg: {% if btn_bg != blank and btn_bg != '#00000000' %}{{ btn_bg }}{% else %}var(--vt-color-primary, #224E09){% endif %};
    --vt-sl-btn-icon: {% if btn_icon != blank and btn_icon != '#00000000' %}{{ btn_icon }}{% else %}var(--vt-color-white, #F8F9DC){% endif %};
  "
  {{ block.shopify_attributes }}
>
  {%- if title != blank -%}
    <h3 class="vt-social-links__title">
      {{ title }}
    </h3>
  {%- elsif request.visual_preview_mode -%}
    <h3 class="vt-social-links__title">
      Follow Us
    </h3>
  {%- endif -%}

  <div class="vt-social-links__buttons">
    <a href="{{ block.settings.facebook_url | default: settings.social_facebook_link | default: '#' }}" class="vt-social-links__btn" aria-label="Facebook" target="_blank" rel="noopener">
      <svg width="12" height="20" viewBox="0 0 11 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6.74157 20V10.8777H9.80231L10.2615 7.32156H6.74157V5.05147C6.74157 4.0222 7.02621 3.32076 8.50386 3.32076L10.3854 3.31999V0.13923C10.06 0.0969453 8.94308 0 7.64308 0C4.92848 0 3.07002 1.65697 3.07002 4.69927V7.32156H0V10.8777H3.07002V20H6.74157Z" fill="currentColor"/>
      </svg>
    </a>

    <a href="{{ block.settings.instagram_url | default: settings.social_instagram_link | default: '#' }}" class="vt-social-links__btn" aria-label="Instagram" target="_blank" rel="noopener">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M19.9804 5.88005C19.9336 4.81738 19.7617 4.0868 19.5156 3.45374C19.2616 2.78176 18.8709 2.18014 18.359 1.68002C17.8589 1.1721 17.2533 0.777435 16.5891 0.527447C15.9524 0.281274 15.2256 0.109427 14.163 0.0625732C13.0923 0.0117516 12.7525 0 10.0371 0C7.32171 0 6.98183 0.0117516 5.91519 0.0586052C4.85251 0.105459 4.12193 0.277459 3.48902 0.523479C2.8169 0.777435 2.21528 1.16814 1.71515 1.68002C1.20724 2.18014 0.812721 2.78573 0.56258 3.44992C0.316408 4.0868 0.14456 4.81341 0.0977066 5.87609C0.0468849 6.9467 0.0351334 7.28658 0.0351334 10.002C0.0351334 12.7173 0.0468849 13.0572 0.0937386 14.1239C0.140592 15.1865 0.312592 15.9171 0.558765 16.5502C0.812721 17.2221 1.20724 17.8238 1.71515 18.3239C2.21528 18.8318 2.82086 19.2265 3.48506 19.4765C4.12193 19.7226 4.84854 19.8945 5.91137 19.9413C6.97787 19.9883 7.3179 19.9999 10.0333 19.9999C12.7486 19.9999 13.0885 19.9883 14.1552 19.9413C15.2178 19.8945 15.9484 19.7226 16.5813 19.4765C17.9254 18.9568 18.9881 17.8941 19.5078 16.5502C19.7538 15.9133 19.9258 15.1865 19.9727 14.1239C20.0195 13.0572 20.0313 12.7173 20.0313 10.002C20.0313 7.28658 20.0273 6.9467 19.9804 5.88005ZM18.1794 14.0457C18.1364 15.0225 17.9723 15.5499 17.8355 15.9015C17.4995 16.7728 16.808 17.4643 15.9367 17.8004C15.585 17.9372 15.0538 18.1012 14.0808 18.1441C13.026 18.1911 12.7096 18.2027 10.0411 18.2027C7.37253 18.2027 7.05219 18.1911 6.00111 18.1441C5.02436 18.1012 4.49691 17.9372 4.14528 17.8004C3.71169 17.6402 3.31702 17.3862 2.99668 17.0541C2.66458 16.7298 2.41063 16.3391 2.25038 15.9055C2.11363 15.5539 1.94957 15.0225 1.90668 14.0497C1.85968 12.9948 1.84808 12.6783 1.84808 10.0097C1.84808 7.34122 1.85968 7.02087 1.90668 5.96995C1.94957 4.99319 2.11363 4.46575 2.25038 4.11412C2.41063 3.68038 2.66458 3.28586 3.00065 2.96536C3.32481 2.63327 3.71551 2.37931 4.14925 2.21921C4.50088 2.08247 5.03229 1.9184 6.00508 1.87537C7.05997 1.82851 7.3765 1.81676 10.0449 1.81676C12.7174 1.81676 13.0337 1.82851 14.0848 1.87537C15.0616 1.9184 15.589 2.08247 15.9406 2.21921C16.3742 2.37931 16.7689 2.63327 17.0892 2.96536C17.4213 3.28967 17.6753 3.68038 17.8355 4.11412C17.9723 4.46575 18.1364 4.99701 18.1794 5.96995C18.2262 7.02484 18.238 7.34122 18.238 10.0097C18.238 12.6783 18.2262 12.9908 18.1794 14.0457Z" fill="currentColor"/>
        <path d="M10.0371 4.86426C7.20068 4.86426 4.89936 7.16543 4.89936 10.002C4.89936 12.8385 7.20068 15.1397 10.0371 15.1397C12.8736 15.1397 15.1748 12.8385 15.1748 10.002C15.1748 7.16543 12.8736 4.86426 10.0371 4.86426ZM10.0371 13.3347C8.19697 13.3347 6.70437 11.8422 6.70437 10.002C6.70437 8.16172 8.19697 6.66927 10.0371 6.66927C11.8773 6.66927 13.3698 8.16172 13.3698 10.002C13.3698 11.8422 11.8773 13.3347 10.0371 13.3347Z" fill="currentColor"/>
        <path d="M16.5775 4.66134C16.5775 5.3237 16.0405 5.86076 15.378 5.86076C14.7156 5.86076 14.1785 5.3237 14.1785 4.66134C14.1785 3.99882 14.7156 3.46191 15.378 3.46191C16.0405 3.46191 16.5775 3.99882 16.5775 4.66134Z" fill="currentColor"/>
      </svg>
    </a>

    <a href="{{ block.settings.twitter_url | default: settings.social_twitter_link | default: '#' }}" class="vt-social-links__btn" aria-label="X (Twitter)" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9.48944 6.77491L15.3177 0H13.9366L8.8759 5.88256L4.83394 0H0.172012L6.28426 8.89547L0.172012 16H1.55321L6.89743 9.78782L11.166 16H15.828L9.4891 6.77491H9.48944ZM7.5977 8.97384L6.9784 8.08805L2.05087 1.03974H4.17231L8.14888 6.72795L8.76818 7.61374L13.9373 15.0075H11.8158L7.5977 8.97418V8.97384Z" fill="currentColor"/>
      </svg>
    </a>

    <a href="{{ block.settings.youtube_url | default: settings.social_youtube_link | default: '#' }}" class="vt-social-links__btn" aria-label="YouTube" target="_blank" rel="noopener">
      <svg width="20" height="15" viewBox="0 0 20 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M19.57 2.2C19.34 1.34 18.66 0.66 17.8 0.43C16.24 0 10 0 10 0C10 0 3.76 0 2.2 0.43C1.34 0.66 0.66 1.34 0.43 2.2C0 3.76 0 7 0 7C0 7 0 10.24 0.43 11.8C0.66 12.66 1.34 13.34 2.2 13.57C3.76 14 10 14 10 14C10 14 16.24 14 17.8 13.57C18.66 13.34 19.34 12.66 19.57 11.8C20 10.24 20 7 20 7C20 7 20 3.76 19.57 2.2ZM8 10V4L13.2 7L8 10Z" fill="currentColor"/>
      </svg>
    </a>
  </div>

  {%- if caption != blank -%}
    <div class="vt-social-links__caption">
      {{ caption }}
    </div>
  {%- elsif request.visual_preview_mode -%}
    <div class="vt-social-links__caption">
      Share your sustainable style with our community
    </div>
  {%- endif -%}

  {%- if block.settings.enable_country_selector or block.settings.enable_language_selector -%}
    <div class="vt-social-links__localization">
      {%- form 'localization', id: 'FooterLocalizationForm', class: 'vt-social-links__localization-form' -%}
        {%- if block.settings.enable_country_selector -%}
          <div class="vt-social-links__select-wrapper">
            <select name="country_code" class="vt-social-links__select" aria-label="Select Country/Currency" onchange="this.form.submit()">
              {%- if localization.available_countries.size > 0 -%}
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              {%- else -%}
                <option value="US" selected>United States (USD $)</option>
                <option value="CA">Canada (CAD $)</option>
                <option value="GB">United Kingdom (GBP £)</option>
                <option value="EU">European Union (EUR €)</option>
              {%- endif -%}
            </select>
            <span class="vt-social-links__select-chevron" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </div>
        {%- endif -%}

        {%- if block.settings.enable_language_selector -%}
          <div class="vt-social-links__select-wrapper">
            <select name="locale_code" class="vt-social-links__select" aria-label="Select Language" onchange="this.form.submit()">
              {%- if localization.available_languages.size > 0 -%}
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              {%- else -%}
                <option value="en" selected>English</option>
                <option value="fr">Français</option>
                <option value="de">Deutsch</option>
                <option value="es">Español</option>
              {%- endif -%}
            </select>
            <span class="vt-social-links__select-chevron" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .vt-social-links {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    width: 100%;
    box-sizing: border-box;
  }

  .vt-social-links__title {
    font-size: 0.9375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--vt-sl-title-color);
    margin: 0;
  }

  .vt-social-links__buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .vt-social-links__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--vt-sl-btn-bg);
    color: var(--vt-sl-btn-icon);
    border-radius: 4px;
    text-decoration: none;
    transition: filter 0.2s ease, transform 0.15s ease;
  }

  .vt-social-links__btn:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }

  .vt-social-links__caption {
    font-size: 0.875rem;
    color: var(--vt-sl-title-color);
    line-height: 1.4;
  }

  .vt-social-links__localization-form {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    width: 100%;
    margin: 0;
  }

  .vt-social-links__select-wrapper {
    position: relative;
    flex: 1;
    min-width: 140px;
    max-width: 200px;
  }

  @media screen and (max-width: 480px) {
    .vt-social-links__select-wrapper {
      max-width: 100%;
    }
  }

  .vt-social-links__select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    background-color: transparent;
    border: 1px solid rgba(0, 50, 37, 0.4);
    border-radius: 4px;
    padding: 0.625rem 2rem 0.625rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--vt-sl-title-color);
    cursor: pointer;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
  }

  .vt-social-links__select:focus-visible {
    border-color: var(--vt-color-secondary, #71CC3B);
    outline: 1px solid var(--vt-color-secondary, #71CC3B);
  }

  .vt-social-links__select-chevron {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    display: flex;
    align-items: center;
    color: var(--vt-sl-title-color);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social links",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Follow Us"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "inline_richtext",
      "id": "caption",
      "label": "Caption text",
      "default": "Connect with us on social media"
    },
    {
      "type": "header",
      "content": "Localization Selectors"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Style & Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Text color",
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Social button background",
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "button_icon_color",
      "label": "Social button icon color",
      "default": "#00000000"
    }
  ],
  "presets": [
    {
      "name": "Social links",
      "settings": {
        "title": "Follow Us",
        "caption": "Connect with us on social media",
        "enable_country_selector": true,
        "enable_language_selector": true
      }
    }
  ]
}
{% endschema %}
