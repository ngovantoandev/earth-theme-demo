{% doc %}
  Scrolling content (marquee): child blocks run in a seamless loop. Use it on its
  own (Scrolling content section) or inside any section that accepts theme
  blocks, for example a Stack beside an Image.

  Motion is a CSS transform animation. assets/theme-marquee.js copies the content
  as many times as the row needs (copies are aria-hidden and inert) and turns the
  Speed setting into a duration. Without JavaScript, or with reduced motion, the
  row stays still and scrolls sideways.

  Items come from the block's child blocks: callers must leave the body empty.

  @example
  {% content_for 'block', type: 'scrolling-content', id: 'scrolling-content' %}
{% enddoc %}

{%- liquid
  assign marquee_class = 'vt-marquee vt-marquee--' | append: block.settings.direction | append: ' vt-marquee--sep-' | append: block.settings.separator
  if block.settings.pause_on_hover
    assign marquee_class = marquee_class | append: ' vt-marquee--pause-hover'
  endif
-%}

{%- comment -%}
  The separator icon becomes a CSS mask, so one icon in the markup draws every
  separator, including those in the copies, with no extra elements or layout shift.
  Capturing the icon is the only way to turn the snippet into a data URL.
{%- endcomment -%}
{%- if block.settings.separator == 'icon' -%}
  {%- capture separator_svg -%}{%- render 'icons', icon: block.settings.separator_icon -%}{%- endcapture -%}
{%- endif -%}

<vt-marquee
  class="{{ marquee_class }}"
  style="
    --vt-marquee-speed-desktop: {{ block.settings.speed_desktop }};
    --vt-marquee-speed-mobile: {{ block.settings.speed_mobile }};
    --vt-marquee-gap: {% render 'fluid-clamp', min_px: block.settings.gap_mobile, max_px: block.settings.gap_desktop %};
    --vt-marquee-image-height: {% render 'fluid-clamp', min_px: block.settings.image_height_mobile, max_px: block.settings.image_height_desktop %};
    {%- if block.settings.separator != 'none' %}
    --vt-marquee-separator-size: {% render 'fluid-clamp', min_px: block.settings.separator_size_mobile, max_px: block.settings.separator_size_desktop %};
    --vt-marquee-separator-color: {{ block.settings.separator_color | default: 'var(--vt-color-secondary)' }};
    {%- endif %}
    {%- if separator_svg != blank %}
    --vt-marquee-separator-icon: url('data:image/svg+xml;base64,{{ separator_svg | strip | base64_encode }}');
    {%- endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="vt-marquee__viewport">
    <div class="vt-marquee__track" data-marquee-track>
      <div class="vt-marquee__group" data-marquee-group>
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>

</vt-marquee>

<script src="{{ 'theme-marquee.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .vt-marquee {
    --vt-marquee-speed: var(--vt-marquee-speed-mobile, 30);
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .vt-marquee {
      --vt-marquee-speed: var(--vt-marquee-speed-desktop, 40);
    }
  }

  /*
    Still row (no JavaScript yet, or reduced motion): scrolls sideways, no scrollbar.
    A scrolling box also clips vertically, so the padding gives focus rings, link
    underlines and entrance animations room above and below; the negative margin
    keeps the row's height unchanged.
  */
  .vt-marquee__viewport {
    --vt-marquee-bleed: 0.75rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: var(--vt-marquee-bleed);
    margin-block: calc(var(--vt-marquee-bleed) * -1);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .vt-marquee__viewport::-webkit-scrollbar {
    display: none;
  }

  .vt-marquee__track,
  .vt-marquee__group {
    display: flex;
    align-items: center;
    gap: var(--vt-marquee-gap, 2.5rem);
    width: max-content;
    white-space: nowrap;
  }

  .vt-marquee__group {
    flex-shrink: 0;
  }

  /* Items: keep their own width on one line; the separator follows each item */
  .vt-marquee .vt-marquee__group > * {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    align-items: center;
    width: auto;
    max-width: none;
    margin: 0;
  }

  .vt-marquee:not(.vt-marquee--sep-none) .vt-marquee__group > *::after {
    content: '';
    flex-shrink: 0;
    margin-inline-start: var(--vt-marquee-gap, 2.5rem);
    color: var(--vt-marquee-separator-color, var(--vt-color-secondary));
  }

  .vt-marquee.vt-marquee--sep-icon .vt-marquee__group > *::after {
    width: var(--vt-marquee-separator-size, 2rem);
    height: var(--vt-marquee-separator-size, 2rem);
    background-color: currentColor;
    mask: var(--vt-marquee-separator-icon) center / contain no-repeat;
  }

  .vt-marquee.vt-marquee--sep-dot .vt-marquee__group > *::after {
    width: calc(var(--vt-marquee-separator-size, 2rem) * 0.3);
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: currentColor;
  }

  .vt-marquee.vt-marquee--sep-slash .vt-marquee__group > *::after {
    content: '/';
    font-size: var(--vt-marquee-separator-size, 2rem);
    line-height: 1;
  }

  /* Images (logos…): one height for the whole row, width from the image */
  .vt-marquee .vt-image__media {
    height: var(--vt-marquee-image-height, 3rem);
    width: auto;
  }

  .vt-marquee .vt-image__img,
  .vt-marquee .vt-image__placeholder {
    width: auto;
    height: 100%;
    aspect-ratio: var(--vt-aspect-ratio, auto);
  }

  /* Moving row */
  @media (prefers-reduced-motion: no-preference) {
    /* Moving row: clip only the sides, nothing is cut above or below */
    .vt-marquee[data-ready] .vt-marquee__viewport {
      overflow-x: clip;
      overflow-y: visible;
    }

    .vt-marquee[data-ready] .vt-marquee__track {
      animation: vt-marquee var(--vt-marquee-duration, 30s) linear infinite;
      will-change: transform;
    }

    .vt-marquee--right[data-ready] .vt-marquee__track {
      animation-direction: reverse;
    }

    .vt-marquee[data-offscreen] .vt-marquee__track,
    .vt-marquee:focus-within .vt-marquee__track,
    .vt-marquee--pause-hover:hover .vt-marquee__track {
      animation-play-state: paused;
    }
  }

  @keyframes vt-marquee {
    to {
      transform: translate3d(calc(var(--vt-marquee-shift, 50%) * -1), 0, 0);
    }
  }

  [dir='rtl'] .vt-marquee__track {
    animation-direction: reverse;
  }

  [dir='rtl'] .vt-marquee--right .vt-marquee__track {
    animation-direction: normal;
  }
{% endstylesheet %}

