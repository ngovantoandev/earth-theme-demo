{% doc %}
  Renders secure payment badges (Amex, Diners, Discover, Mastercard, Visa, Shop Pay, Google Pay, Apple Pay).
  Supports custom icon sizing, alignment, and spacing.
  @example
  {% content_for 'block', type: 'payment-icons', id: 'payment-icons' %}
{% enddoc %}

{%- liquid
  assign alignment = block.settings.alignment | default: 'left'
-%}

