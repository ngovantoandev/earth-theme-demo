{% stylesheet %}
  .vt-payment-icons {
    display: flex;
    width: 100%;
    box-sizing: border-box;
  }

  .vt-payment-icons--align-left {
    justify-content: flex-start;
  }

  .vt-payment-icons--align-center {
    justify-content: center;
  }

  .vt-payment-icons--align-right {
    justify-content: flex-end;
  }

  .vt-payment-icons__grid {
    display: flex;
    align-items: center;
    gap: var(--vt-pi-gap);
    flex-wrap: wrap;
  }

  .vt-payment-icons__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--vt-pi-height);
  }

  .vt-payment-icons__badge svg {
    display: block;
    height: var(--vt-pi-height);
    width: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Payment icons",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Payment icons will appear once you [set up payment methods](/admin/settings/payments)."
    },
    {
      "type": "range",
      "id": "icon_height",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Icon height",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Spacing between icons",
      "default": 8
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Payment icons",
      "settings": {
        "icon_height": 24,
        "gap": 8,
        "alignment": "left"
      }
    }
  ]
}
{% endschema %}
