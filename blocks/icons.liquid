{% doc %}
  Decorative icon, with an optional box behind it.
  Self-contained: callers must leave the body empty.

  @example
  {% content_for 'block', type: 'icons', id: 'icons' %}
{% enddoc %}


{% liquid
  assign icon = block.settings.icon
  assign animation_type = block.settings.animation_type

  # -----------------------------------------------------------------------
  # Color: a blank icon matches the text around it. Inside a box it uses the
  # palette, because the text color could be the same as the box.
  # -----------------------------------------------------------------------
  # Empty colors follow Color style and Box style (palette only)
  assign vt_box_bg = 'var(--vt-background-color)'
  assign vt_icon_on_box = 'var(--vt-foreground-color)'
  case block.settings.box_style
    when 'dark'
      assign vt_box_bg = 'var(--vt-foreground-color)'
      assign vt_icon_on_box = 'var(--vt-background-color)'
    when 'secondary'
      assign vt_box_bg = 'var(--vt-color-secondary)'
    when 'accent'
      assign vt_box_bg = 'var(--vt-color-accent)'
  endcase

  case block.settings.color_style
    when 'primary'
      assign vt_icon_color = 'var(--vt-color-primary)'
    when 'secondary'
      assign vt_icon_color = 'var(--vt-color-secondary)'
    when 'accent'
      assign vt_icon_color = 'var(--vt-color-accent)'
    else
      assign vt_icon_color = 'currentColor'
      if block.settings.show_box
        assign vt_icon_color = vt_icon_on_box
      endif
  endcase
  assign vt_icon_color = block.settings.icon_color | default: vt_icon_color

  # -----------------------------------------------------------------------
  # Animation classes / custom properties. Skipped inside the visual preset
  # preview so presets render fully visible instead of waiting on an
  # IntersectionObserver that may never fire inside the preview frame.
  # -----------------------------------------------------------------------
  assign vt_anim_classes = ''
  unless animation_type == 'none' or request.visual_preview_mode or section.index == 1 and section.location == 'template'
    assign vt_anim_classes = 'vt-animate vt-animate--' | append: animation_type
    if animation_type == 'slide' or animation_type == 'reveal'
      assign vt_anim_classes = vt_anim_classes | append: ' vt-animate--dir-' | append: block.settings.animation_direction
    endif
  endunless

  assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)'
  case block.settings.animation_easing
    when 'linear'
      assign vt_easing_value = 'linear'
    when 'ease-out-sine'
      assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)'
    when 'ease-in-sine'
      assign vt_easing_value = 'cubic-bezier(0.12, 0, 0.39, 0)'
    when 'ease-in-out-sine'
      assign vt_easing_value = 'cubic-bezier(0.37, 0, 0.63, 1)'
    when 'ease-in-cubic'
      assign vt_easing_value = 'cubic-bezier(0.32, 0, 0.67, 0)'
    when 'ease-out-cubic'
      assign vt_easing_value = 'cubic-bezier(0.33, 1, 0.68, 1)'
    when 'ease-in-out-cubic'
      assign vt_easing_value = 'cubic-bezier(0.65, 0, 0.35, 1)'
  endcase

  # -----------------------------------------------------------------------
  # Class list (built with assign + append, no capture needed)
  # -----------------------------------------------------------------------
  assign vt_class_list = 'vt-icon'

  # No color and no box: the icon follows the text color, also when a link around it
  # changes color on hover (Link hover effect: Color only)
  if block.settings.icon_color == blank and block.settings.show_box == false
    assign vt_class_list = vt_class_list | append: ' vt-icon--inherit'
  endif

  if block.settings.show_box
    assign vt_class_list = vt_class_list | append: ' has-box'
  endif

  if vt_anim_classes != blank
    assign vt_class_list = vt_class_list | append: ' ' | append: vt_anim_classes
  endif
%}

<div
  class="{{ vt_class_list }}"
  style="
    --vt-icon-size: {% render 'fluid-clamp', min_px: block.settings.icon_size_mobile, max_px: block.settings.icon_size_desktop %};
    --vt-icon-color: {{ vt_icon_color }};
    {%- if block.settings.show_box %}
    --vt-box-size: {% render 'fluid-clamp', min_px: block.settings.box_size_mobile, max_px: block.settings.box_size_desktop %};
    --vt-box-bg-color: {{ block.settings.box_bg_color | default: vt_box_bg }};
    --vt-box-radius: {{ block.settings.box_radius }};
    {%- endif %}
    {%- if vt_anim_classes != blank %}
    --vt-duration: {{ block.settings.animation_duration }}s;
    --vt-delay: {{ block.settings.animation_delay }}s;
    {%- endif %}
    {%- if animation_type == 'slide' or animation_type == 'reveal' or animation_type == 'blur' %}
    --vt-easing: {{ vt_easing_value }};
    {%- endif %}
    {%- if animation_type == 'blur' %}
    --vt-blur: {{ block.settings.animation_blur_intensity }}px;
    {%- endif %}
  "
  aria-hidden="true"
  {{ block.shopify_attributes }}
>
  {%- render 'icons', icon: icon -%}
</div>

{% stylesheet %}
  .vt-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    flex-shrink: 0;
    contain: layout style;
  }

  .vt-icon svg {
    width: var(--vt-icon-size, 2rem);
    height: var(--vt-icon-size, 2rem);
    color: var(--vt-icon-color, currentColor);
  }

  /* Box icon styles */
  .vt-icon.has-box {
    width: var(--vt-box-size, 3.5rem);
    height: var(--vt-box-size, 3.5rem);
    background-color: var(--vt-box-bg-color, transparent);
    border-radius: var(--vt-box-radius, 50%);
  }

  .vt-icon.has-box svg {
    max-width: 100%;
    max-height: 100%;
  }
{% endstylesheet %}

