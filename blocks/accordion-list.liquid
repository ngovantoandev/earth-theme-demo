{% doc %}
  Renders an Accordion container block.
  - Groups one or more `accordion-item` blocks.
  - Enforces exclusive expansion (auto-closing other items) when `allow_multiple_open: false`.
  - Configurable gaps and responsive padding.

  @example
  {% content_for 'block', type: 'accordion-list', id: 'accordion-list' %}
{% enddoc %}

{%- liquid
  assign gap_desktop = block.settings.gap_desktop | default: 16
  assign gap_mobile = block.settings.gap_mobile | default: 12
-%}

<vt-accordion
  id="vt-accordion-{{ block.id }}"
  class="vt-accordion"
  data-allow-multiple="{{ block.settings.allow_multiple_open }}"
  data-group-id="vt-accordion-{{ block.id }}"
  style="
    --vt-acc-gap: {% render 'fluid-clamp', min_px: gap_mobile, max_px: gap_desktop %};
    --vt-acc-pad-top: {% render 'fluid-clamp', min_px: block.settings.padding_top_mobile, max_px: block.settings.padding_top_desktop %};
    --vt-acc-pad-bottom: {% render 'fluid-clamp', min_px: block.settings.padding_bottom_mobile, max_px: block.settings.padding_bottom_desktop %};
    --vt-acc-pad-left: {% render 'fluid-clamp', min_px: block.settings.padding_left_mobile, max_px: block.settings.padding_left_desktop %};
    --vt-acc-pad-right: {% render 'fluid-clamp', min_px: block.settings.padding_right_mobile, max_px: block.settings.padding_right_desktop %};
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
  {%- if block.blocks.size == 0 and request.design_mode -%}
    <div class="vt-accordion__empty-placeholder" style="display: flex; flex-direction: column; gap: 12px; width: 100%; opacity: 0.7;">
      <div style="border: 1px dashed var(--vt-color-accent, #EAE060); padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-radius: 4px;">
        <span style="font-weight: 600; font-size: 15px;">Accordion (Click + to add Accordion item)</span>
        <span style="font-size: 18px;">+</span>
      </div>
    </div>
  {%- endif -%}
</vt-accordion>

{% stylesheet %}
  .vt-accordion {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--vt-acc-gap, 16px);
    padding-top: var(--vt-acc-pad-top, 0);
    padding-bottom: var(--vt-acc-pad-bottom, 0);
    padding-left: var(--vt-acc-pad-left, 0);
    padding-right: var(--vt-acc-pad-right, 0);
    box-sizing: border-box;
  }
{% endstylesheet %}

<script>
  if (!customElements.get('vt-accordion')) {
    class VtAccordion extends HTMLElement {
      connectedCallback() {
        this.updateGroup();
        this.observer = new MutationObserver(() => this.updateGroup());
        this.observer.observe(this, { childList: true, subtree: true });

        // Fallback event listener for browsers without native details[name] exclusivity
        this.addEventListener(
          'toggle',
          (event) => {
            const allowMultiple = this.dataset.allowMultiple === 'true';
            if (allowMultiple) return;
            if (event.target.tagName.toLowerCase() === 'details' && event.target.open) {
              const allDetails = this.querySelectorAll('details.vt-accordion-item');
              allDetails.forEach((d) => {
                if (d !== event.target && d.open) {
                  d.open = false;
                }
              });
            }
          },
          true
        );
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }

      updateGroup() {
        const allowMultiple = this.dataset.allowMultiple === 'true';
        const groupId = this.dataset.groupId || `vt-accordion-${Math.random().toString(36).slice(2, 8)}`;
        const allDetails = this.querySelectorAll('details.vt-accordion-item');

        allDetails.forEach((details) => {
          if (!allowMultiple) {
            details.setAttribute('name', groupId);
          } else {
            details.removeAttribute('name');
          }
        });
      }
    }
    customElements.define('vt-accordion', VtAccordion);
  }
</script>

