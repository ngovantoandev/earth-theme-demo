{% # theme-check-disable UndefinedObject %}

{% doc %}
  Renders a heading block with optional scroll-in animation.
  Inside a collection card, text comes from closest.collection.title.

  @example
  {% content_for 'block', type: 'collection-title', id: 'collection-title' %}
{% enddoc %}

{%- liquid
  # -----------------------------------------------------------------
  # Override from closest collection, fallback to block setting
  # -----------------------------------------------------------------
  assign vt_heading_text = block.settings.heading

  if closest.collection != blank
    assign vt_heading_text = closest.collection.title
  endif

  assign vt_show_index = block.settings.show_index

  # -----------------------------------------------------------------
  # Product count — resolved from closest.collection.products_count
  # -----------------------------------------------------------------
  assign vt_show_product_count = block.settings.show_product_count
  assign vt_product_count = 0

  if closest.collection != blank
    assign vt_product_count = closest.collection.products_count
  endif

  # Shared size class for both index and product count
  assign vt_meta_size = block.settings.product_count_size | default: 'vt-paragraph-medium'
-%}

{%- if vt_heading_text != blank -%}
  {%- assign heading_tag = block.settings.heading_tag -%}
  {%- assign animation_type = block.settings.animation_type -%}

  {%- assign vt_anim_classes = '' -%}
  {%- unless animation_type == 'none' or request.visual_preview_mode -%}
    {%- assign vt_anim_classes = 'vt-animate vt-animate--' | append: animation_type -%}
    {%- if animation_type == 'slide' or animation_type == 'float' -%}
      {%- assign vt_anim_classes = vt_anim_classes
        | append: ' vt-animate--dir-'
        | append: block.settings.animation_direction
      -%}
    {%- endif -%}
  {%- endunless -%}

  {%- capture heading_class -%}
    vt-heading
    {{ block.settings.heading_size }}
    {{ vt_anim_classes }}
  {%- endcapture -%}
  {%- assign heading_class = heading_class | strip -%}

  {%- assign vt_style = '' -%}
  {%- unless animation_type == 'none' or request.visual_preview_mode -%}
    {%- assign vt_style = vt_style
      | append: '--vt-duration: '
      | append: block.settings.animation_duration
      | append: 's;'
    -%}
    {%- assign vt_style = vt_style | append: ' --vt-delay: ' | append: block.settings.animation_delay | append: 's;' -%}

    {%- if animation_type == 'slide' or animation_type == 'float' or animation_type == 'blur' -%}
      {%- case block.settings.animation_easing -%}
        {%- when 'linear' -%}
          {%- assign vt_easing_value = 'linear' -%}
        {%- when 'ease-out-sine' -%}
          {%- assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)' -%}
        {%- when 'ease-in-sine' -%}
          {%- assign vt_easing_value = 'cubic-bezier(0.12, 0, 0.39, 0)' -%}
        {%- when 'ease-in-out-sine' -%}
          {%- assign vt_easing_value = 'cubic-bezier(0.37, 0, 0.63, 1)' -%}
        {%- when 'ease-in-cubic' -%}
          {%- assign vt_easing_value = 'cubic-bezier(0.32, 0, 0.67, 0)' -%}
        {%- when 'ease-out-cubic' -%}
          {%- assign vt_easing_value = 'cubic-bezier(0.33, 1, 0.68, 1)' -%}
        {%- when 'ease-in-out-cubic' -%}
          {%- assign vt_easing_value = 'cubic-bezier(0.65, 0, 0.35, 1)' -%}
        {%- else -%}
          {%- assign vt_easing_value = 'cubic-bezier(0.61, 1, 0.88, 1)' -%}
      {%- endcase -%}
      {%- assign vt_style = vt_style | append: ' --vt-easing: ' | append: vt_easing_value | append: ';' -%}
    {%- endif -%}

    {%- if animation_type == 'blur' -%}
      {%- assign vt_style = vt_style
        | append: ' --vt-blur: '
        | append: block.settings.animation_blur_intensity
        | append: 'px;'
      -%}
    {%- endif -%}
  {%- endunless -%}

  {%- assign vt_wrapper_class = 'vt-heading-wrapper '
    | append: block.settings.heading_alignment
    | append: ' vt-heading-wrapper--width-'
    | append: block.settings.heading_width
  -%}

  <div id="vt-heading-{{ block.id }}"
    class="{{ vt_wrapper_class }} flex"
    style="
      --vt-heading-gap-mobile: {% render 'fluid-clamp', min_px: block.settings.gap_mobile, max_px: block.settings.gap_mobile %};
      --vt-heading-gap-desktop: {% render 'fluid-clamp', min_px: block.settings.gap, max_px: block.settings.gap %};
      {%- if block.settings.heading_width == 'custom' %}--vt-heading-width: {{ block.settings.width_custom }}%;{% endif -%}
      {%- if block.settings.enable_max_width %}--vt-heading-max-width: {% render 'fluid-clamp', min_px: block.settings.heading_max_width, max_px: block.settings.heading_max_width %};{% endif -%}
    "
    {{ block.shopify_attributes }}
  >
    {%- if vt_show_index -%}
      <span class="vt-heading__index {{ vt_meta_size }}" aria-hidden="true"></span>
    {%- endif -%}

    {%- case heading_tag -%}
      {%- when 'h1' -%}
        <h1 class="{{ heading_class }} flex items-start"{% if vt_style != '' %}style="{{ vt_style | strip }}"{% endif %}>
          {{ vt_heading_text }}
          {%- if vt_show_product_count and vt_product_count > 0 -%}            
            <span class="vt-heading__product-count {{ vt_meta_size }}" aria-label="{{ 'accessibility.items_with_count' | t: count: vt_product_count }}">{{ vt_product_count }}</span>
          {%- endif -%}
        </h1>
      {%- when 'h2' -%}
        <h2 class="{{ heading_class }} flex items-start"{% if vt_style != '' %}style="{{ vt_style | strip }}"{% endif %}>
          {{ vt_heading_text }}
          {%- if vt_show_product_count and vt_product_count > 0 -%}
            <span class="vt-heading__product-count {{ vt_meta_size }}" aria-label="{{ 'accessibility.items_with_count' | t: count: vt_product_count }}">{{ vt_product_count }}</span>
          {%- endif -%}
        </h2>
      {%- when 'h3' -%}
        <h3 class="{{ heading_class }} flex items-start"{% if vt_style != '' %}style="{{ vt_style | strip }}"{% endif %}>
          {{ vt_heading_text }}
          {%- if vt_show_product_count and vt_product_count > 0 -%}
            <span class="vt-heading__product-count {{ vt_meta_size }}" aria-label="{{ 'accessibility.items_with_count' | t: count: vt_product_count }}">{{ vt_product_count }}</span>
          {%- endif -%}
        </h3>
      {%- when 'h4' -%}
        <h4 class="{{ heading_class }} flex items-start"{% if vt_style != '' %}style="{{ vt_style | strip }}"{% endif %}>
          {{ vt_heading_text }}
          {%- if vt_show_product_count and vt_product_count > 0 -%}
            <span class="vt-heading__product-count {{ vt_meta_size }}" aria-label="{{ 'accessibility.items_with_count' | t: count: vt_product_count }}">{{ vt_product_count }}</span>
          {%- endif -%}
        </h4>
      {%- when 'h5' -%}
        <h5 class="{{ heading_class }} flex items-start"{% if vt_style != '' %}style="{{ vt_style | strip }}"{% endif %}>
          {{ vt_heading_text }}
          {%- if vt_show_product_count and vt_product_count > 0 -%}
            <span class="vt-heading__product-count {{ vt_meta_size }}" aria-label="{{ 'accessibility.items_with_count' | t: count: vt_product_count }}">{{ vt_product_count }}</span>
          {%- endif -%}
        </h5>
      {%- when 'h6' -%}
        <h6 class="{{ heading_class }} flex items-start"{% if vt_style != '' %}style="{{ vt_style | strip }}"{% endif %}>
          {{ vt_heading_text }}
          {%- if vt_show_product_count and vt_product_count > 0 -%}
            <span class="vt-heading__product-count {{ vt_meta_size }}" aria-label="{{ 'accessibility.items_with_count' | t: count: vt_product_count }}">{{ vt_product_count }}</span>
          {%- endif -%}
        </h6>
    {%- endcase -%}
  </div>
{%- endif -%}


{% schema %}
{
  "name": "Collection title",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:blocks.heading.settings.heading.default",
      "label": "Collection name",
      "info": "Overridden by collection title inside a collection card."
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "Show index (01, 02...)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "text-left", "label": "t:blocks.heading.settings.heading_alignment.options__1.label" },
        { "value": "text-center", "label": "t:blocks.heading.settings.heading_alignment.options__2.label" },
        { "value": "text-right", "label": "t:blocks.heading.settings.heading_alignment.options__3.label" },
        { "value": "text-inherit", "label": "Inherit" }
      ],
      "default": "text-inherit",
      "label": "t:blocks.heading.settings.heading_alignment.label"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "vt-hero-heading", "label": "t:blocks.heading.settings.heading_size.options__1.label" },
        { "value": "vt-heading-h1", "label": "t:blocks.heading.settings.heading_size.options__2.label" },
        { "value": "vt-heading-h2", "label": "t:blocks.heading.settings.heading_size.options__3.label" },
        { "value": "vt-heading-h3", "label": "t:blocks.heading.settings.heading_size.options__4.label" },
        { "value": "vt-heading-h4", "label": "t:blocks.heading.settings.heading_size.options__5.label" },
        { "value": "vt-heading-h5", "label": "t:blocks.heading.settings.heading_size.options__6.label" },
        { "value": "vt-heading-h6", "label": "t:blocks.heading.settings.heading_size.options__7.label" }
      ],
      "default": "vt-heading-h3",
      "label": "t:blocks.heading.settings.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2",
      "label": "t:blocks.heading.settings.heading_tag.label",
      "info": "t:blocks.heading.settings.heading_tag.info"
    },
    {
      "type": "select",
      "id": "heading_width",
      "label": "Width",
      "options": [
        { "value": "fit",         "label": "Fit" },
        { "value": "fill",        "label": "Fill" },
        { "value": "max-content", "label": "Max content" },
        { "value": "min-content", "label": "Min content" },
        { "value": "custom",      "label": "Custom" }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "width_custom",
      "label": "Custom width",
      "min": 1, "max": 100, "step": 1, "unit": "%",
      "default": 50,
      "visible_if": "{{ block.settings.heading_width == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_max_width",
      "label": "Width limit",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 100, "max": 1200, "step": 20, "unit": "px",
      "default": 600,
      "label": "Max width",
      "visible_if": "{{ block.settings.enable_max_width == true }}"
    },
    {
      "type": "select",
      "id": "product_count_size",
      "options": [
        { "value": "vt-paragraph-extra-small", "label": "t:blocks.paragraph.settings.paragraph_size.options__1.label" },
        { "value": "vt-paragraph-small",       "label": "t:blocks.paragraph.settings.paragraph_size.options__2.label" },
        { "value": "vt-paragraph-medium",      "label": "t:blocks.paragraph.settings.paragraph_size.options__3.label" },
        { "value": "vt-paragraph-large",       "label": "t:blocks.paragraph.settings.paragraph_size.options__4.label" }
      ],
      "default": "vt-paragraph-medium",
      "label": "Product count, item index size"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "Gap (desktop)"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "Gap (mobile)"
    },
    {
      "type": "header",
      "content": "t:blocks.heading.settings.header_animation.content"
    },
    {
      "type": "select",
      "id": "animation_type",
      "options": [
        { "value": "none",  "label": "t:blocks.heading.settings.animation_type.options__1.label" },
        { "value": "fade",  "label": "t:blocks.heading.settings.animation_type.options__2.label" },
        { "value": "slide", "label": "t:blocks.heading.settings.animation_type.options__3.label" },
        { "value": "float", "label": "t:blocks.heading.settings.animation_type.options__4.label" },
        { "value": "blur",  "label": "t:blocks.heading.settings.animation_type.options__5.label" }
      ],
      "default": "none",
      "label": "t:blocks.heading.settings.animation_type.label"
    },
    {
      "type": "select",
      "id": "animation_direction",
      "options": [
        { "value": "from-left",   "label": "t:blocks.heading.settings.animation_direction.options__1.label" },
        { "value": "from-right",  "label": "t:blocks.heading.settings.animation_direction.options__2.label" },
        { "value": "from-top",    "label": "t:blocks.heading.settings.animation_direction.options__3.label" },
        { "value": "from-bottom", "label": "t:blocks.heading.settings.animation_direction.options__4.label" }
      ],
      "default": "from-bottom",
      "label": "t:blocks.heading.settings.animation_direction.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'float' }}"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 0.1, "max": 3, "step": 0.1, "unit": "s",
      "default": 1.2,
      "label": "t:blocks.heading.settings.animation_duration.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "range",
      "id": "animation_delay",
      "min": 0, "max": 2, "step": 0.1, "unit": "s",
      "default": 0.2,
      "label": "t:blocks.heading.settings.animation_delay.label",
      "visible_if": "{{ block.settings.animation_type != 'none' }}"
    },
    {
      "type": "select",
      "id": "animation_easing",
      "options": [
        { "value": "linear",            "label": "t:blocks.heading.settings.animation_easing.options__1.label" },
        { "value": "ease-out-sine",     "label": "t:blocks.heading.settings.animation_easing.options__2.label" },
        { "value": "ease-in-sine",      "label": "t:blocks.heading.settings.animation_easing.options__3.label" },
        { "value": "ease-in-out-sine",  "label": "t:blocks.heading.settings.animation_easing.options__4.label" },
        { "value": "ease-in-cubic",     "label": "t:blocks.heading.settings.animation_easing.options__5.label" },
        { "value": "ease-out-cubic",    "label": "t:blocks.heading.settings.animation_easing.options__6.label" },
        { "value": "ease-in-out-cubic", "label": "t:blocks.heading.settings.animation_easing.options__7.label" }
      ],
      "default": "ease-out-sine",
      "label": "t:blocks.heading.settings.animation_easing.label",
      "visible_if": "{{ block.settings.animation_type == 'slide' or block.settings.animation_type == 'float' or block.settings.animation_type == 'blur' }}"
    },
    {
      "type": "range",
      "id": "animation_blur_intensity",
      "min": 5, "max": 50, "step": 1, "unit": "px",
      "default": 5,
      "label": "t:blocks.heading.settings.animation_blur_intensity.label",
      "visible_if": "{{ block.settings.animation_type == 'blur' }}"
    }
  ],
  "presets": [
    {
      "name": "Collection title",
      "category": "Collection item",
      "settings": {
        "heading": "Collection title",
        "heading_size": "vt-heading-h3",
        "heading_alignment": "text-inherit",
        "heading_tag": "h2",
        "heading_width": "fit",
        "width_custom": 100,
        "enable_max_width": false,
        "heading_max_width": 600,
        "show_index": false,
        "show_product_count": true,
        "product_count_size": "vt-paragraph-medium",
        "gap": 8,
        "gap_mobile": 6,
        "animation_type": "slide",
        "animation_direction": "from-bottom",
        "animation_duration": 1.2,
        "animation_delay": 0.2,
        "animation_easing": "ease-out-sine",
        "animation_blur_intensity": 5
      }
    }
  ]
}
{% endschema %}
{% # theme-check-enable UndefinedObject %}