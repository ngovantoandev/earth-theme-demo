{% doc %}
  Renders an individual Accordion Item container block.
  - Header has built-in icon (with optional circular box badge), title, subtitle, and dynamic arrow indicator.
  - Border settings allow selecting top, bottom, left, and right borders individually.
  - Content uses dynamic child blocks (`content_for 'blocks'`).
  - Smooth expansion with grid-template-rows (0fr -> 1fr).
  - Background: cactus-green when open, primary when closed.
  - Arrow rotates ↘ (closed) to ↗ (open).
  - 1px divider between header and content shown only when open.

  @example
  {% content_for 'block', type: 'accordion-item', id: 'accordion-item' %}
{% enddoc %}

{%- liquid
  assign is_open = false
  if block.settings.open_by_default or request.visual_preview_mode
    assign is_open = true
  endif

  assign pad_desktop = block.settings.padding_desktop | default: 36
  assign pad_mobile = block.settings.padding_mobile | default: 20

  assign gap_desktop = block.settings.gap_desktop | default: 32
  assign gap_mobile = block.settings.gap_mobile | default: 20

  # Header content
  assign display_title = block.settings.title
  if display_title == blank and request.visual_preview_mode
    assign display_title = 'Why Sustainable Fashion?'
  endif
  assign title_size = block.settings.title_size | default: 'vt-heading-h4'

  assign display_subtitle = block.settings.subtitle
  if display_subtitle == blank and request.visual_preview_mode
    assign display_subtitle = 'Understanding the real cost of fast fashion'
  endif
  assign subtitle_size = block.settings.subtitle_size | default: 'vt-paragraph-small'

  # Icon settings
  assign show_icon = block.settings.show_icon
  if show_icon == nil
    assign show_icon = true
  endif
  assign icon = block.settings.icon | default: 'heart'
  assign icon_color = block.settings.icon_color | default: '#003225'
  assign icon_size_desktop = block.settings.icon_size_desktop | default: 24
  assign icon_size_mobile = block.settings.icon_size_mobile | default: 20

  assign show_icon_box = block.settings.show_icon_box
  if show_icon_box == nil
    assign show_icon_box = true
  endif
  assign icon_box_bg = block.settings.icon_box_bg_color | default: '#EAE060'
  assign icon_box_size_desktop = block.settings.icon_box_size_desktop | default: 48
  assign icon_box_size_mobile = block.settings.icon_box_size_mobile | default: 40
  assign icon_box_radius = block.settings.icon_box_radius | default: '50%'
  assign header_gap = block.settings.header_gap | default: 20

  # Header Colors
  assign title_color = block.settings.title_color
  assign title_color_style = ''
  if title_color != blank and title_color != 'rgba(0,0,0,0)' and title_color != '#00000000'
    assign title_color_style = '--vt-acc-title-color: ' | append: title_color | append: ';'
  endif

  assign subtitle_color = block.settings.subtitle_color
  assign subtitle_color_style = ''
  if subtitle_color != blank and subtitle_color != 'rgba(0,0,0,0)' and subtitle_color != '#00000000'
    assign subtitle_color_style = '--vt-acc-subtitle-color: ' | append: subtitle_color | append: ';'
  endif

  # Arrow settings
  assign show_arrow = block.settings.show_arrow
  if show_arrow == nil
    assign show_arrow = true
  endif
  assign arrow_size_desktop = block.settings.arrow_size_desktop | default: 18
  assign arrow_size_mobile = block.settings.arrow_size_mobile | default: 16

  assign arrow_color = block.settings.arrow_color | default: '#EAE060'
  assign arrow_color_style = ''
  if arrow_color != blank and arrow_color != 'rgba(0,0,0,0)' and arrow_color != '#00000000'
    assign arrow_color_style = '--vt-acc-arrow-color: ' | append: arrow_color | append: ';'
  else
    assign arrow_color_style = '--vt-acc-arrow-color: #EAE060;'
  endif

  assign bg_color = block.settings.background_color
  assign bg_color_style = ''
  if bg_color != blank and bg_color != 'rgba(0,0,0,0)' and bg_color != '#00000000'
    assign bg_color_style = '--vt-acc-bg: ' | append: bg_color | append: ';'
  endif

  assign bg_open_color = block.settings.background_color_open
  assign bg_open_color_style = ''
  if bg_open_color != blank and bg_open_color != 'rgba(0,0,0,0)' and bg_open_color != '#00000000'
    assign bg_open_color_style = '--vt-acc-bg-open: ' | append: bg_open_color | append: ';'
  endif

  # Borders (condensed: all, top_bottom, bottom, top, left_right, none, or custom)
  assign border_sides = block.settings.border_sides | default: 'all'
  assign border_top = false
  assign border_bottom = false
  assign border_left = false
  assign border_right = false

  case border_sides
    when 'all'
      assign border_top = true
      assign border_bottom = true
      assign border_left = true
      assign border_right = true
    when 'top_bottom'
      assign border_top = true
      assign border_bottom = true
    when 'top'
      assign border_top = true
    when 'bottom'
      assign border_bottom = true
    when 'left_right'
      assign border_left = true
      assign border_right = true
    when 'none'
      # no borders
    when 'custom'
      assign border_top = block.settings.border_top
      if border_top == nil
        assign border_top = true
      endif
      assign border_bottom = block.settings.border_bottom
      if border_bottom == nil
        assign border_bottom = true
      endif
      assign border_left = block.settings.border_left
      if border_left == nil
        assign border_left = true
      endif
      assign border_right = block.settings.border_right
      if border_right == nil
        assign border_right = true
      endif
    else
      if block.settings.border_top or block.settings.border_bottom or block.settings.border_left or block.settings.border_right
        assign border_top = block.settings.border_top
        assign border_bottom = block.settings.border_bottom
        assign border_left = block.settings.border_left
        assign border_right = block.settings.border_right
      else
        assign border_top = true
        assign border_bottom = true
        assign border_left = true
        assign border_right = true
      endif
  endcase

  assign border_width = block.settings.border_width | default: 1
  assign border_top_width = 0
  assign border_bottom_width = 0
  assign border_left_width = 0
  assign border_right_width = 0
  assign has_any_border = false

  if border_top
    assign border_top_width = border_width
    assign has_any_border = true
  endif
  if border_bottom
    assign border_bottom_width = border_width
    assign has_any_border = true
  endif
  if border_left
    assign border_left_width = border_width
    assign has_any_border = true
  endif
  if border_right
    assign border_right_width = border_width
    assign has_any_border = true
  endif

  assign border_color = block.settings.border_color
  assign border_color_style = ''
  if border_color != blank and border_color != 'rgba(0,0,0,0)' and border_color != '#00000000'
    assign border_color_style = '--vt-accordion-border-color: ' | append: border_color | append: ';'
  endif

  assign divider_color = block.settings.divider_color
  assign divider_color_style = ''
  if divider_color != blank and divider_color != 'rgba(0,0,0,0)' and divider_color != '#00000000'
    assign divider_color_style = '--vt-accordion-divider-color: ' | append: divider_color | append: ';'
  endif
-%}

<vt-accordion-item
  class="vt-accordion-item-wrapper block w-full"
  style="
    --vt-accordion-pad: {{ pad_desktop }}px;
    --vt-accordion-pad-mobile: {{ pad_mobile }}px;
    --vt-accordion-gap: {{ gap_desktop }}px;
    --vt-accordion-gap-mobile: {{ gap_mobile }}px;
    --vt-acc-header-gap: {{ header_gap }}px;
    --vt-acc-arrow-size: {% render 'fluid-clamp', min_px: arrow_size_mobile, max_px: arrow_size_desktop %};
    --vt-acc-icon-size: {% render 'fluid-clamp', min_px: icon_size_mobile, max_px: icon_size_desktop %};
    {%- if icon_color != blank and icon_color != 'rgba(0,0,0,0)' and icon_color != '#00000000' %}
    --vt-acc-icon-color: {{ icon_color }};
    {%- endif %}
    {%- if show_icon_box %}
    --vt-acc-box-size: {% render 'fluid-clamp', min_px: icon_box_size_mobile, max_px: icon_box_size_desktop %};
    {%- if icon_box_bg != blank and icon_box_bg != 'rgba(0,0,0,0)' and icon_box_bg != '#00000000' %}
    --vt-acc-box-bg: {{ icon_box_bg }};
    {%- endif %}
    --vt-acc-box-radius: {{ icon_box_radius }};
    {%- endif %}
    --vt-border-top-width: {{ border_top_width }}px;
    --vt-border-bottom-width: {{ border_bottom_width }}px;
    --vt-border-left-width: {{ border_left_width }}px;
    --vt-border-right-width: {{ border_right_width }}px;
    --vt-accordion-border-opacity: {{ block.settings.border_opacity | default: 100 }}%;
    --vt-accordion-border-radius: {{ block.settings.border_radius | default: 0 }}px;
    --vt-accordion-divider-width: {{ block.settings.divider_width | default: 1 }}px;
        {{ title_color_style }}
    {{ subtitle_color_style }}
    {{ arrow_color_style }}
    {{ bg_color_style }}
    {{ bg_open_color_style }}
    {{ border_color_style }}
    {{ divider_color_style }}
  "
  {{ block.shopify_attributes }}
>
  <details
    class="vt-accordion-item{% if has_any_border %} vt-accordion-item--has-border{% endif %}{% if block.settings.show_divider %} vt-accordion-item--has-divider{% endif %}"
    {% if is_open %}open{% endif %}
  >
    <summary class="vt-accordion-item__summary">
      <div class="vt-accordion-item__summary-left">
        {%- if show_icon and icon != blank and icon != 'none' -%}
          <div
            class="vt-accordion-item__icon{% if show_icon_box %} vt-accordion-item__icon--has-box{% endif %}"
            aria-hidden="true"
          >
            {% render 'icons', icon: icon %}
          </div>
        {%- endif -%}

        <div class="vt-accordion-item__header-text">
          {%- if display_title != blank -%}
            <h3 class="vt-accordion-item__title {{ title_size }}">
              {{ display_title }}
            </h3>
          {%- endif -%}
          {%- if display_subtitle != blank -%}
            <div class="vt-accordion-item__subtitle {{ subtitle_size }}">
              {{ display_subtitle }}
            </div>
          {%- endif -%}
        </div>
      </div>
      {%- if show_arrow -%}
        <span class="vt-accordion-item__arrow" aria-hidden="true">
          <svg viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <path d="M0.238921 0V1.81557H11.8999L0 13.7155L1.28332 15L13.1844 3.10006V14.7611H15V0H0.238921Z" fill="currentColor"/>
          </svg>
        </span>
      {%- endif -%}
    </summary>

    <div class="vt-accordion-item__grid">
      <div class="vt-accordion-item__inner">
        <div class="vt-accordion-item__content">
          {% content_for 'blocks' %}
          {%- if block.blocks.size == 0 and request.visual_preview_mode -%}
            <div class="vt-accordion-item__preview-placeholder" style="padding: 16px; border: 1px dashed var(--vt-color-accent, #EAE060); border-radius: 4px; opacity: 0.8;">
              <p style="margin: 0; font-size: 14px;">Content area (Add cards, columns, or text blocks here)</p>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </details>
</vt-accordion-item>

<script>
  if (!customElements.get('vt-accordion-item')) {
    class VtAccordionItem extends HTMLElement {
      connectedCallback() {
        const details = this.querySelector('details');
        if (!details) return;
        const summary = details.querySelector('summary');
        const grid = details.querySelector('.vt-accordion-item__grid');
        if (!summary || !grid) return;

        let isAnimating = false;

        summary.addEventListener('click', (e) => {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          if (isAnimating) {
            e.preventDefault();
            return;
          }

          if (details.open) {
            e.preventDefault();
            isAnimating = true;
            grid.style.gridTemplateRows = '0fr';

            const onEnd = (event) => {
              if (event.target !== grid) return;
              grid.removeEventListener('transitionend', onEnd);
              details.removeAttribute('open');
              grid.style.gridTemplateRows = '';
              isAnimating = false;
            };
            grid.addEventListener('transitionend', onEnd);
            setTimeout(() => {
              if (isAnimating) {
                details.removeAttribute('open');
                grid.style.gridTemplateRows = '';
                isAnimating = false;
              }
            }, 380);
          } else {
            isAnimating = true;
            grid.style.gridTemplateRows = '0fr';
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                grid.style.gridTemplateRows = '1fr';
                const onEnd = (event) => {
                  if (event.target !== grid) return;
                  grid.removeEventListener('transitionend', onEnd);
                  grid.style.gridTemplateRows = '';
                  isAnimating = false;
                };
                grid.addEventListener('transitionend', onEnd);
                setTimeout(() => {
                  if (isAnimating) {
                    grid.style.gridTemplateRows = '';
                    isAnimating = false;
                  }
                }, 380);
              });
            });
          }
        });
      }
    }
    customElements.define('vt-accordion-item', VtAccordionItem);
  }
</script>

{% stylesheet %}
  .vt-accordion-item-wrapper {
    display: block;
    width: 100%;
    box-sizing: border-box;
  }

  .vt-accordion-item {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background-color: var(--vt-acc-bg, var(--vt-color-primary, #224E09));
    color: var(--color-white, #F8F9DC);
    transition: background-color 0.35s ease, border-color 0.35s ease;
    overflow: hidden;
    border-radius: var(--vt-accordion-border-radius, 0px);
  }

  .vt-accordion-item--has-border {
    border-style: solid;
    border-top-width: var(--vt-border-top-width, 0px);
    border-bottom-width: var(--vt-border-bottom-width, 0px);
    border-left-width: var(--vt-border-left-width, 0px);
    border-right-width: var(--vt-border-right-width, 0px);
    border-color: color-mix(
      in srgb,
      var(--vt-accordion-border-color, var(--vt-color-accent, #EAE060)) var(--vt-accordion-border-opacity, 100%),
      transparent
    );
  }

  .vt-accordion-item[open] {
    background-color: var(--vt-acc-bg-open, var(--vt-color-cactus-green, #34601B));
  }

  /* Summary header layout */
  .vt-accordion-item__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: var(--vt-accordion-pad, 36px);
    cursor: pointer;
    list-style: none;
    user-select: none;
    outline: none;
  }

  .vt-accordion-item__summary::-webkit-details-marker,
  .vt-accordion-item__summary::marker {
    display: none;
  }

  .vt-accordion-item__summary:focus-visible {
    outline: 2px solid var(--vt-color-accent, #EAE060);
    outline-offset: -2px;
  }

  .vt-accordion-item__summary-left {
    display: flex;
    align-items: center;
    gap: var(--vt-acc-header-gap, 20px);
    min-width: 0;
    flex: 1 1 auto;
  }

  .vt-accordion-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .vt-accordion-item__icon svg {
    width: var(--vt-acc-icon-size, 24px);
    height: var(--vt-acc-icon-size, 24px);
    color: var(--vt-acc-icon-color, #003225);
    display: block;
  }

  .vt-accordion-item__icon--has-box {
    width: var(--vt-acc-box-size, 48px);
    height: var(--vt-acc-box-size, 48px);
    background-color: var(--vt-acc-box-bg, var(--vt-color-accent, #EAE060));
    border-radius: var(--vt-acc-box-radius, 50%);
  }

  .vt-accordion-item__header-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .vt-accordion-item__title {
    margin: 0;
    color: var(--vt-acc-title-color, var(--color-white, #F8F9DC));
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .vt-accordion-item__subtitle {
    margin: 0;
    color: var(--vt-acc-subtitle-color, var(--color-white, #F8F9DC));
    line-height: 1.45;
  }

  /* Diagonal arrow rotation: ↘ down-right closed, ↗ up-right open */
  .vt-accordion-item__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 32px;
    flex-shrink: 0;
    color: var(--vt-acc-arrow-color, #EAE060);
    transition: transform 0.35s ease;
    transform: rotate(90deg);
  }

  .vt-accordion-item__arrow svg {
    width: var(--vt-acc-arrow-size, 18px);
    height: var(--vt-acc-arrow-size, 18px);
    display: block;
  }

  .vt-accordion-item[open] .vt-accordion-item__arrow {
    transform: rotate(0deg);
  }

  /* Smooth grid-template-rows expansion */
  .vt-accordion-item__grid {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vt-accordion-item[open] > .vt-accordion-item__grid {
    grid-template-rows: 1fr;
  }

  .vt-accordion-item__inner {
    overflow: hidden;
    min-height: 0;
  }

  /* Content area with divider */
  .vt-accordion-item__content {
    border-top: none;
    padding: var(--vt-accordion-pad, 36px);
    display: flex;
    flex-direction: column;
    gap: var(--vt-accordion-gap, 32px);
    box-sizing: border-box;
    width: 100%;
  }

  .vt-accordion-item--has-divider .vt-accordion-item__content {
    border-top-style: solid;
    border-top-width: var(--vt-accordion-divider-width, 1px);
    border-top-color: var(--vt-accordion-divider-color, var(--vt-accordion-border-color, var(--vt-color-accent, #EAE060)));
  }

  @media (max-width: 768px) {
    .vt-accordion-item__summary {
      padding: var(--vt-accordion-pad-mobile, 20px);
      gap: 12px;
    }
    .vt-accordion-item__summary-left {
      gap: 12px;
    }
    .vt-accordion-item__content {
      padding: var(--vt-accordion-pad-mobile, 20px);
      gap: var(--vt-accordion-gap-mobile, 20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-accordion-item,
    .vt-accordion-item__grid,
    .vt-accordion-item__arrow {
      transition: none !important;
    }
  }
{% endstylesheet %}

