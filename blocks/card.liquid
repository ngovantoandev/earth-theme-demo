      "id": "color_style",
      "label": "Background",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "transparent",
          "label": "None"
        }
      ],
      "default": "primary",
      "info": "Text, icons and links inside follow it. Colors picked below override it."
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Gradient",
      "info": "Leave empty to use colors from the color palette.",
      "visible_if": "{{ block.settings.color_style == 'gradient' }}"
