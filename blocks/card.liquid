{% doc %}
  Renders a statistic card with customizable background color, text color,
  border, padding, gap, position, alignment, decorative icon, and
  scroll-triggered entrance animation.

  @example
  {% content_for 'block', type: 'card', id: 'card' %}
{% enddoc %}

{% liquid
  # -----------------------------------------------------------------------
  # Padding / gap fluid source values (mobile baseline -> desktop baseline)
  # -----------------------------------------------------------------------
  assign vt_padding_block_min = block.settings.padding_vertical
  if block.settings.enable_padding_mobile
    assign vt_padding_block_min = block.settings.padding_vertical_mobile
  endif

  assign vt_padding_inline_min = block.settings.padding_horizontal
  if block.settings.enable_padding_mobile
    assign vt_padding_inline_min = block.settings.padding_horizontal_mobile
  endif

  assign vt_gap_min = block.settings.gap
  if block.settings.enable_gap_mobile
    assign vt_gap_min = block.settings.gap_mobile
  endif

  # -----------------------------------------------------------------------
  # Position / alignment -> flex keywords (text-align keeps the raw value)
  # -----------------------------------------------------------------------
  case block.settings.position
    when 'top'
      assign vt_justify = 'flex-start'
    when 'bottom'
      assign vt_justify = 'flex-end'
    else
      assign vt_justify = 'center'
  endcase

  # vt_align_margin: logical margin-inline that places fit-width children
  # set to "Inherit" (see --vt-align-* alignment context in theme.css)
  case block.settings.alignment
    when 'left'
      assign vt_align = 'flex-start'
      assign vt_align_margin = '0 auto'
    when 'right'
      assign vt_align = 'flex-end'
      assign vt_align_margin = 'auto 0'
    else
      assign vt_align = 'center'
      assign vt_align_margin = 'auto'
  endcase

  case block.settings.decorative_icon_position
    when 'left'
      assign vt_icon_justify = 'flex-start'
    when 'right'
      assign vt_icon_justify = 'flex-end'
    else
      assign vt_icon_justify = 'center'
  endcase

  case block.settings.decorative_icon_alignment
    when 'top'
      assign vt_icon_align = 'flex-start'
    when 'bottom'
      assign vt_icon_align = 'flex-end'
    else
      assign vt_icon_align = 'center'
  endcase

  # -----------------------------------------------------------------------
  # Animation easing keyword -> real CSS timing function
  # -----------------------------------------------------------------------
  case block.settings.animation_easing
    when 'linear'
      assign vt_easing = 'linear'
    when 'ease-out-sine'
      assign vt_easing = 'cubic-bezier(0.39, 0.575, 0.565, 1)'
    when 'ease-in-sine'
      assign vt_easing = 'cubic-bezier(0.47, 0, 0.745, 0.715)'
    when 'ease-in-out-sine'
      assign vt_easing = 'cubic-bezier(0.445, 0.05, 0.55, 0.95)'
    when 'ease-in-cubic'
      assign vt_easing = 'cubic-bezier(0.55, 0.055, 0.675, 0.19)'
    when 'ease-out-cubic'
      assign vt_easing = 'cubic-bezier(0.215, 0.61, 0.355, 1)'
    when 'ease-in-out-cubic'
      assign vt_easing = 'cubic-bezier(0.645, 0.045, 0.355, 1)'
    else
      assign vt_easing = 'cubic-bezier(0.61, 1, 0.88, 1)'
  endcase

  # -----------------------------------------------------------------------
  # Animation classes. Skipped entirely inside the theme editor's visual
  # preview so presets render fully visible instead of waiting on an
  # IntersectionObserver that may never fire inside the preview frame.
  # -----------------------------------------------------------------------
  assign vt_animate_classes = ''
  if block.settings.animation_type != 'none' and request.visual_preview_mode != true
    assign vt_animate_classes = 'vt-animate vt-animate--' | append: block.settings.animation_type
    if block.settings.animation_type == 'slide'
      assign vt_animate_classes = vt_animate_classes | append: ' vt-animate--dir-' | append: block.settings.animation_direction
    endif
  endif

  # -----------------------------------------------------------------------
  # Final class list
  # -----------------------------------------------------------------------
  assign vt_class_list = 'vt-card vt-card--width-' | append: block.settings.width | append: ' vt-card--height-' | append: block.settings.height

  if block.settings.border == 'solid'
    assign vt_class_list = vt_class_list | append: ' vt-card--border-solid'
  endif

  if vt_animate_classes != blank
    assign vt_class_list = vt_class_list | append: ' ' | append: vt_animate_classes
  endif
%}

<div  
  class="{{ vt_class_list }}"
  style="
    --vt-bg: {{ block.settings.background_color }};
    --vt-heading-color: {{ block.settings.heading_color }};
    --vt-text-color: {{ block.settings.text_color }};
    --vt-justify: {{ vt_justify }};
    --vt-align: {{ vt_align }};
    --vt-text-align: {{ block.settings.alignment }};
    --vt-align-justify: {{ vt_align }};
    --vt-align-margin: {{ vt_align_margin }};
    --vt-padding-block: {% render 'fluid-clamp', min_px: vt_padding_block_min, max_px: block.settings.padding_vertical %};
    --vt-padding-inline: {% render 'fluid-clamp', min_px: vt_padding_inline_min, max_px: block.settings.padding_horizontal %};
    --vt-gap: {% render 'fluid-clamp', min_px: vt_gap_min, max_px: block.settings.gap %};
    --vt-border-width: {{ block.settings.border_width }};
    --vt-border-radius: {{ block.settings.border_radius }};
    --vt-border-color: {{ block.settings.border_color }};
    --vt-border-opacity: {{ block.settings.border_opacity }}%;
    {%- if block.settings.width == 'custom' %}
    --vt-width: {{ block.settings.width_custom }}%;
    {%- endif %}

    {%- if block.settings.height == 'custom' %}
    --vt-min-height: {% render 'fluid-clamp', min_px: block.settings.min_height, max_px: block.settings.min_height %};
    --vt-min-height-mobile: {% render 'fluid-clamp', min_px: block.settings.min_height_mobile, max_px: block.settings.min_height_mobile %};
    {%- endif %}

    {%- if vt_animate_classes != blank %}
    --vt-duration: {{ block.settings.animation_duration }}s;
    --vt-delay: {{ block.settings.animation_delay }}s;
    {%- endif %}
    {%- if block.settings.animation_type == 'slide' or block.settings.animation_type == 'blur' %}
    --vt-easing: {{ vt_easing }};
    {%- endif %}
    {%- if block.settings.animation_type == 'blur' %}
    --vt-blur: {{ block.settings.animation_blur_intensity }}px;
    {%- endif %}
  "
  role="group"
  aria-roledescription="card"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.enable_decorative_icon %}
    <div
      class="vt-card__decorative-icon"
      style="
        --vt-icon-justify: {{ vt_icon_justify }};
        --vt-icon-align: {{ vt_icon_align }};
        --vt-decorative-icon-size: {% render 'fluid-clamp', min_px: block.settings.decorative_icon_size_mobile, max_px: block.settings.decorative_icon_size_desktop %};
        --vt-decorative-icon-color: {{ block.settings.decorative_icon_color }};
        --vt-decorative-icon-opacity: {{ block.settings.decorative_icon_opacity | times: 1.0 | divided_by: 100 }};
      "
      aria-hidden="true"
    >
      {%- render 'icons', icon: block.settings.decorative_icon -%}
    </div>
  {%- endif %}

  <div class="vt-card__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-card {
    position: relative;
    display: flex;
    overflow: hidden;
    flex-direction: column;    
    justify-content: var(--vt-justify, center);
    align-items: var(--vt-align, center);
    gap: var(--vt-gap, 1rem);
    box-sizing: border-box;
    padding-block: var(--vt-padding-block, 1rem);
    padding-inline: var(--vt-padding-inline, 1rem);
    text-align: var(--vt-text-align, center);
    color: var(--vt-text-color, inherit);
    background-color: var(--vt-bg, transparent);
    border-style: none;
    border-radius: calc(var(--vt-border-radius, 0) / 16 * 1rem);
    contain: layout style;
  }

  .vt-card .vt-heading{
    color: var(--vt-heading-color);
  }

  .vt-card .vt-paragraph{
    color: var(--vt-text-color);
  }

  .vt-card--border-solid {
    border-style: solid;
    border-width: calc(var(--vt-border-width, 0) / 16 * 1rem);
    border-color: color-mix(in srgb, var(--vt-border-color, currentColor) var(--vt-border-opacity, 100%), transparent);
  }

  .vt-card--width-fit {
    width: fit-content;
    max-width: 100%;
  }

  .vt-card--width-fill {
    width: 100%;
  }

  .vt-card--width-custom {
    width: var(--vt-width, auto);
  }

  .vt-card--height-fit {
    height: fit-content;
  }

  .vt-card--height-fill {
    height: 100%;
  }

  .vt-card--height-custom {
    height: auto;
    min-height: var(--vt-min-height, auto);
  }

  /* Hide first/last child (icon blocks) on mobile */
  @media screen and (max-width: 749px) {
    .vt-card--height-custom {
      min-height: var(--vt-min-height-mobile, auto);
    }
  }

  .vt-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: inherit;
    gap: inherit;
    width: 100%;
  }

  /* Decorative watermark icon: purely visual, never affects layout flow */
  .vt-card__decorative-icon {    
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    width: 100%;
    height: 100%;
    padding-block: var(--vt-padding-block, 1rem);
    padding-inline: var(--vt-padding-inline, 1rem);
    justify-content: var(--vt-icon-justify, center);
    align-items: var(--vt-icon-align, center);    
    pointer-events: none;
    color: var(--vt-decorative-icon-color, currentColor);
    opacity: var(--vt-decorative-icon-opacity, 0.12);
  }

  .vt-card__decorative-icon svg {
    width: var(--vt-decorative-icon-size, 14rem);
    height: var(--vt-decorative-icon-size, 14rem);
    max-width: 100%;
    aspect-ratio: 1 / 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-card__decorative-icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Card",
  "tag": null,  
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
