      "label": "Heading",
      "default": "#F8F9DC"
    }, 
    {
      "type": "color",
      "id": "text_color",
      "label": "Paragraph",
      "default": "#F8F9DC"
    },    
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "enable_decorative_icon",
      "label": "Decorative icon",
      "default": false
    },
    {
      "type": "select",
      "id": "decorative_icon",
      "options": [
        { "value": "leaf", "label": "t:blocks.icon.settings.icon.options__1.label" },
        { "value": "carbon", "label": "t:blocks.icon.settings.icon.options__2.label" },
        { "value": "cotton-plant", "label": "Cotton plant" },
        { "value": "tree", "label": "t:blocks.icon.settings.icon.options__3.label" },
        { "value": "zero-emissions", "label": "t:blocks.icon.settings.icon.options__4.label" },
        { "value": "quality", "label": "t:blocks.icon.settings.icon.options__5.label" },
        { "value": "drop", "label": "t:blocks.icon.settings.icon.options__6.label" },
        { "value": "ecology", "label": "t:blocks.icon.settings.icon.options__7.label" },
        { "value": "arrow-left", "label": "t:blocks.icon.settings.icon.options__8.label" },
        { "value": "arrow-right", "label": "t:blocks.icon.settings.icon.options__9.label" },
        { "value": "close", "label": "t:blocks.icon.settings.icon.options__10.label" },
        { "value": "heart", "label": "t:blocks.icon.settings.icon.options__13.label" },
        { "value": "check-circle", "label": "t:blocks.icon.settings.icon.options__14.label" },
        { "value": "x-circle", "label": "t:blocks.icon.settings.icon.options__15.label" },
        { "value": "info", "label": "t:blocks.icon.settings.icon.options__16.label" }
      ],
      "default": "cotton-plant",
      "label": "t:blocks.icon.settings.icon.label",
      "visible_if": "{{ block.settings.enable_decorative_icon == true }}"
    },
    {
      "type": "color",
      "id": "decorative_icon_color",
      "default": "#F8F9DC",
      "label": "Color",
      "visible_if": "{{ block.settings.enable_decorative_icon == true }}"
    },
    {
      "type": "range",
      "id": "decorative_icon_size_desktop",
      "min": 100,
      "max": 300,
      "step": 2,
      "unit": "px",
      "default": 226,
