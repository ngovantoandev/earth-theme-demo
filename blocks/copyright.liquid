{% doc %}
  Copyright line: "© {year} {store name}." followed by the merchant's text, and
  optionally Shopify's "Powered by Shopify" link, in one paragraph. The paragraph
  is a wrapping flex row, so on narrow screens Powered by Shopify moves to the
  next line as a whole and the separator bar stays at the end of the first one.

  The Powered by Shopify link is output exactly as {{ powered_by_link }}: the
  Theme Store doesn't allow it to be altered, so it is only styled from here.
  Underlined, it thickens on hover; otherwise its wrapper is a .vt-link-wrap and
  it takes Theme settings > Typography > Link hover effect like other links.

  Self-contained: callers must leave the body empty.

  @example
  {% content_for 'block', type: 'copyright', id: 'copyright' %}
{% enddoc %}

{%- liquid
  assign root_class = 'vt-copyright flex flex-wrap items-center gap-x-3.75 gap-y-2 ' | append: block.settings.text_size
  if block.settings.underline_powered_by
    assign root_class = root_class | append: ' vt-copyright--underline'
  endif
-%}

<p class="{{ root_class }}" {{ block.shopify_attributes }}>
  <span class="vt-copyright__text">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.
    {%- if block.settings.text != blank %} {{ block.settings.text }}{% endif -%}
  </span>
  {%- if block.settings.show_powered_by %}
    <span class="vt-copyright__powered{% unless block.settings.underline_powered_by %} vt-link-wrap{% endunless %}">{{ powered_by_link }}</span>
  {%- endif %}
</p>

{% stylesheet %}    
  .vt-copyright:has(.vt-copyright__powered) .vt-copyright__text::after {
    content: '';
    display: inline-block;
    inline-size: 1px;
    block-size: 1.1em;
    margin-inline-start: 0.9375rem;    
    vertical-align: -0.2em;
    background: currentColor;
  }

  /* Powered by Shopify never breaks inside itself */
  .vt-copyright__powered {
    white-space: nowrap;
  }

  .vt-copyright__powered a {
    color: inherit;
    text-decoration: none;
  }

  .vt-copyright--underline .vt-copyright__powered a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .vt-copyright--underline .vt-copyright__powered a:hover {
    text-decoration-thickness: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Copyright",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Starts with ©, the current year and your store name."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "All rights reserved"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show Powered by Shopify",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "underline_powered_by",
      "label": "Underline Powered by Shopify",
      "default": true,
      "visible_if": "{{ block.settings.show_powered_by }}",
      "info": "When off, the link uses the Link hover effect in Theme settings > Typography."
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "vt-paragraph-extra-small",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__1.label"
        },
        {
          "value": "vt-paragraph-small",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__2.label"
        },
        {
          "value": "vt-paragraph-medium",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__3.label"
        },
        {
          "value": "vt-paragraph-large",
          "label": "t:blocks.paragraph.settings.paragraph_size.options__4.label"
        }
      ],
      "default": "vt-paragraph-medium"
    }
  ],
  "presets": [
    {
      "name": "Copyright"
    }
  ]
}
{% endschema %}
