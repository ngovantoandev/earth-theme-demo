{%- doc -%}
  Renders a collection list of blocks with configurable direction, gap,
  alignment, width and optional icon hiding on mobile.

  @example
  {% content_for 'block', type: 'collection-list', id: 'collection-list' %}
{%- enddoc -%}

{%- liquid
  assign gap_mobile_px = block.settings.gap_mobile
  assign gap_desktop_px = block.settings.gap_desktop

  # --- Standard grid maps ---
  case block.settings.grid_mobile
    when '1'
      assign vt_grid_mobile = 'grid-cols-1'
    when '1-1'
      assign vt_grid_mobile = 'grid-cols-[1fr_1fr]'
  endcase

  case block.settings.grid_tablet
    when '2'
      assign vt_grid_tablet = 'md:grid-cols-2'
    when '3'
      assign vt_grid_tablet = 'md:grid-cols-3'
  endcase

  case block.settings.grid_desktop
    when '2'
      assign vt_grid_desktop = 'lg:grid-cols-2'
    when '3'
      assign vt_grid_desktop = 'lg:grid-cols-3'
  endcase
-%}

<div
  class="
    vt-collection-list w-full
    {% if block.settings.enable_justified %}vt-collection-list--justified{% endif %}"
  style="
    --vt-gap: {% render 'fluid-clamp', min_px: gap_mobile_px, max_px: gap_desktop_px %};
  "
  role="region"
  aria-label="{{ 'accessibility.collection_aria_label' | t | default: 'Collection gallery' }}"
  {{ block.shopify_attributes }}
>
  <ul
    class="
      vt-collection-list__grid grid
      {% unless block.settings.enable_justified %}
        {{ vt_grid_mobile }}
        {{ vt_grid_tablet }}
        {{ vt_grid_desktop }}
      {% endunless %}
    "
    role="list"
  >
    {% content_for 'blocks' %}
  </ul>
</div>


