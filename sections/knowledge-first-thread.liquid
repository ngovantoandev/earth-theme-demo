{% comment %}
  Knowledge First Thread Section
  Educational accordion showcasing sustainable vs fast fashion with comparison cards and fact boxes.
  - Left sidebar: Add & edit topic items (Title, Subtitle, Icon, Fast vs Sustainable points, Info facts)
  - Right sidebar: UI configuration (Layout, Header styling, Full Width, Accordion style, Colors, Padding)
  - Seamlessly integrated with snippets/title-styling.liquid
{% endcomment %}

{%- liquid
  assign section_title = section.settings.title | default: 'Knowledge First Thread'
  assign header_layout = section.settings.header_layout | default: 'split'
  assign show_leaf = section.settings.show_leaf_icons
  if show_leaf == nil
    assign show_leaf = section.settings.show_leaf_icon | default: true
  endif

  assign header_text_color = section.settings.text_color | default: '#F8F9DC'
  assign header_title_color = section.settings.title_color | default: header_text_color
  assign header_eyebrow_color = section.settings.eyebrow_color | default: header_text_color
  assign header_subtitle_color = section.settings.subtitle_color | default: header_text_color
  assign header_leaf_color = section.settings.leaf_color | default: '#EAE060'

  assign accordion_style = section.settings.accordion_style | default: 'lime_outline'
  assign accordion_behavior = section.settings.accordion_behavior | default: 'multi_expand'
-%}

{%- capture header_button_block -%}
  {%- if section.settings.show_header_btn and section.settings.header_btn_text != blank -%}
    <div class="earth-section-header__btn-wrap">
      {%- if section.settings.header_btn_type == 'arrow' -%}
        {% render 'btn-arrow',
          text: section.settings.header_btn_text,
          url: section.settings.header_btn_url,
          theme: section.settings.header_btn_theme,
          color: section.settings.header_btn_color,
          circle_bg: section.settings.header_btn_circle_bg,
          circle_color: section.settings.header_btn_circle_color
        %}
      {%- else -%}
        {%- assign kft_btn_bg = section.settings.header_btn_bg_color | default: section.settings.header_btn_color -%}
        {% render 'btn-action',
          text: section.settings.header_btn_text,
          url: section.settings.header_btn_url,
          variant: section.settings.header_btn_type,
          custom_bg: kft_btn_bg,
          custom_color: section.settings.header_btn_text_color
        %}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<section 
  class="knowledge-thread full-width{% if section.settings.full_width != false %} knowledge-thread--full{% else %} knowledge-thread--contained{% endif %} knowledge-thread--style-{{ accordion_style }}" 
  id="knowledgeThread-{{ section.id }}" 
  style="
    --kt-bg: {{ section.settings.bg_color | default: '#224E09' }};
    --kt-text: {{ section.settings.text_color | default: '#F8F9DC' }};
    --kt-pt: {{ section.settings.desktop_padding_top | default: 96 }}px;
    --kt-pb: {{ section.settings.desktop_padding_bottom | default: 112 }}px;
    --kt-mpt: {{ section.settings.mobile_padding_top | default: 56 }}px;
    --kt-mpb: {{ section.settings.mobile_padding_bottom | default: 64 }}px;
    
    --kt-card-bg: {{ section.settings.card_bg_color | default: '#34601B' }};
    --kt-card-border: {{ section.settings.card_border_color | default: '#EAE060' }};
    --kt-card-radius: {{ section.settings.card_corner_radius | default: 2 }}px;
    --kt-card-gap: {{ section.settings.card_gap | default: 16 }}px;
    
    --kt-badge-bg: {{ section.settings.badge_bg_color | default: '#EAE060' }};
    --kt-badge-icon: {{ section.settings.badge_icon_color | default: '#003225' }};
    --kt-badge-size: {{ section.settings.badge_size | default: 48 }}px;

    --kt-fast-bg: {{ section.settings.fast_card_bg | default: '#EAE060' }};
    --kt-fast-text: {{ section.settings.fast_card_text | default: '#003225' }};
    --kt-sust-bg: {{ section.settings.sust_card_bg | default: '#00281E' }};
    --kt-sust-text: {{ section.settings.sust_card_text | default: '#F8F9DC' }};
    --kt-compare-radius: {{ section.settings.compare_card_radius | default: 2 }}px;

    --kt-info-bg: {{ section.settings.info_box_bg | default: '#224E09' }};
    --kt-info-border: {{ section.settings.info_box_border | default: '#71CC3B' }};
    --kt-info-text: {{ section.settings.info_box_text | default: '#F8F9DC' }};
  "
>
  <div class="knowledge-thread__container">
    
    <!-- 1. Unified Section Header (Using title-styling snippet) -->
    <div class="knowledge-thread__header-container">
      {% render 'title-styling',
        layout: header_layout,
        title: section_title,
        title_color: header_title_color,
        title_size: section.settings.title_size_desktop,
        title_size_desktop: section.settings.title_size_desktop,
        title_size_mobile: section.settings.title_size_mobile,
        eyebrow: section.settings.eyebrow,
        show_eyebrow_icon: section.settings.show_eyebrow_icon,
        eyebrow_color: header_eyebrow_color,
        eyebrow_size_desktop: section.settings.eyebrow_size_desktop,
        eyebrow_size_mobile: section.settings.eyebrow_size_mobile,
        subtitle: section.settings.subtitle,
        subtitle_color: header_subtitle_color,
        subtitle_size_desktop: section.settings.subtitle_size_desktop,
        subtitle_size_mobile: section.settings.subtitle_size_mobile,
        show_leaf: show_leaf,
        leaf_position: section.settings.leaf_position,
        leaf_color: header_leaf_color,
        leaf_size: section.settings.leaf_size,
        leaf_gap: section.settings.leaf_gap,
        split_ratio: section.settings.header_split_ratio,
        btn_block: header_button_block,
        text_color: header_text_color
      %}
    </div>

    <!-- 2. Accordion List -->
    <div 
      class="knowledge-thread__accordion-list" 
      role="region" 
      aria-label="Knowledge Topics"
      data-behavior="{{ accordion_behavior }}"
    >
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign is_open = false -%}
          {%- if forloop.first or block.settings.default_open -%}
            {%- assign is_open = true -%}
          {%- endif -%}

          <div 
            class="knowledge-thread__item {% if is_open %}is-open{% endif %}" 
            {{ block.shopify_attributes }} 
            data-accordion-item
            style="
              {% if block.settings.custom_card_bg != blank and block.settings.custom_card_bg != 'rgba(0,0,0,0)' %}--item-bg: {{ block.settings.custom_card_bg }};{% endif %}
              {% if block.settings.custom_border_color != blank and block.settings.custom_border_color != 'rgba(0,0,0,0)' %}--item-border: {{ block.settings.custom_border_color }};{% endif %}
              {% if block.settings.custom_badge_bg != blank and block.settings.custom_badge_bg != 'rgba(0,0,0,0)' %}--item-badge-bg: {{ block.settings.custom_badge_bg }};{% endif %}
            "
          >
            
            <!-- Accordion Trigger Header -->
            <button type="button" class="knowledge-thread__trigger" aria-expanded="{% if is_open %}true{% else %}false{% endif %}" aria-controls="kt-content-{{ block.id }}">
              <div class="knowledge-thread__trigger-main">
                <div class="knowledge-thread__trigger-top">
                  <div class="knowledge-thread__trigger-header-left">
                    <!-- Rounded Icon Badge -->
                    <div class="knowledge-thread__badge" aria-hidden="true">
                      {%- if block.settings.custom_icon != blank -%}
                        <img src="{{ block.settings.custom_icon | image_url: width: 64 }}" width="24" height="24" alt="" loading="lazy">
                      {%- elsif block.settings.icon_type != blank and block.settings.icon_type != 'auto' -%}
                        {%- case block.settings.icon_type -%}
                          {%- when 'heart' -%}{{ 'icon-heart.svg' | inline_asset_content }}
                          {%- when 'eco' -%}{{ 'icon-eco.svg' | inline_asset_content }}
                          {%- when 'calculator' -%}{{ 'icon-caculator.svg' | inline_asset_content }}
                          {%- when 'washing' -%}{{ 'icon-washing.svg' | inline_asset_content }}
                          {%- when 'recycle' -%}{{ 'icon-get-dressed.svg' | inline_asset_content }}
                          {%- when 'sparkle' -%}{{ 'icon-sparkle.svg' | inline_asset_content }}
                          {%- when 'plant' -%}{{ 'icon-plant-based.svg' | inline_asset_content }}
                          {%- when 'globe' -%}{{ 'icon-Drop.svg' | inline_asset_content }}
                          {%- when 'leaf' -%}{{ 'icon-Carbon.svg' | inline_asset_content }}
                          {%- when 'check' -%}{{ 'icon-check.svg' | inline_asset_content }}
                          {%- else -%}{{ block.settings.icon_type | inline_asset_content }}
                        {%- endcase -%}
                      {%- else -%}
                        {%- case forloop.index0 -%}
                          {%- when 0 -%}{{ 'icon-heart.svg' | inline_asset_content }}
                          {%- when 1 -%}{{ 'icon-eco.svg' | inline_asset_content }}
                          {%- when 2 -%}{{ 'icon-caculator.svg' | inline_asset_content }}
                          {%- when 3 -%}{{ 'icon-washing.svg' | inline_asset_content }}
                          {%- when 4 -%}{{ 'icon-get-dressed.svg' | inline_asset_content }}
                          {%- when 5 -%}{{ 'icon-sparkle.svg' | inline_asset_content }}
                          {%- else -%}{{ 'icon-heart.svg' | inline_asset_content }}
                        {%- endcase -%}
                      {%- endif -%}
                    </div>
                    <!-- Title -->
                    <h3 class="knowledge-thread__item-title">{{ block.settings.title }}</h3>
                  </div>

                  <!-- Animated Arrow Indicator -->
                  <div class="knowledge-thread__trigger-arrow" aria-hidden="true">
                    {{ 'icon-next-right.svg' | inline_asset_content }}
                  </div>
                </div>

                <!-- Subtitle (Full-width beneath top row) -->
                {%- if block.settings.subtitle != blank -%}
                  <p class="knowledge-thread__item-subtitle">{{ block.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            </button>

            <!-- Expandable Accordion Body -->
            <div class="knowledge-thread__content" id="kt-content-{{ block.id }}">
              <div class="knowledge-thread__content-inner">
                
                {%- if block.settings.show_comparison -%}
                  <!-- 2 Comparison Columns -->
                  <div class="knowledge-thread__comparison-grid">
                    
                    <!-- Left Card: Fast Fashion -->
                    <div class="knowledge-thread__compare-card knowledge-thread__compare-card--fast">
                      <h4 class="knowledge-thread__compare-heading">{{ block.settings.fast_heading | default: 'FAST FASHION' }}</h4>
                      <ul class="knowledge-thread__compare-list">
                        {%- if block.settings.fast_points != blank -%}
                          {%- assign fast_lines = block.settings.fast_points | newline_to_br | split: '<br />' -%}
                          {%- for line in fast_lines -%}
                            {%- assign line_clean = line | strip -%}
                            {%- if line_clean != blank -%}
                              <li class="knowledge-thread__compare-item">
                                <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                  {{ 'icon-close-circle.svg' | inline_asset_content }}
                                </span>
                                <span>{{ line_clean }}</span>
                              </li>
                            {%- endif -%}
                          {%- endfor -%}
                        {%- else -%}
                          {%- if block.settings.fast_point_1 != blank -%}
                            <li class="knowledge-thread__compare-item">
                              <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                {{ 'icon-close-circle.svg' | inline_asset_content }}
                              </span>
                              <span>{{ block.settings.fast_point_1 }}</span>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.fast_point_2 != blank -%}
                            <li class="knowledge-thread__compare-item">
                              <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                {{ 'icon-close-circle.svg' | inline_asset_content }}
                              </span>
                              <span>{{ block.settings.fast_point_2 }}</span>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.fast_point_3 != blank -%}
                            <li class="knowledge-thread__compare-item">
                              <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                {{ 'icon-close-circle.svg' | inline_asset_content }}
                              </span>
                              <span>{{ block.settings.fast_point_3 }}</span>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.fast_point_4 != blank -%}
                            <li class="knowledge-thread__compare-item">
                              <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                {{ 'icon-close-circle.svg' | inline_asset_content }}
                              </span>
                              <span>{{ block.settings.fast_point_4 }}</span>
                            </li>
                          {%- endif -%}
                        {%- endif -%}
                      </ul>
                    </div>

                    <!-- Right Card: Sustainable Fashion -->
                    <div class="knowledge-thread__compare-card knowledge-thread__compare-card--sustainable">
                      <h4 class="knowledge-thread__compare-heading">{{ block.settings.sustainable_heading | default: 'SUSTAINABLE FASHION' }}</h4>
                      <ul class="knowledge-thread__compare-list">
                        {%- if block.settings.sustainable_points != blank -%}
                          {%- assign sust_lines = block.settings.sustainable_points | newline_to_br | split: '<br />' -%}
                          {%- for line in sust_lines -%}
                            {%- assign line_clean = line | strip -%}
                            {%- if line_clean != blank -%}
                              <li class="knowledge-thread__compare-item">
                                <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                  {{ 'icon-check.svg' | inline_asset_content }}
                                </span>
                                <span>{{ line_clean }}</span>
                              </li>
                            {%- endif -%}
                          {%- endfor -%}
                        {%- else -%}
                          {%- if block.settings.sust_point_1 != blank -%}
                            <li class="knowledge-thread__compare-item">
                              <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                {{ 'icon-check.svg' | inline_asset_content }}
                              </span>
                              <span>{{ block.settings.sust_point_1 }}</span>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.sust_point_2 != blank -%}
                            <li class="knowledge-thread__compare-item">
                              <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                {{ 'icon-check.svg' | inline_asset_content }}
                              </span>
                              <span>{{ block.settings.sust_point_2 }}</span>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.sust_point_3 != blank -%}
                            <li class="knowledge-thread__compare-item">
                              <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                {{ 'icon-check.svg' | inline_asset_content }}
                              </span>
                              <span>{{ block.settings.sust_point_3 }}</span>
                            </li>
                          {%- endif -%}
                          {%- if block.settings.sust_point_4 != blank -%}
                            <li class="knowledge-thread__compare-item">
                              <span class="knowledge-thread__compare-icon" aria-hidden="true">
                                {{ 'icon-check.svg' | inline_asset_content }}
                              </span>
                              <span>{{ block.settings.sust_point_4 }}</span>
                            </li>
                          {%- endif -%}
                        {%- endif -%}
                      </ul>
                    </div>

                  </div>
                {%- endif -%}

                <!-- Bottom Info Box: Did You Know? -->
                {%- if block.settings.info_text != blank -%}
                  <div class="knowledge-thread__info-box">
                    <div class="knowledge-thread__info-header">
                      <span class="knowledge-thread__info-icon-wrap" aria-hidden="true">
                        {{ 'icon-info.svg' | inline_asset_content }}
                      </span>
                      {%- if block.settings.info_title != blank -%}
                        <h5 class="knowledge-thread__info-title">{{ block.settings.info_title }}</h5>
                      {%- endif -%}
                    </div>
                    <p class="knowledge-thread__info-text">{{ block.settings.info_text }}</p>
                  </div>
                {%- endif -%}

                <!-- Optional Custom Content (Rich text) -->
                {%- if block.settings.custom_content != blank -%}
                  <div class="knowledge-thread__custom-content rte">
                    {{ block.settings.custom_content }}
                  </div>
                {%- endif -%}

              </div>
            </div>

          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
  /* ==========================================================================
     Knowledge First Thread Section Styles
     ========================================================================== */
  .knowledge-thread {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: var(--kt-bg, #224E09);
    color: var(--kt-text, #F8F9DC);
    padding-top: var(--kt-pt, 96px);
    padding-bottom: var(--kt-pb, 110px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .knowledge-thread__container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Full Width vs Contained */
  .knowledge-thread--full .knowledge-thread__container {
    max-width: 100%;
    padding-left: clamp(20px, 2.5vw, 34px);
    padding-right: clamp(20px, 2.5vw, 34px);
  }

  .knowledge-thread--contained .knowledge-thread__container {
    max-width: var(--page-width, 1320px);
    padding-left: clamp(16px, 2vw, 24px);
    padding-right: clamp(16px, 2vw, 24px);
  }

  /* 1. Header Area */
  .knowledge-thread__header-container {
    width: 100%;
    margin-bottom: clamp(36px, 5vw, 56px);
    box-sizing: border-box;
  }

  /* 2. Accordion List */
  .knowledge-thread__accordion-list {
    display: flex;
    flex-direction: column;
    gap: var(--kt-card-gap, 16px);
    width: 100%;
  }

  /* Accordion Item Card with Lime Green Outline */
  .knowledge-thread__item {
    background: var(--item-bg, var(--kt-card-bg, #34601B));
    border: 1.5px solid var(--item-border, var(--kt-card-border, #EAE060));
    border-radius: var(--kt-card-radius, 2px);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  /* Alternative Style Variants */
  .knowledge-thread--style-clean_dark .knowledge-thread__item {
    border-color: rgba(234, 224, 96, 0.35);
  }
  .knowledge-thread--style-minimal_divider .knowledge-thread__item {
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--kt-card-border, #EAE060);
    border-radius: 0;
  }
  .knowledge-thread--style-soft_rounded .knowledge-thread__item {
    border-radius: 12px;
  }

  /* Trigger Button */
  .knowledge-thread__trigger {
    width: 100%;
    display: block;
    padding: clamp(20px, 2.5vw, 28px) clamp(20px, 2.5vw, 32px);
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    box-sizing: border-box;
  }

  .knowledge-thread__trigger-main {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .knowledge-thread__trigger-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
  }

  .knowledge-thread__trigger-header-left {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.8vw, 20px);
    min-width: 0;
  }

  /* Yellow Circle Badge with Dark Icon */
  .knowledge-thread__badge {
    width: var(--kt-badge-size, 48px);
    height: var(--kt-badge-size, 48px);
    border-radius: 50%;
    background-color: var(--item-badge-bg, var(--kt-badge-bg, #EAE060));
    color: var(--kt-badge-icon, #003225);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .knowledge-thread__trigger:hover .knowledge-thread__badge {
    transform: scale(1.05);
  }

  .knowledge-thread__badge img,
  .knowledge-thread__badge svg {
    max-width: calc(var(--kt-badge-size, 48px) * 0.5);
    max-height: calc(var(--kt-badge-size, 48px) * 0.5);
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
  }

  .knowledge-thread__badge svg path,
  .knowledge-thread__badge svg g,
  .knowledge-thread__badge svg * {
    fill: var(--kt-badge-icon, #003225) !important;
  }

  .knowledge-thread__item-title {
    font-size: clamp(20px, 1.8vw, 24px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--kt-text, #F8F9DC);
    margin: 0;
  }

  .knowledge-thread__item-subtitle {
    font-size: 18px;
    line-height: 1.45;
    color: var(--kt-text, #F8F9DC);
    margin: 14px 0 0 0;
    opacity: 0.95;
  }

  /* Diagonal Arrow with Smooth Rotation */
  .knowledge-thread__trigger-arrow {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transform: rotate(90deg);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--kt-text, #F8F9DC);
  }

  .knowledge-thread__item.is-open .knowledge-thread__trigger-arrow {
    transform: rotate(0deg);
  }

  .knowledge-thread__trigger-arrow img,
  .knowledge-thread__trigger-arrow svg {
    width: 15px;
    height: 15px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    display: block;
  }

  /* Accordion Body */
  .knowledge-thread__content {
    display: none;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    background: transparent;
    overflow: hidden;
  }

  .knowledge-thread__item.is-open .knowledge-thread__content {
    display: block;
  }

  .knowledge-thread__content-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 8px clamp(18px, 2.5vw, 32px) clamp(22px, 2.8vw, 32px);
    box-sizing: border-box;
  }

  /* 2 Comparison Cards (Side-by-Side on Desktop, Stacked on Mobile) */
  .knowledge-thread__comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2vw, 24px);
    width: 100%;
    box-sizing: border-box;
  }

  .knowledge-thread__compare-card {
    padding: clamp(20px, 2.5vw, 30px);
    border-radius: var(--kt-compare-radius, 2px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* Fast Fashion Card (Yellow background with dark green text) */
  .knowledge-thread__compare-card--fast {
    background-color: var(--kt-fast-bg, #EAE060);
    color: var(--kt-fast-text, #003225);
  }
  .knowledge-thread__compare-card--fast .knowledge-thread__compare-heading {
    color: var(--kt-fast-text, #003225);
  }
  .knowledge-thread__compare-card--fast .knowledge-thread__compare-item {
    color: var(--kt-fast-text, #003225);
  }

  /* Sustainable Fashion Card (Deep Pine Green with Cream text) */
  .knowledge-thread__compare-card--sustainable {
    background-color: var(--kt-sust-bg, #00281E);
    color: var(--kt-sust-text, #F8F9DC);
  }
  .knowledge-thread__compare-card--sustainable .knowledge-thread__compare-heading {
    color: var(--kt-sust-text, #F8F9DC);
  }
  .knowledge-thread__compare-card--sustainable .knowledge-thread__compare-item {
    color: var(--kt-sust-text, #F8F9DC);
  }

  .knowledge-thread__compare-heading {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 18px 0;
    line-height: 1.2;
  }

  .knowledge-thread__compare-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .knowledge-thread__compare-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.4;
  }

  .knowledge-thread__compare-icon {
