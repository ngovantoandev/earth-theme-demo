  .knowledge-thread__compare-icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Bottom Info Box (Did You Know?) */
  .knowledge-thread__info-box {
    background-color: var(--kt-info-bg, #224E09);
    border-left: 4px solid var(--kt-info-border, #71CC3B);
    padding: clamp(20px, 2.5vw, 26px) clamp(20px, 2.5vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-radius: 0;
    box-sizing: border-box;
    color: var(--kt-info-text, #F8F9DC);
  }

  .knowledge-thread__info-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .knowledge-thread__info-icon-wrap {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .knowledge-thread__info-icon-wrap img,
  .knowledge-thread__info-icon-wrap svg {
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
  }

  .knowledge-thread__info-title {
    font-size: clamp(17px, 1.4vw, 19px);
    font-weight: 700;
    color: var(--kt-info-text, #F8F9DC);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .knowledge-thread__info-text {
    font-size: 18px;
    line-height: 1.55;
    color: var(--kt-info-text, #F8F9DC);
    opacity: 0.95;
    margin: 0;
  }

  .knowledge-thread__custom-content {
    font-size: 15px;
    line-height: 1.6;
    color: var(--kt-text, #F8F9DC);
  }

  /* ==========================================================================
     Responsive Breakpoints
     ========================================================================== */
  @media (max-width: 1024px) {
    .knowledge-thread {
      padding-top: 72px;
      padding-bottom: 80px;
    }
  }

  @media (max-width: 768px) {
    .knowledge-thread {
      padding-top: var(--kt-mpt, 56px);
      padding-bottom: var(--kt-mpb, 64px);
    }

    .knowledge-thread__trigger {
      padding: 18px 16px;
    }

    .knowledge-thread__badge {
      width: 42px;
      height: 42px;
    }
    .knowledge-thread__badge img {
      max-width: 20px;
      max-height: 20px;
    }

    .knowledge-thread__item-title {
      font-size: 19px;
    }

    .knowledge-thread__item-subtitle {
      font-size: 16px;
      margin-top: 10px;
    }

    .knowledge-thread__info-text {
      font-size: 16px;
      line-height: 1.55;
    }

    .knowledge-thread__content {
      padding: 0;
    }

    .knowledge-thread__content-inner {
      padding: 8px 16px 20px;
    }

    /* Stack 2 comparison cards on Mobile */
    .knowledge-thread__comparison-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .knowledge-thread__compare-card {
      padding: 20px 18px;
    }

    .knowledge-thread__compare-item {
      font-size: 14px;
    }

    .knowledge-thread__info-box {
      padding: 16px 18px;
      gap: 12px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initKnowledgeThread() {
      var section = document.getElementById('knowledgeThread-{{ section.id }}');
      if (!section) return;

      var list = section.querySelector('.knowledge-thread__accordion-list');
      var behavior = list ? list.dataset.behavior : 'multi_expand';
      var items = section.querySelectorAll('[data-accordion-item]');

      items.forEach(function(item) {
        var trigger = item.querySelector('.knowledge-thread__trigger');
        var content = item.querySelector('.knowledge-thread__content');
        if (!trigger || !content) return;

        if (trigger.dataset.accordionBound === 'true') return;
        trigger.dataset.accordionBound = 'true';

        var isAnimating = false;

        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          if (isAnimating) return;

          var isOpen = item.classList.contains('is-open');

          if (isOpen) {
            isAnimating = true;
            item.classList.remove('is-open');
            trigger.setAttribute('aria-expanded', 'false');

            content.style.display = 'block';
            var startH = content.offsetHeight;

            var anim = content.animate([
              { height: startH + 'px', opacity: 1 },
              { height: '0px', opacity: 0 }
            ], {
              duration: 280,
              easing: 'cubic-bezier(0.25, 1, 0.5, 1)'
            });

            anim.onfinish = function() {
              content.style.display = 'none';
              content.style.height = '';
              content.style.opacity = '';
              isAnimating = false;
            };
          } else {
            // If single_expand behavior is selected, close any other open items
            if (behavior === 'single_expand') {
              items.forEach(function(otherItem) {
                if (otherItem !== item && otherItem.classList.contains('is-open')) {
                  var otherTrigger = otherItem.querySelector('.knowledge-thread__trigger');
                  var otherContent = otherItem.querySelector('.knowledge-thread__content');
                  if (otherTrigger && otherContent) {
                    otherItem.classList.remove('is-open');
                    otherTrigger.setAttribute('aria-expanded', 'false');
                    otherContent.style.display = 'none';
                  }
                }
              });
            }

            isAnimating = true;
            item.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');

            content.style.display = 'block';
            var endH = content.offsetHeight;

            var anim = content.animate([
              { height: '0px', opacity: 0 },
              { height: endH + 'px', opacity: 1 }
            ], {
              duration: 320,
              easing: 'cubic-bezier(0.25, 1, 0.5, 1)'
            });

            anim.onfinish = function() {
              content.style.height = '';
              content.style.opacity = '';
              isAnimating = false;
            };
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initKnowledgeThread);
    } else {
      initKnowledgeThread();
    }

    document.addEventListener('shopify:section:load', initKnowledgeThread);
  })();
</script>

