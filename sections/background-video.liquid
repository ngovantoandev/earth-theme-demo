<section class="earth-bg-video earth-bg-video--{{ section.id }} full-width" id="earthBgVideo-{{ section.id }}" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="earth-bg-video__wrapper">
    
    <!-- 1. Background Video Media Layer (Full Width 16:9) -->
    <div class="earth-bg-video__media-layer">
      {%- liquid
        assign poster_url = ''
        if section.settings.cover_image != blank
          assign poster_url = section.settings.cover_image | image_url: width: 2400
        else
          assign poster_url = 'farm-story.jpg' | asset_url
        endif

        assign uploaded_video_url = ''
        if section.settings.video != blank
          for source in section.settings.video.sources
            if forloop.first
              assign uploaded_video_url = source.url
            endif
          endfor
        endif

        assign youtube_id = ''
        assign vimeo_id = ''
        if section.settings.video_url != blank
          if section.settings.video_url.type == 'youtube'
            assign youtube_id = section.settings.video_url.id
          elsif section.settings.video_url.type == 'vimeo'
            assign vimeo_id = section.settings.video_url.id
          else
            assign yt_match = section.settings.video_url | split: 'v=' | last | split: '&' | first
            if yt_match != blank
              assign youtube_id = yt_match
            endif
          endif
        endif
      -%}

      {%- if uploaded_video_url != blank -%}
        <!-- Native Uploaded HTML5 Video -->
        <video 
          class="earth-bg-video__video-element" 
          id="bgVideoElement-{{ section.id }}"
          autoplay 
          loop 
          muted 
          playsinline 
          poster="{{ poster_url }}"
          aria-hidden="true"
        >
          <source src="{{ uploaded_video_url }}" type="video/mp4">
        </video>

      {%- elsif section.settings.mp4_url != blank -%}
        <!-- Direct MP4 Link Video -->
        <video 
          class="earth-bg-video__video-element" 
          id="bgVideoElement-{{ section.id }}"
          autoplay 
          loop 
          muted 
          playsinline 
          poster="{{ poster_url }}"
          aria-hidden="true"
        >
          <source src="{{ section.settings.mp4_url }}" type="video/mp4">
        </video>

      {%- elsif youtube_id != blank -%}
        <!-- YouTube Background Iframe -->
        <div class="earth-bg-video__iframe-container">
          <iframe 
            class="earth-bg-video__iframe" 
            id="bgVideoIframe-{{ section.id }}"
            src="https://www.youtube.com/embed/{{ youtube_id }}?autoplay=1&mute=1&controls=0&loop=1&playlist={{ youtube_id }}&showinfo=0&rel=0&enablejsapi=1&playsinline=1" 
            frameborder="0" 
            allow="autoplay; encrypted-media" 
            allowfullscreen
            aria-hidden="true"
          ></iframe>
        </div>

      {%- elsif vimeo_id != blank -%}
        <!-- Vimeo Background Iframe -->
        <div class="earth-bg-video__iframe-container">
          <iframe 
            class="earth-bg-video__iframe" 
            id="bgVideoIframe-{{ section.id }}"
            src="https://player.vimeo.com/video/{{ vimeo_id }}?background=1&autoplay=1&loop=1&byline=0&title=0&muted=1" 
            frameborder="0" 
            allow="autoplay; fullscreen" 
            allowfullscreen
            aria-hidden="true"
          ></iframe>
        </div>

      {%- else -%}
        <!-- Ambient Video Fallback -->
        {%- # theme-check-disable RemoteAsset -%}
        <video 
          class="earth-bg-video__video-element" 
          id="bgVideoElement-{{ section.id }}"
          autoplay 
          loop 
          muted 
          playsinline 
          poster="{{ poster_url }}"
          aria-hidden="true"
        >
          <source src="https://assets.mixkit.co/videos/preview/mixkit-tree-branches-in-the-breeze-1188-large.mp4" type="video/mp4">
        </video>
        {%- # theme-check-enable RemoteAsset -%}
      {%- endif -%}

      <!-- Dark Gradient Overlay -->
      <div class="earth-bg-video__overlay"></div>
    </div>

    <!-- 2. Foreground Content Overlay (Exact 2 Texts + Play/Pause Button) -->
    <div class="earth-bg-video__container">
      <div class="earth-bg-video__content">
        
        <!-- Text 1: Heading -->
        {%- if section.settings.heading != blank -%}
          <h2 class="earth-bg-video__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        <!-- Center Play/Pause Control Button for Background Video -->
        <div class="earth-bg-video__btn-wrap">
          <button 
            type="button" 
            class="earth-bg-video__play-btn is-playing" 
            id="earthBgVideoPlayBtn-{{ section.id }}"
            aria-label="Play or pause background video"
          >
            <span class="earth-bg-video__play-ripple"></span>
            <span class="earth-bg-video__play-icon-circle">
              <!-- Play Icon (Show when paused) -->
              <svg class="earth-bg-video__icon-play" width="22" height="24" viewBox="0 0 22 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.5 10.2679C21.8333 11.0377 21.8333 12.9623 20.5 13.7321L3.25 23.6913C1.91667 24.4611 0.25 23.4989 0.25 21.9593L0.25 2.04071C0.25 0.501109 1.91667 -0.461141 3.25 0.308659L20.5 10.2679Z" fill="white"/>
              </svg>
              <!-- Pause Icon (Show when playing) -->
              <svg class="earth-bg-video__icon-pause" width="20" height="22" viewBox="0 0 20 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="2" width="5" height="18" rx="2" fill="white"/>
                <rect x="13" y="2" width="5" height="18" rx="2" fill="white"/>
              </svg>
            </span>
          </button>
        </div>

        <!-- Text 2: Subtext Below Button -->
        {%- if section.settings.subtext != blank -%}
          <span class="earth-bg-video__subtext">{{ section.settings.subtext }}</span>
        {%- endif -%}

      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .earth-bg-video {
    grid-column: 1 / -1 !important;
    width: 100%;
    position: relative;
    overflow: hidden;
    background-color: var(--color-primary, #224E09);
    color: var(--color-white, #F8F9DC);
    box-sizing: border-box;
  }

  .earth-bg-video__wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  /* 1. Media Layer */
  .earth-bg-video__media-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .earth-bg-video__video-element,
  .earth-bg-video__poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    pointer-events: none;
  }

  .earth-bg-video__iframe-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }
  .earth-bg-video__iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
  }

  /* Dark Overlay */
  .earth-bg-video__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 50, 37, 0.25) 0%, rgba(0, 0, 0, 0.45) 100%);
    opacity: var(--overlay-opacity, 0.2);
    pointer-events: none;
  }

  /* 2. Content Center */
  .earth-bg-video__container {
    position: relative;
    z-index: 2;
    width: min(1200px, calc(100% - clamp(20px, 4vw, 80px)));
    margin: 0 auto;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
  }

  .earth-bg-video__content {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 2vw, 24px);
  }

  /* Text 1: Heading */
  .earth-bg-video__heading {
    font-size: clamp(20px, 4.5vw, 64px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-white, #F8F9DC);
    margin: 0;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
  }

  /* Center Play/Pause Button */
  .earth-bg-video__btn-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .earth-bg-video__play-btn {
    position: relative;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .earth-bg-video__play-icon-circle {
    position: relative;
    z-index: 2;
    width: clamp(38px, 5.5vw, 76px);
    height: clamp(38px, 5.5vw, 76px);
    border-radius: 50%;
    background-color: var(--color-secondary, #71CC3B);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease, box-shadow 0.35s ease;
  }
  .earth-bg-video__play-btn:hover .earth-bg-video__play-icon-circle {
    transform: scale(1.1);
    background-color: #7FE543;
    box-shadow: 0 12px 36px rgba(113, 204, 59, 0.45);
  }

  .earth-bg-video__icon-play {
    width: clamp(13px, 1.8vw, 22px);
    height: auto;
    margin-left: 2px; /* Optical center for triangle */
    display: block;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
  }
  .earth-bg-video__icon-pause {
    width: clamp(12px, 1.6vw, 20px);
    height: auto;
    display: none;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
  }

  /* Toggle Icon States based on is-playing class */
  .earth-bg-video__play-btn.is-playing .earth-bg-video__icon-play {
    display: none;
  }
  .earth-bg-video__play-btn.is-playing .earth-bg-video__icon-pause {
    display: block;
  }

  /* Subtle Ripple Pulse Animation */
  .earth-bg-video__play-ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid rgba(113, 204, 59, 0.7);
    animation: earthBgVideoPulse 2.4s cubic-bezier(0.25, 1, 0.5, 1) infinite;
    pointer-events: none;
    z-index: 1;
  }

  @keyframes earthBgVideoPulse {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.8;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.6);
      opacity: 0;
    }
  }

  /* Text 2: Subtext Below Button */
  .earth-bg-video__subtext {
    font-size: clamp(9px, 1.1vw, 14px);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-white, #F8F9DC);
    opacity: 0.95;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    margin: 0;
  }
{% endstylesheet %}

<script>
  (function() {
    function initBgVideoSection() {
      var sectionId = '{{ section.id }}';
      var videoEl = document.getElementById('bgVideoElement-' + sectionId);
      var iframeEl = document.getElementById('bgVideoIframe-' + sectionId);
      var playBtn = document.getElementById('earthBgVideoPlayBtn-' + sectionId);

      if (!playBtn) return;

      var isPlaying = true;

      playBtn.addEventListener('click', function() {
        if (videoEl) {
          if (videoEl.paused) {
            videoEl.play();
            isPlaying = true;
            playBtn.classList.add('is-playing');
          } else {
            videoEl.pause();
            isPlaying = false;
            playBtn.classList.remove('is-playing');
          }
        } else if (iframeEl && iframeEl.contentWindow) {
          // Control YouTube iframe playback via postMessage
          if (isPlaying) {
            iframeEl.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
            isPlaying = false;
            playBtn.classList.remove('is-playing');
          } else {
            iframeEl.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
            isPlaying = true;
            playBtn.classList.add('is-playing');
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBgVideoSection);
    } else {
      initBgVideoSection();
    }
  })();
</script>

{% schema %}
{
  "name": "Background Video Section",
  "class": "earth-bg-video-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From organic farms to your wardrobe"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext Label",
      "default": "WATCH THE 30S ORIGIN STORY"
    },
    {
      "type": "header",
      "content": "Video Source"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Direct Upload Video (Shopify File MP4)",
      "info": "Upload an MP4 file directly for fast native looping"
    },
    {
      "type": "text",
      "id": "mp4_url",
      "label": "Direct MP4 Link URL (Alternative)",
      "info": "Direct link to .mp4 video file"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube or Vimeo Background URL",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=jUxMoX4HKVQ",
      "info": "YouTube or Vimeo URL"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Poster Cover Image",
      "info": "Displays while video loads or as fallback"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Background Video Section"
    }
  ]
}
{% endschema %}
