{% comment %}
  Newsletter section.
  Full-width or max-width banner with dark green background,
  heading on left and email form with subtext on right.
{% endcomment %}

{%- liquid
  assign apply_max_width = section.settings.apply_max_width

  assign section_bg = section.settings.background_color
  assign bg_style = ''
  if section_bg != blank and section_bg != 'rgba(0,0,0,0)' and section_bg != '#00000000'
    assign bg_style = '--vt-bg: ' | append: section_bg | append: ';'
  endif

  assign heading_color = section.settings.heading_color
  assign heading_style = ''
  if heading_color != blank and heading_color != 'rgba(0,0,0,0)' and heading_color != '#00000000'
    assign heading_style = '--vt-heading-color: ' | append: heading_color | append: ';'
  endif

  assign paragraph_color = section.settings.paragraph_color
  assign paragraph_style = ''
  if paragraph_color != blank and paragraph_color != 'rgba(0,0,0,0)' and paragraph_color != '#00000000'
    assign paragraph_style = '--vt-paragraph-color: ' | append: paragraph_color | append: ';'
  endif

  assign pad_top = section.settings.padding_top_desktop | default: 48
  assign pad_bottom = section.settings.padding_bottom_desktop | default: 48
  assign pad_left = section.settings.padding_left_desktop | default: 34
  assign pad_right = section.settings.padding_right_desktop | default: 34

  if section.settings.enable_custom_mobile_padding
    assign pad_top_mobile = section.settings.padding_top_mobile | default: pad_top
    assign pad_bottom_mobile = section.settings.padding_bottom_mobile | default: pad_bottom
    assign pad_left_mobile = section.settings.padding_left_mobile | default: pad_left
    assign pad_right_mobile = section.settings.padding_right_mobile | default: pad_right
  else
    assign pad_top_mobile = pad_top | times: 0.75 | round
    assign pad_bottom_mobile = pad_bottom | times: 0.75 | round
    assign pad_left_mobile = pad_left | times: 0.75 | round
    assign pad_right_mobile = pad_right | times: 0.75 | round
  endif

  assign gap_desktop = section.settings.gap | default: 48
  assign gap_mobile = section.settings.gap_mobile | default: 32
-%}

<div
  id="newsletter-section-{{ section.id }}"
  class="vt-newsletter-section{% unless apply_max_width %} vt-page-full-width{% endunless %}"
  style="
    {{ bg_style }}
    {{ heading_style }}
    {{ paragraph_style }}
    --vt-nl-pt: {% render 'fluid-clamp', min_px: pad_top_mobile, max_px: pad_top %};
    --vt-nl-pb: {% render 'fluid-clamp', min_px: pad_bottom_mobile, max_px: pad_bottom %};
    --vt-nl-pl: {% render 'fluid-clamp', min_px: pad_left_mobile, max_px: pad_left %};
    --vt-nl-pr: {% render 'fluid-clamp', min_px: pad_right_mobile, max_px: pad_right %};
    --vt-block-gap: {% render 'fluid-clamp', min_px: gap_mobile, max_px: gap_desktop %};
    --vt-ph-desktop: {{ pad_left }}px;
    --vt-ph-mobile: {{ pad_left_mobile }}px;
    --vt-page-padding: {{ pad_left }}px;
    --vt-page-padding-mobile: {{ pad_left_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-newsletter__inner{% if apply_max_width %} vt-page-width{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-newsletter-section {
    background-color: var(--vt-bg, var(--vt-color-primary, var(--color-primary, #224E09)));
    color: var(--vt-paragraph-color, var(--vt-background-color, var(--color-white, #F8F9DC)));
    padding-top: var(--vt-nl-pt);
    padding-bottom: var(--vt-nl-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .vt-newsletter__inner {
    width: 100%;
    margin-inline: auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--vt-block-gap, 0);
    padding-left: var(--vt-nl-pl, 34px);
    padding-right: var(--vt-nl-pr, 34px);
  }

  .vt-newsletter__inner:not(.vt-page-width) {
    max-width: 100%;
  }

  @media screen and (max-width: 768px) {
    .vt-newsletter__inner {
      padding-left: var(--vt-nl-pl, 20px);
      padding-right: var(--vt-nl-pr, 20px);
    }
  }

  .vt-newsletter__inner > .shopify-block,
  .vt-newsletter__inner > shopify-block {
    display: contents;
  }

  .vt-newsletter-section .vt-heading {
    color: var(--vt-heading-color, var(--vt-background-color, var(--color-white, #F8F9DC)));
  }

  .vt-newsletter-section .vt-card .vt-heading {
    color: var(--vt-heading-color);
  }

  .vt-newsletter-section .vt-paragraph {
    color: var(--vt-paragraph-color, var(--vt-background-color, var(--color-white, #F8F9DC)));
  }

  .vt-newsletter-section .vt-card .vt-paragraph {
    color: var(--vt-text-color);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "vt-newsletter",
  "settings": [
    {
      "type": "checkbox",
      "id": "apply_max_width",
      "label": "Apply max width",
      "default": true,
      "info": "Constrains layout to global 1200px container"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48,
      "label": "Gap (desktop)"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Gap (mobile)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph",
      "default": "#00000000"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 48,
      "label": "Top (desktop)"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 48,
      "label": "Bottom (desktop)"
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Left (desktop)"
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Right (desktop)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_padding",
      "default": true,
      "label": "Custom for mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Top (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Bottom (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Left (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Right (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    }
  ],
  "blocks": [
    { "type": "@theme" }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "apply_max_width": true,
        "background_color": "#00000000",
        "heading_color": "#00000000",
        "paragraph_color": "#00000000",
        "gap": 48,
        "gap_mobile": 32,
        "padding_top_desktop": 48,
        "padding_bottom_desktop": 48,
        "padding_left_desktop": 34,
        "padding_right_desktop": 34,
        "enable_custom_mobile_padding": true,
        "padding_top_mobile": 32,
        "padding_bottom_mobile": 32,
        "padding_left_mobile": 20,
        "padding_right_mobile": 20
      },
      "blocks": [
        {
          "type": "column-layout",
          "settings": {
            "desktop_column_count": 2,
            "tablet_column_count": 1,
            "mobile_column_count": 1,
            "desktop_column_1_width": "lg:w-1/2|50",
            "desktop_column_2_width": "lg:w-1/2|50",
            "mobile_column_1_width": "w-full|100",
            "swipe_columns_mobile": false,
            "vertical_alignment": "center",
            "desktop_gap_x": "lg:gap-x-12",
            "desktop_gap_y": "lg:gap-y-6",
            "mobile_gap_x": "gap-x-0",
            "mobile_gap_y": "gap-y-6"
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "heading": "Subscribe to our newsletter",
                "heading_size": "vt-heading-h2",
                "heading_tag": "h2"
              }
            },
            {
              "type": "stack",
              "settings": {
                "layout_direction_desktop": "vt-stack--vertical",
                "layout_direction_tablet": "vt-stack--vertical",
                "layout_direction_mobile": "vt-stack--vertical",
                "gap_desktop": 12,
                "gap_mobile": 10
              },
              "blocks": [
                {
                  "type": "email-signup",
                  "settings": {
                    "placeholder": "Enter your email address",
                    "success_message": "Thank you for subscribing!",
                    "max_width": 480,
                    "border_radius": 4
                  }
                },
                {
                  "type": "paragraph",
                  "settings": {
                    "text": "<p>Be first to receive updates and exclusive offers</p>",
                    "paragraph_size": "vt-paragraph-extra-small"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
