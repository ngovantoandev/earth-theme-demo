{% comment %}
  Email signup: a band that invites customers to subscribe, built from theme blocks
  (by default a heading and the Email signup block). Lives in the footer group above
  the footer, and can also be added to any template.

  Columns use the same grid as the Column layout block (snippets/grid-tracks.liquid,
  .vt-grid-tracks and Tailwind gap classes), so equal widths and gaps line up with
  any Column layout above or below. Side by side applies from 1024px, and from 768px
  when Columns (tablet) is 2, like the Column layout breakpoints; mobile stacks. Each block takes one
  column: group several blocks in a Stack to keep them in one column.
{% endcomment %}

{%- liquid
  assign s = section.settings

  assign inner_class = 'vt-newsletter__inner vt-grid-tracks ' | append: s.mobile_gap_y | append: ' ' | append: s.tablet_gap_y | append: ' ' | append: s.desktop_gap_y
  assign tablet_columns = false
  if s.layout == 'side_by_side'
    assign inner_class = inner_class | append: ' ' | append: s.desktop_gap_x
    if s.tablet_column_count == '2'
      assign tablet_columns = true
      assign inner_class = inner_class | append: ' ' | append: s.tablet_gap_x
    endif
  endif
  if s.make_section_page_width
    assign inner_class = inner_class | append: ' vt-page-width'
  endif

  assign section_class = 'vt-section vt-newsletter vt-newsletter--' | append: s.layout
  if s.layout == 'stacked' and s.content_alignment == 'center'
    assign section_class = section_class | append: ' vt-newsletter--center text-center'
  endif
-%}

{%- comment -%} Without blocks the storefront shows nothing, so no empty space. The theme editor keeps it visible to add blocks. {%- endcomment -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
  {% render 'section-styles', section: section %}

  <div
    class="{{ section_class }}"
    {% if s.layout == 'side_by_side' %}
      style="--vt-grid-desktop: {% render 'grid-tracks', settings: s, device: 'desktop', count: 2 %};{% if tablet_columns %} --vt-grid-tablet: {% render 'grid-tracks', settings: s, device: 'tablet', count: 2 %};{% endif %} --vt-newsletter-align: {{ s.vertical_alignment }};"
    {% endif %}
    {{ section.shopify_attributes }}
  >
    <div class="{{ inner_class }}">
      {% content_for 'blocks' %}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .vt-newsletter--center .vt-newsletter__inner {
    justify-items: center;
  }

  /* Only matters once blocks share a row (tablet when set to 2 columns, desktop) */
  .vt-newsletter--side_by_side .vt-newsletter__inner {
    align-items: var(--vt-newsletter-align, start);
  }
{% endstylesheet %}

