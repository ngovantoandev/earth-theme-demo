    color: var(--values-tab-active, #F8F9DC) !important;
  }
  .earth-values__tab--active,
  .earth-values__tab.earth-values__tab--active .earth-values__tab-text {
    color: var(--values-tab-active, #F8F9DC) !important;
  }
  .earth-values__tab--active .earth-values__tab-line {
    width: 100%;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .earth-values__slide {
      flex: 0 0 92%;
    }
    .earth-values__tabs-wrapper {
      width: 100% !important;
      padding: 12px 0 0 !important;
      overflow-x: auto !important;
