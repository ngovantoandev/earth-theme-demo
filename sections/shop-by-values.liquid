    color: var(--values-card-text, #003225);
    line-height: 1.55;
    margin: 0 0 32px;
    opacity: 0.92;
  }
  .earth-values__description p {
    margin: 0;
  }

  /* 3. Floating Navigation Arrows */
  .earth-values__nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: var(--values-nav-size, 48px);
    height: var(--values-nav-size, 48px);
    border-radius: 50%;
    background-color: var(--values-nav-bg, #F8F9DC);
    border: 1.5px solid var(--values-nav-bg, #F8F9DC);
    color: var(--values-nav-color, #003225);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 50, 37, 0.16);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .earth-values__slider-wrapper:hover .earth-values__nav-btn:not(.is-disabled) {
    opacity: 1;
    visibility: visible;
  }
  .earth-values__nav-btn--always:not(.is-disabled) {
    opacity: 1;
    visibility: visible;
  }
  .earth-values__nav-btn.is-disabled {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(-50%) scale(0.7) !important;
  }
  .earth-values__nav-btn:hover:not(.is-disabled) {
    background-color: var(--values-nav-hover-bg, #71CC3B);
    border-color: var(--values-nav-hover-bg, #71CC3B);
    color: var(--values-nav-hover-color, #003225);
    transform: translateY(-50%) scale(1.08);
  }
  .earth-values__nav-btn--prev {
    left: clamp(16px, 2.5vw, 36px);
  }
  .earth-values__nav-btn--next {
    right: clamp(16px, 2.5vw, 36px);
  }

  .earth-values__icon-arrow {
    width: 15px;
    height: 15px;
    object-fit: contain;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-values__icon-arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .earth-values__icon-arrow--next {
    transform: rotate(0deg);
  }
  .earth-values__nav-btn--next:hover .earth-values__icon-arrow--next {
    transform: rotate(45deg);
  }
  .earth-values__icon-arrow--prev {
    transform: rotate(0deg);
  }
  .earth-values__nav-btn--prev:hover .earth-values__icon-arrow--prev {
    transform: rotate(-45deg);
  }

  /* 4. Bottom Values Navigation Tabs */
  .earth-values__tabs-wrapper {
    width: 100%;
    padding: 12px clamp(20px, 3.5vw, 34px) 0;
    box-sizing: border-box;
  }
  .earth-values__tabs {
