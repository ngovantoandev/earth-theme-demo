<script>
  (function() {
    function initShopByValuesSlider() {
      var sectionId = '{{ section.id }}';
      var track = document.getElementById('earthValuesTrack-' + sectionId);
      var tabsContainer = document.getElementById('earthValuesTabs-' + sectionId);
      var prevBtn = document.getElementById('earthValuesPrev-' + sectionId);
      var nextBtn = document.getElementById('earthValuesNext-' + sectionId);

      if (!track || track.classList.contains('earth-values__track--grid')) return;

      var slides = track.querySelectorAll('.earth-values__slide');
      if (slides.length === 0) return;

      function updateNavButtons(currentIdx) {
        if (prevBtn) {
          if (currentIdx <= 0) {
            prevBtn.classList.add('is-disabled');
          } else {
            prevBtn.classList.remove('is-disabled');
          }
        }
        if (nextBtn) {
          if (currentIdx >= slides.length - 1) {
            nextBtn.classList.add('is-disabled');
          } else {
            nextBtn.classList.remove('is-disabled');
          }
        }
      }

      function updateActiveTab(index) {
        if (!tabsContainer) return;
        var tabs = tabsContainer.querySelectorAll('.earth-values__tab');
        tabs.forEach(function(tab, i) {
          if (i === index) {
            tab.classList.add('earth-values__tab--active');
            tab.setAttribute('aria-selected', 'true');
            var tabsWrapper = tabsContainer.closest('.earth-values__tabs-wrapper');
            if (tabsWrapper && window.innerWidth <= 1024) {
              var tabLeft = tab.offsetLeft;
              tabsWrapper.scrollTo({
                left: Math.max(0, tabLeft - 20),
                behavior: 'smooth'
              });
            }
          } else {
            tab.classList.remove('earth-values__tab--active');
            tab.setAttribute('aria-selected', 'false');
          }
        });
        updateNavButtons(index);
      }

      function scrollToSlide(index) {
        if (index < 0) index = 0;
        if (index >= slides.length) index = slides.length - 1;
        var targetSlide = slides[index];
        if (targetSlide) {
          track.scrollTo({
            left: targetSlide.offsetLeft - (window.innerWidth <= 768 ? 20 : track.offsetLeft),
            behavior: 'smooth'
          });
          updateActiveTab(index);
        }
      }

      // Tab clicks
      if (tabsContainer) {
        tabsContainer.addEventListener('click', function(e) {
          var tab = e.target.closest('.earth-values__tab');
          if (tab) {
            var idx = parseInt(tab.getAttribute('data-index'), 10);
            if (!isNaN(idx)) {
              scrollToSlide(idx);
            }
          }
        });
      }

      // Prev / Next button clicks
      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          var currentScroll = track.scrollLeft;
          var slideWidth = slides[0].offsetWidth;
          var currentIdx = Math.round(currentScroll / slideWidth);
          scrollToSlide(currentIdx - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          var currentScroll = track.scrollLeft;
          var slideWidth = slides[0].offsetWidth;
          var currentIdx = Math.round(currentScroll / slideWidth);
          scrollToSlide(currentIdx + 1);
        });
      }

      // Scroll listener to update tabs on drag/swipe
      var scrollTimeout;
      track.addEventListener('scroll', function() {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(function() {
          var currentScroll = track.scrollLeft;
          var slideWidth = slides[0].offsetWidth;
          var currentIdx = Math.round(currentScroll / slideWidth);
          if (currentIdx >= 0 && currentIdx < slides.length) {
            updateActiveTab(currentIdx);
          }
        }, 80);
      });

      // Initial state
      updateNavButtons(0);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShopByValuesSlider);
    } else {
      initShopByValuesSlider();
    }

    // Support Shopify Theme Editor dynamic re-render
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initShopByValuesSlider();
      }
    });
  })();
</script>

