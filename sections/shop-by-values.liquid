<section 
  class="earth-values earth-values-{{ section.id }} full-width{% if section.settings.full_width %} earth-values--full{% else %} earth-values--contained{% endif %}" 
  id="earthValuesSection-{{ section.id }}"
  style="
    --values-bg: {{ section.settings.bg_color | default: '#224E09' }};
    --values-text: {{ section.settings.text_color | default: '#F8F9DC' }};
    --values-card-bg: {{ section.settings.card_bg_color | default: '#F8F9DC' }};
    --values-card-text: {{ section.settings.card_text_color | default: '#003225' }};
    --values-badge-bg: {{ section.settings.badge_bg_color | default: '#003225' }};
    --values-badge-text: {{ section.settings.badge_text_color | default: '#EAE060' }};
    --values-highlight-color: {{ section.settings.highlight_color | default: '#224E09' }};
    --values-tab-inactive: {{ section.settings.tab_inactive_color | default: '#EAE060' }};
    --values-tab-active: {{ section.settings.tab_active_color | default: '#F8F9DC' }};
    --values-card-radius: {{ section.settings.card_corner_radius | default: 0 }}px;
    --values-card-aspect: {{ section.settings.card_image_aspect | default: '1 / 1' }};
    --values-pt: {{ section.settings.padding_top | default: 80 }}px;
    --values-pb: {{ section.settings.padding_bottom | default: 96 }}px;
    --values-mpt: {{ section.settings.mobile_padding_top | default: 50 }}px;
    --values-mpb: {{ section.settings.mobile_padding_bottom | default: 60 }}px;
    --values-nav-size: {{ section.settings.nav_button_size | default: 48 }}px;
    --values-nav-bg: {{ section.settings.nav_bg_color | default: '#F8F9DC' }};
    --values-nav-color: {{ section.settings.nav_icon_color | default: '#003225' }};
    --values-nav-hover-bg: {{ section.settings.nav_hover_bg_color | default: '#71CC3B' }};
    --values-nav-hover-color: {{ section.settings.nav_hover_icon_color | default: '#003225' }};
  "
>
  <div class="earth-values__inner-container">
    {%- capture header_button_block -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'button' -%}
          <div class="earth-section-header__btn-wrap" {{ block.shopify_attributes }}>
            {%- assign btn_style = block.settings.button_type | default: 'arrow' -%}
            {%- assign btn_theme = block.settings.arrow_theme | default: 'dark' -%}
            {%- if btn_style == 'arrow' -%}
              {% render 'btn-arrow',
                text: block.settings.button_text,
                url: block.settings.button_link,
                theme: btn_theme,
                color: block.settings.custom_color
              %}
            {%- else -%}
              {% render 'btn-action',
                text: block.settings.button_text,
                url: block.settings.button_link,
                variant: btn_style,
                custom_bg: block.settings.custom_color
              %}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    <!-- 1. Section Header -->
    <div class="earth-values__header-container">
      {%- assign header_layout = section.settings.header_layout | default: 'centered' -%}
      {%- assign show_leaf_val = section.settings.show_leaf_icons -%}
      {%- if show_leaf_val == nil -%}{%- assign show_leaf_val = section.settings.show_leaf_icon -%}{%- endif -%}
      {%- assign header_title_color = section.settings.title_color | default: '#F8F9DC' -%}
      {%- assign header_eyebrow_color = section.settings.eyebrow_color | default: '#F8F9DC' -%}
      {%- assign header_subtitle_color = section.settings.subtitle_color | default: '#F8F9DC' -%}
      {%- assign header_leaf_color = section.settings.leaf_color | default: '#EAE060' -%}
      {%- assign header_text_color = section.settings.text_color | default: '#F8F9DC' -%}
      {% render 'section-header',
        layout: header_layout,
        title: section.settings.title,
        title_color: header_title_color,
        title_size: section.settings.title_size_desktop,
        title_size_desktop: section.settings.title_size_desktop,
        title_size_mobile: section.settings.title_size_mobile,
        eyebrow: section.settings.eyebrow,
        show_eyebrow_icon: section.settings.show_eyebrow_icon,
        eyebrow_color: header_eyebrow_color,
        eyebrow_size_desktop: section.settings.eyebrow_size_desktop,
        eyebrow_size_mobile: section.settings.eyebrow_size_mobile,
        subtitle: section.settings.subtitle,
        subtitle_color: header_subtitle_color,
        subtitle_size_desktop: section.settings.subtitle_size_desktop,
        subtitle_size_mobile: section.settings.subtitle_size_mobile,
        show_leaf: show_leaf_val,
        leaf_position: section.settings.leaf_position,
        leaf_color: header_leaf_color,
        leaf_size: section.settings.leaf_size,
        leaf_gap: section.settings.leaf_gap,
        btn_text: section.settings.header_btn_text,
        btn_url: section.settings.header_btn_url,
        btn_type: section.settings.header_btn_type,
        btn_theme: section.settings.header_btn_theme,
        btn_color: section.settings.header_btn_color,
        btn_block: header_button_block,
        text_color: header_text_color
      %}
    </div>

    <!-- 2. Slider / Grid Showcase Area -->
    <div class="earth-values__slider-wrapper earth-values__slider-wrapper--{{ section.settings.layout_mode | default: 'slider' }}" id="earthValuesSliderWrapper-{{ section.id }}">
      {%- if section.settings.layout_mode != 'grid' and section.settings.show_nav_arrows != false -%}
        <!-- Left Floating Navigation Arrow -->
        <button 
          type="button" 
          class="earth-values__nav-btn earth-values__nav-btn--prev is-disabled{% if section.settings.nav_arrow_visibility == 'always' %} earth-values__nav-btn--always{% endif %}" 
          id="earthValuesPrev-{{ section.id }}" 
          aria-label="Previous value"
        >
          <span class="earth-values__icon-arrow earth-values__icon-arrow--prev" aria-hidden="true">{{ 'icon-prev-left.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}

      <!-- Horizontal Slider Track or Grid Container -->
      <div class="earth-values__track earth-values__track--{{ section.settings.layout_mode | default: 'slider' }} earth-values__track--cols-{{ section.settings.columns_desktop | default: '1' }}" id="earthValuesTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- assign slide_idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'value_item' -%}
              <div class="earth-values__slide" data-index="{{ slide_idx }}" {{ block.shopify_attributes }}>
              <div class="earth-values__card">
                <div class="earth-values__media-box">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.title, class: 'earth-values__img', loading: 'lazy' }}
                  {%- else -%}
                    {%- case forloop.index0 -%}
                      {%- when 0 -%}
                        <img src="{{ 'cat-organic.jpg' | asset_url }}" alt="{{ block.settings.title }}" class="earth-values__img" width="600" height="600" loading="lazy">
                      {%- when 1 -%}
                        <img src="{{ 'cat-ocean.jpg' | asset_url }}" alt="{{ block.settings.title }}" class="earth-values__img" width="600" height="600" loading="lazy">
                      {%- when 2 -%}
                        <img src="{{ 'earth-3.jpg' | asset_url }}" alt="{{ block.settings.title }}" class="earth-values__img" width="600" height="600" loading="lazy">
                      {%- when 3 -%}
                        <img src="{{ 'cat-activewear.jpg' | asset_url }}" alt="{{ block.settings.title }}" class="earth-values__img" width="600" height="600" loading="lazy">
                      {%- else -%}
                        <img src="{{ 'earth-4.jpg' | asset_url }}" alt="{{ block.settings.title }}" class="earth-values__img" width="600" height="600" loading="lazy">
                    {%- endcase -%}
                  {%- endif -%}
                </div>

                <div class="earth-values__info-box">
                  <h3 class="earth-values__item-title">{{ block.settings.title }}</h3>
                  
                  {%- if block.settings.badge != blank -%}
                    <div class="earth-values__badge-wrap">
                      <span class="earth-values__badge">{{ block.settings.badge }}</span>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.highlight != blank -%}
                    <div class="earth-values__highlight">
                      {%- assign icon_file = block.settings.icon | default: 'icon-handshake.svg' -%}
                      <span class="earth-values__highlight-icon" aria-hidden="true">{{ icon_file | inline_asset_content }}</span>
                      <span>{{ block.settings.highlight }}</span>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.desc != blank -%}
                    <div class="earth-values__description">{{ block.settings.desc }}</div>
                  {%- endif -%}

                  {%- assign cta_label = block.settings.cta_text | default: 'EXPLORE PRODUCTS' -%}
                  {%- assign cta_url = block.settings.link | default: routes.all_products_collection_url -%}
                  {%- assign cta_theme = block.settings.cta_theme | default: 'dark' -%}
                  <div class="earth-values__cta-wrap">
                    {% render 'btn-arrow', text: cta_label, url: cta_url, theme: cta_theme %}
                  </div>
                </div>
              </div>
            </div>
            {%- assign slide_idx = slide_idx | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <!-- Default 5 Values Slides -->
          <!-- Slide 1: Organic Cotton -->
          <div class="earth-values__slide" data-index="0">
            <div class="earth-values__card">
              <div class="earth-values__media-box">
                <img src="{{ 'cat-organic.jpg' | asset_url }}" alt="Organic Cotton" class="earth-values__img" width="600" height="600" loading="lazy">
              </div>
              <div class="earth-values__info-box">
                <h3 class="earth-values__item-title">Organic Cotton</h3>
                <div class="earth-values__badge-wrap">
                  <span class="earth-values__badge">GOTS Certified Organic</span>
                </div>
                <div class="earth-values__highlight">
                  <span class="earth-values__highlight-icon" aria-hidden="true">{{ 'icon-handshake.svg' | inline_asset_content }}</span>
                  <span>100% Pesticide & GMO Free</span>
                </div>
                <div class="earth-values__description"><p>Cultivated using non-toxic methods that preserve soil health and save up to 91% water compared to conventional cotton.</p></div>
                <div class="earth-values__cta-wrap">
                  {% render 'btn-arrow', text: 'EXPLORE PRODUCTS', url: routes.all_products_collection_url, theme: 'dark' %}
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 2: Recycled Materials -->
          <div class="earth-values__slide" data-index="1">
            <div class="earth-values__card">
              <div class="earth-values__media-box">
                <img src="{{ 'cat-ocean.jpg' | asset_url }}" alt="Recycled Materials" class="earth-values__img" width="600" height="600" loading="lazy">
              </div>
              <div class="earth-values__info-box">
                <h3 class="earth-values__item-title">Recycled Materials</h3>
                <div class="earth-values__badge-wrap">
                  <span class="earth-values__badge">Ocean & Land Waste Diverted</span>
                </div>
                <div class="earth-values__highlight">
                  <span class="earth-values__highlight-icon" aria-hidden="true">{{ 'icon-handshake.svg' | inline_asset_content }}</span>
                  <span>7.8 plastic bottles per garment</span>
                </div>
                <div class="earth-values__description"><p>Transforming post-consumer plastic and recycled textile scraps into high-performance, ultra-soft circular garments.</p></div>
                <div class="earth-values__cta-wrap">
                  {% render 'btn-arrow', text: 'EXPLORE PRODUCTS', url: routes.all_products_collection_url, theme: 'dark' %}
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 3: Fair Trade -->
          <div class="earth-values__slide" data-index="2">
            <div class="earth-values__card">
              <div class="earth-values__media-box">
                <img src="{{ 'earth-3.jpg' | asset_url }}" alt="Fair Trade" class="earth-values__img" width="600" height="600" loading="lazy">
              </div>
              <div class="earth-values__info-box">
                <h3 class="earth-values__item-title">Fair Trade</h3>
                <div class="earth-values__badge-wrap">
                  <span class="earth-values__badge">Ethical wages guaranteed</span>
                </div>
                <div class="earth-values__highlight">
                  <span class="earth-values__highlight-icon" aria-hidden="true">{{ 'icon-handshake.svg' | inline_asset_content }}</span>
                  <span>100% worker-owned cooperatives</span>
                </div>
                <div class="earth-values__description"><p>Partnering with Fair Trade certified factories ensuring safe conditions and living wages for 2,500+ artisans.</p></div>
                <div class="earth-values__cta-wrap">
                  {% render 'btn-arrow', text: 'EXPLORE PRODUCTS', url: routes.all_products_collection_url, theme: 'dark' %}
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 4: Carbon Neutral -->
          <div class="earth-values__slide" data-index="3">
            <div class="earth-values__card">
              <div class="earth-values__media-box">
                <img src="{{ 'cat-activewear.jpg' | asset_url }}" alt="Carbon Neutral" class="earth-values__img" width="600" height="600" loading="lazy">
              </div>
              <div class="earth-values__info-box">
                <h3 class="earth-values__item-title">Carbon Neutral</h3>
                <div class="earth-values__badge-wrap">
                  <span class="earth-values__badge">Net-Zero Supply Chain</span>
                </div>
                <div class="earth-values__highlight">
                  <span class="earth-values__highlight-icon" aria-hidden="true">{{ 'icon-handshake.svg' | inline_asset_content }}</span>
                  <span>100% renewable energy powered</span>
                </div>
                <div class="earth-values__description"><p>Measuring and neutralizing our entire product carbon footprint from raw harvest to final door delivery.</p></div>
                <div class="earth-values__cta-wrap">
                  {% render 'btn-arrow', text: 'EXPLORE PRODUCTS', url: routes.all_products_collection_url, theme: 'dark' %}
                </div>
              </div>
            </div>
          </div>

          <!-- Slide 5: Vegan & Cruelty-Free -->
          <div class="earth-values__slide" data-index="4">
            <div class="earth-values__card">
              <div class="earth-values__media-box">
                <img src="{{ 'earth-4.jpg' | asset_url }}" alt="Vegan & Cruelty-Free" class="earth-values__img" width="600" height="600" loading="lazy">
              </div>
              <div class="earth-values__info-box">
                <h3 class="earth-values__item-title">Vegan & Cruelty-Free</h3>
                <div class="earth-values__badge-wrap">
                  <span class="earth-values__badge">PETA Approved Vegan</span>
                </div>
                <div class="earth-values__highlight">
                  <span class="earth-values__highlight-icon" aria-hidden="true">{{ 'icon-handshake.svg' | inline_asset_content }}</span>
                  <span>Zero animal testing or materials</span>
                </div>
                <div class="earth-values__description"><p>100% plant-based and synthetic animal alternatives engineered for durability, comfort, and kind living.</p></div>
                <div class="earth-values__cta-wrap">
                  {% render 'btn-arrow', text: 'EXPLORE PRODUCTS', url: routes.all_products_collection_url, theme: 'dark' %}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.layout_mode != 'grid' and section.settings.show_nav_arrows != false -%}
        <!-- Right Floating Navigation Arrow -->
        <button 
          type="button" 
          class="earth-values__nav-btn earth-values__nav-btn--next{% if section.settings.nav_arrow_visibility == 'always' %} earth-values__nav-btn--always{% endif %}" 
          id="earthValuesNext-{{ section.id }}" 
          aria-label="Next value"
        >
          <span class="earth-values__icon-arrow earth-values__icon-arrow--next" aria-hidden="true">{{ 'icon-next-right.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}
    </div>

    <!-- 3. Bottom Values Navigation Tabs (Only in Slider mode) -->
    {%- if section.settings.layout_mode != 'grid' and section.settings.show_tabs != false -%}
      <div class="earth-values__tabs-wrapper">
        <div class="earth-values__tabs" id="earthValuesTabs-{{ section.id }}" role="tablist">
          {%- if section.blocks.size > 0 -%}
            {%- assign tab_idx = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'value_item' -%}
                <button 
                  type="button" 
                  class="earth-values__tab {% if tab_idx == 0 %}earth-values__tab--active{% endif %}" 
                  data-index="{{ tab_idx }}"
                  role="tab"
                  aria-selected="{% if tab_idx == 0 %}true{% else %}false{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <span class="earth-values__tab-line"></span>
                  <span class="earth-values__tab-text">{{ block.settings.title }}</span>
                </button>
                {%- assign tab_idx = tab_idx | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <button type="button" class="earth-values__tab earth-values__tab--active" data-index="0" role="tab" aria-selected="true">
              <span class="earth-values__tab-line"></span>
              <span class="earth-values__tab-text">Organic Cotton</span>
            </button>
            <button type="button" class="earth-values__tab" data-index="1" role="tab" aria-selected="false">
              <span class="earth-values__tab-line"></span>
              <span class="earth-values__tab-text">Recycled Materials</span>
            </button>
            <button type="button" class="earth-values__tab" data-index="2" role="tab" aria-selected="false">
              <span class="earth-values__tab-line"></span>
              <span class="earth-values__tab-text">Fair Trade</span>
            </button>
            <button type="button" class="earth-values__tab" data-index="3" role="tab" aria-selected="false">
              <span class="earth-values__tab-line"></span>
              <span class="earth-values__tab-text">Carbon Neutral</span>
            </button>
            <button type="button" class="earth-values__tab" data-index="4" role="tab" aria-selected="false">
              <span class="earth-values__tab-line"></span>
              <span class="earth-values__tab-text">Vegan & Cruelty-Free</span>
            </button>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .earth-values {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: var(--values-bg, #224E09);
    color: var(--values-text, #F8F9DC);
    padding: var(--values-pt, 80px) 0 var(--values-pb, 96px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .earth-values__inner-container {
    width: 100%;
    box-sizing: border-box;
  }

  .earth-values--contained .earth-values__inner-container {
    max-width: var(--page-width, 1320px);
    margin: 0 auto;
  }

  .earth-values--full .earth-values__inner-container {
    max-width: 100%;
  }

  .earth-values__header-container {
    width: 100%;
    padding: 0 clamp(20px, 3.5vw, 34px);
    box-sizing: border-box;
  }

  /* 1. Header */
  .earth-values__header {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .earth-values__title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: var(--type-section-title, 2.625rem);
    font-weight: 800;
    color: var(--values-text, #F8F9DC);
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .earth-values__leaf-icon {
    color: var(--values-tab-inactive, var(--color-accent, #EAE060));
    width: clamp(24px, 3vw, 32px);
    height: auto;
    object-fit: contain;
    flex-shrink: 0;
  }
  .earth-values__subtitle {
    font-size: var(--type-section-subtitle, 1.3125rem);
    color: var(--values-text, #F8F9DC);
    opacity: 0.9;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.5;
  }
  .earth-values__subtitle p {
    margin: 0;
  }

  /* 2. Slider Showcase Track */
  .earth-values__slider-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: clamp(36px, 4.5vw, 56px);
  }

  .earth-values__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-left: clamp(20px, 3.5vw, 34px);
    scroll-padding-right: clamp(20px, 3.5vw, 34px);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: clamp(24px, 2.5vw, 40px);
    padding: 64px clamp(20px, 3.5vw, 34px);
    box-sizing: border-box;
  }
  .earth-values__track::-webkit-scrollbar {
    display: none;
  }

  /* Grid Layout Mode */
  .earth-values__track--grid {
    display: grid !important;
    overflow-x: visible !important;
    scroll-snap-type: none !important;
    gap: clamp(24px, 3vw, 40px) !important;
    padding: 0 clamp(20px, 3.5vw, 34px) !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  .earth-values__track--grid.earth-values__track--cols-1 {
    grid-template-columns: 1fr !important;
    max-width: 1200px;
    margin: 0 auto;
  }
  .earth-values__track--grid.earth-values__track--cols-2 {
    grid-template-columns: repeat(2, 1fr) !important;
  }
  .earth-values__track--grid .earth-values__slide {
    flex: none !important;
    width: 100% !important;
    min-width: 0 !important;
  }
  .earth-values__track--grid.earth-values__track--cols-2 .earth-values__card {
    grid-template-columns: 1fr !important;
  }

  /* Each Value Slide */
  .earth-values__slide {
    flex: 0 0 clamp(660px, 66vw, 80vw);
    min-width: 320px;
    scroll-snap-align: start;
    box-sizing: border-box;
  }

  /* Split Card (Left: Media Box, Right: Info Box) */
  .earth-values__card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background-color: var(--values-card-bg, #F8F9DC);
    border-radius: var(--values-card-radius, 0px);
    box-sizing: border-box;
    overflow: hidden;
    height: 100%;
    align-items: stretch;
  }

  /* Image Box */
  .earth-values__media-box {
    position: relative;
    width: 100%;
    aspect-ratio: var(--values-card-aspect, 1 / 1);
    overflow: hidden;
    background-color: #1e3a10;
  }
  .earth-values__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-values__card:hover .earth-values__img {
    transform: scale(1.03);
  }

  /* Info Box */
  .earth-values__info-box {
    padding: clamp(36px, 4.5vw, 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    color: var(--values-card-text, #003225);
    box-sizing: border-box;
  }
  .earth-values__item-title {
    font-size: clamp(34px, 3.2vw, 48px);
    font-weight: 800;
    color: var(--values-card-text, #003225);
    margin: 0 0 18px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  
  .earth-values__badge-wrap {
    margin-bottom: 20px;
  }
  .earth-values__badge {
    display: inline-block;
    background-color: var(--values-badge-bg, var(--color-black, #003225));
    color: var(--values-badge-text, var(--color-accent, #EAE060));
    font-size: 15px;
    font-weight: 400;
    padding: 7px 16px;
    border-radius: 20px;
    letter-spacing: 0.02em;
  }

  .earth-values__highlight {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 400;
    color: var(--values-highlight-color, var(--color-primary, #003225));
    margin-bottom: 20px;
