    justify-content: space-between;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    width: 100%;
    box-sizing: border-box;
  }

  /* Underline Style (Default) */
  .earth-values__tab {
    background: none;
    border: none;
    color: var(--values-tab-inactive, #EAE060) !important;
    padding: 12px 0 0;
    cursor: pointer;
    position: relative;
    text-align: left;
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    transition: color 0.25s ease;
  }
  .earth-values__tab-line {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--values-tab-active, #F8F9DC);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-values__tab-text {
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 700;
    letter-spacing: -0.01em;
    display: block;
    white-space: nowrap;
