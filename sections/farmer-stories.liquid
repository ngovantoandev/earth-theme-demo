{%- comment -%}
  Section: Farmer & Artisan Stories
  Renders harvest stories featuring farmers and artisans cultivate materials.
  Uses atomic theme blocks:
  - Header: stack (heading-group with leaf icon & heading + subtitle paragraph)
  - Cards Carousel: carousel (wrapping cards with circular slider navigation arrows)
{%- endcomment -%}

{%- liquid
  assign make_section_page_width = section.settings.make_section_page_width

  assign section_bg = section.settings.background_color
  assign bg_style = ''
  if section_bg != blank and section_bg != 'rgba(0,0,0,0)' and section_bg != '#00000000'
    assign bg_style = '--vt-bg: ' | append: section_bg | append: ';'
  endif

  assign heading_color = section.settings.heading_color
  assign heading_style = ''
  if heading_color != blank and heading_color != 'rgba(0,0,0,0)' and heading_color != '#00000000'
    assign heading_style = '--vt-heading-color: ' | append: heading_color | append: ';'
  endif

  assign paragraph_color = section.settings.paragraph_color
  assign paragraph_style = ''
  if paragraph_color != blank and paragraph_color != 'rgba(0,0,0,0)' and paragraph_color != '#00000000'
    assign paragraph_style = '--vt-paragraph-color: ' | append: paragraph_color | append: ';'
  endif

  assign pad_top = section.settings.padding_top_desktop | default: 80
  assign pad_bottom = section.settings.padding_bottom_desktop | default: 96
  assign pad_left = section.settings.padding_left_desktop | default: 34
  assign pad_right = section.settings.padding_right_desktop | default: 34

  if section.settings.enable_custom_mobile_padding
    assign pad_top_mobile = section.settings.padding_top_mobile | default: 48
    assign pad_bottom_mobile = section.settings.padding_bottom_mobile | default: 48
    assign pad_left_mobile = section.settings.padding_left_mobile | default: 20
    assign pad_right_mobile = section.settings.padding_right_mobile | default: 20
  else
    assign pad_top_mobile = pad_top | times: 0.75 | round
    assign pad_bottom_mobile = pad_bottom | times: 0.75 | round
    assign pad_left_mobile = pad_left | times: 0.75 | round
    assign pad_right_mobile = pad_right | times: 0.75 | round
  endif

  assign block_gap = section.settings.gap | default: 48
  assign block_gap_mobile = section.settings.gap_mobile | default: 32
-%}

<div
  class="vt-farmer-stories{% unless make_section_page_width %} vt-page-full-width{% endunless %}"
  id="vtFarmerStories-{{ section.id }}"
  style="
    {{ bg_style }}
    {{ heading_style }}
    {{ paragraph_style }}
    --vt-pt: {% render 'fluid-clamp', min_px: pad_top_mobile, max_px: pad_top %};
    --vt-pb: {% render 'fluid-clamp', min_px: pad_bottom_mobile, max_px: pad_bottom %};
    --vt-pl: {% render 'fluid-clamp', min_px: pad_left_mobile, max_px: pad_left %};
    --vt-pr: {% render 'fluid-clamp', min_px: pad_right_mobile, max_px: pad_right %};
    --vt-pl-desktop: {{ pad_left }}px;
    --vt-pr-desktop: {{ pad_right }}px;
    --vt-pl-mobile: {{ pad_left_mobile }}px;
    --vt-pr-mobile: {{ pad_right_mobile }}px;
    --vt-block-gap: {% render 'fluid-clamp', min_px: block_gap_mobile, max_px: block_gap %};
    --vt-block-gap-mobile: {{ block_gap_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-farmer-stories__container{% if make_section_page_width %} vt-page-width{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-farmer-stories {
    display: block;
    width: 100%;
    background-color: var(--vt-bg, var(--vt-background-color));
    color: var(--vt-heading-color, var(--vt-foreground-color));
    padding-top: var(--vt-pt, 80px);
    padding-bottom: var(--vt-pb, 96px);
    box-sizing: border-box;
    overflow-x: clip;
    position: relative;
  }

  .vt-farmer-stories__container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--vt-block-gap, 48px);
    padding-left: var(--vt-pl-desktop, 34px);
    padding-right: var(--vt-pr-desktop, 34px);
  }

  .vt-farmer-stories .vt-farmer-stories__container.vt-page-width {
    max-width: calc(var(--vt-page-width, 1200px) + var(--vt-pl-desktop, 34px) + var(--vt-pr-desktop, 34px));
    padding-inline: var(--vt-pl-desktop, 34px) var(--vt-pr-desktop, 34px);
  }

  .vt-farmer-stories__container:not(.vt-page-width) {
    max-width: 100%;
  }

  /* Support Theme Editor wrappers without altering block layouts or configs */
  .vt-farmer-stories__container > .shopify-block,
  .vt-farmer-stories__container > shopify-block {
    display: contents;
  }

  .vt-farmer-stories .vt-heading {
    color: var(--vt-heading-color, var(--vt-foreground-color, #003225));
  }

  .vt-farmer-stories .vt-paragraph {
    color: var(--vt-paragraph-color, var(--vt-color-primary, #224E09));
  }

  @media screen and (max-width: 768px) {
    .vt-farmer-stories__container {
      padding-left: var(--vt-pl-mobile, 20px);
      padding-right: var(--vt-pr-mobile, 20px);
      gap: var(--vt-block-gap-mobile, 32px);
    }

    .vt-farmer-stories .vt-farmer-stories__container.vt-page-width {
      max-width: calc(var(--vt-page-width, 1200px) + var(--vt-pl-mobile, 20px) + var(--vt-pr-mobile, 20px));
      padding-inline: var(--vt-pl-mobile, 20px) var(--vt-pr-mobile, 20px);
    }
  }
{% endstylesheet %}

