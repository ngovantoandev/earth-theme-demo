<section class="earth-farmers earth-farmers-{{ section.id }} full-width" id="earthFarmers-{{ section.id }}">
  <!-- 1. Full-Width Section Header (34px Padding on left & right) -->
  <div class="earth-farmers__header-container">
    <div class="earth-farmers__header">
      <div class="earth-farmers__header-left">
        <div class="earth-farmers__leaf-icon-wrap" aria-hidden="true">
          <svg class="earth-farmers__leaf-icon" width="34" height="30" viewBox="0 0 41 37" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M36.5053 0C31.3399 8.60515 23.6183 8.25605 18.7209 16.5435C18.1501 17.5098 17.7216 18.4694 17.4006 19.4141C17.9201 19.9982 18.4198 20.6252 18.8896 21.3102C21.8992 25.6864 22.0051 29.5861 21.469 32.2433C28.2393 23.9243 33.6728 14.439 36.3796 4.02875C33.8597 15.1885 28.2277 25.4233 21.1299 34.3842C24.0269 34.7664 31.8942 34.8442 37.1803 25.7609C44.5942 13.0194 36.5053 0 36.5053 0Z" fill="currentColor"/>
            <path d="M18.1567 21.8148C12.4933 13.5753 2.73161 13.3403 0 13.4462C1.99535 16.7238 2.37093 19.7351 2.73492 22.652C3.11711 25.7112 3.4778 28.6 5.61213 31.7518C9.73022 37.8305 16.8298 37.081 18.3536 36.8378C14.5465 28.4031 9.27192 20.5375 2.15915 14.5548C9.4109 20.1818 14.9651 27.7198 19.1229 35.9047C20.435 33.7439 22.6801 28.3931 18.1567 21.8148Z" fill="currentColor"/>
          </svg>
        </div>
        <h2 class="earth-farmers__title">{{ section.settings.title | default: 'The hands that hold the harvest' }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="earth-farmers__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <!-- Reusable Slider Navigation Arrows Snippet -->
      <div class="earth-farmers__header-right">
        {%- assign prev_id_str = 'earthFarmersPrev-' | append: section.id -%}
        {%- assign next_id_str = 'earthFarmersNext-' | append: section.id -%}
        {% render 'btn-nav-slider', 
          prev_id: prev_id_str, 
          next_id: next_id_str, 
          theme: 'green',
          prev_label: 'Previous artisan story',
          next_label: 'Next artisan story'
        %}
      </div>
    </div>
  </div>

  <!-- 2. Full-Width Edge-to-Edge Slider Track (34px Padding & Gap) -->
  <div class="earth-farmers__slider-wrapper">
    <div class="earth-farmers__track" id="earthFarmersTrack-{{ section.id }}" tabindex="0" role="region" aria-label="Artisan Stories Slider">
      
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="earth-farmers__slide" {{ block.shopify_attributes }}>
            <div class="earth-farmers__card">
              
              <!-- Card Image Box -->
              <div class="earth-farmers__media-box">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: 
                    alt: block.settings.name, 
                    class: 'earth-farmers__img', 
                    loading: 'lazy',
                    widths: '300, 450, 600, 900' 
                  }}
                {%- else -%}
                  {%- assign fallback_num = forloop.index0 | modulo: 6 | plus: 1 -%}
                  {%- assign fallback_img = 'farmer-' | append: fallback_num | append: '.jpg' -%}
                  <img 
                    src="{{ fallback_img | asset_url }}" 
                    alt="{{ block.settings.name | default: 'Artisan Story' }}" 
                    class="earth-farmers__img" 
                    width="600" 
                    height="500" 
                    loading="lazy"
                  >
                {%- endif -%}
              </div>

              <!-- Quote Text -->
              {%- if block.settings.quote != blank -%}
                <blockquote class="earth-farmers__quote">
                  “{{ block.settings.quote }}”
                </blockquote>
              {%- endif -%}

              <!-- Bottom Meta Row: Name, Role & Badge -->
              <div class="earth-farmers__meta-row">
                <div class="earth-farmers__author">
                  <span class="earth-farmers__name">{{ block.settings.name }}</span>
                  {%- if block.settings.role_location != blank -%}
                    <span class="earth-farmers__role">{{ block.settings.role_location }}</span>
                  {%- endif -%}
                </div>

                {%- if block.settings.badge != blank -%}
                  <div class="earth-farmers__badge-wrap">
                    <span class="earth-farmers__badge">{{ block.settings.badge }}</span>
                  </div>
                {%- endif -%}
              </div>

            </div>
          </div>
        {%- endfor -%}

      {%- else -%}
        <!-- Default Curated Stories (6 Items) -->
        <!-- Story 1: Ananya R. -->
        <div class="earth-farmers__slide">
          <div class="earth-farmers__card">
            <div class="earth-farmers__media-box">
              <img src="{{ 'farmer-1.jpg' | asset_url }}" alt="Ananya R." class="earth-farmers__img" width="600" height="500" loading="lazy">
            </div>
            <blockquote class="earth-farmers__quote">
              “I grow this cotton for my children, so they may inherit a soil that is healthy and full of life.”
            </blockquote>
            <div class="earth-farmers__meta-row">
              <div class="earth-farmers__author">
                <span class="earth-farmers__name">Ananya R.</span>
                <span class="earth-farmers__role">Organic Farmer, Gujarat</span>
              </div>
              <div class="earth-farmers__badge-wrap">
                <span class="earth-farmers__badge">Regenerative Practice</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Story 2: Mateo S. -->
        <div class="earth-farmers__slide">
          <div class="earth-farmers__card">
            <div class="earth-farmers__media-box">
              <img src="{{ 'farmer-2.jpg' | asset_url }}" alt="Mateo S." class="earth-farmers__img" width="600" height="500" loading="lazy">
            </div>
            <blockquote class="earth-farmers__quote">
              “Every thread is a silent conversation between my hands and the fibers of the Earth.”
            </blockquote>
            <div class="earth-farmers__meta-row">
              <div class="earth-farmers__author">
                <span class="earth-farmers__name">Mateo S.</span>
                <span class="earth-farmers__role">Master Weaver, Peru</span>
              </div>
              <div class="earth-farmers__badge-wrap">
                <span class="earth-farmers__badge">Fair Trade Certified</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Story 3: Elias K. -->
        <div class="earth-farmers__slide">
          <div class="earth-farmers__card">
            <div class="earth-farmers__media-box">
              <img src="{{ 'farmer-3.jpg' | asset_url }}" alt="Elias K." class="earth-farmers__img" width="600" height="500" loading="lazy">
            </div>
            <blockquote class="earth-farmers__quote">
              “Sustainability is not a modern trend to us; it is the only way we know how to work with flax — patiently and respectfully.”
            </blockquote>
            <div class="earth-farmers__meta-row">
              <div class="earth-farmers__author">
                <span class="earth-farmers__name">Elias K.</span>
                <span class="earth-farmers__role">Flax Cultivator, Belgium</span>
              </div>
              <div class="earth-farmers__badge-wrap">
                <span class="earth-farmers__badge">Zero Chemical</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Story 4: Sophia L. -->
        <div class="earth-farmers__slide">
          <div class="earth-farmers__card">
            <div class="earth-farmers__media-box">
              <img src="{{ 'farmer-4.jpg' | asset_url }}" alt="Sophia L." class="earth-farmers__img" width="600" height="500" loading="lazy">
            </div>
            <blockquote class="earth-farmers__quote">
              “Colors harvested from nature contain a soul and softness that synthetic chemicals can never replicate.”
            </blockquote>
            <div class="earth-farmers__meta-row">
              <div class="earth-farmers__author">
                <span class="earth-farmers__name">Sophia L.</span>
                <span class="earth-farmers__role">Botanical Dye Specialist, Portugal</span>
              </div>
              <div class="earth-farmers__badge-wrap">
                <span class="earth-farmers__badge">Non-Toxic Dyes</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Story 5: Hiroshi T. -->
        <div class="earth-farmers__slide">
          <div class="earth-farmers__card">
            <div class="earth-farmers__media-box">
              <img src="{{ 'farmer-5.jpg' | asset_url }}" alt="Hiroshi T." class="earth-farmers__img" width="600" height="500" loading="lazy">
            </div>
            <blockquote class="earth-farmers__quote">
              “True circular denim begins with reverence for the harvest and ends with garments crafted to outlast a lifetime.”
            </blockquote>
            <div class="earth-farmers__meta-row">
              <div class="earth-farmers__author">
                <span class="earth-farmers__name">Hiroshi T.</span>
                <span class="earth-farmers__role">Organic Denim Artisan, Japan</span>
              </div>
              <div class="earth-farmers__badge-wrap">
                <span class="earth-farmers__badge">Zero Waste Artisan</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Story 6: Nadia B. -->
        <div class="earth-farmers__slide">
          <div class="earth-farmers__card">
            <div class="earth-farmers__media-box">
              <img src="{{ 'farmer-6.jpg' | asset_url }}" alt="Nadia B." class="earth-farmers__img" width="600" height="500" loading="lazy">
            </div>
            <blockquote class="earth-farmers__quote">
              “Protecting pasture biodiversity ensures our sheep thrive naturally without harming water systems.”
            </blockquote>
            <div class="earth-farmers__meta-row">
              <div class="earth-farmers__author">
                <span class="earth-farmers__name">Nadia B.</span>
                <span class="earth-farmers__role">Regenerative Wool Shepherd, New Zealand</span>
              </div>
              <div class="earth-farmers__badge-wrap">
                <span class="earth-farmers__badge">Animal Welfare</span>
              </div>
            </div>
          </div>
        </div>

      {%- endif -%}

    </div>
  </div>
</section>

{% stylesheet %}
  .earth-farmers {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: #F1F4D8;
    color: var(--color-black, #003225);
    padding-top: 115px;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* 1. Header (Full Width with 34px padding) */
  .earth-farmers__header-container {
    width: 100%;
    padding-left: 34px;
    padding-right: 34px;
    box-sizing: border-box;
  }

  .earth-farmers__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .earth-farmers__header-left {
    max-width: 680px;
  }

  .earth-farmers__leaf-icon-wrap {
    margin-bottom: 12px;
    display: inline-block;
  }
  .earth-farmers__leaf-icon {
    color: var(--color-secondary, #71CC3B);
    width: clamp(28px, 3vw, 36px);
    height: auto;
    display: block;
  }

  .earth-farmers__title {
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-black, #003225);
    margin: 0 0 14px;
  }

  .earth-farmers__subtitle {
    font-size: clamp(15px, 1.25vw, 17px);
    line-height: 1.55;
    color: var(--color-black, #003225);
    opacity: 0.88;
    margin: 0;
  }

  /* 2. Full-Width Edge-to-Edge Slider Track (34px Padding & 34px Gap) */
  .earth-farmers__slider-wrapper {
    position: relative;
    width: 100%;
    margin-top: clamp(36px, 4.5vw, 52px);
  }

  .earth-farmers__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 34px;
    scroll-padding-right: 34px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 34px;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 0;
    padding-bottom: 0;
    box-sizing: border-box;
  }
  .earth-farmers__track::-webkit-scrollbar {
    display: none;
  }

  /* Slide Items: Prominent, wide cards */
  .earth-farmers__slide {
    flex: 0 0 clamp(360px, 36vw, 540px);
    min-width: 320px;
    scroll-snap-align: start;
    box-sizing: border-box;
  }

  /* Card */
  .earth-farmers__card {
    background-color: var(--color-accent);
    color: var(--color-black, #003225);
    padding: clamp(24px, 2.8vw, 36px);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    border-radius: 0px;
  }

  /* Media Box */
  .earth-farmers__media-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.95;
    overflow: hidden;
    background-color: #c9d23e;
    margin-bottom: clamp(20px, 2.2vw, 28px);
  }
  .earth-farmers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* Quote */
  .earth-farmers__quote {
    font-size: clamp(17px, 1.4vw, 21px);
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-black, #003225);
    margin: 0 0 clamp(24px, 2.8vw, 36px);
    padding: 0;
    border: none;
    flex-grow: 1;
    font-style: normal;
  }

  /* Meta Row */
  .earth-farmers__meta-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    box-sizing: border-box;
  }

  .earth-farmers__author {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .earth-farmers__name {
    font-size: 19px;
    font-weight: 800;
    color: var(--color-black, #003225);
    letter-spacing: -0.01em;
  }

  .earth-farmers__role {
    font-size: 18px;
    color: var(--color-black, #003225);
    opacity: 0.85;
    line-height: 1.2;
  }

  .earth-farmers__badge-wrap {
    flex-shrink: 0;
  }
  .earth-farmers__badge {
    display: inline-block;
    background-color: var(--color-black, #003225);
    color: var(--color-white, #F8F9DC);
    font-size: 15px;
    font-weight: 400;
    padding: 6px 16px;
    border-radius: 20px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .earth-farmers__slide {
      flex: 0 0 clamp(320px, 46vw, 440px);
      min-width: 290px;
    }
  }

  @media (max-width: 768px) {
    .earth-farmers {
      padding: 50px 0 60px;
    }
    .earth-farmers__header-container {
      padding-left: 20px;
      padding-right: 20px;
    }
    .earth-farmers__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .earth-farmers__leaf-icon-wrap {
      display: none !important;
    }
    .earth-farmers__header-right {
      display: none !important;
    }
    .earth-farmers__slider-wrapper {
      margin-top: 24px;
    }
    .earth-farmers__track {
      padding-left: 20px;
      padding-right: 20px;
      scroll-padding-left: 20px;
      scroll-padding-right: 20px;
      gap: 20px;
    }
    .earth-farmers__slide {
      flex: 0 0 85%;
      min-width: 270px;
    }
    .earth-farmers__quote {
      font-size: 16px;
    }
    .earth-farmers__meta-row {
      flex-wrap: wrap;
      gap: 8px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initFarmersSlider() {
      var sectionId = '{{ section.id }}';
      var track = document.getElementById('earthFarmersTrack-' + sectionId);
      var prevBtn = document.getElementById('earthFarmersPrev-' + sectionId);
      var nextBtn = document.getElementById('earthFarmersNext-' + sectionId);

      if (!track || !prevBtn || !nextBtn) return;

      function getScrollStep() {
        var slide = track.querySelector('.earth-farmers__slide');
        if (!slide) return 420;
        var style = window.getComputedStyle(track);
        var gap = parseFloat(style.gap) || 34;
        return slide.offsetWidth + gap;
      }

      nextBtn.addEventListener('click', function() {
        var maxScroll = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= maxScroll - 2) {
          // Already at the last item - do nothing, no overscroll
          return;
        }
        var target = Math.min(track.scrollLeft + getScrollStep(), maxScroll);
        track.scrollTo({ left: target, behavior: 'smooth' });
      });

      prevBtn.addEventListener('click', function() {
        if (track.scrollLeft <= 2) {
          // Already at the first item - do nothing
          return;
        }
        var target = Math.max(track.scrollLeft - getScrollStep(), 0);
        track.scrollTo({ left: target, behavior: 'smooth' });
      });

      // Keyboard navigation
      track.addEventListener('keydown', function(e) {
        var maxScroll = track.scrollWidth - track.clientWidth;
        if (e.key === 'ArrowRight') {
          if (track.scrollLeft < maxScroll - 2) {
            var target = Math.min(track.scrollLeft + getScrollStep(), maxScroll);
            track.scrollTo({ left: target, behavior: 'smooth' });
          }
        } else if (e.key === 'ArrowLeft') {
          if (track.scrollLeft > 2) {
            var target = Math.max(track.scrollLeft - getScrollStep(), 0);
            track.scrollTo({ left: target, behavior: 'smooth' });
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFarmersSlider);
    } else {
      initFarmersSlider();
    }
  })();
</script>

