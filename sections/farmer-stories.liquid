<section 
  class="earth-farmers earth-farmers-{{ section.id }}{% if section.settings.full_width %} earth-farmers--full{% else %} earth-farmers--contained{% endif %}{% if section.settings.full_width %} full-width{% endif %}" 
  id="earthFarmers-{{ section.id }}"
  style="
    --farmer-bg: {{ section.settings.section_bg_color | default: '#F1F4D8' }};
    --farmer-text: {{ section.settings.section_text_color | default: '#003225' }};
    --farmer-leaf: {{ section.settings.leaf_color | default: '#71CC3B' }};
    --farmer-card-bg: {{ section.settings.card_bg_color | default: '#EAE060' }};
    --farmer-card-text: {{ section.settings.card_text_color | default: '#003225' }};
    --farmer-card-radius: {{ section.settings.card_corner_radius | default: 0 }}px;
    --farmer-card-padding: {{ section.settings.card_padding | default: 36 }}px;
    --farmer-card-border-color: {{ section.settings.card_border_color | default: '#E0D650' }};
    --farmer-img-radius: {{ section.settings.image_corner_radius | default: 0 }}px;
    --farmer-quote-size: {{ section.settings.quote_font_size | default: 19 }}px;
    --farmer-author-size: {{ section.settings.author_name_size | default: 19 }}px;
    --farmer-badge-bg: {{ section.settings.badge_bg_color | default: '#003225' }};
    --farmer-badge-text: {{ section.settings.badge_text_color | default: '#F8F9DC' }};
    --farmer-badge-radius: {{ section.settings.badge_border_radius | default: 20 }}px;
    --farmer-nav-size: {{ section.settings.nav_btn_size | default: 48 }}px;
    --farmer-nav-bg: {{ section.settings.nav_bg_color | default: '#F8F9DC' }};
    --farmer-nav-color: {{ section.settings.nav_icon_color | default: '#003225' }};
    --farmer-nav-hover-bg: {{ section.settings.nav_hover_bg_color | default: '#71CC3B' }};
    --farmer-nav-hover-color: {{ section.settings.nav_hover_icon_color | default: '#003225' }};
    --farmer-pt: {{ section.settings.padding_top | default: 116 }}px;
    --farmer-pb: {{ section.settings.padding_bottom | default: 116 }}px;
    --farmer-pt-mob: {{ section.settings.mobile_padding_top | default: 50 }}px;
    --farmer-pb-mob: {{ section.settings.mobile_padding_bottom | default: 60 }}px;
    --farmer-gap: {{ section.settings.columns_gap | default: 34 }}px;
  "
>
  <div class="earth-farmers__inner-container">
    
    {%- capture header_button_block -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'button' -%}
          <div class="earth-section-header__btn-wrap" {{ block.shopify_attributes }}>
            {%- assign btn_style = block.settings.button_type | default: 'arrow' -%}
            {%- assign btn_theme = block.settings.arrow_theme | default: 'dark' -%}
            {%- if btn_style == 'arrow' -%}
              {% render 'btn-arrow',
                text: block.settings.button_text,
                url: block.settings.button_link,
                theme: btn_theme,
                color: block.settings.custom_color
              %}
            {%- else -%}
              {% render 'btn-action',
                text: block.settings.button_text,
                url: block.settings.button_link,
                variant: btn_style,
                custom_bg: block.settings.custom_color
              %}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    <!-- 1. Section Header -->
    <div class="earth-farmers__header-container">
      {%- assign header_layout = section.settings.header_layout | default: 'stacked_left' -%}
      {%- assign show_leaf_val = section.settings.show_leaf_icons -%}
      {%- if show_leaf_val == nil -%}{%- assign show_leaf_val = section.settings.show_leaf_icon -%}{%- endif -%}
      {%- assign title_color_val = section.settings.title_color | default: section.settings.section_text_color -%}
      {% render 'title-styling',
        layout: header_layout,
        title: section.settings.title,
        title_color: title_color_val,
        title_size: section.settings.title_size_desktop,
        title_size_desktop: section.settings.title_size_desktop,
        title_size_mobile: section.settings.title_size_mobile,
        eyebrow: section.settings.eyebrow,
        show_eyebrow_icon: section.settings.show_eyebrow_icon,
        eyebrow_color: section.settings.eyebrow_color,
        eyebrow_size_desktop: section.settings.eyebrow_size_desktop,
        eyebrow_size_mobile: section.settings.eyebrow_size_mobile,
        subtitle: section.settings.subtitle,
        subtitle_color: section.settings.subtitle_color,
        subtitle_size_desktop: section.settings.subtitle_size_desktop,
        subtitle_size_mobile: section.settings.subtitle_size_mobile,
        show_leaf: show_leaf_val,
        leaf_position: section.settings.leaf_position,
        leaf_color: section.settings.leaf_color,
        leaf_size: section.settings.leaf_size,
        leaf_gap: section.settings.leaf_gap,
        split_ratio: section.settings.header_split_ratio,
        show_btn: section.settings.show_header_btn,
        btn_text: section.settings.header_btn_text,
        btn_url: section.settings.header_btn_url,
        btn_type: section.settings.header_btn_type,
        btn_theme: section.settings.header_btn_theme,
        btn_color: section.settings.header_btn_color,
        btn_bg_color: section.settings.header_btn_bg_color,
        btn_text_color: section.settings.header_btn_text_color,
        btn_arrow_circle_bg: section.settings.header_btn_circle_bg,
        btn_arrow_circle_color: section.settings.header_btn_circle_color,
        btn_block: header_button_block,
        text_color: section.settings.section_text_color
      %}
    </div>

    <!-- 2. Slider / Grid Showcase Area -->
    <div class="earth-farmers__showcase-wrapper earth-farmers__showcase-wrapper--{{ section.settings.layout_mode | default: 'slider' }}" id="earthFarmersWrapper-{{ section.id }}">
      
      {%- if section.settings.layout_mode != 'grid' and section.settings.show_nav_arrows != false -%}
        <!-- Left Floating Navigation Arrow -->
        <button 
          type="button" 
          class="earth-farmers__nav-btn earth-farmers__nav-btn--prev{% if section.settings.nav_arrow_visibility == 'always' %} earth-farmers__nav-btn--always{% endif %}" 
          id="earthFarmersPrev-{{ section.id }}" 
          aria-label="Previous artisan story"
        >
          <span class="earth-farmers__icon-arrow earth-farmers__icon-arrow--prev" aria-hidden="true">{{ 'icon-prev-left.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}

      {%- if section.settings.layout_mode == 'grid' -%}
        <!-- Grid Layout -->
        <div class="earth-farmers__grid earth-farmers__grid--cols-{{ section.settings.columns_desktop | default: '3' }}" id="earthFarmersGrid-{{ section.id }}">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'farmer_story' -%}
                <div class="earth-farmers__grid-item" {{ block.shopify_attributes }}>
                  <div 
                    class="earth-farmers__card{% if section.settings.card_shadow != 'none' %} earth-farmers__card--shadow-{{ section.settings.card_shadow }}{% endif %}{% if section.settings.card_border %} earth-farmers__card--bordered{% endif %}"
                    style="{% if block.settings.custom_card_bg != blank and block.settings.custom_card_bg != 'rgba(0,0,0,0)' %}background-color: {{ block.settings.custom_card_bg }};{% endif %}"
                  >
                    <!-- Card Image Box -->
                    <div class="earth-farmers__media-box earth-farmers__media-box--aspect-{{ section.settings.card_image_aspect | default: '0.95' }}">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 900 | image_tag: 
                          alt: block.settings.name, 
                          class: 'earth-farmers__img', 
                          loading: 'lazy',
                          widths: '300, 450, 600, 900' 
                        }}
                      {%- else -%}
                        {%- assign fallback_num = forloop.index0 | modulo: 6 | plus: 1 -%}
                        {%- assign fallback_img = 'farmer-' | append: fallback_num | append: '.jpg' -%}
                        <img 
                          src="{{ fallback_img | asset_url }}" 
                          alt="{{ block.settings.name | default: 'Artisan Story' }}" 
                          class="earth-farmers__img" 
                          width="600" 
                          height="500" 
                          loading="lazy"
                        >
                      {%- endif -%}
                    </div>

                    <!-- Quote Text -->
                    {%- if block.settings.quote != blank -%}
                      <blockquote class="earth-farmers__quote{% if section.settings.quote_style == 'italic' %} earth-farmers__quote--italic{% endif %}">
                        {%- if section.settings.show_quote_marks -%}“{%- endif -%}
                        {{ block.settings.quote }}
                        {%- if section.settings.show_quote_marks -%}”{%- endif -%}
                      </blockquote>
                    {%- endif -%}

                    <!-- Bottom Meta Row: Name, Role & Practice Badge -->
                    <div class="earth-farmers__meta-row">
                      <div class="earth-farmers__author">
                        {%- if block.settings.name != blank -%}
                          <span class="earth-farmers__name">{{ block.settings.name }}</span>
                        {%- endif -%}
                        {%- if block.settings.role_location != blank -%}
                          <span class="earth-farmers__role">{{ block.settings.role_location }}</span>
                        {%- endif -%}
                      </div>

                      {%- if block.settings.badge != blank -%}
                        <div class="earth-farmers__badge-wrap">
                          <span class="earth-farmers__badge">{{ block.settings.badge }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Preset Items -->
            {%- for i in (1..6) -%}
              {%- assign f_img = 'farmer-' | append: i | append: '.jpg' -%}
              <div class="earth-farmers__grid-item">
                <div class="earth-farmers__card">
                  <div class="earth-farmers__media-box earth-farmers__media-box--aspect-{{ section.settings.card_image_aspect | default: '0.95' }}">
                    <img src="{{ f_img | asset_url }}" alt="Artisan Story" class="earth-farmers__img" width="600" height="500" loading="lazy">
                  </div>
                  <blockquote class="earth-farmers__quote">
                    {%- case i -%}
                      {%- when 1 -%}“I grow this cotton for my children, so they may inherit a soil that is healthy and full of life.”
                      {%- when 2 -%}“Every thread is a silent conversation between my hands and the fibers of the Earth.”
                      {%- when 3 -%}“Sustainability is not a modern trend to us; it is the only way we know how to work with flax.”
                      {%- when 4 -%}“Colors harvested from nature contain a soul and softness that synthetic chemicals can never replicate.”
                      {%- when 5 -%}“True circular denim begins with reverence for the harvest and ends with garments crafted to outlast a lifetime.”
                      {%- when 6 -%}“Protecting pasture biodiversity ensures our sheep thrive naturally without harming water systems.”
                    {%- endcase -%}
                  </blockquote>
                  <div class="earth-farmers__meta-row">
                    <div class="earth-farmers__author">
                      <span class="earth-farmers__name">
                        {%- case i -%}{%- when 1 -%}Ananya R.{%- when 2 -%}Mateo S.{%- when 3 -%}Elias K.{%- when 4 -%}Sophia L.{%- when 5 -%}Hiroshi T.{%- when 6 -%}Nadia B.{%- endcase -%}
                      </span>
                      <span class="earth-farmers__role">
                        {%- case i -%}{%- when 1 -%}Organic Farmer, Gujarat{%- when 2 -%}Master Weaver, Peru{%- when 3 -%}Flax Cultivator, Belgium{%- when 4 -%}Botanical Dye Specialist, Portugal{%- when 5 -%}Organic Denim Artisan, Japan{%- when 6 -%}Regenerative Wool Shepherd, New Zealand{%- endcase -%}
                      </span>
                    </div>
                    <div class="earth-farmers__badge-wrap">
                      <span class="earth-farmers__badge">
                        {%- case i -%}{%- when 1 -%}Regenerative Practice{%- when 2 -%}Fair Trade Certified{%- when 3 -%}Zero Chemical{%- when 4 -%}Non-Toxic Dyes{%- when 5 -%}Zero Waste Artisan{%- when 6 -%}Animal Welfare{%- endcase -%}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

      {%- else -%}
        <!-- Swiper Slider Container -->
        <div class="swiper earth-farmers__swiper" id="earthFarmersSwiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'farmer_story' -%}
                  <div class="swiper-slide earth-farmers__slide" {{ block.shopify_attributes }}>
                    <div 
                      class="earth-farmers__card{% if section.settings.card_shadow != 'none' %} earth-farmers__card--shadow-{{ section.settings.card_shadow }}{% endif %}{% if section.settings.card_border %} earth-farmers__card--bordered{% endif %}"
                      style="{% if block.settings.custom_card_bg != blank and block.settings.custom_card_bg != 'rgba(0,0,0,0)' %}background-color: {{ block.settings.custom_card_bg }};{% endif %}"
                    >
                      <!-- Card Image Box -->
                      <div class="earth-farmers__media-box earth-farmers__media-box--aspect-{{ section.settings.card_image_aspect | default: '0.95' }}">
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 900 | image_tag: 
                            alt: block.settings.name, 
                            class: 'earth-farmers__img', 
                            loading: 'lazy',
                            widths: '300, 450, 600, 900' 
                          }}
                        {%- else -%}
                          {%- assign fallback_num = forloop.index0 | modulo: 6 | plus: 1 -%}
                          {%- assign fallback_img = 'farmer-' | append: fallback_num | append: '.jpg' -%}
                          <img 
                            src="{{ fallback_img | asset_url }}" 
                            alt="{{ block.settings.name | default: 'Artisan Story' }}" 
                            class="earth-farmers__img" 
                            width="600" 
                            height="500" 
                            loading="lazy"
                          >
                        {%- endif -%}
                      </div>

                      <!-- Quote Text -->
                      {%- if block.settings.quote != blank -%}
                        <blockquote class="earth-farmers__quote{% if section.settings.quote_style == 'italic' %} earth-farmers__quote--italic{% endif %}">
                          {%- if section.settings.show_quote_marks -%}“{%- endif -%}
                          {{ block.settings.quote }}
                          {%- if section.settings.show_quote_marks -%}”{%- endif -%}
                        </blockquote>
                      {%- endif -%}

                      <!-- Bottom Meta Row: Name, Role & Practice Badge -->
                      <div class="earth-farmers__meta-row">
                        <div class="earth-farmers__author">
                          {%- if block.settings.name != blank -%}
                            <span class="earth-farmers__name">{{ block.settings.name }}</span>
                          {%- endif -%}
                          {%- if block.settings.role_location != blank -%}
                            <span class="earth-farmers__role">{{ block.settings.role_location }}</span>
                          {%- endif -%}
                        </div>

                        {%- if block.settings.badge != blank -%}
                          <div class="earth-farmers__badge-wrap">
                            <span class="earth-farmers__badge">{{ block.settings.badge }}</span>
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback Preset Items -->
              {%- for i in (1..6) -%}
                {%- assign f_img = 'farmer-' | append: i | append: '.jpg' -%}
                <div class="swiper-slide earth-farmers__slide">
                  <div class="earth-farmers__card">
                    <div class="earth-farmers__media-box earth-farmers__media-box--aspect-{{ section.settings.card_image_aspect | default: '0.95' }}">
                      <img src="{{ f_img | asset_url }}" alt="Artisan Story" class="earth-farmers__img" width="600" height="500" loading="lazy">
                    </div>
                    <blockquote class="earth-farmers__quote">
                      {%- case i -%}
                        {%- when 1 -%}“I grow this cotton for my children, so they may inherit a soil that is healthy and full of life.”
                        {%- when 2 -%}“Every thread is a silent conversation between my hands and the fibers of the Earth.”
                        {%- when 3 -%}“Sustainability is not a modern trend to us; it is the only way we know how to work with flax.”
                        {%- when 4 -%}“Colors harvested from nature contain a soul and softness that synthetic chemicals can never replicate.”
                        {%- when 5 -%}“True circular denim begins with reverence for the harvest and ends with garments crafted to outlast a lifetime.”
                        {%- when 6 -%}“Protecting pasture biodiversity ensures our sheep thrive naturally without harming water systems.”
                      {%- endcase -%}
                    </blockquote>
                    <div class="earth-farmers__meta-row">
                      <div class="earth-farmers__author">
                        <span class="earth-farmers__name">
                          {%- case i -%}{%- when 1 -%}Ananya R.{%- when 2 -%}Mateo S.{%- when 3 -%}Elias K.{%- when 4 -%}Sophia L.{%- when 5 -%}Hiroshi T.{%- when 6 -%}Nadia B.{%- endcase -%}
                        </span>
                        <span class="earth-farmers__role">
                          {%- case i -%}{%- when 1 -%}Organic Farmer, Gujarat{%- when 2 -%}Master Weaver, Peru{%- when 3 -%}Flax Cultivator, Belgium{%- when 4 -%}Botanical Dye Specialist, Portugal{%- when 5 -%}Organic Denim Artisan, Japan{%- when 6 -%}Regenerative Wool Shepherd, New Zealand{%- endcase -%}
                        </span>
                      </div>
                      <div class="earth-farmers__badge-wrap">
                        <span class="earth-farmers__badge">
                          {%- case i -%}{%- when 1 -%}Regenerative Practice{%- when 2 -%}Fair Trade Certified{%- when 3 -%}Zero Chemical{%- when 4 -%}Non-Toxic Dyes{%- when 5 -%}Zero Waste Artisan{%- when 6 -%}Animal Welfare{%- endcase -%}
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.layout_mode != 'grid' and section.settings.show_nav_arrows != false -%}
        <!-- Right Floating Navigation Arrow -->
        <button 
          type="button" 
          class="earth-farmers__nav-btn earth-farmers__nav-btn--next{% if section.settings.nav_arrow_visibility == 'always' %} earth-farmers__nav-btn--always{% endif %}" 
          id="earthFarmersNext-{{ section.id }}" 
          aria-label="Next artisan story"
        >
          <span class="earth-farmers__icon-arrow earth-farmers__icon-arrow--next" aria-hidden="true">{{ 'icon-next-right.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}

    </div>
  </div>
</section>

{% stylesheet %}
  .earth-farmers {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: var(--farmer-bg, #F1F4D8);
    color: var(--farmer-text, #003225);
    padding-top: var(--farmer-pt, 116px);
    padding-bottom: var(--farmer-pb, 116px);
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
  }

  /* Full Width vs Contained inner layout */
  .earth-farmers--full .earth-farmers__inner-container {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  .earth-farmers--contained .earth-farmers__inner-container {
    max-width: var(--page-width, 1440px);
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(20px, 3vw, 40px);
    padding-right: clamp(20px, 3vw, 40px);
    box-sizing: border-box;
  }

  /* 1. Header */
  .earth-farmers__header-container {
    width: 100%;
    box-sizing: border-box;
  }

  .earth-farmers--full .earth-farmers__header-container {
    padding-left: 34px;
    padding-right: 34px;
  }

  .earth-farmers--contained .earth-farmers__header-container {
    padding-left: 0;
    padding-right: 0;
  }

  /* 2. Slider & Showcase Wrapper */
  .earth-farmers__showcase-wrapper {
    position: relative;
    width: 100%;
    margin-top: clamp(36px, 4.5vw, 52px);
    overflow: hidden;
  }

  /* Swiper Container */
  .earth-farmers__swiper {
    width: 100%;
    overflow: visible;
    box-sizing: border-box;
  }

  .earth-farmers--full .earth-farmers__swiper,
  .earth-farmers--full .earth-farmers__grid {
    padding-left: 34px;
    padding-right: 34px;
  }

  .earth-farmers--contained .earth-farmers__swiper,
  .earth-farmers--contained .earth-farmers__grid {
    padding-left: 0;
    padding-right: 0;
  }

  .earth-farmers__swiper .swiper-wrapper {
    display: flex;
    align-items: stretch;
  }

  .earth-farmers__slide {
    width: clamp(360px, 36vw, 540px) !important;
    height: auto !important;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  /* Grid Layout Mode */
  .earth-farmers__grid {
    display: grid;
    gap: var(--farmer-gap, 34px);
    width: 100%;
    box-sizing: border-box;
  }

  .earth-farmers__grid--cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .earth-farmers__grid--cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .earth-farmers__grid--cols-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .earth-farmers__grid-item {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Card */
  .earth-farmers__card {
    background-color: var(--farmer-card-bg, #EAE060);
    color: var(--farmer-card-text, #003225);
    padding: var(--farmer-card-padding, clamp(24px, 2.8vw, 36px));
    border-radius: var(--farmer-card-radius, 0px);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
  }

  /* Card Shadows */
  .earth-farmers__card--shadow-soft {
    box-shadow: 0 6px 20px rgba(0, 50, 37, 0.08);
  }
  .earth-farmers__card--shadow-elevated {
    box-shadow: 0 12px 32px rgba(0, 50, 37, 0.14);
  }
  .earth-farmers__card--bordered {
    border: 1px solid var(--farmer-card-border-color, #E0D650);
  }

  /* Media Box & Aspect Ratios */
  .earth-farmers__media-box {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--farmer-img-radius, 0px);
    background-color: #c9d23e;
    margin-bottom: clamp(20px, 2.2vw, 28px);
  }

  .earth-farmers__media-box--aspect-0\.95 {
    aspect-ratio: 1 / 0.95;
  }
  .earth-farmers__media-box--aspect-1 {
    aspect-ratio: 1 / 1;
  }
  .earth-farmers__media-box--aspect-1\.25 {
    aspect-ratio: 4 / 5;
  }
  .earth-farmers__media-box--aspect-0\.75 {
    aspect-ratio: 4 / 3;
  }

  .earth-farmers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
  }

  .earth-farmers__card:hover .earth-farmers__img {
    transform: scale(1.04);
  }

  /* Quote */
  .earth-farmers__quote {
    font-size: clamp(16px, 1.4vw, var(--farmer-quote-size, 19px));
    font-weight: 500;
    line-height: 1.45;
    color: var(--farmer-card-text, #003225);
    margin: 0 0 clamp(24px, 2.8vw, 36px);
    padding: 0;
    border: none;
    flex-grow: 1;
    font-style: normal;
  }

  .earth-farmers__quote--italic {
    font-style: italic;
  }

  /* Meta Row */
  .earth-farmers__meta-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    box-sizing: border-box;
  }

  .earth-farmers__author {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .earth-farmers__name {
    font-size: var(--farmer-author-size, 19px);
    font-weight: 800;
    color: var(--farmer-card-text, #003225);
    letter-spacing: -0.01em;
  }

  .earth-farmers__role {
    font-size: clamp(15px, 1.2vw, 18px);
    color: var(--farmer-card-text, #003225);
    opacity: 0.85;
    line-height: 1.2;
  }

  .earth-farmers__badge-wrap {
    flex-shrink: 0;
  }

  .earth-farmers__badge {
    display: inline-block;
    background-color: var(--farmer-badge-bg, #003225);
    color: var(--farmer-badge-text, #F8F9DC);
    font-size: 15px;
    font-weight: 400;
    padding: 6px 16px;
    border-radius: var(--farmer-badge-radius, 20px);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  /* Floating Navigation Arrows */
  .earth-farmers__nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: var(--farmer-nav-size, 48px);
    height: var(--farmer-nav-size, 48px);
    border-radius: 50%;
    background-color: var(--farmer-nav-bg, #F8F9DC);
    border: 1.5px solid var(--farmer-nav-bg, #F8F9DC);
    color: var(--farmer-nav-color, #003225);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 50, 37, 0.16);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.2s ease, background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }

  .earth-farmers__nav-btn--always:not(.swiper-button-disabled):not(.swiper-button-lock) {
    opacity: 1 !important;
    visibility: visible !important;
  }

  .earth-farmers__showcase-wrapper:hover .earth-farmers__nav-btn:not(.swiper-button-disabled):not(.swiper-button-lock) {
    opacity: 1;
    visibility: visible;
  }

  .earth-farmers__nav-btn:hover:not(.swiper-button-disabled):not(.swiper-button-lock) {
    background-color: var(--farmer-nav-hover-bg, #71CC3B);
    border-color: var(--farmer-nav-hover-bg, #71CC3B);
    color: var(--farmer-nav-hover-color, #003225);
    transform: translateY(-50%) scale(1.06);
  }

  .earth-farmers__nav-btn.swiper-button-disabled,
  .earth-farmers__nav-btn.swiper-button-lock {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(-50%) scale(0.7) !important;
  }

  .earth-farmers__nav-btn--prev {
    left: clamp(16px, 2.5vw, 36px);
  }

  .earth-farmers__nav-btn--next {
    right: clamp(16px, 2.5vw, 36px);
  }

  .earth-farmers__icon-arrow {
    width: 15px;
    height: 15px;
    object-fit: contain;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-farmers__icon-arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .earth-farmers__icon-arrow--next {
    transform: rotate(0deg);
  }
  .earth-farmers__nav-btn--next:hover:not(.swiper-button-disabled):not(.swiper-button-lock) .earth-farmers__icon-arrow--next {
    transform: rotate(45deg);
  }
  .earth-farmers__icon-arrow--prev {
    transform: rotate(0deg);
  }
  .earth-farmers__nav-btn--prev:hover:not(.swiper-button-disabled):not(.swiper-button-lock) .earth-farmers__icon-arrow--prev {
    transform: rotate(-45deg);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .earth-farmers--full .earth-farmers__header-container {
      padding-left: 24px;
      padding-right: 24px;
    }
    .earth-farmers--full .earth-farmers__swiper,
    .earth-farmers--full .earth-farmers__grid {
      padding-left: 24px;
      padding-right: 24px;
    }
    .earth-farmers__slide {
      width: clamp(320px, 46vw, 440px) !important;
    }
    .earth-farmers__grid--cols-3,
    .earth-farmers__grid--cols-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .earth-farmers {
      padding-top: var(--farmer-pt-mob, 50px);
      padding-bottom: var(--farmer-pb-mob, 60px);
    }
    .earth-farmers--full .earth-farmers__header-container {
      padding-left: 20px;
      padding-right: 20px;
    }
    .earth-farmers--full .earth-farmers__swiper,
    .earth-farmers--full .earth-farmers__grid {
      padding-left: 20px;
      padding-right: 20px;
    }
    .earth-farmers__showcase-wrapper {
      margin-top: 24px;
      width: 100% !important;
      overflow: visible;
    }
    .earth-farmers__slide {
      width: 85vw !important;
      min-width: 270px !important;
    }
    .earth-farmers__quote {
      font-size: 16px;
    }
    .earth-farmers__meta-row {
      flex-wrap: wrap;
      gap: 8px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initFarmersSwiper() {
      var sectionId = '{{ section.id }}';
      var swiperEl = document.getElementById('earthFarmersSwiper-' + sectionId);
      var prevBtn = document.getElementById('earthFarmersPrev-' + sectionId);
      var nextBtn = document.getElementById('earthFarmersNext-' + sectionId);

      if (!swiperEl) return;

      function createSwiper() {
        if (!window.Swiper) {
          setTimeout(createSwiper, 50);
          return;
        }

        if (swiperEl._farmersSwiperInstance) {
          swiperEl._farmersSwiperInstance.destroy(true, true);
        }

        var swiper = new window.Swiper(swiperEl, {
          slidesPerView: 'auto',
          spaceBetween: 34,
          grabCursor: true,
          speed: 450,
          watchSlidesProgress: true,
          observer: true,
          observeParents: true,
          keyboard: {
            enabled: true,
            onlyInViewport: true
          },
          navigation: {
            prevEl: prevBtn,
            nextEl: nextBtn,
            disabledClass: 'swiper-button-disabled'
          },
          breakpoints: {
            0: {
              spaceBetween: 16
            },
            768: {
              spaceBetween: 24
            },
            1024: {
              spaceBetween: 34
            }
          }
        });

        swiperEl._farmersSwiperInstance = swiper;
      }

      createSwiper();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFarmersSwiper);
    } else {
      initFarmersSwiper();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initFarmersSwiper();
      }
    });

    document.addEventListener('shopify:section:unload', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        var el = document.getElementById('earthFarmersSwiper-{{ section.id }}');
        if (el && el._farmersSwiperInstance) {
          el._farmersSwiperInstance.destroy(true, true);
        }
      }
    });
  })();
</script>

