{% comment %}
  Sustainable Essentials Section - Product Showcase with Tabs, Real Product Data, and Slider / Grid
{% endcomment %}

<section 
  class="earth-sustainable-essentials full-width{% if section.settings.full_width %} earth-sustainable-essentials--full{% endif %} earth-sustainable-essentials--layout-{{ section.settings.layout_mode | default: 'slider' }} earth-sustainable-essentials--cols-{{ section.settings.columns_desktop | default: '3' }} earth-sustainable-essentials--m-cols-{{ section.settings.columns_mobile | default: '1' }} earth-sustainable-essentials--tabs-{{ section.settings.tab_style | default: 'underline' }}" 
  id="earthEssentials-{{ section.id }}"
  style="
    --sus-bg: {{ section.settings.bg_color | default: '#F8F9DC' }};
    --sus-title-color: {{ section.settings.title_color | default: '#003225' }};
    --sus-pt: {{ section.settings.padding_top | default: 80 }}px;
    --sus-pb: {{ section.settings.padding_bottom | default: 96 }}px;
    --sus-m-pt: {{ section.settings.mobile_padding_top | default: 48 }}px;
    --sus-m-pb: {{ section.settings.mobile_padding_bottom | default: 56 }}px;
    --sus-card-radius: {{ section.settings.card_corner_radius | default: 0 }}px;
    --sus-nav-size: {{ section.settings.nav_button_size | default: 48 }}px;
    --sus-nav-bg: {{ section.settings.nav_bg_color | default: '#F8F9DC' }};
    --sus-nav-color: {{ section.settings.nav_icon_color | default: '#003225' }};
    --sus-nav-hover-bg: {{ section.settings.nav_hover_bg_color | default: '#71CC3B' }};
    --sus-nav-hover-color: {{ section.settings.nav_hover_icon_color | default: '#003225' }};
    --sus-tab-active-color: {{ section.settings.tab_active_color | default: '#71CC3B' }};
  "
>
  <div class="earth-sus__container">
    <!-- 1. Top Section Header -->
    {%- assign header_layout = section.settings.header_layout | default: 'centered' -%}
    <div class="earth-sus__header-container">
      {%- assign show_leaf_val = section.settings.show_leaf_icons -%}
      {%- if show_leaf_val == nil -%}{%- assign show_leaf_val = section.settings.show_leaf_icon -%}{%- endif -%}
      {% render 'section-header',
        layout: header_layout,
        title: section.settings.title,
        title_color: section.settings.title_color,
        title_size: section.settings.title_size_desktop,
        title_size_desktop: section.settings.title_size_desktop,
        title_size_mobile: section.settings.title_size_mobile,
        eyebrow: section.settings.eyebrow,
        show_eyebrow_icon: section.settings.show_eyebrow_icon,
        eyebrow_color: section.settings.eyebrow_color,
        eyebrow_size_desktop: section.settings.eyebrow_size_desktop,
        eyebrow_size_mobile: section.settings.eyebrow_size_mobile,
        subtitle: section.settings.subtitle,
        subtitle_color: section.settings.subtitle_color,
        subtitle_size_desktop: section.settings.subtitle_size_desktop,
        subtitle_size_mobile: section.settings.subtitle_size_mobile,
        show_leaf: show_leaf_val,
        leaf_position: section.settings.leaf_position,
        leaf_color: section.settings.leaf_color,
        leaf_size: section.settings.leaf_size,
        leaf_gap: section.settings.leaf_gap,
        btn_text: section.settings.header_btn_text,
        btn_url: section.settings.header_btn_url,
        btn_type: section.settings.header_btn_type,
        btn_theme: section.settings.header_btn_theme,
        btn_color: section.settings.header_btn_color,
        text_color: section.settings.text_color
      %}
    </div>

    {%- if section.settings.show_tabs != false -%}
      <!-- Category Filter Tabs -->
      <div class="earth-sus__tabs-wrapper">
        <nav class="earth-sus__tabs" aria-label="Product categories">
          <button type="button" class="earth-sus__tab is-active" data-tab="all">{{ section.settings.tab_1_label | default: 'All' }}</button>
          <button type="button" class="earth-sus__tab" data-tab="mens">{{ section.settings.tab_2_label | default: "Men's" }}</button>
          <button type="button" class="earth-sus__tab" data-tab="womens">{{ section.settings.tab_3_label | default: "Women's" }}</button>
          <button type="button" class="earth-sus__tab" data-tab="new-arrivals">{{ section.settings.tab_4_label | default: 'New Arrivals' }}</button>
          <button type="button" class="earth-sus__tab" data-tab="sale">{{ section.settings.tab_5_label | default: 'Sale' }}</button>
        </nav>
      </div>
    {%- endif -%}

    <!-- 2. Product Slider / Grid Track Area -->
    <div class="earth-sus__slider-wrapper">
      <div class="earth-sus__track" id="earthSusTrack-{{ section.id }}">
        {%- assign selected_collection = section.settings.collection -%}
        {%- if selected_collection == blank or selected_collection.products_count == 0 -%}
          {%- assign selected_collection = collections['all'] -%}
        {%- endif -%}

        {%- assign prod_list = selected_collection.products -%}
        {%- case section.settings.sort_by -%}
          {%- when 'price_asc' -%}
            {%- assign prod_list = prod_list | sort: 'price' -%}
          {%- when 'price_desc' -%}
            {%- assign prod_list = prod_list | sort: 'price' | reverse -%}
          {%- when 'title_asc' -%}
            {%- assign prod_list = prod_list | sort: 'title' -%}
          {%- when 'title_desc' -%}
            {%- assign prod_list = prod_list | sort: 'title' | reverse -%}
          {%- when 'created_desc' -%}
            {%- assign prod_list = prod_list | sort: 'created_at' | reverse -%}
        {%- endcase -%}

        {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
          {%- for product in prod_list limit: section.settings.products_to_show -%}
            <div class="earth-sus__slide" data-product-type="{{ product.type | handleize }}" data-tags="{{ product.tags | join: ',' | downcase }}">
              {% render 'product-card',
                product: product,
                aspect_ratio: section.settings.card_aspect_ratio,
                show_impact_badge: section.settings.show_impact_badge,
                show_metrics: section.settings.show_metrics_pills,
                show_quick_view: section.settings.show_quick_view,
                show_material: section.settings.show_material,
                show_tags: section.settings.show_tags,
                show_origin: section.settings.show_origin,
                show_discount: section.settings.show_discount
              %}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Curated Products from Design -->
          <!-- Product 1: Regenerative Denim -->
          <div class="earth-sus__slide" data-product-type="mens" data-tags="organic-cotton,recycled-materials">
            {% render 'product-card',
              fallback_image: 'prod-denim.jpg',
              title: 'Regenerative Denim',
              material: '100% Regenerative Organic Cotton',
              impact_score: '97% Impact',
              water_saved: '3,200 L',
              co2_saved: '5.5 kg',
              origin: 'Vietnam',
              badges: 'Organic Cotton, Recycled Materials',
              price: '110',
              aspect_ratio: section.settings.card_aspect_ratio,
              show_impact_badge: section.settings.show_impact_badge,
              show_metrics: section.settings.show_metrics_pills,
              show_quick_view: section.settings.show_quick_view,
              show_material: section.settings.show_material,
              show_tags: section.settings.show_tags,
              show_origin: section.settings.show_origin,
              show_discount: section.settings.show_discount
            %}
          </div>

          <!-- Product 2: Essential Organic Tee -->
          <div class="earth-sus__slide" data-product-type="womens" data-tags="sale,fair-trade,carbon-neutral">
            {% render 'product-card',
              fallback_image: 'prod-tee.jpg',
              title: 'Essential Organic Tee',
              material: '100% Organic Cotton',
              impact_score: '95% Impact',
              water_saved: '2,000 L',
              co2_saved: '3.5 kg',
              origin: 'India',
              discount_text: '52% Off (Price as Marked)',
              badges: 'Fair Trade, Carbon Neutral',
              price: '68',
              compare_price: '128',
              aspect_ratio: section.settings.card_aspect_ratio,
              show_impact_badge: section.settings.show_impact_badge,
              show_metrics: section.settings.show_metrics_pills,
              show_quick_view: section.settings.show_quick_view,
              show_material: section.settings.show_material,
              show_tags: section.settings.show_tags,
              show_origin: section.settings.show_origin,
              show_discount: section.settings.show_discount
            %}
          </div>

          <!-- Product 3: Classic Oxford Shirt -->
          <div class="earth-sus__slide" data-product-type="mens" data-tags="new-arrivals,plastic-free,organic-cotton">
            {% render 'product-card',
              fallback_image: 'prod-oxford.jpg',
              title: 'Classic Oxford Shirt',
              material: '100% Organic Cotton',
              impact_score: '93% Impact',
              water_saved: '2,100 L',
              co2_saved: '3.8 kg',
              origin: 'India',
              badges: 'Plastic-Free, Organic Cotton',
              price: '68',
              aspect_ratio: section.settings.card_aspect_ratio,
              show_impact_badge: section.settings.show_impact_badge,
              show_metrics: section.settings.show_metrics_pills,
              show_quick_view: section.settings.show_quick_view,
              show_material: section.settings.show_material,
              show_tags: section.settings.show_tags,
              show_origin: section.settings.show_origin,
              show_discount: section.settings.show_discount
            %}
          </div>

          <!-- Product 4: Sustainable Linen Trouser -->
          <div class="earth-sus__slide" data-product-type="womens" data-tags="new-arrivals,organic-cotton,zero-waste">
            {% render 'product-card',
              fallback_image: 'prod-denim.jpg',
              title: 'Sustainable Linen Trouser',
              material: '100% Organic Linen & Hemp',
              impact_score: '96% Impact',
              water_saved: '2,800 L',
              co2_saved: '4.2 kg',
              origin: 'Vietnam',
              badges: 'Organic Cotton, Zero Waste',
              price: '120',
              aspect_ratio: section.settings.card_aspect_ratio,
              show_impact_badge: section.settings.show_impact_badge,
              show_metrics: section.settings.show_metrics_pills,
              show_quick_view: section.settings.show_quick_view,
              show_material: section.settings.show_material,
              show_tags: section.settings.show_tags,
              show_origin: section.settings.show_origin,
              show_discount: section.settings.show_discount
            %}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.layout_mode != 'grid' and section.settings.show_nav_buttons != false -%}
        <!-- Left Floating Navigation Arrow (Disabled initially at start) -->
        <button 
          type="button" 
          class="earth-sus__nav-btn earth-sus__nav-btn--prev is-disabled{% if section.settings.nav_button_visibility == 'always' %} earth-sus__nav-btn--always{% endif %}" 
          id="earthSusPrev-{{ section.id }}" 
          aria-label="Previous Products"
        >
          <span class="earth-sus__icon-arrow earth-sus__icon-arrow--prev" aria-hidden="true">{{ 'icon-prev-left.svg' | inline_asset_content }}</span>
        </button>

        <!-- Right Floating Navigation Arrow -->
        <button 
          type="button" 
          class="earth-sus__nav-btn earth-sus__nav-btn--next{% if section.settings.nav_button_visibility == 'always' %} earth-sus__nav-btn--always{% endif %}" 
          id="earthSusNext-{{ section.id }}" 
          aria-label="Next Products"
        >
          <span class="earth-sus__icon-arrow earth-sus__icon-arrow--next" aria-hidden="true">{{ 'icon-next-right.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}
    </div>

    <!-- 3. Optional Bottom Call To Action Button -->
    {%- if section.settings.show_bottom_cta and section.settings.bottom_cta_text != blank -%}
      <div class="earth-sus__bottom-cta">
        {%- assign cta_url = section.settings.bottom_cta_link | default: selected_collection.url | default: routes.all_products_collection_url -%}
        {%- assign cta_style = section.settings.bottom_cta_style | default: 'arrow' -%}
        {%- if cta_style == 'arrow' -%}
          {% render 'btn-arrow',
            text: section.settings.bottom_cta_text,
            url: cta_url,
            theme: 'dark'
          %}
        {%- else -%}
          {% render 'btn-action',
            text: section.settings.bottom_cta_text,
            url: cta_url,
            variant: cta_style
          %}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ==========================================================================
     Sustainable Essentials Section & Product Card Styles
     ========================================================================== */
  .earth-sustainable-essentials {
    grid-column: 1 / -1 !important;
    background-color: var(--sus-bg, #F8F9DC);
    padding: var(--sus-pt, 80px) 0 var(--sus-pb, 96px);
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }
  .earth-sus__container {
    width: 100%;
    max-width: var(--page-width, 1320px);
    margin: 0 auto;
    box-sizing: border-box;
  }
  .earth-sustainable-essentials--full .earth-sus__container {
    max-width: 100%;
  }

  /* 1. Header */
  .earth-sus__header-container {
    width: 100%;
    padding: 0 34px;
    box-sizing: border-box;
    margin-bottom: clamp(24px, 3vw, 36px);
  }

 /* Category Filter Tabs Wrapper & Tabs */
.earth-sus__tabs-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  padding: 0 34px;
  margin-bottom: clamp(36px, 4.5vw, 52px);
}

.earth-sus__tabs {
  display: inline-flex;
  align-items: stretch;
  justify-content: center;
  padding: 0;
  margin: 0;
  max-width: 100%;
  box-sizing: border-box;
  position: relative;
}

.earth-sus__tab {
  background: none;
  border: none;
  border-bottom: 1px solid var(--color-black, #003225);
  font-size: clamp(15px, 1.4vw, 18px);
  font-weight: 700;
  color: var(--color-black, #003225);
  padding: 10px clamp(16px, 2.5vw, 32px) 14px;
  cursor: pointer;
  position: relative;
  white-space: nowrap;
  text-align: center;
  box-sizing: border-box;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.earth-sus__tab.is-active {
  font-weight: 700;
  color: var(--sus-tab-active-color, #71CC3B);
  border-bottom: 1px solid var(--sus-tab-active-color, #71CC3B);
}

.earth-sus__tab.is-active::after {
  display: none !important;
}

/* Tabs Styles */
.earth-sustainable-essentials--tabs-pill .earth-sus__tabs {
  background-color: rgba(0, 50, 37, 0.06);
  padding: 6px;
  border-radius: 30px;
  gap: 6px;
}
.earth-sustainable-essentials--tabs-pill .earth-sus__tab {
  border-bottom: none !important;
  border-radius: 24px;
  padding: 8px 22px !important;
}
.earth-sustainable-essentials--tabs-pill .earth-sus__tab.is-active {
  background-color: var(--sus-tab-active-color, #71CC3B);
  color: #003225 !important;
}

.earth-sustainable-essentials--tabs-minimal .earth-sus__tab {
  border-bottom: none !important;
  opacity: 0.65;
}
.earth-sustainable-essentials--tabs-minimal .earth-sus__tab.is-active {
  opacity: 1;
  color: var(--sus-tab-active-color, #71CC3B) !important;
}

  /* 2. Slider Track / Grid */
  .earth-sus__slider-wrapper {
    position: relative;
    width: 100%;
    margin-top: 0;
  }
  .earth-sus__track {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 34px;
    scroll-padding-right: 34px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 20px;
    padding: 0 34px 20px 34px;
    box-sizing: border-box;
  }
  .earth-sus__track::-webkit-scrollbar {
    display: none;
  }

  /* Slider Column Widths */
  .earth-sus__slide {
    flex: 0 0 31.5%;
    min-width: 300px;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    box-sizing: border-box;
  }
  .earth-sustainable-essentials--cols-2 .earth-sus__slide {
    flex: 0 0 calc(50% - 10px);
    max-width: none;
  }
  .earth-sustainable-essentials--cols-3 .earth-sus__slide {
    flex: 0 0 31.5%;
    min-width: 300px;
    max-width: 440px;
  }
  .earth-sustainable-essentials--cols-4 .earth-sus__slide {
    flex: 0 0 calc(25% - 15px);
    min-width: 250px;
    max-width: 360px;
  }

  /* Grid Mode */
  .earth-sustainable-essentials--layout-grid .earth-sus__track {
    display: grid !important;
    overflow-x: visible !important;
    scroll-snap-type: none !important;
    gap: 24px;
    padding: 0 34px !important;
  }
  .earth-sustainable-essentials--layout-grid.earth-sustainable-essentials--cols-2 .earth-sus__track {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
  .earth-sustainable-essentials--layout-grid.earth-sustainable-essentials--cols-3 .earth-sus__track {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }
  .earth-sustainable-essentials--layout-grid.earth-sustainable-essentials--cols-4 .earth-sus__track {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  }
  .earth-sustainable-essentials--layout-grid .earth-sus__slide {
    flex: none !important;
    min-width: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
  }
  .earth-sustainable-essentials--layout-grid .earth-sus__nav-btn {
    display: none !important;
  }

  /* Floating Navigation Arrows */
  .earth-sus__nav-btn {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 10;
    width: var(--sus-nav-size, 48px);
    height: var(--sus-nav-size, 48px);
    border-radius: 50%;
    background-color: var(--sus-nav-bg, #F8F9DC);
    border: 1.5px solid var(--sus-nav-bg, #F8F9DC);
    color: var(--sus-nav-color, #003225);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 50, 37, 0.16);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.28s ease, visibility 0.28s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  .earth-sus__slider-wrapper:hover .earth-sus__nav-btn:not(.is-disabled) {
    opacity: 1;
    visibility: visible;
  }
  .earth-sus__nav-btn--always:not(.is-disabled) {
    opacity: 1;
    visibility: visible;
  }
  .earth-sus__nav-btn.is-disabled {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transform: translateY(-50%) scale(0.7) !important;
  }
  .earth-sus__nav-btn:hover:not(.is-disabled) {
    background-color: var(--sus-nav-hover-bg, #71CC3B);
    border-color: var(--sus-nav-hover-bg, #71CC3B);
    color: var(--sus-nav-hover-color, #003225);
    transform: translateY(-50%) scale(1.08);
  }
  .earth-sus__nav-btn--prev {
    left: clamp(16px, 2.5vw, 36px);
  }
  .earth-sus__nav-btn--next {
    right: clamp(16px, 2.5vw, 36px);
  }

  /* Smooth Icon Rotation on Hover */
  .earth-sus__icon-arrow {
    width: 15px;
    height: 15px;
    object-fit: contain;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-sus__icon-arrow svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .earth-sus__icon-arrow--next {
    transform: rotate(0deg);
  }
  .earth-sus__nav-btn--next:hover .earth-sus__icon-arrow--next {
    transform: rotate(45deg);
  }
  .earth-sus__icon-arrow--prev {
    transform: rotate(0deg);
  }
  .earth-sus__nav-btn--prev:hover .earth-sus__icon-arrow--prev {
    transform: rotate(-45deg);
  }

  /* Optional Bottom CTA */
  .earth-sus__bottom-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: clamp(36px, 4.5vw, 60px);
    width: 100%;
  }

  /* ==========================================================================
     Product Card Component Styles
     ========================================================================== */
  .earth-prod-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  /* Media Area */
  .earth-prod-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #e5ecd2;
    margin-bottom: 16px;
    flex-shrink: 0;
    border-radius: var(--sus-card-radius, 0px);
  }
  .earth-prod-card__media--aspect-portrait {
    aspect-ratio: 3 / 4 !important;
  }
  .earth-prod-card__media--aspect-square {
    aspect-ratio: 1 / 1 !important;
  }
  .earth-prod-card__media--aspect-tall {
    aspect-ratio: 2 / 3 !important;
  }

  .earth-prod-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .earth-prod-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-prod-card__media:hover .earth-prod-card__img {
    transform: scale(1.04);
  }

  /* Dark translucent overlay when hovering image */
  .earth-prod-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 30, 20, 0.28);
    opacity: 0;
    visibility: hidden;
    z-index: 2;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .earth-prod-card__media:hover .earth-prod-card__overlay {
    opacity: 1;
    visibility: visible;
  }

  /* Top Left Impact Badge */
  .earth-prod-card__impact-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 3;
    background-color: var(--color-black, #003225);
    color: var(--color-white, #F8F9DC);
    font-size: 15px;
    font-weight: 400;
    padding: 6px 12px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .earth-prod-card__badge-icon {
    width: 13px;
    height: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    object-fit: contain;
  }
  .earth-prod-card__badge-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Bottom Left Metrics (Water & CO2) */
  .earth-prod-card__metrics {
    position: absolute;
    bottom: 14px;
    left: 14px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .earth-prod-card__metric-pill {
    background-color: var(--color-accent, #EAE060);
    color: var(--color-black, #003225);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .earth-prod-card__metric-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    object-fit: contain;
    filter: brightness(0);
  }
