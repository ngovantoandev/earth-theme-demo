<script>
  (function() {
    function initSusEssentials() {
      var sectionEl = document.getElementById('earthEssentials-{{ section.id }}');
      if (!sectionEl) return;
      var track = document.getElementById('earthSusTrack-{{ section.id }}');
      var prevBtn = document.getElementById('earthSusPrev-{{ section.id }}');
      var nextBtn = document.getElementById('earthSusNext-{{ section.id }}');

      if (!track) return;

      function updateNavButtons() {
        if (!prevBtn && !nextBtn) return;
        var maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
        var currentScroll = track.scrollLeft;

        // If all items fit without scrolling
        if (maxScroll <= 5) {
          if (prevBtn) prevBtn.classList.add('is-disabled');
          if (nextBtn) nextBtn.classList.add('is-disabled');
          return;
        }

        // Prev button: hide when at the start
        if (prevBtn) {
          if (currentScroll <= 5) {
            prevBtn.classList.add('is-disabled');
          } else {
            prevBtn.classList.remove('is-disabled');
          }
        }

        // Next button: hide when reached the end
        if (nextBtn) {
          if (currentScroll >= maxScroll - 8) {
            nextBtn.classList.add('is-disabled');
          } else {
            nextBtn.classList.remove('is-disabled');
          }
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var slide = track.querySelector('.earth-sus__slide');
          var step = slide ? slide.offsetWidth + 20 : 350;
          track.scrollBy({ left: -step, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var slide = track.querySelector('.earth-sus__slide');
          var step = slide ? slide.offsetWidth + 20 : 350;
          track.scrollBy({ left: step, behavior: 'smooth' });
        });
      }

      track.addEventListener('scroll', updateNavButtons, { passive: true });
      window.addEventListener('resize', updateNavButtons);

      // Tab switcher filter simulation / interaction
      var tabs = sectionEl.querySelectorAll('.earth-sus__tab');
      var tabsWrapper = sectionEl.querySelector('.earth-sus__tabs-wrapper');
      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          tabs.forEach(function(t) { t.classList.remove('is-active'); });
          tab.classList.add('is-active');
          if (tabsWrapper && window.innerWidth <= 768) {
            tabsWrapper.scrollTo({
              left: Math.max(0, tab.offsetLeft - 20),
              behavior: 'smooth'
            });
          }
          // Reset slider track to start on tab change
          track.scrollTo({ left: 0, behavior: 'smooth' });
          setTimeout(updateNavButtons, 200);
        });
      });

      // Initialize state on load
      setTimeout(updateNavButtons, 100);
      window.addEventListener('load', updateNavButtons);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSusEssentials);
    } else {
      initSusEssentials();
    }

    // Support Shopify Theme Editor dynamic re-render
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initSusEssentials();
      }
    });
  })();
</script>

