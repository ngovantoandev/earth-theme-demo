{% comment %}
  Sustainable Essentials Section - Product Showcase with Tabs, Real Product Data, and Slider
{% endcomment %}

<section class="earth-sustainable-essentials full-width" id="earthEssentials-{{ section.id }}">
  <div class="earth-sus__container">
    <!-- 1. Top Section Header -->
    <div class="earth-sus__header">
      <h2 class="earth-sus__main-title">
        <img src="{{ 'leaf-2.svg' | asset_url }}" width="36" height="36" alt="" class="earth-sus__leaf earth-sus__leaf--left" loading="lazy">
        <span>{{ section.settings.title | default: 'Sustainable Essentials' }}</span>
        <img src="{{ 'leaf-2.svg' | asset_url }}" width="36" height="36" alt="" class="earth-sus__leaf earth-sus__leaf--right" loading="lazy">
      </h2>
      <p class="earth-sus__subtitle">
        {{ section.settings.subtitle | default: 'Every piece designed with purpose – discover the full impact story behind each garment' }}
      </p>

      <!-- Category Filter Tabs -->
      <div class="earth-sus__tabs-wrapper">
        <nav class="earth-sus__tabs" aria-label="Product categories">
          <button type="button" class="earth-sus__tab is-active" data-tab="all">All</button>
          <button type="button" class="earth-sus__tab" data-tab="mens">Men's</button>
          <button type="button" class="earth-sus__tab" data-tab="womens">Women's</button>
          <button type="button" class="earth-sus__tab" data-tab="new-arrivals">New Arrivals</button>
          <button type="button" class="earth-sus__tab" data-tab="sale">Sale</button>
        </nav>
      </div>
    </div>

    <!-- 2. Product Slider Track Area -->
    <div class="earth-sus__slider-wrapper">
      <div class="earth-sus__track" id="earthSusTrack-{{ section.id }}">
        {%- assign selected_collection = section.settings.collection -%}
        {%- if selected_collection == blank or selected_collection.products_count == 0 -%}
          {%- assign selected_collection = collections['all'] -%}
        {%- endif -%}

        {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
          {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
            <div class="earth-sus__slide" data-product-type="{{ product.type | handleize }}" data-tags="{{ product.tags | join: ',' | downcase }}">
              {% render 'product-card', product: product %}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Curated Products from Design -->
          <!-- Product 1: Regenerative Denim -->
          <div class="earth-sus__slide">
            {% render 'product-card',
              fallback_image: 'prod-denim.jpg',
              title: 'Regenerative Denim',
              material: '100% Regenerative Organic Cotton',
              impact_score: '97% Impact',
              water_saved: '3,200 L',
              co2_saved: '5.5 kg',
              origin: 'Vietnam',
              badges: 'Organic Cotton, Recycled Materials',
              price: '110'
            %}
          </div>

          <!-- Product 2: Essential Organic Tee -->
          <div class="earth-sus__slide">
            {% render 'product-card',
              fallback_image: 'prod-tee.jpg',
              title: 'Essential Organic Tee',
              material: '100% Organic Cotton',
              impact_score: '95% Impact',
              water_saved: '2,000 L',
              co2_saved: '3.5 kg',
              origin: 'India',
              discount_text: '52% Off (Price as Marked)',
              badges: 'Fair Trade, Carbon Neutral',
              price: '68',
              compare_price: '128'
            %}
          </div>

          <!-- Product 3: Classic Oxford Shirt -->
          <div class="earth-sus__slide">
            {% render 'product-card',
              fallback_image: 'prod-oxford.jpg',
              title: 'Classic Oxford Shirt',
              material: '100% Organic Cotton',
              impact_score: '93% Impact',
              water_saved: '2,100 L',
              co2_saved: '3.8 kg',
              origin: 'India',
              badges: 'Plastic-Free, Organic Cotton',
              price: '68'
            %}
          </div>

          <!-- Product 4: Sustainable Linen Trouser -->
          <div class="earth-sus__slide">
            {% render 'product-card',
              fallback_image: 'prod-denim.jpg',
              title: 'Sustainable Linen Trouser',
              material: '100% Organic Linen & Hemp',
              impact_score: '96% Impact',
              water_saved: '2,800 L',
              co2_saved: '4.2 kg',
              origin: 'Vietnam',
              badges: 'Organic Cotton, Zero Waste',
              price: '120'
            %}
          </div>
        {%- endif -%}
      </div>

      <!-- Left Floating Navigation Arrow (Appears on hover) -->
      <button type="button" class="earth-sus__nav-btn earth-sus__nav-btn--prev" id="earthSusPrev-{{ section.id }}" aria-label="Previous Products">
        <img src="{{ 'prev-left.svg' | asset_url }}" width="15" height="15" alt="" class="earth-sus__icon-arrow earth-sus__icon-arrow--prev">
      </button>

      <!-- Right Floating Navigation Arrow (Appears on hover) -->
      <button type="button" class="earth-sus__nav-btn earth-sus__nav-btn--next" id="earthSusNext-{{ section.id }}" aria-label="Next Products">
        <img src="{{ 'next-right.svg' | asset_url }}" width="15" height="15" alt="" class="earth-sus__icon-arrow earth-sus__icon-arrow--next">
      </button>
    </div>
  </div>
</section>

{% stylesheet %}
  /* ==========================================================================
     Sustainable Essentials Section & Product Card Styles
     ========================================================================== */
  .earth-sustainable-essentials {
    background-color: var(--color-white, #F8F9DC);
    padding: clamp(56px, 7vw, 96px) 0 clamp(64px, 8vw, 110px);
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }
  .earth-sus__container {
    width: 100%;
    margin: 0 auto;
  }

  /* 1. Header */
  .earth-sus__header {
    text-align: center;
    padding: 0 24px;
    margin-bottom: clamp(36px, 5vw, 52px);
  }
  .earth-sus__main-title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    color: var(--color-black, #003225);
    letter-spacing: -0.03em;
    margin: 0 0 14px 0;
    line-height: 1.15;
  }
  .earth-sus__leaf {
    width: 36px;
    height: 36px;
    object-fit: contain;
    display: inline-block;
  }
  .earth-sus__leaf--right {
    transform: scaleX(-1);
  }
  .earth-sus__subtitle {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--color-black, #003225);
    max-width: 620px;
    margin: 0 auto 32px;
    line-height: 1.45;
  }

 /* Category Filter Tabs Wrapper & Tabs */
.earth-sus__tabs-wrapper {
  width: 100%;
  display: flex;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.earth-sus__tabs {
  display: inline-flex;
  align-items: stretch;
  justify-content: center;
  padding: 0;
  margin: 0;
  max-width: 100%;
  box-sizing: border-box;
  position: relative;
}

.earth-sus__tab {
  background: none;
  border: none;
  border-bottom: 1px solid var(--color-black, #003225);
  font-size: clamp(15px, 1.4vw, 18px);
  font-weight: 700;
  color: var(--color-black, #003225);
  padding: 10px clamp(16px, 2.5vw, 32px) 14px;
  cursor: pointer;
  position: relative;
  transition: color 0.2s ease, border-color 0.2s ease;
  white-space: nowrap;
  text-align: center;
  box-sizing: border-box;
}

.earth-sus__tab.is-active {
  font-weight: 700;
  color: var(--color-secondary, #71CC3B);
  border-bottom: 1px solid var(--color-secondary, #71CC3B);
}

.earth-sus__tab.is-active::after {
  display: none !important;
}

  /* 2. Slider Track */
  .earth-sus__slider-wrapper {
    margin-left: 34px;
    position: relative;
    width: calc(100% - 34px);
  }
  .earth-sus__track {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 20px;
    padding: 0 34px 20px 0;
    box-sizing: border-box;
  }
  .earth-sus__track::-webkit-scrollbar {
    display: none;
  }

  .earth-sus__slide {
    flex: 0 0 31.5%;
    min-width: 320px;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    box-sizing: border-box;
  }

  /* Floating Navigation Arrows (Visible on hover of slider wrapper) */
  .earth-sus__nav-btn {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 10;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-white, #F8F9DC);
    border: 1.5px solid var(--color-white, #F8F9DC);
    color: var(--color-black, #003225);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 50, 37, 0.16);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.2s ease, background-color 0.25s ease, border-color 0.25s ease;
  }
  .earth-sus__slider-wrapper:hover .earth-sus__nav-btn {
    opacity: 1;
    visibility: visible;
  }
  .earth-sus__nav-btn:hover {
    background-color: var(--color-secondary, #71CC3B);
    border-color: var(--color-secondary, #71CC3B);
    transform: translateY(-50%) scale(1.06);
  }
  .earth-sus__nav-btn--prev {
    left: clamp(16px, 2.5vw, 36px);
  }
  .earth-sus__nav-btn--next {
    right: clamp(16px, 2.5vw, 36px);
  }

  /* Smooth Icon Rotation on Hover */
  .earth-sus__icon-arrow {
    width: 15px;
    height: 15px;
    object-fit: contain;
    display: block;
    pointer-events: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-sus__icon-arrow--next {
    transform: rotate(0deg);
  }
  .earth-sus__nav-btn--next:hover .earth-sus__icon-arrow--next {
    transform: rotate(45deg);
  }
  .earth-sus__icon-arrow--prev {
    transform: rotate(0deg);
  }
  .earth-sus__nav-btn--prev:hover .earth-sus__icon-arrow--prev {
    transform: rotate(-45deg);
  }

  /* ==========================================================================
     Product Card Component Styles
     ========================================================================== */
  .earth-prod-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  /* Media Area */
  .earth-prod-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #e5ecd2;
    margin-bottom: 16px;
    flex-shrink: 0;
  }
  .earth-prod-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .earth-prod-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-prod-card__media:hover .earth-prod-card__img {
    transform: scale(1.05);
  }

  /* Dark translucent overlay when hovering image */
  .earth-prod-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 30, 20, 0.28);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 2;
    pointer-events: none;
  }
  .earth-prod-card__media:hover .earth-prod-card__overlay {
    opacity: 1;
    visibility: visible;
  }

  /* Top Left Impact Badge */
  .earth-prod-card__impact-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 3;
    background-color: var(--color-black, #003225);
    color: var(--color-white, #F8F9DC);
    font-size: 15px;
    font-weight: 400;
    padding: 6px 12px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .earth-prod-card__badge-icon {
    width: 13px;
    height: 14px;
    object-fit: contain;
  }

  /* Bottom Left Metrics (Water & CO2) */
  .earth-prod-card__metrics {
    position: absolute;
    bottom: 14px;
    left: 14px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .earth-prod-card__metric-pill {
    background-color: var(--color-accent, #EAE060);
    color: var(--color-black, #003225);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .earth-prod-card__metric-icon {
    object-fit: contain;
    filter: brightness(0);
  }

  /* Center Hover Quick View Button */
  .earth-prod-card__quick-view {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    z-index: 4;
    background-color: var(--color-secondary, #71CC3B);
    color: var(--color-black, #003225);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 11px 20px;
    border-radius: 2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    box-shadow: 0 4px 14px rgba(0, 50, 37, 0.2);
  }
  .earth-prod-card__media:hover .earth-prod-card__quick-view {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  /* Product Details */
  .earth-prod-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 6px;
  }
  .earth-prod-card__title {
    margin: 0;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .earth-prod-card__title a {
    color: var(--color-black, #003225);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .earth-prod-card__title a:hover {
    opacity: 0.75;
  }
  .earth-prod-card__material {
    font-size: 16px;
    font-weight: 400;
    color: var(--color-black, #003225);
    margin: 0 0 4px 0;
    line-height: 1.35;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* Tags */
  .earth-prod-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 6px;
  }
  .earth-prod-card__tag-pill {
    background-color: var(--color-accent, #EAE060);
    border: 1px solid var(--color-primary, #224E09);
    color: var(--color-black, #003225);
    font-size: 15px;
    font-weight: 400;
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.2;
  }

  /* Origin & Discount Meta Row */
  .earth-prod-card__meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 15px;
    color: var(--color-primary, #224E09);
    margin-bottom: 12px;
  }
  .earth-prod-card__origin,
  .earth-prod-card__discount {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .earth-prod-card__meta-icon {
    object-fit: contain;
  }

  /* Action Unit (Joined Price & Add Button on SAME Row) */
  .earth-prod-card__action-group {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    margin-top: auto;
    overflow: hidden;
  }
  .earth-prod-card__price-box {
    background-color: var(--color-black, #003225);
    color: var(--color-white, #F8F9DC);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 800;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
  }
  .earth-prod-card__compare-price {
    font-size: 14px;
    font-weight: 700;
    text-decoration: line-through;
    opacity: 0.75;
  }
  .earth-prod-card__form {
    flex: 1;
    display: flex;
    margin: 0;
    min-width: 0;
  }
  .earth-prod-card__add-btn {
    width: 100%;
    background-color: var(--color-accent, #EAE060);
    color: var(--color-black, #003225);
    border: none;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    white-space: nowrap;
    text-align: center;
    box-sizing: border-box;
  }
  .earth-prod-card__add-btn:hover {
    background-color: #dfd452;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .earth-sus__slide {
      flex: 0 0 45%;
    }
  }

  @media (max-width: 768px) {
    .earth-sustainable-essentials {
      padding: 44px 0 60px;
    }
    .earth-sus__leaf {
      display: none !important;
    }
    .earth-sus__main-title {
      font-size: 26px;
    }
    .earth-sus__subtitle {
      font-size: 15px;
      margin-bottom: 24px;
    }
    .earth-sus__tabs-wrapper {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      margin-bottom: 28px;
    }
    .earth-sus__tabs-wrapper::-webkit-scrollbar {
      display: none;
    }
    .earth-sus__tabs {
      display: flex;
      min-width: 100%;
      width: max-content;
      justify-content: flex-start;
      padding: 0;
      margin: 0;
      gap: 0;
      position: relative;
    }
    .earth-sus__tabs::after {
      content: '';
      flex: 1;
      min-width: 40px;
      border-bottom: 1px solid var(--color-black, #003225);
    }
    .earth-sus__tab {
      padding: 8px clamp(14px, 3.8vw, 22px) 12px;
      flex-shrink: 0;
      position: relative;
      margin: 0;
      box-sizing: border-box;
      text-align: center;
      border: none;
      border-bottom: 1px solid var(--color-black, #003225);
      background: transparent;
    }
    .earth-sus__tab.is-active {
      color: var(--color-secondary, #71CC3B) !important;
      border-bottom: 1px solid var(--color-secondary, #71CC3B) !important;
    }
    .earth-sus__tab.is-active::after {
      display: none !important;
    }
    .earth-sus__slider-wrapper {
      margin: 0 !important;
      width: 100% !important;
      overflow: visible;
    }
    .earth-sus__slide {
      flex: 0 0 78%;
      min-width: 260px;
    }
    .earth-sus__nav-btn {
      display: none;
    }
    .earth-prod-card__quick-view {
      font-size: 12px;
      padding: 9px 16px;
      gap: 6px;
      white-space: nowrap;
    }
    .earth-sus__track {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      scroll-padding-left: 20px !important;
      scroll-padding-right: 20px !important;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0 20px 16px !important;
      margin: 0 !important;
      gap: 16px !important;
    }
    .earth-sus__slide {
      flex: 0 0 78% !important;
      min-width: 260px !important;
      scroll-snap-align: start !important;
      margin: 0 !important;
    }
    .earth-sus__track::after {
      content: '' !important;
      flex: 0 0 1px !important;
      min-width: 1px !important;
      height: 1px;
      display: block !important;
      pointer-events: none;
    }
    /* Mobile: Stack Price Box and Add to Cart Button into 2 rows */
    .earth-prod-card__action-group {
      flex-direction: column !important;
      width: 100%;
    }
    .earth-prod-card__price-box {
      width: 100% !important;
      justify-content: center !important;
      text-align: center !important;
      padding: 10px 14px;
    }
    .earth-prod-card__form {
      width: 100% !important;
      flex: none !important;
    }
    .earth-prod-card__add-btn {
      width: 100% !important;
      padding: 11px 16px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initSusEssentials() {
      var track = document.getElementById('earthSusTrack-{{ section.id }}');
      var prevBtn = document.getElementById('earthSusPrev-{{ section.id }}');
      var nextBtn = document.getElementById('earthSusNext-{{ section.id }}');

      if (!track) return;

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          var slide = track.querySelector('.earth-sus__slide');
          var step = slide ? slide.offsetWidth + 20 : 350;
          track.scrollBy({ left: -step, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          var slide = track.querySelector('.earth-sus__slide');
          var step = slide ? slide.offsetWidth + 20 : 350;
          track.scrollBy({ left: step, behavior: 'smooth' });
        });
      }

      // Tab switcher filter simulation / interaction
      var tabs = document.querySelectorAll('#earthEssentials-{{ section.id }} .earth-sus__tab');
      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          tabs.forEach(function(t) { t.classList.remove('is-active'); });
          tab.classList.add('is-active');
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSusEssentials);
    } else {
      initSusEssentials();
    }
  })();
</script>

{% schema %}
{
  "name": "Sustainable Essentials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Sustainable Essentials"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Every piece designed with purpose – discover the full impact story behind each garment"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Product Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Products to Show"
    }
  ],
  "presets": [
    {
      "name": "Sustainable Essentials"
    }
  ]
}
{% endschema %}
