{% comment %}
  Featured Eco Essentials - Category Showcase
  Matching exact design with 2x2 cards, badges, numbers, titles, and reusable arrow buttons
{% endcomment %}

<section
  class="earth-featured-essentials full-width{% if section.settings.full_width %} earth-featured-essentials--full{% endif %} earth-featured-essentials--{{ section.settings.layout_style | default: 'asymmetric' }} earth-featured-essentials--hover-{{ section.settings.image_hover_effect | default: 'zoom' }}"
  id="earthFeaturedEssentials-{{ section.id }}"
  style="
    --section-bg: {{ section.settings.bg_color | default: '#EBF7BE' }};
    --section-text: {{ section.settings.text_color | default: '#003225' }};
    --section-pt: {{ section.settings.padding_top | default: 80 }}px;
    --section-pb: {{ section.settings.padding_bottom | default: 96 }}px;
    --section-m-pt: {{ section.settings.mobile_padding_top | default: 48 }}px;
    --section-m-pb: {{ section.settings.mobile_padding_bottom | default: 56 }}px;
    --card-radius: {{ section.settings.card_border_radius | default: 0 }}px;
    --card-height: {{ section.settings.card_height | default: 530 }}px;
    --card-overlay-color: {{ section.settings.card_overlay_color | default: '#002017' }};
    --card-overlay-opacity: {{ section.settings.card_overlay_opacity | default: 88 | divided_by: 100.0 }};
  "
>
  <div class="earth-essentials__container">
    <!-- 1. Section Header -->
    {%- assign header_layout = section.settings.header_layout | default: 'split_btn' -%}
    {%- assign header_btn_text = '' -%}
    {%- if section.settings.show_header_button and section.settings.header_button_text != blank and section.settings.header_button_type != 'none' -%}
      {%- assign header_btn_text = section.settings.header_button_text -%}
    {%- endif -%}
    {%- assign header_btn_url = section.settings.header_button_link | default: routes.all_products_collection_url -%}
    <div class="earth-essentials__header-container">
      {% render 'section-header',
        layout: header_layout,
        title: section.settings.title,
        eyebrow: section.settings.eyebrow,
        show_eyebrow_icon: section.settings.show_eyebrow_icon,
        eyebrow_color: section.settings.eyebrow_color,
        eyebrow_size_desktop: section.settings.eyebrow_size_desktop,
        eyebrow_size_mobile: section.settings.eyebrow_size_mobile,
        subtitle: section.settings.subtitle,
        subtitle_color: section.settings.subtitle_color,
        subtitle_size_desktop: section.settings.subtitle_size_desktop,
        subtitle_size_mobile: section.settings.subtitle_size_mobile,
        show_leaf: section.settings.show_leaf_icon,
        leaf_position: section.settings.leaf_position,
        leaf_color: section.settings.leaf_color,
        leaf_size: section.settings.leaf_size,
        leaf_gap: section.settings.leaf_gap,
        btn_text: header_btn_text,
        btn_url: header_btn_url,
        btn_type: section.settings.header_button_type,
        btn_theme: section.settings.header_arrow_theme,
        btn_color: section.settings.header_arrow_text_color,
        title_color: section.settings.title_color,
        text_color: section.settings.text_color
      %}
    </div>

    <!-- 2. Cards Grid -->
    <div class="earth-essentials__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign card_collection = block.settings.collection -%}
          {%- assign card_title = block.settings.title | default: card_collection.title | default: 'Eco Collection' -%}
          {%- assign card_subtitle = block.settings.subtitle | default: 'Sustainable essentials' -%}
          {%- assign card_url = block.settings.button_link | default: card_collection.url | default: routes.all_products_collection_url -%}
          {%- assign card_btn_text = block.settings.button_text | default: 'SHOP COLLECTION' -%}
          {%- assign card_num = forloop.index | prepend: '0' | slice: -2, 2 -%}

          <div class="earth-essentials__card" {{ block.shopify_attributes }}>
            <!-- Card Image -->
            <div class="earth-essentials__image-wrapper">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'earth-essentials__image', loading: 'lazy', alt: card_title }}
              {%- elsif card_collection.featured_image != blank -%}
                {{ card_collection.featured_image | image_url: width: 1000 | image_tag: class: 'earth-essentials__image', loading: 'lazy', alt: card_title }}
              {%- else -%}
                {%- assign fallback_img = forloop.index | modulo: 4 -%}
                {%- if fallback_img == 1 -%}
                  <img src="{{ 'cat-organic.jpg' | asset_url }}" width="800" height="600" alt="{{ card_title }}" class="earth-essentials__image" loading="lazy">
                {%- elsif fallback_img == 2 -%}
                  <img src="{{ 'cat-ocean.jpg' | asset_url }}" width="800" height="600" alt="{{ card_title }}" class="earth-essentials__image" loading="lazy">
                {%- elsif fallback_img == 3 -%}
                  <img src="{{ 'earth-3.jpg' | asset_url }}" width="800" height="600" alt="{{ card_title }}" class="earth-essentials__image" loading="lazy">
                {%- else -%}
                  <img src="{{ 'cat-activewear.jpg' | asset_url }}" width="800" height="600" alt="{{ card_title }}" class="earth-essentials__image" loading="lazy">
                {%- endif -%}
              {%- endif -%}
              <!-- Dark Vignette Overlay -->
              <div class="earth-essentials__overlay"></div>
            </div>

            <!-- Top Left Floating Badges -->
            {%- if section.settings.show_badges -%}
              <div class="earth-essentials__badges">
                {%- if block.settings.badge_1 != blank -%}
                  <span class="earth-essentials__badge">
                    {%- assign icon_1 = block.settings.badge_1_icon | default: 'drop' -%}
                    {%- if icon_1 != 'none' -%}
                      <span class="earth-essentials__badge-icon" aria-hidden="true">
                        {%- case icon_1 -%}
                          {%- when 'drop' -%}{{ 'icon-Drop.svg' | inline_asset_content }}
                          {%- when 'leaf' -%}{{ 'icon-Carbon.svg' | inline_asset_content }}
                          {%- else -%}{{ 'icon-Drop.svg' | inline_asset_content }}
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                    <span>{{ block.settings.badge_1 }}</span>
                  </span>
                {%- endif -%}
                {%- if block.settings.badge_2 != blank -%}
                  <span class="earth-essentials__badge">
                    {%- assign icon_2 = block.settings.badge_2_icon | default: 'leaf' -%}
                    {%- if icon_2 != 'none' -%}
                      <span class="earth-essentials__badge-icon" aria-hidden="true">
                        {%- case icon_2 -%}
                          {%- when 'drop' -%}{{ 'icon-Drop.svg' | inline_asset_content }}
                          {%- when 'leaf' -%}{{ 'icon-Carbon.svg' | inline_asset_content }}
                          {%- else -%}{{ 'icon-Carbon.svg' | inline_asset_content }}
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                    <span>{{ block.settings.badge_2 }}</span>
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <!-- Bottom Content -->
            <div class="earth-essentials__card-body">
              {%- if section.settings.show_card_numbers -%}
                <span class="earth-essentials__card-number">{{ card_num }}</span>
              {%- endif -%}
              <h3 class="earth-essentials__card-title">{{ card_title }}</h3>
              {%- if card_subtitle != blank -%}
                <p class="earth-essentials__card-subtitle">{{ card_subtitle }}</p>
              {%- endif -%}
              {%- assign card_btn_type = block.settings.button_type | default: 'arrow' -%}
              {%- if card_btn_type != 'none' and card_btn_text != blank -%}
                <div class="earth-essentials__card-cta">
                  {%- if card_btn_type == 'arrow' -%}
                    {%- assign card_arrow_theme = block.settings.arrow_theme | default: 'light' -%}
                    {% render 'btn-arrow',
                      text: card_btn_text,
                      url: card_url,
                      theme: card_arrow_theme,
                      color: block.settings.button_color,
                      circle_bg: block.settings.button_circle_bg,
                      circle_color: block.settings.button_circle_icon,
                      font_size: block.settings.font_size,
                      padding_vertical: block.settings.padding_vertical,
                      padding_horizontal: block.settings.padding_horizontal
                    %}
                  {%- else -%}
                    {% render 'btn-action',
                      text: card_btn_text,
                      url: card_url,
                      variant: card_btn_type,
                      custom_bg: block.settings.button_circle_bg,
                      custom_color: block.settings.button_color,
                      font_size: block.settings.font_size,
                      padding_vertical: block.settings.padding_vertical,
                      padding_horizontal: block.settings.padding_horizontal
                    %}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Default 4 Cards Matching Design -->
        <!-- Card 01 -->
        <div class="earth-essentials__card">
          <div class="earth-essentials__image-wrapper">
            <img src="{{ 'cat-organic.jpg' | asset_url }}" width="800" height="600" alt="Organic Essentials" class="earth-essentials__image" loading="lazy">
            <div class="earth-essentials__overlay"></div>
          </div>
          {%- if section.settings.show_badges -%}
            <div class="earth-essentials__badges">
              <span class="earth-essentials__badge">
                <span class="earth-essentials__badge-icon" aria-hidden="true">{{ 'icon-Drop.svg' | inline_asset_content }}</span>
                <span>GOTS Certified</span>
              </span>
              <span class="earth-essentials__badge">
                <span class="earth-essentials__badge-icon" aria-hidden="true">{{ 'icon-Carbon.svg' | inline_asset_content }}</span>
                <span>Carbon</span>
              </span>
            </div>
          {%- endif -%}
          <div class="earth-essentials__card-body">
            {%- if section.settings.show_card_numbers -%}
              <span class="earth-essentials__card-number">01</span>
            {%- endif -%}
            <h3 class="earth-essentials__card-title">Organic Essentials</h3>
            <p class="earth-essentials__card-subtitle">From farm to wardrobe</p>
            <div class="earth-essentials__card-cta">
              {% render 'btn-arrow',
                text: 'SHOP ORGANIC ESSENTIALS',
                url: routes.all_products_collection_url,
                theme: 'light'
              %}
            </div>
          </div>
        </div>

        <!-- Card 02 -->
        <div class="earth-essentials__card">
          <div class="earth-essentials__image-wrapper">
            <img src="{{ 'cat-ocean.jpg' | asset_url }}" width="800" height="600" alt="Recycled Ocean" class="earth-essentials__image" loading="lazy">
            <div class="earth-essentials__overlay"></div>
          </div>
          {%- if section.settings.show_badges -%}
            <div class="earth-essentials__badges">
              <span class="earth-essentials__badge">
                <span class="earth-essentials__badge-icon" aria-hidden="true">{{ 'icon-Drop.svg' | inline_asset_content }}</span>
                <span>Ocean Plastic</span>
              </span>
              <span class="earth-essentials__badge">
                <span class="earth-essentials__badge-icon" aria-hidden="true">{{ 'icon-Carbon.svg' | inline_asset_content }}</span>
                <span>B Corp</span>
              </span>
            </div>
          {%- endif -%}
          <div class="earth-essentials__card-body">
            {%- if section.settings.show_card_numbers -%}
              <span class="earth-essentials__card-number">02</span>
            {%- endif -%}
            <h3 class="earth-essentials__card-title">Recycled Ocean</h3>
            <p class="earth-essentials__card-subtitle">Plastic-free future</p>
            <div class="earth-essentials__card-cta">
              {% render 'btn-arrow',
                text: 'DISCOVER RECYCLED OCEAN',
                url: routes.all_products_collection_url,
                theme: 'light'
              %}
            </div>
          </div>
        </div>

        <!-- Card 03 -->
        <div class="earth-essentials__card">
          <div class="earth-essentials__image-wrapper">
            <img src="{{ 'earth-3.jpg' | asset_url }}" width="800" height="600" alt="Timeless Neutrals" class="earth-essentials__image" loading="lazy">
            <div class="earth-essentials__overlay"></div>
          </div>
          {%- if section.settings.show_badges -%}
            <div class="earth-essentials__badges">
              <span class="earth-essentials__badge">
                <span class="earth-essentials__badge-icon" aria-hidden="true">{{ 'icon-Drop.svg' | inline_asset_content }}</span>
                <span>Fair Trade</span>
              </span>
              <span class="earth-essentials__badge">
                <span class="earth-essentials__badge-icon" aria-hidden="true">{{ 'icon-Carbon.svg' | inline_asset_content }}</span>
                <span>Zero Waste</span>
              </span>
            </div>
          {%- endif -%}
          <div class="earth-essentials__card-body">
            {%- if section.settings.show_card_numbers -%}
              <span class="earth-essentials__card-number">03</span>
            {%- endif -%}
            <h3 class="earth-essentials__card-title">Timeless Neutrals</h3>
            <p class="earth-essentials__card-subtitle">Built to last forever</p>
            <div class="earth-essentials__card-cta">
              {% render 'btn-arrow',
                text: 'EXPLORE TIMELESS NEUTRALS',
                url: routes.all_products_collection_url,
                theme: 'light'
              %}
            </div>
          </div>
        </div>

        <!-- Card 04 -->
        <div class="earth-essentials__card">
          <div class="earth-essentials__image-wrapper">
            <img src="{{ 'cat-activewear.jpg' | asset_url }}" width="800" height="600" alt="Eco Activewear" class="earth-essentials__image" loading="lazy">
            <div class="earth-essentials__overlay"></div>
          </div>
          {%- if section.settings.show_badges -%}
            <div class="earth-essentials__badges">
              <span class="earth-essentials__badge">
                <span class="earth-essentials__badge-icon" aria-hidden="true">{{ 'icon-Drop.svg' | inline_asset_content }}</span>
                <span>Recycled Fabric</span>
              </span>
              <span class="earth-essentials__badge">
                <span class="earth-essentials__badge-icon" aria-hidden="true">{{ 'icon-Carbon.svg' | inline_asset_content }}</span>
                <span>Low Impact</span>
              </span>
            </div>
          {%- endif -%}
          <div class="earth-essentials__card-body">
            {%- if section.settings.show_card_numbers -%}
              <span class="earth-essentials__card-number">04</span>
            {%- endif -%}
            <h3 class="earth-essentials__card-title">Eco Activewear</h3>
            <p class="earth-essentials__card-subtitle">Move with purpose</p>
            <div class="earth-essentials__card-cta">
              {% render 'btn-arrow',
                text: 'SHOP ECO ACTIVEWEAR',
                url: routes.all_products_collection_url,
                theme: 'light'
              %}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* ==========================================================================
     Featured Eco Essentials Styles
     ========================================================================== */
  .earth-featured-essentials {
    grid-column: 1 / -1 !important;
    background-color: var(--section-bg, #EBF7BE);
    color: var(--section-text, #003225);
    padding-top: var(--section-pt, 80px);
    padding-bottom: var(--section-pb, 96px);
    padding-left: clamp(20px, 2.5vw, 34px);
    padding-right: clamp(20px, 2.5vw, 34px);
    width: 100%;
    box-sizing: border-box;
    transition: background-color 0.3s ease;
  }
  .earth-essentials__container {
    margin: 0 auto;
    width: 100%;
    max-width: var(--page-width, 1320px);
    box-sizing: border-box;
  }
  .earth-featured-essentials--full .earth-essentials__container {
    max-width: 100%;
  }

  /* 1. Header Layout */
  .earth-essentials__header-container {
    width: 100%;
    margin-bottom: clamp(40px, 5vw, 60px);
  }

  /* 2. Reusable Arrow Link Button Component */
  .earth-btn-arrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: pointer;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 6px;
  }
  .earth-btn-arrow__text {
    line-height: 1;
  }
  .earth-btn-arrow__icon-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .earth-btn-arrow:hover .earth-btn-arrow__icon-circle {
    transform: translateX(4px);
  }

  .earth-btn-arrow__icon-circle img,
  .earth-btn-arrow__icon-circle svg {
    width: 12px;
    height: 10px;
    display: block;
    object-fit: contain;
  }

  /* Theme variants for arrow button */
  .earth-btn-arrow--dark {
    color: var(--section-text, #003225);
  }
  .earth-btn-arrow--dark .earth-btn-arrow__icon-circle {
    background-color: var(--section-text, #003225);
    color: var(--color-white, #FFFFFF);
  }

  .earth-btn-arrow--light {
    color: var(--color-white, #FFFFFF);
  }
  .earth-btn-arrow--light .earth-btn-arrow__icon-circle {
    background-color: var(--color-white, #FFFFFF);
    color: var(--color-black, #003225);
  }
  .earth-btn-arrow--light .earth-btn-arrow__icon-circle img,
  .earth-btn-arrow--light .earth-btn-arrow__icon-circle svg {
    filter: brightness(0) saturate(100%) invert(18%) sepia(35%) saturate(1914%) hue-rotate(92deg) brightness(94%) contrast(97%);
  }

  /* 3. Cards Grid Layouts */
  .earth-essentials__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    width: 100%;
  }

  .earth-essentials__card {
    position: relative;
    border-radius: var(--card-radius, 0px);
    overflow: hidden;
    height: var(--card-height, 530px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(24px, 3.5vw, 36px);
    box-sizing: border-box;
    cursor: pointer;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }

  /* Layout 1: Asymmetric Diagonal Staggered Grid (Default) */
  .earth-featured-essentials--asymmetric .earth-essentials__card:nth-child(4n + 1) {
    width: calc(57.5% - 10px);
  }
  .earth-featured-essentials--asymmetric .earth-essentials__card:nth-child(4n + 2) {
    width: calc(42.5% - 10px);
  }
  .earth-featured-essentials--asymmetric .earth-essentials__card:nth-child(4n + 3) {
    width: calc(42.5% - 10px);
  }
  .earth-featured-essentials--asymmetric .earth-essentials__card:nth-child(4n + 4) {
    width: calc(57.5% - 10px);
  }

  /* Layout 2: Equal 2-Column Grid */
  .earth-featured-essentials--grid_equal .earth-essentials__card {
    width: calc(50% - 10px);
  }

  /* Layout 3: 3-Column Grid */
  .earth-featured-essentials--grid_3_col .earth-essentials__card {
    width: calc(33.333% - 13.333px);
  }

  /* Layout 4: 4-Column Grid */
  .earth-featured-essentials--grid_4_col .earth-essentials__card {
    width: calc(25% - 15px);
  }

  /* Hover Effects */
  .earth-featured-essentials--hover-zoom .earth-essentials__card:hover .earth-essentials__image {
    transform: scale(1.05);
  }
  .earth-featured-essentials--hover-lift .earth-essentials__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 32, 23, 0.22);
  }
  .earth-featured-essentials--hover-glow .earth-essentials__card:hover {
    box-shadow: 0 0 0 2px var(--color-secondary, #71CC3B), 0 12px 30px rgba(113, 204, 59, 0.2);
  }

  .earth-essentials__image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .earth-essentials__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .earth-essentials__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.05) 40%, rgba(0, 32, 23, var(--card-overlay-opacity, 0.88)) 100%);
  }

  /* Badges */
  .earth-essentials__badges {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .earth-essentials__badge {
    background-color: rgba(255, 255, 255, 0.95);
    color: var(--color-black, #003225);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    backdrop-filter: blur(4px);
  }
  .earth-essentials__badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }
  .earth-essentials__badge-icon svg {
    width: 12px;
    height: 12px;
    display: block;
  }
  .earth-essentials__badge-icon svg path[stroke] {
    stroke: #003225 !important;
  }
  .earth-essentials__badge-icon svg path[fill] {
    fill: #003225 !important;
  }

  /* Card Body */
  .earth-essentials__card-body {
    position: relative;
    z-index: 2;
    color: var(--color-white, #FFFFFF);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .earth-essentials__card-number {
    font-size: 21px;
    font-weight: 400;
    opacity: 0.9;
    margin-bottom: 4px;
    color: var(--color-white, #FFFFFF);
  }
  .earth-essentials__card-title {
    font-size: 34px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-white, #FFFFFF);
    margin: 0 0 6px 0;
  }
  .earth-essentials__card-subtitle {
    font-size: 18px;
    color: var(--color-white, #FFFFFF);
    margin: 0 0 18px 0;
    opacity: 0.92;
  }
  .earth-essentials__card-cta {
    display: flex;
  }

  /* Responsive Design for Tablet & Mobile */
  @media (max-width: 1024px) {
    .earth-featured-essentials {
      padding-top: calc(var(--section-pt, 80px) * 0.75);
      padding-bottom: calc(var(--section-pb, 96px) * 0.75);
    }
    .earth-featured-essentials--grid_3_col .earth-essentials__card,
    .earth-featured-essentials--grid_4_col .earth-essentials__card {
      width: calc(50% - 10px);
    }
  }

  @media (max-width: 768px) {
    .earth-featured-essentials {
      padding-top: var(--section-m-pt, 48px);
      padding-bottom: var(--section-m-pb, 56px);
      padding-left: 20px;
      padding-right: 20px;
    }
    .earth-essentials__header {
      flex-direction: column;
      gap: 14px;
      margin-bottom: 24px;
    }
    .earth-essentials__header-left,
    .earth-essentials__header-right {
      width: 100%;
      flex: auto;
    }
    .earth-essentials__main-title {
      font-size: 2.25rem !important;
      gap: 10px;
    }
    .earth-essentials__leaf-icon {
      display: none !important;
    }
    .earth-essentials__header-desc {
      font-size: 1.125rem;
      max-width: 100%;
    }
    .earth-essentials__grid {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .earth-essentials__card {
      width: 100% !important;
      padding: 16px !important;
    }
    /* Mobile Asymmetric Heights */
    .earth-featured-essentials--asymmetric .earth-essentials__card:nth-child(odd) {
      width: 100% !important;
      height: 265px !important;
      min-height: 265px !important;
    }
    .earth-featured-essentials--asymmetric .earth-essentials__card:nth-child(even) {
      width: 100% !important;
      height: 450px !important;
      min-height: 450px !important;
    }
    .earth-essentials__badges {
      gap: 5px;
    }
    .earth-essentials__badge {
      font-size: 10.5px;
      padding: 2px 7px;
      border-radius: 10px;
      background-color: var(--color-white, #F8F9DC);
      color: var(--color-black, #003225);
    }
    .earth-essentials__card-number {
      font-size: 15px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 2px;
    }
    .earth-essentials__card-title {
      font-size: 22px;
      font-weight: 800;
      color: #ffffff;
      margin: 0 0 2px 0;
      line-height: 1.15;
    }
    .earth-essentials__card-subtitle {
      font-size: 13px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.85);
      margin: 0 0 12px 0;
    }
    .earth-btn-arrow {
      font-size: 11px;
      gap: 7px;
      padding-bottom: 3px;
    }
    .earth-btn-arrow__icon-circle {
      width: 20px;
      height: 20px;
    }
    .earth-btn-arrow__icon-circle img,
    .earth-btn-arrow__icon-circle svg {
      width: 9px;
      height: 7px;
    }
  }
{% endstylesheet %}

