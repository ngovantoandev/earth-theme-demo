{% comment %}
  Sustainability Journey Section
  Interactive timeline with connected milestones, call-to-action box, reusable action buttons, and sustainability pillars.
  Left column: Enter data (Milestone blocks, Pillar blocks, Button blocks)
  Right column: Configure UI & styling (Layout, Timeline styles, Node styles, Card styles, CTA box styles, Colors)
  Full width toggle applies to inner container while section background spans edge-to-edge.
  Integrated with snippets/section-header.liquid with exact original default UI preserved.
{% endcomment %}

{%- liquid
  assign section_title = section.settings.title | default: 'Our Sustainability Journey'
  assign header_layout = section.settings.header_layout | default: 'centered'
  assign timeline_layout = section.settings.timeline_layout | default: 'horizontal_connected'
  assign card_style = section.settings.card_style | default: 'outline'
  assign node_style = section.settings.timeline_node_style | default: 'solid_dark'
  assign line_style = section.settings.timeline_line_style | default: 'solid'
  assign hover_effect = section.settings.card_hover_effect | default: 'none'
  assign year_style = section.settings.year_style | default: 'bold_header'

  assign milestone_blocks = section.blocks | where: 'type', 'milestone'
  assign pillar_blocks = section.blocks | where: 'type', 'pillar'
  assign button_blocks = section.blocks | where: 'type', 'button'
-%}

{%- capture header_button_block -%}
  {%- if section.settings.show_header_btn and section.settings.header_btn_text != blank -%}
    <div class="earth-section-header__btn-wrap">
      {%- if section.settings.header_btn_type == 'arrow' -%}
        {% render 'btn-arrow',
          text: section.settings.header_btn_text,
          url: section.settings.header_btn_url,
          theme: section.settings.header_btn_theme,
          color: section.settings.header_btn_color
        %}
      {%- else -%}
        {% render 'btn-action',
          text: section.settings.header_btn_text,
          url: section.settings.header_btn_url,
          variant: section.settings.header_btn_type,
          custom_bg: section.settings.header_btn_color
        %}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<section
  class="sustainability-journey full-width{% if section.settings.full_width %} sustainability-journey--full{% else %} sustainability-journey--contained{% endif %} sustainability-journey--layout-{{ timeline_layout }} sustainability-journey--card-{{ card_style }} sustainability-journey--node-{{ node_style }} sustainability-journey--line-{{ line_style }} sustainability-journey--hover-{{ hover_effect }} sustainability-journey--year-{{ year_style }}"
  id="sustainabilityJourney-{{ section.id }}"
  style="
    --journey-bg: {{ section.settings.bg_color | default: '#F1F4D8' }};
    --journey-color: {{ section.settings.text_color | default: '#003225' }};
    --journey-accent: {{ section.settings.accent_color | default: '#71CC3B' }};
    --journey-pt: {{ section.settings.desktop_padding_top | default: 116 }}px;
    --journey-pb: {{ section.settings.desktop_padding_bottom | default: 116 }}px;
    --journey-mpt: {{ section.settings.mobile_padding_top | default: 48 }}px;
    --journey-mpb: {{ section.settings.mobile_padding_bottom | default: 56 }}px;
    --journey-line-color: {{ section.settings.timeline_line_color | default: '#003225' }};
    --journey-node-bg: {{ section.settings.node_bg_color | default: '#003225' }};
    --journey-node-border: {{ section.settings.node_border_color | default: '#003225' }};
    --journey-node-icon: {{ section.settings.node_icon_color | default: '#F1F4D8' }};
    --journey-node-active-bg: {{ section.settings.node_active_bg | default: '#71CC3B' }};
    --journey-node-active-icon: {{ section.settings.node_active_icon_color | default: '#003225' }};
    --journey-card-bg: {{ section.settings.card_bg_color | default: 'transparent' }};
    --journey-card-border: {{ section.settings.card_border_color | default: '#003225' }};
    --journey-card-radius: {{ section.settings.card_border_radius | default: 0 }}px;
    --journey-year-color: {{ section.settings.year_color | default: '#003225' }};
    --journey-cta-bg: {{ section.settings.cta_bg_color | default: 'transparent' }};
    --journey-cta-border: {{ section.settings.cta_border_color | default: '#003225' }};
    --journey-cta-radius: {{ section.settings.cta_border_radius | default: 0 }}px;
    --journey-pillar-bg: {{ section.settings.pillar_icon_bg | default: '#71CC3B' }};
    --journey-pillar-icon: {{ section.settings.pillar_icon_color | default: '#003225' }};
    --journey-pillar-size: {{ section.settings.pillar_label_size | default: 18 }}px;
  "
>
  <div class="sustainability-journey__container">
    
    <!-- 1. Unified Section Header -->
    <div class="sustainability-journey__header-container">
      {% render 'section-header',
        layout: header_layout,
        title: section_title,
        title_color: section.settings.title_color,
        title_size: section.settings.title_size_desktop,
        eyebrow: section.settings.eyebrow,
        show_eyebrow_icon: section.settings.show_eyebrow_icon,
        eyebrow_color: section.settings.eyebrow_color,
        eyebrow_size_desktop: section.settings.eyebrow_size_desktop,
        eyebrow_size_mobile: section.settings.eyebrow_size_mobile,
        subtitle: section.settings.subtitle,
        subtitle_color: section.settings.subtitle_color,
        subtitle_size_desktop: section.settings.subtitle_size_desktop,
        subtitle_size_mobile: section.settings.subtitle_size_mobile,
        show_leaf: section.settings.show_leaf_icons,
        leaf_position: section.settings.leaf_position,
        leaf_color: section.settings.leaf_color,
        leaf_size: section.settings.leaf_size,
        leaf_gap: section.settings.leaf_gap,
        btn_block: header_button_block
      %}
    </div>

    <!-- 2. Timeline Milestones Grid / Track -->
    <div class="sustainability-journey__timeline-wrapper sustainability-journey__timeline-wrapper--{{ timeline_layout }}">
      <div class="sustainability-journey__timeline-line" aria-hidden="true"></div>
      
      <div class="sustainability-journey__milestones" role="region" aria-label="Sustainability Milestones">
        {%- if milestone_blocks.size > 0 -%}
          {%- for block in milestone_blocks -%}
            {%- assign is_highlight = block.settings.highlight -%}
            <div 
              class="sustainability-journey__milestone-item{% if is_highlight %} sustainability-journey__milestone-item--highlight{% endif %}" 
              {{ block.shopify_attributes }}
              style="{% if block.settings.custom_node_bg != blank %}--item-node-bg: {{ block.settings.custom_node_bg }};{% endif %}"
            >
              
              <!-- Top Circle Badge / Node -->
              <div class="sustainability-journey__node-badge" aria-hidden="true">
                <div class="sustainability-journey__icon-inner">
                  {%- if block.settings.custom_svg != blank -%}
                    {{ block.settings.custom_svg }}
                  {%- elsif block.settings.custom_icon != blank -%}
                    <img src="{{ block.settings.custom_icon | image_url: width: 64 }}" width="28" height="28" alt="{{ block.settings.title | escape }}" loading="lazy">
                  {%- elsif block.settings.icon_name != blank -%}
                    {{ block.settings.icon_name | inline_asset_content }}
                  {%- else -%}
                    {%- case block.settings.icon_type -%}
                      {%- when 'idea' -%}
                        {{ 'icon-idea.svg' | inline_asset_content }}
                      {%- when 'handshake' -%}
                        {{ 'icon-handshake.svg' | inline_asset_content }}
                      {%- when 'tree' -%}
                        {{ 'icon-tree.svg' | inline_asset_content }}
                      {%- when 'badge' -%}
                        {{ 'icon-badge.svg' | inline_asset_content }}
                      {%- when 'repost' -%}
                        {{ 'icon-repost.svg' | inline_asset_content }}
                      {%- when 'leaf' -%}
                        {{ 'icon-leaf-2.svg' | inline_asset_content }}
                      {%- when 'sparkle' -%}
                        {{ 'icon-sparkle.svg' | inline_asset_content }}
                      {%- else -%}
                        {{ 'icon-tree.svg' | inline_asset_content }}
                    {%- endcase -%}
                  {%- endif -%}
                </div>
              </div>

              <!-- Year Label & Optional Badge -->
              <div class="sustainability-journey__year-wrap">
                <span class="sustainability-journey__year">{{ block.settings.year }}</span>
                {%- if block.settings.badge_text != blank -%}
                  <span class="sustainability-journey__status-badge">{{ block.settings.badge_text }}</span>
                {%- endif -%}
              </div>

              <!-- Milestone Card -->
              <div class="sustainability-journey__card">
                <h3 class="sustainability-journey__card-title">
                  {%- if block.settings.link_url != blank -%}
                    <a href="{{ block.settings.link_url }}" class="sustainability-journey__card-link">{{ block.settings.title }}</a>
                  {%- else -%}
                    {{ block.settings.title }}
                  {%- endif -%}
                </h3>
                <div class="sustainability-journey__card-desc">
                  {%- if block.settings.description contains '<p>' -%}
                    {{ block.settings.description }}
                  {%- else -%}
                    <p>{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
              </div>

            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Fallback Milestones (5 steps matching initial design) -->
          <!-- 1. 2018 -->
          <div class="sustainability-journey__milestone-item">
            <div class="sustainability-journey__node-badge" aria-hidden="true">
              <div class="sustainability-journey__icon-inner">
                {{ 'icon-idea.svg' | inline_asset_content }}
              </div>
            </div>
            <div class="sustainability-journey__year-wrap">
              <span class="sustainability-journey__year">2018</span>
            </div>
            <div class="sustainability-journey__card">
              <h3 class="sustainability-journey__card-title">The Beginning</h3>
              <p class="sustainability-journey__card-desc">Founded in Hanoi with mission to source 100% organic cotton from local farms</p>
            </div>
          </div>

          <!-- 2. 2020 -->
          <div class="sustainability-journey__milestone-item">
            <div class="sustainability-journey__node-badge" aria-hidden="true">
              <div class="sustainability-journey__icon-inner">
                {{ 'icon-handshake.svg' | inline_asset_content }}
              </div>
            </div>
            <div class="sustainability-journey__year-wrap">
              <span class="sustainability-journey__year">2020</span>
            </div>
            <div class="sustainability-journey__card">
              <h3 class="sustainability-journey__card-title">Fair Trade Partnership</h3>
              <p class="sustainability-journey__card-desc">Partnered with first Fair Trade factories, ensuring ethical labor for 500 artisans</p>
            </div>
          </div>

          <!-- 3. 2022 -->
          <div class="sustainability-journey__milestone-item">
            <div class="sustainability-journey__node-badge" aria-hidden="true">
              <div class="sustainability-journey__icon-inner">
                {{ 'icon-tree.svg' | inline_asset_content }}
              </div>
            </div>
            <div class="sustainability-journey__year-wrap">
              <span class="sustainability-journey__year">2022</span>
            </div>
            <div class="sustainability-journey__card">
              <h3 class="sustainability-journey__card-title">Reforestation Initiative</h3>
              <p class="sustainability-journey__card-desc">Launched "1 Tree Per Product" – planted 50K trees in Vietnam reforestation</p>
            </div>
          </div>

          <!-- 4. 2024 -->
          <div class="sustainability-journey__milestone-item sustainability-journey__milestone-item--highlight">
            <div class="sustainability-journey__node-badge" aria-hidden="true">
              <div class="sustainability-journey__icon-inner">
                {{ 'icon-badge.svg' | inline_asset_content }}
              </div>
            </div>
            <div class="sustainability-journey__year-wrap">
              <span class="sustainability-journey__year">2024</span>
              <span class="sustainability-journey__status-badge">Achieved</span>
            </div>
            <div class="sustainability-journey__card">
              <h3 class="sustainability-journey__card-title">Carbon Neutral</h3>
              <p class="sustainability-journey__card-desc">Achieved B Corp certification and full carbon-neutral shipping</p>
            </div>
          </div>

          <!-- 5. 2026 -->
          <div class="sustainability-journey__milestone-item">
            <div class="sustainability-journey__node-badge" aria-hidden="true">
              <div class="sustainability-journey__icon-inner">
                {{ 'icon-repost.svg' | inline_asset_content }}
              </div>
            </div>
            <div class="sustainability-journey__year-wrap">
              <span class="sustainability-journey__year">2026</span>
            </div>
            <div class="sustainability-journey__card">
              <h3 class="sustainability-journey__card-title">Circular Economy</h3>
              <p class="sustainability-journey__card-desc">Closed-loop recycling: turn old clothes into new collections</p>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- 3. Bottom Call-to-Action Box & Pillars -->
    {%- if section.settings.show_cta_box != false -%}
      <div class="sustainability-journey__cta-box sustainability-journey__cta-box--{{ section.settings.cta_layout | default: 'centered_card' }}">
        
        <div class="sustainability-journey__cta-content">
          <h3 class="sustainability-journey__cta-title">
            {{ section.settings.cta_title | default: 'Be part of our story' }}
          </h3>
          
          {%- if section.settings.cta_subtitle != blank -%}
            <p class="sustainability-journey__cta-subtitle">
              {{ section.settings.cta_subtitle }}
            </p>
          {%- endif -%}

          <!-- Action Buttons Group -->
          <div class="sustainability-journey__btn-group">
            {%- if button_blocks.size > 0 -%}
              {%- for block in button_blocks -%}
                <div class="sustainability-journey__btn-item" {{ block.shopify_attributes }}>
                  {%- assign btn_style = block.settings.button_type | default: 'solid' -%}
                  {%- assign btn_theme = block.settings.arrow_theme | default: 'dark' -%}
                  {%- if btn_style == 'arrow' -%}
                    {% render 'btn-arrow',
                      text: block.settings.button_text,
                      url: block.settings.button_link,
                      theme: btn_theme,
                      color: block.settings.custom_color
                    %}
                  {%- else -%}
                    {% render 'btn-action',
                      text: block.settings.button_text,
                      url: block.settings.button_link,
                      variant: btn_style,
                      custom_bg: block.settings.custom_color
                    %}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback buttons from section settings -->
              {%- assign p_variant = section.settings.primary_btn_type | default: 'solid' -%}
              {%- assign s_variant = section.settings.secondary_btn_type | default: 'outline' -%}
              {%- if section.settings.primary_btn_text != blank -%}
                {% render 'btn-action',
                  text: section.settings.primary_btn_text,
                  url: section.settings.primary_btn_url,
                  variant: p_variant
                %}
              {%- endif -%}

              {%- if section.settings.secondary_btn_text != blank -%}
                {% render 'btn-action',
                  text: section.settings.secondary_btn_text,
                  url: section.settings.secondary_btn_url,
                  variant: s_variant
                %}
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>

        <!-- 3 Pillars / Badges Row -->
        {%- if section.settings.show_pillars != false -%}
          <div class="sustainability-journey__pillars sustainability-journey__pillars--{{ section.settings.pillars_layout | default: 'horizontal_row' }}">
            {%- if pillar_blocks.size > 0 -%}
              {%- for block in pillar_blocks -%}
                <div class="sustainability-journey__pillar-item" {{ block.shopify_attributes }}>
                  <div class="sustainability-journey__pillar-icon-wrap sustainability-journey__pillar-icon-wrap--{{ section.settings.pillar_icon_style | default: 'circle_badge' }}" aria-hidden="true">
                    {%- if block.settings.custom_svg != blank -%}
                      {{ block.settings.custom_svg }}
                    {%- elsif block.settings.custom_icon != blank -%}
                      <img src="{{ block.settings.custom_icon | image_url: width: 64 }}" width="30" height="30" alt="{{ block.settings.label | escape }}" loading="lazy">
                    {%- elsif block.settings.icon_name != blank -%}
                      {{ block.settings.icon_name | inline_asset_content }}
                    {%- else -%}
                      {%- case block.settings.icon_type -%}
                        {%- when 'plant' -%}
                          {{ 'icon-plant-based.svg' | inline_asset_content }}
                        {%- when 'co2' -%}
                          {{ 'icon-plant-based-1.svg' | inline_asset_content }}
                        {%- when 'wages' -%}
                          {{ 'icon-Fair-Wages.svg' | inline_asset_content }}
                        {%- when 'tree' -%}
                          {{ 'icon-tree.svg' | inline_asset_content }}
                        {%- when 'gots' -%}
                          {{ 'icon-GOTS-Certified.svg' | inline_asset_content }}
                        {%- when 'fairtrade' -%}
                          {{ 'icon-Fair-Trade.svg' | inline_asset_content }}
                        {%- else -%}
                          {{ 'icon-plant-based.svg' | inline_asset_content }}
                      {%- endcase -%}
                    {%- endif -%}
                  </div>
                  <div class="sustainability-journey__pillar-text">
                    <span class="sustainability-journey__pillar-label">{{ block.settings.label }}</span>
                    {%- if block.settings.sublabel != blank -%}
                      <span class="sustainability-journey__pillar-sublabel">{{ block.settings.sublabel }}</span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- else -%}
              <!-- Fallback Pillars matching exact initial design -->
              {%- if section.settings.pillar_1_label != blank -%}
                <div class="sustainability-journey__pillar-item">
                  <div class="sustainability-journey__pillar-icon-wrap sustainability-journey__pillar-icon-wrap--{{ section.settings.pillar_icon_style | default: 'circle_badge' }}" aria-hidden="true">
                    {{ 'icon-plant-based.svg' | inline_asset_content }}
                  </div>
                  <span class="sustainability-journey__pillar-label">{{ section.settings.pillar_1_label }}</span>
                </div>
              {%- endif -%}

              {%- if section.settings.pillar_2_label != blank -%}
                <div class="sustainability-journey__pillar-item">
                  <div class="sustainability-journey__pillar-icon-wrap sustainability-journey__pillar-icon-wrap--{{ section.settings.pillar_icon_style | default: 'circle_badge' }}" aria-hidden="true">
                    {{ 'icon-plant-based-1.svg' | inline_asset_content }}
                  </div>
                  <span class="sustainability-journey__pillar-label">{{ section.settings.pillar_2_label }}</span>
                </div>
              {%- endif -%}

              {%- if section.settings.pillar_3_label != blank -%}
                <div class="sustainability-journey__pillar-item">
                  <div class="sustainability-journey__pillar-icon-wrap sustainability-journey__pillar-icon-wrap--{{ section.settings.pillar_icon_style | default: 'circle_badge' }}" aria-hidden="true">
                    {{ 'icon-Fair-Wages.svg' | inline_asset_content }}
                  </div>
                  <span class="sustainability-journey__pillar-label">{{ section.settings.pillar_3_label }}</span>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  /* ==========================================================================
     Sustainability Journey Section Styles (Full Width background with inner control)
     ========================================================================== */
  .sustainability-journey {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: var(--journey-bg, #F1F4D8);
    color: var(--journey-color, #003225);
    padding: var(--journey-pt, 116px) 0 var(--journey-pb, 116px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .sustainability-journey__container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* 1. Full Width Mode */
  .sustainability-journey--full .sustainability-journey__container {
    max-width: 100%;
    padding-left: clamp(20px, 2.5vw, 34px);
    padding-right: clamp(20px, 2.5vw, 34px);
  }

  /* 2. Contained Mode */
  .sustainability-journey--contained .sustainability-journey__container {
    max-width: var(--page-width, 1920px);
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(20px, 3vw, var(--page-margin, 20px));
    padding-right: clamp(20px, 3vw, var(--page-margin, 20px));
  }

  /* Section Header Wrap */
  .sustainability-journey__header-container {
    width: 100%;
    margin-bottom: clamp(40px, 5.5vw, 68px);
    box-sizing: border-box;
    text-align: center;
  }

  /* ==========================================================================
     Timeline Milestones Layout
     ========================================================================== */
  .sustainability-journey__timeline-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: clamp(12px, 1.8vw, 24px);
    box-sizing: border-box;
  }

  /* Horizontal Connected Line */
  .sustainability-journey__timeline-line {
    position: absolute;
    top: 26px;
    left: 0;
    right: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--journey-line-color, #003225);
    z-index: 1;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .sustainability-journey--line-dashed .sustainability-journey__timeline-line {
    background: repeating-linear-gradient(90deg, var(--journey-line-color, #003225) 0, var(--journey-line-color, #003225) 8px, transparent 8px, transparent 16px);
  }
  .sustainability-journey--line-gradient .sustainability-journey__timeline-line {
    background: linear-gradient(90deg, transparent 0%, var(--journey-line-color, #003225) 15%, var(--journey-accent, #71CC3B) 85%, transparent 100%);
    height: 2px;
  }
  .sustainability-journey--line-none .sustainability-journey__timeline-line {
    display: none;
  }

  /* Milestones Grid */
  .sustainability-journey__milestones {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 24px);
    position: relative;
    z-index: 2;
    width: 100%;
    box-sizing: border-box;
  }

  .sustainability-journey--layout-cards_grid .sustainability-journey__milestones {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  /* Individual Milestone Item */
  .sustainability-journey__milestone-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  /* Node Badge / Circle (Exact Image 1: Solid dark green circle with cream icon, sitting on horizontal line) */
  .sustainability-journey__node-badge {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: var(--item-node-bg, var(--journey-node-bg, #003225));
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    position: relative;
    z-index: 3;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .sustainability-journey--node-solid_dark .sustainability-journey__node-badge {
    background-color: var(--item-node-bg, var(--journey-node-bg, #003225));
    border: none;
  }
  .sustainability-journey--node-solid_dark .sustainability-journey__icon-inner {
    color: var(--journey-bg, #F1F4D8);
  }
  .sustainability-journey--node-outline_circle .sustainability-journey__node-badge {
    background-color: var(--item-node-bg, var(--journey-bg, #F1F4D8));
    border: 1.5px solid var(--journey-node-border, #003225);
  }
  .sustainability-journey--node-outline_circle .sustainability-journey__icon-inner {
    color: var(--journey-color, #003225);
  }
  .sustainability-journey--node-accent_badge .sustainability-journey__node-badge {
    background-color: var(--journey-accent, #71CC3B);
    border: none;
  }
  .sustainability-journey--node-accent_badge .sustainability-journey__icon-inner {
    color: var(--journey-color, #003225);
  }
  .sustainability-journey--node-floating_badge .sustainability-journey__node-badge {
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(0, 50, 37, 0.1);
  }
  .sustainability-journey--node-minimal_dot .sustainability-journey__node-badge {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
  }

  .sustainability-journey__milestone-item--highlight .sustainability-journey__node-badge {
    background-color: var(--journey-node-active-bg, #71CC3B);
    box-shadow: 0 0 0 3px rgba(113, 204, 59, 0.25);
  }

  .sustainability-journey__icon-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
    color: var(--journey-node-icon, #F1F4D8);
    flex-shrink: 0;
  }

  .sustainability-journey__milestone-item--highlight .sustainability-journey__icon-inner {
    color: var(--journey-node-active-icon, #003225);
  }

  .sustainability-journey__icon-inner img,
  .sustainability-journey__icon-inner svg {
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  /* Year Wrap & Label */
  .sustainability-journey__year-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .sustainability-journey__year {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--journey-year-color, #003225);
    line-height: 1.2;
  }

  .sustainability-journey--year-pill_badge .sustainability-journey__year {
    font-size: 1.125rem;
    background-color: var(--journey-node-border, #003225);
    color: var(--journey-bg, #F1F4D8);
    padding: 3px 14px;
    border-radius: 20px;
    letter-spacing: 0.04em;
  }

  .sustainability-journey--year-accent_text .sustainability-journey__year {
    color: var(--journey-accent, #71CC3B);
  }

  .sustainability-journey__status-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--journey-accent, #71CC3B);
    color: #003225;
    padding: 2px 8px;
    border-radius: 12px;
    line-height: 1.3;
  }

  /* Milestone Card (Exact Original Dimensions & Styles) */
  .sustainability-journey__card {
    border: 1.5px solid var(--journey-card-border, #003225);
    border-radius: var(--journey-card-radius, 0px);
    background-color: var(--journey-card-bg, transparent);
    padding: clamp(20px, 2vw, 28px) clamp(14px, 1.4vw, 20px);
    width: 100%;
    height: 100%;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
  }

  .sustainability-journey--card-filled_card .sustainability-journey__card {
    border: none;
    background-color: var(--journey-card-bg, #ffffff);
    box-shadow: 0 4px 18px rgba(0, 50, 37, 0.06);
  }

  .sustainability-journey--card-glass .sustainability-journey__card {
    background-color: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(0, 50, 37, 0.15);
  }

  .sustainability-journey--card-minimal_text .sustainability-journey__card {
    border: none;
    background: transparent;
    padding: 8px 4px;
    min-height: auto;
  }

  .sustainability-journey__card-title {
    font-size: 1.188rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--journey-color, #003225);
    margin: 0 0 10px 0;
  }

  .sustainability-journey__card-link {
    color: inherit;
    text-decoration: none;
  }

  .sustainability-journey__card-desc {
    font-size: 1rem;
    line-height: 1.45;
    color: var(--journey-color, #003225);
    opacity: 0.9;
    margin: 0;
  }
  .sustainability-journey__card-desc p {
    margin: 0;
  }

  /* ==========================================================================
     Bottom Call-to-Action Card & 3 Pillars
     ========================================================================== */
  .sustainability-journey__cta-box {
    border: 1.5px solid var(--journey-cta-border, #003225);
    background-color: var(--journey-cta-bg, transparent);
    border-radius: var(--journey-cta-radius, 0px);
    padding: clamp(42px, 5.5vw, 68px) clamp(20px, 4vw, 56px);
    width: 100%;
    box-sizing: border-box;
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sustainability-journey__cta-box--split_banner {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    gap: 40px;
  }

  .sustainability-journey__cta-title {
    font-size: clamp(2rem, 3.2vw, 2.9rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--journey-color, #003225);
    margin: 0 0 14px 0;
  }

  .sustainability-journey__cta-subtitle {
    font-size: clamp(15.5px, 1.2vw, 18px);
    line-height: 1.5;
    color: var(--journey-color, #003225);
    opacity: 0.92;
    max-width: 650px;
    margin: 0 auto clamp(28px, 3.5vw, 38px);
    letter-spacing: -0.01em;
  }

  .sustainability-journey__cta-box--split_banner .sustainability-journey__cta-subtitle {
    margin-left: 0;
  }

  /* Action Buttons Group */
  .sustainability-journey__btn-group {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: clamp(36px, 4.5vw, 56px);
  }

  /* 3 Pillars Row */
  .sustainability-journey__pillars {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(32px, 6.5vw, 96px);
    flex-wrap: wrap;
    width: 100%;
    box-sizing: border-box;
  }

  .sustainability-journey__pillar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .sustainability-journey__pillar-icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background-color: var(--journey-pillar-bg, #71CC3B);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--journey-pillar-icon, #003225);
  }

  .sustainability-journey__pillar-icon-wrap--square_badge {
    border-radius: 14px;
  }
  .sustainability-journey__pillar-icon-wrap--raw_icon {
    background: transparent;
    border: none;
    box-shadow: none;
    width: 36px;
    height: 36px;
  }

  .sustainability-journey__pillar-icon-wrap img,
  .sustainability-journey__pillar-icon-wrap svg {
    max-width: 30px;
    max-height: 30px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .sustainability-journey__pillar-text {
    display: flex;
    flex-direction: column;
    text-align: center;
    gap: 2px;
  }

  .sustainability-journey__pillar-label {
    font-size: var(--journey-pillar-size, 1.125rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--journey-color, #003225);
    line-height: 1.2;
  }

  .sustainability-journey__pillar-sublabel {
    font-size: 13px;
    font-weight: 600;
    color: var(--journey-color, #003225);
    opacity: 0.75;
  }

  /* ==========================================================================
     Responsive Breakpoints
     ========================================================================== */
  @media (max-width: 1024px) {
    .sustainability-journey {
      padding: var(--journey-mpt, 60px) 0 var(--journey-mpb, 70px);
    }

    .sustainability-journey--full .sustainability-journey__container,
    .sustainability-journey--contained .sustainability-journey__container {
      padding-left: 24px;
      padding-right: 24px;
    }

    .sustainability-journey__timeline-line {
      display: none !important;
    }

    .sustainability-journey__timeline-wrapper {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 12px;
      margin: 0 0 32px 0;
      width: 100%;
    }
    .sustainability-journey__timeline-wrapper::-webkit-scrollbar {
      display: none;
    }

    .sustainability-journey__milestones {
      display: flex;
      width: max-content;
      gap: 12px;
      position: relative;
      padding: 0;
      box-sizing: border-box;
    }

    .sustainability-journey__milestones::before {
      content: "";
      position: absolute;
      top: 32px;
      left: 0;
      right: 0;
      width: 100%;
      height: 2px;
      background-color: var(--journey-line-color, #003225);
      z-index: 1;
      pointer-events: none;
      transform: translateY(-50%);
    }

    .sustainability-journey__milestone-item {
      flex: 0 0 240px;
      scroll-snap-align: start;
    }

    .sustainability-journey__cta-box--split_banner {
      flex-direction: column;
      text-align: center;
    }
    .sustainability-journey__cta-box--split_banner .sustainability-journey__cta-subtitle {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 768px) {
    .sustainability-journey {
      padding: var(--journey-mpt, 48px) 0 var(--journey-mpb, 56px);
    }

    .sustainability-journey--full .sustainability-journey__container,
    .sustainability-journey--contained .sustainability-journey__container {
      padding-left: 20px;
      padding-right: 20px;
    }

    .sustainability-journey__milestone-item {
      flex: 0 0 220px;
    }

    .sustainability-journey__cta-box {
      padding: 36px 20px 44px;
    }

    .sustainability-journey__cta-title {
      font-size: 24px;
      line-height: 1.2;
      margin-bottom: 12px;
    }

    .sustainability-journey__cta-subtitle {
      font-size: 16px;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    .sustainability-journey__btn-group {
      flex-direction: column;
      width: 100%;
      gap: 12px;
      margin-bottom: 32px;
    }

    .sustainability-journey__btn-group .earth-btn-action,
    .sustainability-journey__btn-group .sustainability-journey__btn-item {
      width: 100%;
    }

    /* Vertical stacked pillars on mobile */
    .sustainability-journey__pillars {
      flex-direction: column;
      gap: 24px;
    }

    .sustainability-journey__pillar-item {
      gap: 12px;
    }

    .sustainability-journey__pillar-icon-wrap {
      width: 52px;
      height: 52px;
    }

    .sustainability-journey__pillar-label {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0.04em;
    }
  }
{% endstylesheet %}

