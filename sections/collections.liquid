      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Column gap (desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Column gap (mobile)",
      "default": 20
