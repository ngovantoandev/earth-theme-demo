          "value": "z_a",
          "label": "Alphabetically, Z-A"
        },
        {
          "value": "new",
          "label": "Date, new to old"
        },
        {
          "value": "old",
          "label": "Date, old to new"
        },
        {
          "value": "high",
          "label": "Product count, high to low"
        },
        {
          "value": "low",
          "label": "Product count, low to high"
        }
      ],
      "default": "a_z"
    },
    {
      "type": "header",
      "content": "Collection layout"
    },
    {
      "type": "select",
      "id": "grid_desktop",
      "label": "Desktop column",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "grid_mobile",
      "label": "Mobile column",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
