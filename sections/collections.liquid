{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{%- liquid
  assign make_section_page_width = section.settings.make_section_page_width

  # Outer class list
  assign section_classes = 'vt-section'

  # Inner class list
  assign inner_classes = 'vt-section__inner'
  if make_section_page_width
    assign inner_classes = inner_classes | append: ' vt-page-width'
  endif
  
  # -----------------------------------------------------------------
  # Grid columns. Full Tailwind class names are written as literals
  # so the Tailwind scanner never purges them.
  # -----------------------------------------------------------------

  case section.settings.grid_mobile
    when '2'
      assign vt_grid_mobile = 'grid-cols-2'
    else
      assign vt_grid_mobile = 'grid-cols-1'
  endcase

  # Tablet has no setting: always 2 columns, desktop comes from the setting
  assign vt_grid_tablet = 'md:grid-cols-2'

  case section.settings.grid_desktop
    when '2'
      assign vt_grid_desktop = 'lg:grid-cols-2'
    when '4'
      assign vt_grid_desktop = 'lg:grid-cols-4'
    else
      assign vt_grid_desktop = 'lg:grid-cols-3'
  endcase

  assign vt_list_classes = 'vt-collections-list ' | append: vt_grid_mobile | append: ' ' | append: vt_grid_tablet | append: ' ' | append: vt_grid_desktop
-%}

{%- comment -%} Reusable section CSS variables (padding, gap, colors) {%- endcomment -%}
{% render 'section-styles', section: section %}

<div class="{{ section_classes }}" {{ section.shopify_attributes }}>
  <div class="{{ inner_classes }}">
    
    {% content_for 'blocks' %}

    {%- paginate collections by 50 -%}
      {%- liquid
        # Sort the current page of collections (Shopify allows max 50 per page)
        case section.settings.sort_collections
          when 'z_a'
            assign vt_sorted = collections | sort_natural: 'title' | reverse
          when 'new'
            assign vt_sorted = collections | sort: 'published_at' | reverse
          when 'old'
            assign vt_sorted = collections | sort: 'published_at'
          when 'high'
            assign vt_sorted = collections | sort: 'products_count' | reverse
          when 'low'
            assign vt_sorted = collections | sort: 'products_count'
          else
            assign vt_sorted = collections | sort_natural: 'title'
        endcase
      -%}

      {%- if vt_sorted.size > 0 -%}        
        <ul
          class="{{ vt_list_classes }}"
          role="list"
          aria-label="{{ page_title | escape }}"
          style="
            --vt-collections-gap-mobile: {% render 'fluid-clamp', min_px: section.settings.column_gap_mobile, max_px: section.settings.column_gap_mobile, unit: 'rem' %};
            --vt-collections-gap-desktop: {% render 'fluid-clamp', min_px: section.settings.column_gap_desktop, max_px: section.settings.column_gap_desktop, unit: 'rem' %};
          "
        >
          {%- for collection in vt_sorted -%}
            {% content_for 'block', type: 'collection-card', id: 'vt-collection-card', closest.collection: collection %}
          {%- endfor -%}
        </ul>

        {%- assign vt_pagination_label = 'collections.pagination_label' | t -%}
        {% content_for 'block', type: 'pagination', id: 'vt-pagination', paginate: paginate, aria_label: vt_pagination_label %}
      {%- else -%}
        <p class="vt-collections-empty">{{ 'collections.empty' | t }}</p>
      {%- endif -%}
      
    {%- endpaginate -%}
  </div>
</div>


