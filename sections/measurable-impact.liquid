{% comment %}
  Measurable Impact / Metrics Section
  Left Column: Section Header & Metric Items (with optional Action Button block)
  Right Column: Gallery Image Blocks (with Asymmetric, 2x2 Equal, or Hero layouts)
  Fully responsive with Full-Width toggle (34px edge padding) and rich UI options.
{% endcomment %}

{%- liquid
  assign section_title = section.settings.title | default: section.settings.heading | default: 'Our footprint is small, but our impact is deep.'
  assign header_layout = section.settings.header_layout | default: 'stacked_left'
  assign header_btn_text = section.settings.header_btn_text
  assign header_btn_url = section.settings.header_btn_url
  assign gallery_layout = section.settings.gallery_layout | default: 'asymmetric'
  assign col_order = section.settings.column_order | default: 'content_left'
  assign v_align = section.settings.vertical_alignment | default: 'start'
  assign metric_card_style = section.settings.metric_style | default: 'clean'

  assign metric_blocks = section.blocks | where: 'type', 'metric'
  assign image_blocks = section.blocks | where: 'type', 'image_item'
  assign button_blocks = section.blocks | where: 'type', 'button'
-%}

{%- capture header_button_block -%}
  {%- for block in button_blocks -%}
    <div class="earth-section-header__btn-wrap" {{ block.shopify_attributes }}>
      {%- assign btn_style = block.settings.button_type | default: 'arrow' -%}
      {%- assign btn_theme = block.settings.arrow_theme | default: 'dark' -%}
      {%- if btn_style == 'arrow' -%}
        {% render 'btn-arrow',
          text: block.settings.button_text,
          url: block.settings.button_link,
          theme: btn_theme,
          color: block.settings.custom_color
        %}
      {%- else -%}
        {% render 'btn-action',
          text: block.settings.button_text,
          url: block.settings.button_link,
          variant: btn_style,
          custom_bg: block.settings.custom_color
        %}
      {%- endif -%}
    </div>
  {%- endfor -%}
{%- endcapture -%}

<section
  class="measurable-impact-section full-width{% if section.settings.full_width %} measurable-impact-section--full{% else %} measurable-impact-section--contained{% endif %} measurable-impact-section--order-{{ col_order }} measurable-impact-section--valign-{{ v_align }} measurable-impact-section--gallery-{{ gallery_layout }} measurable-impact-section--style-{{ metric_card_style }}"
  id="measurableImpact-{{ section.id }}"
  style="
    --mi-bg-color: {{ section.settings.bg_color | default: '#F1F4D8' }};
    --mi-text-color: {{ section.settings.text_color | default: '#003225' }};
    --mi-pt: {{ section.settings.padding_top | default: 115 }}px;
    --mi-pb: {{ section.settings.padding_bottom | default: 96 }}px;
    --mi-mpt: {{ section.settings.mobile_padding_top | default: 48 }}px;
    --mi-mpb: {{ section.settings.mobile_padding_bottom | default: 56 }}px;
    --mi-card-radius: {{ section.settings.image_corner_radius | default: 0 }}px;
    --mi-metric-num-color: {{ section.settings.metric_number_color | default: section.settings.text_color | default: '#003225' }};
    --mi-metric-text-color: {{ section.settings.metric_text_color | default: section.settings.text_color | default: '#003225' }};
    --mi-metric-icon-color: {{ section.settings.metric_icon_color | default: '#556B3A' }};
    --mi-metric-card-bg: {{ section.settings.metric_card_bg | default: '#ffffff' }};
    --mi-metric-card-border: {{ section.settings.metric_card_border | default: 'rgba(0, 50, 37, 0.12)' }};
  "
>
  <div class="measurable-impact__container">
    
    <!-- Left / Content Column: Header & Metrics List -->
    <div class="measurable-impact__left">
      <!-- 1. Unified Section Header -->
      <div class="measurable-impact__header-wrap">
        {% render 'section-header',
          layout: header_layout,
          title: section_title,
          eyebrow: section.settings.eyebrow,
          show_eyebrow_icon: section.settings.show_eyebrow_icon,
          eyebrow_color: section.settings.eyebrow_color,
          eyebrow_size_desktop: section.settings.eyebrow_size_desktop,
          eyebrow_size_mobile: section.settings.eyebrow_size_mobile,
          subtitle: section.settings.subtitle,
          subtitle_color: section.settings.subtitle_color,
          subtitle_size_desktop: section.settings.subtitle_size_desktop,
          subtitle_size_mobile: section.settings.subtitle_size_mobile,
          show_leaf: section.settings.show_leaf_icons,
          leaf_position: section.settings.leaf_position,
          leaf_color: section.settings.leaf_color,
          leaf_size: section.settings.leaf_size,
          leaf_gap: section.settings.leaf_gap,
          btn_text: header_btn_text,
          btn_url: header_btn_url,
          btn_type: section.settings.header_btn_type,
          btn_theme: section.settings.header_btn_theme,
          btn_color: section.settings.header_btn_color,
          btn_block: header_button_block,
          title_color: section.settings.title_color,
          text_color: section.settings.text_color
        %}
      </div>

      <!-- 2. Metrics List -->
      <div class="measurable-impact__metrics-list measurable-impact__metrics-list--{{ metric_card_style }}">
        {%- if metric_blocks.size > 0 -%}
          {%- for block in metric_blocks -%}
            {%- assign icon_pos = block.settings.icon_position | default: 'right' -%}
            {%- assign icon_type = block.settings.icon_type | default: 'smile' -%}
            <div class="measurable-impact__metric-item measurable-impact__metric-item--{{ metric_card_style }}" {{ block.shopify_attributes }}>
              <div class="measurable-impact__metric-header measurable-impact__metric-header--{{ icon_pos }}">
                {%- capture icon_markup -%}
                  {%- if block.settings.show_smile != false and icon_type != 'none' -%}
                    <span class="measurable-impact__smile-icon" aria-hidden="true">
                      {%- if block.settings.custom_icon != blank -%}
                        <img src="{{ block.settings.custom_icon | image_url: width: 120 }}" width="52" height="52" alt="" loading="lazy">
                      {%- elsif icon_type == 'smile' -%}
                        {{ 'icon-smile.svg' | inline_asset_content }}
                      {%- elsif icon_type == 'leaf' -%}
                        {{ 'icon-leaf-2.svg' | inline_asset_content }}
                      {%- elsif icon_type == 'drop' -%}
                        {{ 'icon-Drop.svg' | inline_asset_content }}
                      {%- elsif icon_type == 'tree' -%}
                        {{ 'icon-tree.svg' | inline_asset_content }}
                      {%- elsif icon_type == 'co2' -%}
                        {{ 'icon-zero-emissions.svg' | inline_asset_content }}
                      {%- elsif icon_type == 'sparkle' -%}
                        <span class="measurable-impact__sparkle-text">✨</span>
                      {%- else -%}
                        {{ 'icon-smile.svg' | inline_asset_content }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                {%- endcapture -%}

                {%- if icon_pos == 'left' -%}
                  {{ icon_markup }}
                  <span class="measurable-impact__metric-number">{{ block.settings.number }}</span>
                {%- else -%}
                  <span class="measurable-impact__metric-number">{{ block.settings.number }}</span>
                  {{ icon_markup }}
                {%- endif -%}
              </div>
              {%- if block.settings.text != blank -%}
                <div class="measurable-impact__metric-text">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Fallback Metrics if no metric blocks configured -->
          <div class="measurable-impact__metric-item measurable-impact__metric-item--{{ metric_card_style }}">
            <div class="measurable-impact__metric-header measurable-impact__metric-header--right">
              <span class="measurable-impact__metric-number">50k+</span>
              <span class="measurable-impact__smile-icon" aria-hidden="true">
                {{ 'icon-smile.svg' | inline_asset_content }}
              </span>
            </div>
            <div class="measurable-impact__metric-text">
              <p>Liters of water saved compared to traditional manufacturing processes.</p>
            </div>
          </div>

          <div class="measurable-impact__metric-item measurable-impact__metric-item--{{ metric_card_style }}">
            <div class="measurable-impact__metric-header measurable-impact__metric-header--left">
              <span class="measurable-impact__smile-icon" aria-hidden="true">
                {{ 'icon-smile.svg' | inline_asset_content }}
              </span>
              <span class="measurable-impact__metric-number">100%</span>
            </div>
            <div class="measurable-impact__metric-text">
              <p>Plastic-free packaging. Every box we ship returns to the earth as compost.</p>
            </div>
          </div>

          <div class="measurable-impact__metric-item measurable-impact__metric-item--{{ metric_card_style }}">
            <div class="measurable-impact__metric-header measurable-impact__metric-header--right">
              <span class="measurable-impact__metric-number">12,400</span>
              <span class="measurable-impact__smile-icon" aria-hidden="true">
                {{ 'icon-smile.svg' | inline_asset_content }}
              </span>
            </div>
            <div class="measurable-impact__metric-text">
              <p>Native trees planted across our partner organic farms this year.</p>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Right / Media Column: Image Gallery Blocks -->
    <div class="measurable-impact__right">
      <div class="measurable-impact__gallery-grid measurable-impact__gallery-grid--{{ gallery_layout }} measurable-impact__gallery-grid--hover-{{ section.settings.image_hover_effect | default: 'zoom' }}">
        {%- if image_blocks.size > 0 -%}
          {%- case gallery_layout -%}
            {%- when 'equal_grid' -%}
              <!-- 2x2 Equal Grid -->
              <div class="measurable-impact__gallery-equal">
                {%- for block in image_blocks -%}
                  {%- assign shape_class = block.settings.shape -%}
                  {%- if shape_class == 'auto' or shape_class == blank -%}
                    {%- assign shape_class = 'square' -%}
                  {%- endif -%}
                  <div class="measurable-impact__gallery-item measurable-impact__gallery-item--{{ shape_class }}" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: 'Impact gallery image' }}
                    {%- else -%}
                      {%- assign img_idx = forloop.index | modulo: 4 -%}
                      {%- if img_idx == 0 -%}{%- assign img_idx = 4 -%}{%- endif -%}
                      {%- assign fallback_name = 'impact-' | append: img_idx | append: '.jpg' -%}
                      <img src="{{ fallback_name | asset_url }}" width="400" height="400" alt="Impact image" loading="lazy">
                    {%- endif -%}
                    {%- if block.settings.badge != blank -%}
                      <span class="measurable-impact__img-badge">{{ block.settings.badge }}</span>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>

            {%- when 'single_hero' -%}
              <!-- 1 Big Hero Top + Mini Thumbnails Bottom -->
              <div class="measurable-impact__gallery-hero">
                {%- for block in image_blocks -%}
                  {%- if forloop.first -%}
                    <div class="measurable-impact__gallery-item measurable-impact__gallery-item--hero" {{ block.shopify_attributes }}>
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: 'Main impact image' }}
                      {%- else -%}
                        <img src="{{ 'impact-1.jpg' | asset_url }}" width="700" height="440" alt="Sustainable fashion showcase" loading="lazy">
                      {%- endif -%}
                      {%- if block.settings.badge != blank -%}
                        <span class="measurable-impact__img-badge">{{ block.settings.badge }}</span>
                      {%- endif -%}
                    </div>
                    <div class="measurable-impact__gallery-row">
                  {%- else -%}
                    <div class="measurable-impact__gallery-item measurable-impact__gallery-item--thumb" {{ block.shopify_attributes }}>
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: 'Thumbnail image' }}
                      {%- else -%}
                        {%- assign img_idx = forloop.index | modulo: 4 -%}
                        {%- if img_idx == 0 -%}{%- assign img_idx = 4 -%}{%- endif -%}
                        {%- assign fallback_name = 'impact-' | append: img_idx | append: '.jpg' -%}
                        <img src="{{ fallback_name | asset_url }}" width="220" height="220" alt="Thumbnail" loading="lazy">
                      {%- endif -%}
                      {%- if block.settings.badge != blank -%}
                        <span class="measurable-impact__img-badge">{{ block.settings.badge }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- if forloop.last and forloop.index > 1 -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- else -%}
              <!-- Asymmetric Staggered Grid (Design Default) -->
              <div class="measurable-impact__gallery-col measurable-impact__gallery-col--left">
                {%- assign col1_count = 0 -%}
                {%- for block in image_blocks -%}
                  {%- assign is_col1 = forloop.index | modulo: 2 -%}
                  {%- if is_col1 == 1 -%}
                    {%- assign default_shape = 'portrait' -%}
                    {%- if col1_count > 0 -%}{%- assign default_shape = 'square' -%}{%- endif -%}
                    {%- assign item_shape = block.settings.shape -%}
                    {%- if item_shape == 'auto' or item_shape == blank -%}{%- assign item_shape = default_shape -%}{%- endif -%}
                    <div class="measurable-impact__gallery-item measurable-impact__gallery-item--{{ item_shape }}" {{ block.shopify_attributes }}>
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: 'Impact Gallery Image' }}
                      {%- else -%}
                        {%- assign img_idx = forloop.index | modulo: 4 -%}
                        {%- if img_idx == 0 -%}{%- assign img_idx = 4 -%}{%- endif -%}
                        {%- assign fallback_name = 'impact-' | append: img_idx | append: '.jpg' -%}
                        <img src="{{ fallback_name | asset_url }}" width="346" height="448" alt="Impact image" loading="lazy">
                      {%- endif -%}
                      {%- if block.settings.badge != blank -%}
                        <span class="measurable-impact__img-badge">{{ block.settings.badge }}</span>
                      {%- endif -%}
                    </div>
                    {%- assign col1_count = col1_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <div class="measurable-impact__gallery-col measurable-impact__gallery-col--right">
                {%- assign col2_count = 0 -%}
                {%- for block in image_blocks -%}
                  {%- assign is_col1 = forloop.index | modulo: 2 -%}
                  {%- if is_col1 == 0 -%}
                    {%- assign default_shape = 'square' -%}
                    {%- if col2_count > 0 -%}{%- assign default_shape = 'portrait' -%}{%- endif -%}
                    {%- assign item_shape = block.settings.shape -%}
                    {%- if item_shape == 'auto' or item_shape == blank -%}{%- assign item_shape = default_shape -%}{%- endif -%}
                    <div class="measurable-impact__gallery-item measurable-impact__gallery-item--{{ item_shape }}" {{ block.shopify_attributes }}>
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: 'Impact Gallery Image' }}
                      {%- else -%}
                        {%- assign img_idx = forloop.index | modulo: 4 -%}
                        {%- if img_idx == 0 -%}{%- assign img_idx = 4 -%}{%- endif -%}
                        {%- assign fallback_name = 'impact-' | append: img_idx | append: '.jpg' -%}
                        <img src="{{ fallback_name | asset_url }}" width="346" height="448" alt="Impact image" loading="lazy">
                      {%- endif -%}
                      {%- if block.settings.badge != blank -%}
                        <span class="measurable-impact__img-badge">{{ block.settings.badge }}</span>
                      {%- endif -%}
                    </div>
                    {%- assign col2_count = col2_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
          {%- endcase -%}
        {%- else -%}
          <!-- Default Fallback if no image blocks configured in Theme Editor -->
          <div class="measurable-impact__gallery-col measurable-impact__gallery-col--left">
            <div class="measurable-impact__gallery-item measurable-impact__gallery-item--portrait">
              <img src="{{ 'impact-1.jpg' | asset_url }}" width="346" height="448" alt="Sustainable fashion model in linen dress" loading="lazy">
            </div>
            <div class="measurable-impact__gallery-item measurable-impact__gallery-item--square">
              <img src="{{ 'impact-3.jpg' | asset_url }}" width="346" height="346" alt="Folded organic wool knitwear sweaters" loading="lazy">
            </div>
          </div>
          <div class="measurable-impact__gallery-col measurable-impact__gallery-col--right">
            <div class="measurable-impact__gallery-item measurable-impact__gallery-item--square">
              <img src="{{ 'impact-2.jpg' | asset_url }}" width="346" height="346" alt="Man in olive organic polo shirt" loading="lazy">
            </div>
            <div class="measurable-impact__gallery-item measurable-impact__gallery-item--portrait">
              <img src="{{ 'impact-4.jpg' | asset_url }}" width="346" height="448" alt="Couple walking outdoors in sustainable clothing" loading="lazy">
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  /* ==========================================================================
     Measurable Impact Section (Full Width background with inner element control)
     ========================================================================== */
  .measurable-impact-section {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: var(--mi-bg-color, #F1F4D8);
    color: var(--mi-text-color, #003225);
    padding: var(--mi-pt, 115px) 0 var(--mi-pb, 96px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .measurable-impact__container {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
    box-sizing: border-box;
  }

  /* 1. Full Width Mode (Inner elements expand edge-to-edge with 34px padding) */
  .measurable-impact-section--full .measurable-impact__container {
    max-width: 100%;
    padding-left: clamp(20px, 2.5vw, 34px);
    padding-right: clamp(20px, 2.5vw, 34px);
    margin: 0 auto;
  }

  /* 2. Contained Mode (Inner elements constrained by Page Max Width & Page Margin) */
  .measurable-impact-section--contained .measurable-impact__container {
    max-width: var(--page-width, 1920px);
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(20px, 3vw, var(--page-margin, 20px));
    padding-right: clamp(20px, 3vw, var(--page-margin, 20px));
  }

  /* Column Order Modifiers */
  .measurable-impact-section--order-content_right .measurable-impact__container {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  }
  .measurable-impact-section--order-content_right .measurable-impact__left {
    order: 2;
  }
  .measurable-impact-section--order-content_right .measurable-impact__right {
    order: 1;
  }

  /* Vertical Alignment */
  .measurable-impact-section--valign-center .measurable-impact__container {
    align-items: center;
  }

  /* Left Column Styling */
  .measurable-impact__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 600px;
    min-width: 0;
  }

  .measurable-impact__header-wrap {
    width: 100%;
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  /* Metrics List */
  .measurable-impact__metrics-list {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3.5vw, 44px);
    width: 100%;
  }

  /* Style 1: Clean (Default Minimalist) */
  .measurable-impact__metric-item--clean {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Style 2: Cards */
  .measurable-impact__metric-item--cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background-color: var(--mi-metric-card-bg, #ffffff);
    padding: clamp(20px, 2.5vw, 28px);
    border-radius: var(--mi-card-radius, 0px);
    box-shadow: 0 4px 20px rgba(0, 50, 37, 0.05);
    border: 1px solid var(--mi-metric-card-border, rgba(0, 50, 37, 0.08));
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .measurable-impact__metric-item--cards:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0, 50, 37, 0.1);
  }

  /* Style 3: Bordered */
  .measurable-impact__metric-item--bordered {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(18px, 2vw, 24px);
    border-radius: var(--mi-card-radius, 0px);
    border: 1.5px solid var(--mi-metric-card-border, rgba(0, 50, 37, 0.18));
    background-color: transparent;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .measurable-impact__metric-item--bordered:hover {
    background-color: rgba(255, 255, 255, 0.35);
  }

  .measurable-impact__metric-header {
    display: inline-flex;
    align-items: center;
    gap: 16px;
  }

  .measurable-impact__metric-number {
    font-size: clamp(2.5rem, 4.4vw, 3.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--mi-metric-num-color, #003225);
  }

  .measurable-impact__smile-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(44px, 3.8vw, 56px);
    height: clamp(44px, 3.8vw, 56px);
    flex-shrink: 0;
    color: var(--mi-metric-icon-color, #556B3A);
  }

  .measurable-impact__smile-icon img,
  .measurable-impact__smile-icon svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    fill: currentColor;
  }

  .measurable-impact__sparkle-text {
    font-size: 2.2rem;
    line-height: 1;
  }

  .measurable-impact__metric-text {
    font-size: clamp(0.9375rem, 1.2vw, 1.09375rem);
    line-height: 1.45;
    color: var(--mi-metric-text-color, #003225);
    margin: 0;
    max-width: 460px;
    letter-spacing: -0.01em;
    opacity: 0.92;
  }
  .measurable-impact__metric-text p {
    margin: 0;
  }

  /* Right Column Styling: Gallery */
  .measurable-impact__right {
    width: 100%;
    min-width: 0;
  }

  /* Layout 1: Asymmetric Staggered Grid */
  .measurable-impact__gallery-grid--asymmetric {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.5vw, 30px);
    width: 100%;
  }

  .measurable-impact__gallery-col {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2.5vw, 30px);
  }

  .measurable-impact__gallery-item {
    position: relative;
    border-radius: var(--mi-card-radius, 0px);
    overflow: hidden;
    background-color: rgba(0, 50, 37, 0.04);
    width: 100%;
    box-sizing: border-box;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }

  .measurable-impact__gallery-item--portrait {
    aspect-ratio: 346 / 448;
    width: 100%;
    overflow: hidden;
  }

  .measurable-impact__gallery-item--square {
    aspect-ratio: 346 / 346;
    width: 100%;
    overflow: hidden;
  }

  .measurable-impact__gallery-item--landscape {
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
  }

  .measurable-impact__gallery-item--hero {
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
  }

  .measurable-impact__gallery-item--thumb {
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
  }

  .measurable-impact__gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Layout 2: Equal 2x2 Grid */
  .measurable-impact__gallery-equal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.5vw, 24px);
    width: 100%;
  }

  /* Layout 3: Hero + Thumbs */
  .measurable-impact__gallery-hero {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }
  .measurable-impact__gallery-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  /* Floating Image Badge */
  .measurable-impact__img-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    z-index: 2;
    background-color: rgba(0, 50, 37, 0.88);
    color: #F8F9DC;
    font-size: 13px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 20px;
    letter-spacing: 0.02em;
    backdrop-filter: blur(4px);
  }

  /* Hover Effects */
  .measurable-impact__gallery-grid--hover-zoom .measurable-impact__gallery-item:hover img {
    transform: scale(1.05);
  }
  .measurable-impact__gallery-grid--hover-lift .measurable-impact__gallery-item:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 50, 37, 0.16);
  }
  .measurable-impact__gallery-grid--hover-glow .measurable-impact__gallery-item:hover {
    box-shadow: 0 0 0 2px var(--color-secondary, #71CC3B), 0 12px 28px rgba(113, 204, 59, 0.2);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .measurable-impact-section {
      padding: var(--mi-mpt, 60px) 0 var(--mi-mpb, 70px);
    }

    .measurable-impact-section--full .measurable-impact__container,
    .measurable-impact-section--contained .measurable-impact__container {
      padding-left: 24px;
      padding-right: 24px;
    }

    .measurable-impact__container {
      grid-template-columns: 1fr !important;
      gap: 48px;
    }

    .measurable-impact__left {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .measurable-impact-section {
      padding: var(--mi-mpt, 48px) 0 var(--mi-mpb, 56px);
    }

    .measurable-impact-section--full .measurable-impact__container,
    .measurable-impact-section--contained .measurable-impact__container {
      padding-left: 20px;
      padding-right: 20px;
    }

    .measurable-impact__container {
      gap: 36px;
    }

    .measurable-impact__header-wrap {
      margin-bottom: 24px;
    }

    .measurable-impact__metrics-list {
      gap: 24px;
    }

    .measurable-impact__metric-number {
      font-size: 2.375rem;
    }

    .measurable-impact__smile-icon {
      width: 42px;
      height: 42px;
    }

    .measurable-impact__metric-text {
      font-size: 0.9375rem;
      line-height: 1.4;
    }

    .measurable-impact__gallery-grid--asymmetric {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .measurable-impact__gallery-col {
      gap: 16px;
    }
  }
{% endstylesheet %}

