{%- comment -%}
  Section: Shop by Values
  Container wrapper for theme blocks (stack, heading-group, value-tabs, etc.).
  Features an interactive carousel of brand value cards with bottom tab navigation.
  Supports full width, theme color tokens, and responsive section padding.
{%- endcomment -%}

{%- liquid
  assign make_section_page_width = section.settings.make_section_page_width

  assign section_bg = section.settings.background_color
  if section_bg != blank and section_bg != 'rgba(0,0,0,0)' and section_bg != '#00000000'
    assign background_color = section_bg
  else
    assign background_color = 'var(--vt-foreground-color, var(--color-black, #003225))'
  endif

  assign section_heading_color = section.settings.heading_color
  if section_heading_color != blank and section_heading_color != 'rgba(0,0,0,0)' and section_heading_color != '#00000000'
    assign heading_color = section_heading_color
  else
    assign heading_color = 'var(--vt-background-color, var(--color-white, #F8F9DC))'
  endif

  assign section_paragraph_color = section.settings.paragraph_color
  if section_paragraph_color != blank and section_paragraph_color != 'rgba(0,0,0,0)' and section_paragraph_color != '#00000000'
    assign paragraph_color = section_paragraph_color
  else
    assign paragraph_color = 'var(--vt-background-color, var(--color-white, #F8F9DC))'
  endif
  assign pad_ph_desktop = section.settings.padding_horizontal
  if pad_ph_desktop == blank
    assign pad_ph_desktop = 34
  endif
  assign pad_ph_mobile = section.settings.padding_horizontal_mobile
  if pad_ph_mobile == blank
    assign pad_ph_mobile = 20
  endif
-%}

<div
  class="vt-shop-by-values{% unless make_section_page_width %} vt-page-full-width{% endunless %}"
  id="vtShopByValues-{{ section.id }}"
  style="
    --vt-bg: {{ background_color }};
    --vt-heading-color: {{ heading_color }};
    --vt-paragraph-color: {{ paragraph_color }};
    --vt-pt: {{ section.settings.padding_top | default: 80 }}px;
    --vt-pb: {{ section.settings.padding_bottom | default: 96 }}px;
    --vt-ph: {{ pad_ph_desktop }}px;
    --vt-pt-mobile: {{ section.settings.padding_top_mobile | default: 48 }}px;
    --vt-pb-mobile: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    --vt-ph-mobile: {{ pad_ph_mobile }}px;
    --vt-page-padding: {{ pad_ph_desktop }}px;
    --vt-page-padding-mobile: {{ pad_ph_mobile }}px;
    --vt-block-gap: {{ section.settings.block_gap | default: 56 }}px;
    --vt-block-gap-mobile: {{ section.settings.block_gap_mobile | default: 36 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-shop-by-values__container{% if make_section_page_width %} vt-page-width{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-shop-by-values {
    width: 100%;
    background-color: var(--vt-bg, var(--vt-foreground-color, var(--color-black, #003225)));
    padding-top: var(--vt-pt, 80px);
    padding-bottom: var(--vt-pb, 96px);
    box-sizing: border-box;
    overflow-x: hidden; /* fallback for browsers without overflow: clip */
    overflow-x: clip;
    position: relative;
  }

  .vt-shop-by-values__container {
    width: 100%;
    min-width: 0;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--vt-block-gap, 56px);
    padding-left: var(--vt-ph, 34px);
    padding-right: var(--vt-ph, 34px);
  }

  .vt-shop-by-values__container:not(.vt-page-width) {
    max-width: 100%;
  }

  /* Support Theme Editor wrappers without altering layout */
  .vt-shop-by-values__container > .shopify-block,
  .vt-shop-by-values__container > shopify-block {
    display: contents;
  }

  /* Scoped section heading & paragraph styling */
  .vt-shop-by-values > .vt-shop-by-values__container > .vt-heading,
  .vt-shop-by-values .vt-heading-group,
  .vt-shop-by-values .vt-heading-group .vt-heading,
  .vt-shop-by-values .vt-subheading {
    color: var(--vt-heading-color, var(--vt-background-color, var(--color-white, #F8F9DC)));
  }

  .vt-shop-by-values .vt-heading-group .vt-heading {
    color: inherit;
  }

  .vt-shop-by-values .vt-paragraph {
    color: var(--vt-paragraph-color, var(--vt-background-color, var(--color-white, #F8F9DC)));
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .vt-shop-by-values__container {
      padding-left: var(--vt-ph, 34px);
      padding-right: var(--vt-ph, 34px);
    }
  }

  @media screen and (max-width: 749px) {
    .vt-shop-by-values {
      padding-top: var(--vt-pt-mobile, 48px);
      padding-bottom: var(--vt-pb-mobile, 48px);
    }

    .vt-shop-by-values__container {
      padding-left: var(--vt-ph-mobile, 0px);
      padding-right: var(--vt-ph-mobile, 0px);
      gap: var(--vt-block-gap-mobile, 36px);
    }
  }
{% endstylesheet %}

