{% comment %}
  Header Section - Earth Shopify Theme
  Configurable header with multi-layout support, sticky options, icon sizing,
  language/country selectors, mobile layout options, drawer menu, and styling controls.
{% endcomment %}

{%- liquid
  assign main_menu = section.settings.menu
  assign drawer_menu = section.settings.drawer_menu | default: section.settings.menu
  assign layout = section.settings.header_layout | default: 'logo_center_menu_left'
  assign icon_size = section.settings.icons_size | default: 'large'
  assign icon_size_class = 'earth-header--icons-' | append: icon_size
  assign sticky_mode = section.settings.sticky_header | default: 'always'
-%}

<div 
  class="earth-header-wrapper{% if section.settings.full_width %} full-width{% endif %} earth-header--sticky-{{ sticky_mode }} {{ icon_size_class }}"
  id="earthHeaderWrapper-{{ section.id }}"
  style="
    --header-bg: {{ section.settings.bg_color | default: '#f3f6e4' }};
    --header-color: {{ section.settings.text_color | default: '#224E09' }};
    --header-pt: {{ section.settings.top_padding | default: 0 }}px;
    --header-pb: {{ section.settings.bottom_padding | default: 0 }}px;
    --header-radius: {% if section.settings.rounded %}16px{% else %}0px{% endif %};
  "
>
  <header class="earth-main-header earth-header--layout-{{ layout }}{% if section.settings.rounded %} earth-header--rounded{% endif %}">
    <div class="earth-header-container{% if section.settings.full_width %} earth-header-container--full{% endif %}">
      
      <!-- Drawer / Hamburger Button (Mobile + Drawer Layouts) -->
      <button 
        type="button" 
        class="earth-header__mobile-menu-btn{% if layout == 'logo_left_menu_drawer' or layout == 'logo_center_menu_drawer' %} earth-header__drawer-btn--desktop{% endif %}" 
        id="earthMobileMenuBtn-{{ section.id }}" 
        aria-label="Toggle navigation"
      >
        <img src="{{ 'mobile_menu.svg' | asset_url }}" width="24" height="18" alt="Menu" class="earth-header__mobile-menu-icon">
        {%- if section.settings.menu_drawer_icon_label != blank -%}
          <span class="earth-header__drawer-btn-label">{{ section.settings.menu_drawer_icon_label }}</span>
        {%- endif -%}
      </button>

      <!-- Left Navigation Menu (for logo_center_menu_left, logo_left_menu_left, logo_center_menu_split) -->
      {%- if layout == 'logo_center_menu_left' or layout == 'logo_left_menu_left' or layout == 'logo_left_menu_center' or layout == 'logo_center_menu_split' -%}
        <nav class="earth-header__nav-left earth-header__nav--{{ layout }}" aria-label="Main Navigation">
          {%- if main_menu != blank and main_menu.links.size > 0 -%}
            {%- if layout == 'logo_center_menu_split' -%}
              {%- assign half_count = main_menu.links.size | divided_by: 2 -%}
              {%- for link in main_menu.links limit: half_count -%}
                <a href="{{ link.url }}" class="earth-header__nav-link">{{ link.title }}</a>
              {%- endfor -%}
            {%- else -%}
              {%- for link in main_menu.links -%}
                <a href="{{ link.url }}" class="earth-header__nav-link">{{ link.title }}</a>
              {%- endfor -%}
            {%- endif -%}
          {%- else -%}
            <a href="{{ routes.root_url }}" class="earth-header__nav-link">Home</a>
            <a href="{{ routes.all_products_collection_url }}" class="earth-header__nav-link">Shop</a>
            <a href="/blogs/news" class="earth-header__nav-link">Blog</a>
            <a href="/pages/about" class="earth-header__nav-link">About</a>
            <a href="/pages/contact" class="earth-header__nav-link">Contact</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

      <!-- Logo Area (H1 or DIV for SEO) -->
      {%- capture logo_markup -%}
        <a href="{{ routes.root_url }}" class="earth-header__logo-link" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 300 | image_tag: class: 'earth-header__logo-img', alt: shop.name, loading: 'eager' }}
          {%- else -%}
            <img src="{{ 'Earth-logo.svg' | asset_url }}" alt="earth" width="82" height="24" class="earth-header__logo-img" loading="eager">
          {%- endif -%}
        </a>
      {%- endcapture -%}

      {%- if request.page_type == 'index' and section.settings.enable_logo_h1 -%}
        <h1 class="earth-header__logo-wrapper earth-header__logo--mobile-{{ section.settings.mobile_logo_position | default: 'center' }}">
          {{ logo_markup }}
        </h1>
      {%- else -%}
        <div class="earth-header__logo-wrapper earth-header__logo--mobile-{{ section.settings.mobile_logo_position | default: 'center' }}">
          {{ logo_markup }}
        </div>
      {%- endif -%}

      <!-- Split Menu Right Side (for logo_center_menu_split) -->
      {%- if layout == 'logo_center_menu_split' -%}
        <nav class="earth-header__nav-split-right" aria-label="Secondary Navigation">
          {%- if main_menu != blank and main_menu.links.size > 0 -%}
            {%- assign half_count = main_menu.links.size | divided_by: 2 -%}
            {%- for link in main_menu.links offset: half_count -%}
              <a href="{{ link.url }}" class="earth-header__nav-link">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </nav>
      {%- endif -%}

      <!-- Right Utility Actions -->
      <div class="earth-header__actions-right">
        <!-- Desktop Language Selector -->
        {%- if section.settings.enable_language_selector -%}
          <div class="earth-header__language-selector">
            <span class="earth-header__language-label">{{ localization.language.endonym_name | default: 'English' | capitalize }}</span>
            <img src="{{ 'icon-down.svg' | asset_url }}" width="10" height="5" alt="" class="earth-header__selector-arrow">
          </div>
        {%- endif -%}

        <!-- Desktop Country / Region Selector -->
        {%- if section.settings.enable_country_selector -%}
          <div class="earth-header__country-selector">
            <span class="earth-header__country-label">
              {%- if localization.country -%}
                {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
              {%- else -%}
                United States (USD $)
              {%- endif -%}
            </span>
            <img src="{{ 'icon-down.svg' | asset_url }}" width="11" height="6" alt="" class="earth-header__country-arrow">
          </div>
        {%- endif -%}

        <!-- Search Icon -->
        <a href="{{ routes.search_url }}" class="earth-header__icon-btn earth-header__search-btn" aria-label="Search">
          <img src="{{ 'search.svg' | asset_url }}" width="22" height="22" alt="Search">
        </a>

        <!-- Account / User Icon -->
        {%- if shop.customer_accounts_enabled or true -%}
          <a href="{{ routes.account_url }}" class="earth-header__icon-btn earth-header__account-btn" aria-label="Customer Account">
            <img src="{{ 'icon-account.svg' | asset_url }}" width="20" height="21" alt="Account">
          </a>
        {%- endif -%}

        <!-- Cart Bag Icon with Badge -->
        <a href="{{ routes.cart_url }}" class="earth-header__icon-btn earth-header__cart-link" aria-label="Cart">
          <div class="earth-header__cart-icon-wrapper">
            <img src="{{ 'icon-cart.svg' | asset_url }}" width="18" height="23" alt="Cart">
            <span class="earth-header__cart-badge">{{ cart.item_count | default: 0 }}</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Below Navigation Bar (for logo_center_menu_below) -->
    {%- if layout == 'logo_center_menu_below' -%}
      <div class="earth-header__nav-below-container">
        <nav class="earth-header__nav-below" aria-label="Main Navigation Below">
          {%- if main_menu != blank and main_menu.links.size > 0 -%}
            {%- for link in main_menu.links -%}
              <a href="{{ link.url }}" class="earth-header__nav-link">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </nav>
      </div>
    {%- endif -%}

    <!-- Mobile Drawer Menu -->
    <div class="earth-mobile-drawer" id="earthMobileDrawer-{{ section.id }}" aria-hidden="true">
      <div class="earth-mobile-drawer__overlay" id="earthDrawerOverlay-{{ section.id }}"></div>
      <div class="earth-mobile-drawer__panel">
        <div class="earth-mobile-drawer__top">
          <a href="{{ routes.root_url }}">
            <img src="{{ 'Earth-logo.svg' | asset_url }}" alt="{{ shop.name }}" width="82" height="24">
          </a>
          <button type="button" class="earth-mobile-drawer__close" id="earthDrawerCloseBtn-{{ section.id }}" aria-label="Close menu">
            <svg width="18" height="18" viewBox="0 0 14 14" fill="none">
              <path d="M13 1L1 13M1 1L13 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <!-- Drawer Links & Accordion Navigation -->
        <nav class="earth-mobile-drawer__links">
          {%- if drawer_menu != blank and drawer_menu.links.size > 0 -%}
            {%- for link in drawer_menu.links -%}
              {%- if link.links.size > 0 and section.settings.enable_accordion_menu -%}
                <div class="earth-mobile-drawer__accordion-item">
                  <button type="button" class="earth-mobile-drawer__accordion-toggle" aria-expanded="false">
                    <span>{{ link.title }}</span>
                    <img src="{{ 'icon-down.svg' | asset_url }}" width="10" height="6" alt="" class="earth-mobile-drawer__accordion-arrow">
                  </button>
                  <div class="earth-mobile-drawer__accordion-content">
                    {%- for childlink in link.links -%}
                      <a href="{{ childlink.url }}" class="earth-mobile-drawer__sublink">{{ childlink.title }}</a>
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
                <a href="{{ link.url }}" class="earth-mobile-drawer__link">{{ link.title }}</a>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <a href="{{ routes.root_url }}" class="earth-mobile-drawer__link">Home</a>
            <a href="{{ routes.all_products_collection_url }}" class="earth-mobile-drawer__link">Shop</a>
            <a href="/blogs/news" class="earth-mobile-drawer__link">Blog</a>
            <a href="/pages/about" class="earth-mobile-drawer__link">About</a>
            <a href="/pages/contact" class="earth-mobile-drawer__link">Contact</a>
          {%- endif -%}
        </nav>

        <!-- Drawer Footer: Language / Country Selectors & Social Media -->
        <div class="earth-mobile-drawer__footer">
          {%- if section.settings.mobile_enable_language_selector -%}
            <div class="earth-mobile-drawer__selector-row">
              <span class="earth-mobile-drawer__selector-label">{{ localization.language.endonym_name | default: 'English' | capitalize }}</span>
              <img src="{{ 'icon-down.svg' | asset_url }}" width="10" height="6" alt="">
            </div>
          {%- endif -%}

          {%- if section.settings.mobile_enable_country_selector -%}
            <div class="earth-mobile-drawer__selector-row">
              <span class="earth-mobile-drawer__selector-label">
                {%- if localization.country -%}
                  {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
                {%- else -%}
                  United States (USD $)
                {%- endif -%}
              </span>
              <img src="{{ 'icon-down.svg' | asset_url }}" width="10" height="6" alt="">
            </div>
          {%- endif -%}

          {%- if section.settings.show_social_media_icons -%}
            <div class="earth-mobile-drawer__social-icons">
              {%- if settings.social_facebook_link != blank -%}
                <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook" class="earth-mobile-drawer__social-link">FB</a>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram" class="earth-mobile-drawer__social-link">IG</a>
              {%- endif -%}
              {%- if settings.social_twitter_link != blank -%}
                <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="X / Twitter" class="earth-mobile-drawer__social-link">X</a>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok" class="earth-mobile-drawer__social-link">TT</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </header>
</div>

{% stylesheet %}
  .earth-header-wrapper {
    width: 100%;
    color: var(--header-color, #171717);
    font-family: inherit;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  /* Sticky Header Options */
  .earth-header-wrapper.earth-header--sticky-always {
    position: sticky;
    top: 0;
    z-index: 999;
  }

  .earth-header-wrapper.earth-header--sticky-on_scroll_up {
    position: sticky;
    top: 0;
    z-index: 999;
    transition: transform 0.3s ease;
  }

  .earth-header-wrapper.earth-header--sticky-none {
    position: relative;
  }

  .earth-header-wrapper.earth-header-hidden {
    transform: translateY(-100%);
  }

  /* Main Header Container */
  .earth-main-header {
    background-color: var(--header-bg, #f3f6e4);
    color: var(--header-color, #224E09);
    border-bottom: 1px solid rgba(34, 78, 9, 0.08);
    width: 100%;
    border-radius: var(--header-radius, 0px);
    box-sizing: border-box;
    transition: background-color 0.3s ease;
  }

  .earth-header--rounded {
    overflow: hidden;
  }

  .earth-header-container {
    width: 100%;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    min-height: 70px;
    padding-top: var(--header-pt, 0px);
    padding-bottom: var(--header-pb, 0px);
    padding-left: clamp(20px, 3.5vw, 56px);
    padding-right: clamp(20px, 3.5vw, 56px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    box-sizing: border-box;
    gap: 20px;
  }

  .earth-header-container--full {
    max-width: 100% !important;
  }

  /* Logo */
  .earth-header__logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .earth-header__logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .earth-header__logo-img {
    height: auto;
    max-height: 36px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* Nav Links */
  .earth-header__nav-left,
  .earth-header__nav-split-right,
  .earth-header__nav-below {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .earth-header__nav-link {
    color: inherit;
    font-size: var(--font-nav--size, 18px);
    font-weight: var(--font-nav--weight, 600);
    text-decoration: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .earth-header__nav-link:hover {
    opacity: 0.75;
  }

  /* Layout Specific Styles */
  /* Logo Center, Menu Left */
  .earth-header--layout-logo_center_menu_left .earth-header__nav-left {
    flex: 1;
  }
  .earth-header--layout-logo_center_menu_left .earth-header__logo-wrapper {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  /* Logo Left, Menu Left */
  .earth-header--layout-logo_left_menu_left .earth-header-container {
    justify-content: flex-start;
  }
  .earth-header--layout-logo_left_menu_left .earth-header__nav-left {
    margin-left: 24px;
    flex: 1;
  }

  /* Logo Left, Menu Center */
  .earth-header--layout-logo_left_menu_center .earth-header__nav-left {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  /* Logo Left, Menu Drawer */
  .earth-header--layout-logo_left_menu_drawer .earth-header__nav-left,
  .earth-header--layout-logo_center_menu_drawer .earth-header__nav-left {
    display: none;
  }

  .earth-header--layout-logo_center_menu_drawer .earth-header__logo-wrapper {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .earth-header__drawer-btn--desktop {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
  }

  .earth-header__drawer-btn-label {
    font-size: 15px;
    font-weight: 500;
    color: inherit;
  }

  /* Logo Center, Menu Split */
  .earth-header--layout-logo_center_menu_split .earth-header__nav-left {
    flex: 1;
    justify-content: flex-end;
  }
  .earth-header--layout-logo_center_menu_split .earth-header__nav-split-right {
    flex: 1;
    justify-content: flex-start;
  }

  /* Logo Center, Menu Below */
  .earth-header--layout-logo_center_menu_below .earth-header__logo-wrapper {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .earth-header__nav-below-container {
    width: 100%;
    display: flex;
    justify-content: center;
    padding-bottom: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  .earth-header__nav-below {
    padding-top: 12px;
  }

  /* Right Actions */
  .earth-header__actions-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
    flex: 1;
  }

  .earth-header__language-selector,
  .earth-header__country-selector {
    display: flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
  }

  /* Icon Sizing Modifier Classes */
  .earth-header--icons-small .earth-header__icon-btn svg,
  .earth-header--icons-small .earth-header__icon-btn img,
  .earth-header--icons-small .earth-header__mobile-menu-btn svg,
  .earth-header--icons-small .earth-header__mobile-menu-btn img {
    width: 16px;
    height: 16px;
    max-width: 16px;
    max-height: 16px;
    object-fit: contain;
  }

  .earth-header--icons-medium .earth-header__icon-btn svg,
  .earth-header--icons-medium .earth-header__icon-btn img,
  .earth-header--icons-medium .earth-header__mobile-menu-btn svg,
  .earth-header--icons-medium .earth-header__mobile-menu-btn img {
    width: 20px;
    height: 20px;
    max-width: 20px;
    max-height: 20px;
    object-fit: contain;
  }

  .earth-header--icons-large .earth-header__icon-btn svg,
  .earth-header--icons-large .earth-header__icon-btn img,
  .earth-header--icons-large .earth-header__mobile-menu-btn svg,
  .earth-header--icons-large .earth-header__mobile-menu-btn img {
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
  }

  .earth-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .earth-header__icon-btn:hover {
    transform: translateY(-1px);
    opacity: 0.8;
  }

  .earth-header__cart-icon-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .earth-header__cart-badge {
    position: absolute;
    bottom: -3px;
    right: -7px;
    background-color: var(--color-primary, #224E09);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    border: 1.5px solid var(--header-bg, #f3f6e4);
  }

  /* Mobile Button */
  .earth-header__mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 6px;
    align-items: center;
    gap: 6px;
  }

  /* Mobile Drawer */
  .earth-header-wrapper.has-drawer-open {
    z-index: 999999 !important;
  }

  /* Mobile Drawer */
  .earth-mobile-drawer {
    display: none;
  }
  .earth-mobile-drawer.is-open {
    display: block;
  }
  .earth-mobile-drawer__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 100000;
  }
  .earth-mobile-drawer__panel {
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    max-width: 85vw;
    height: 100vh;
    height: 100dvh;
    background-color: var(--header-bg, #f3f6e4);
    color: var(--header-color, #224E09);
    z-index: 100001;
    padding: max(24px, env(safe-area-inset-top)) 24px 24px 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgba(0,0,0,0.15);
    box-sizing: border-box;
    overflow-y: auto;
  }
  .earth-mobile-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(34, 78, 9, 0.12);
    min-height: 36px;
  }
  .earth-mobile-drawer__top img {
    height: 24px;
    width: auto;
    display: block;
  }
  .earth-mobile-drawer__close {
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .earth-mobile-drawer__links {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 24px;
  }
  .earth-mobile-drawer__link {
    color: inherit;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }
  .earth-mobile-drawer__accordion-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border: none;
    color: inherit;
    font-size: 16px;
    font-weight: 600;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .earth-mobile-drawer__accordion-content {
    display: none;
    flex-direction: column;
    gap: 10px;
    padding-left: 12px;
    margin-top: 10px;
  }
  .earth-mobile-drawer__accordion-item.is-active .earth-mobile-drawer__accordion-content {
    display: flex;
  }
  .earth-mobile-drawer__sublink {
    color: inherit;
    opacity: 0.85;
    font-size: 14px;
    text-decoration: none;
  }

  .earth-mobile-drawer__footer {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .earth-mobile-drawer__selector-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .earth-mobile-drawer__social-icons {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }
  .earth-mobile-drawer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0,0,0,0.06);
    color: inherit;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .earth-header-container {
      padding-left: 24px;
      padding-right: 24px;
    }
    .earth-header__nav-left,
    .earth-header__nav-split-right {
      gap: 18px;
    }
    .earth-header__language-selector,
    .earth-header__country-selector {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .earth-header__nav-left,
    .earth-header__nav-split-right,
    .earth-header__nav-below-container {
      display: none !important;
    }
    .earth-header__mobile-menu-btn {
      display: inline-flex !important;
    }
    .earth-header__account-btn {
      display: none !important;
    }
    .earth-header-container {
      padding-left: 20px !important;
      padding-right: 20px !important;
      padding-top: 16px !important;
      padding-bottom: 16px !important;
    }
    .earth-header__logo--mobile-left {
      position: static !important;
      transform: none !important;
      order: 1;
    }
    .earth-header__logo--mobile-center {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initHeader() {
      var sectionId = '{{ section.id }}';
      var mobileBtn = document.getElementById('earthMobileMenuBtn-' + sectionId);
      var drawer = document.getElementById('earthMobileDrawer-' + sectionId);
      var drawerClose = document.getElementById('earthDrawerCloseBtn-' + sectionId);
      var drawerOverlay = document.getElementById('earthDrawerOverlay-' + sectionId);
      var headerWrapper = document.getElementById('earthHeaderWrapper-' + sectionId);

      function openDrawer() {
        if (drawer) {
          drawer.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          if (headerWrapper) headerWrapper.classList.add('has-drawer-open');
          document.body.style.overflow = 'hidden';
        }
      }
      function closeDrawer() {
        if (drawer) {
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
          if (headerWrapper) headerWrapper.classList.remove('has-drawer-open');
          document.body.style.overflow = '';
        }
      }

      if (mobileBtn) mobileBtn.addEventListener('click', openDrawer);
      if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
      if (drawerOverlay) drawerOverlay.addEventListener('click', closeDrawer);

      // Accordion toggles
      if (drawer) {
        var toggles = drawer.querySelectorAll('.earth-mobile-drawer__accordion-toggle');
        toggles.forEach(function(btn) {
          btn.addEventListener('click', function() {
            var item = btn.closest('.earth-mobile-drawer__accordion-item');
            var isExpanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', !isExpanded);
            if (item) item.classList.toggle('is-active');
          });
        });
      }

      // Sticky on scroll up logic
      if (headerWrapper && headerWrapper.classList.contains('earth-header--sticky-on_scroll_up')) {
        var lastScrollTop = 0;
        window.addEventListener('scroll', function() {
          var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          if (scrollTop > lastScrollTop && scrollTop > 120) {
            headerWrapper.classList.add('earth-header-hidden');
          } else {
            headerWrapper.classList.remove('earth-header-hidden');
          }
          lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }, { passive: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', initHeader);
    }
  })();
</script>

