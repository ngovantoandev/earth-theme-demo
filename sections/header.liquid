{% comment %}
  Header Section - Earth Shopify Theme
  Clean header with Logo left layout options, sticky controls, icon sizing,
  drawer menu, and theme logo integration.
{% endcomment %}

{%- liquid
  assign main_menu = section.settings.menu
  assign drawer_menu = section.settings.drawer_menu | default: section.settings.menu
  assign layout = section.settings.header_layout | default: 'logo_center_menu_left'
  assign icon_size = section.settings.icons_size | default: 'large'
  assign icon_size_class = 'earth-header--icons-' | append: icon_size
  assign sticky_mode = section.settings.sticky_header | default: 'always'
  assign logo_width = settings.logo_width | default: 85
  assign mobile_logo_width = settings.mobile_logo_width | default: 70
-%}

{% style %}
  #earthHeaderWrapper-{{ section.id }} {
    --header-logo-width: {{ logo_width }}px;
    --header-mobile-logo-width: {{ mobile_logo_width }}px;
  }
  #earthHeaderWrapper-{{ section.id }} .earth-header__logo-img {
    width: {{ logo_width }}px !important;
    max-width: 100% !important;
    height: auto !important;
  }
  @media (max-width: 768px) {
    #earthHeaderWrapper-{{ section.id }} .earth-header__logo-img {
      width: {{ mobile_logo_width }}px !important;
      max-width: 100% !important;
      height: auto !important;
    }
    #earthHeaderWrapper-{{ section.id }} .earth-header__logo-img--mobile {
      width: {{ mobile_logo_width }}px !important;
      max-width: 100% !important;
      height: auto !important;
      display: block !important;
    }
  }
{% endstyle %}

<div 
  class="earth-header-wrapper{% if section.settings.full_width %} full-width{% endif %} earth-header--sticky-{{ sticky_mode }} {{ icon_size_class }}"
  id="earthHeaderWrapper-{{ section.id }}"
  style="
    --header-bg: {{ section.settings.bg_color | default: '#f3f6e4' }};
    --header-color: {{ section.settings.text_color | default: '#224E09' }};
    --header-pt: {{ section.settings.top_padding | default: 0 }}px;
    --header-pb: {{ section.settings.bottom_padding | default: 0 }}px;
    --header-logo-width: {{ logo_width }}px;
    --header-mobile-logo-width: {{ mobile_logo_width }}px;
  "
>
  <header class="earth-main-header earth-header--layout-{{ layout }}">
    <div class="earth-header-container{% if section.settings.full_width %} earth-header-container--full{% endif %}">
      
      <!-- Drawer / Hamburger Button (Mobile) -->
      <button 
        type="button" 
        class="earth-header__mobile-menu-btn" 
        id="earthMobileMenuBtn-{{ section.id }}" 
        aria-label="Toggle navigation"
      >
        <span class="earth-header__mobile-menu-icon" aria-hidden="true">
          {{ 'icon-mobile_menu.svg' | inline_asset_content }}
        </span>
        {%- if section.settings.menu_drawer_icon_label != blank -%}
          <span class="earth-header__drawer-btn-label">{{ section.settings.menu_drawer_icon_label }}</span>
        {%- endif -%}
      </button>

      <!-- Logo Area (H1 or DIV for SEO) -->
      {%- capture logo_markup -%}
        <a href="{{ routes.root_url }}" class="earth-header__logo-link" aria-label="{{ shop.name }}">
          {%- assign desktop_logo_class = 'earth-header__logo-img' -%}
          {%- if settings.mobile_logo != blank -%}
            {%- assign desktop_logo_class = desktop_logo_class | append: ' earth-header__logo-img--hide-on-mobile' -%}
          {%- endif -%}

          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = logo_width | divided_by: settings.logo.aspect_ratio | round -%}
            {{ settings.logo | image_url: width: 600 | image_tag: 
              class: desktop_logo_class, 
              alt: logo_alt, 
              width: logo_width,
              height: logo_height,
              loading: 'eager'
            }}
          {%- else -%}
            <span class="{{ desktop_logo_class }}" aria-hidden="true">{{ 'icon-Earth-logo.svg' | inline_asset_content }}</span>
          {%- endif -%}

          {%- if settings.mobile_logo != blank -%}
            {%- assign mobile_logo_alt = settings.mobile_logo.alt | default: shop.name | escape -%}
            {%- assign mobile_logo_height = mobile_logo_width | divided_by: settings.mobile_logo.aspect_ratio | round -%}
            {{ settings.mobile_logo | image_url: width: 400 | image_tag: 
              class: 'earth-header__logo-img earth-header__logo-img--mobile', 
              alt: mobile_logo_alt, 
              width: mobile_logo_width,
              height: mobile_logo_height,
              loading: 'eager'
            }}
          {%- endif -%}
        </a>
      {%- endcapture -%}

      {%- if request.page_type == 'index' and section.settings.enable_logo_h1 -%}
        <h1 class="earth-header__logo-wrapper earth-header__logo--mobile-{{ section.settings.mobile_logo_position | default: 'center' }}">
          {{ logo_markup }}
        </h1>
      {%- else -%}
        <div class="earth-header__logo-wrapper earth-header__logo--mobile-{{ section.settings.mobile_logo_position | default: 'center' }}">
          {{ logo_markup }}
        </div>
      {%- endif -%}

      <!-- Navigation Menu (Desktop) -->
      <nav class="earth-header__nav-left earth-header__nav--{{ layout }}" aria-label="Main Navigation">
        {%- if main_menu != blank and main_menu.links.size > 0 -%}
          {%- for link in main_menu.links -%}
            <a href="{{ link.url }}" class="earth-header__nav-link">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ routes.root_url }}" class="earth-header__nav-link">Home</a>
          <a href="{{ routes.all_products_collection_url }}" class="earth-header__nav-link">Shop</a>
          <a href="/blogs/news" class="earth-header__nav-link">Blog</a>
          <a href="/pages/about" class="earth-header__nav-link">About</a>
          <a href="/pages/contact" class="earth-header__nav-link">Contact</a>
        {%- endif -%}
      </nav>

      <!-- Right Utility Actions -->
      <div class="earth-header__actions-right">
        <!-- Country / Currency Selector -->
        {%- if section.settings.enable_country_selector -%}
          <div class="earth-header__country-selector">
            {%- if localization.available_countries.size > 1 -%}
              {%- form 'localization', id: 'HeaderCountryForm', class: 'earth-header__localization-form' -%}
                <div class="earth-header__select-wrapper">
                  <select name="country_code" class="earth-header__country-select" onchange="this.form.submit()" aria-label="Country/region">
                    {%- for country in localization.available_countries -%}
                      <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                        {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="earth-header__select-arrow" aria-hidden="true">
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M1 1L5 5L9 1"/>
                    </svg>
                  </span>
                </div>
              {%- endform -%}
            {%- else -%}
              <div class="earth-header__select-wrapper">
                <select class="earth-header__country-select" aria-label="Country/region">
                  <option value="US" selected>{{ localization.country.name | default: 'United States' }} ({{ localization.country.currency.iso_code | default: 'USD' }} {{ localization.country.currency.symbol | default: '$' }})</option>
                  <option value="CA">Canada (CAD $)</option>
                  <option value="GB">United Kingdom (GBP £)</option>
                  <option value="EU">European Union (EUR €)</option>
                  <option value="AU">Australia (AUD $)</option>
                </select>
                <span class="earth-header__select-arrow" aria-hidden="true">
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 1L5 5L9 1"/>
                  </svg>
                </span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Search Icon -->
        <a href="{{ routes.search_url }}" class="earth-header__icon-btn earth-header__search-btn" aria-label="Search">
          {{ 'icon-search.svg' | inline_asset_content }}
        </a>

        <!-- Account / User Icon -->
        {%- if shop.customer_accounts_enabled or true -%}
          <a href="{{ routes.account_url }}" class="earth-header__icon-btn earth-header__account-btn" aria-label="Customer Account">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {%- endif -%}

        <!-- Cart Bag Icon with Badge -->
        <a href="{{ routes.cart_url }}" class="earth-header__icon-btn earth-header__cart-link" aria-label="Cart">
          <div class="earth-header__cart-icon-wrapper">
            {{ 'icon-cart.svg' | inline_asset_content }}
            <span class="earth-header__cart-badge">{{ cart.item_count | default: 0 }}</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div class="earth-mobile-drawer" id="earthMobileDrawer-{{ section.id }}" aria-hidden="true">
      <div class="earth-mobile-drawer__overlay" id="earthDrawerOverlay-{{ section.id }}"></div>
      <div class="earth-mobile-drawer__panel">
        <div class="earth-mobile-drawer__top">
          <a href="{{ routes.root_url }}">
            {%- if settings.mobile_logo != blank -%}
              {%- assign drawer_logo_alt = settings.mobile_logo.alt | default: shop.name | escape -%}
              {%- assign drawer_logo_height = mobile_logo_width | divided_by: settings.mobile_logo.aspect_ratio | round -%}
              {{ settings.mobile_logo | image_url: width: 400 | image_tag: class: 'earth-mobile-drawer__logo-img', alt: drawer_logo_alt, width: mobile_logo_width, height: drawer_logo_height, loading: 'lazy' }}
            {%- elsif settings.logo != blank -%}
              {%- assign drawer_logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {%- assign drawer_logo_height = mobile_logo_width | divided_by: settings.logo.aspect_ratio | round -%}
              {{ settings.logo | image_url: width: 400 | image_tag: class: 'earth-mobile-drawer__logo-img', alt: drawer_logo_alt, width: mobile_logo_width, height: drawer_logo_height, loading: 'lazy' }}
            {%- else -%}
              <span class="earth-mobile-drawer__logo-img" aria-hidden="true">{{ 'icon-Earth-logo.svg' | inline_asset_content }}</span>
            {%- endif -%}
          </a>
          <button type="button" class="earth-mobile-drawer__close" id="earthDrawerCloseBtn-{{ section.id }}" aria-label="Close menu">
            <svg width="18" height="18" viewBox="0 0 14 14" fill="none">
              <path d="M13 1L1 13M1 1L13 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <!-- Drawer Links & Accordion Navigation -->
        <nav class="earth-mobile-drawer__links">
          {%- if drawer_menu != blank and drawer_menu.links.size > 0 -%}
            {%- for link in drawer_menu.links -%}
              {%- if link.links.size > 0 and section.settings.enable_accordion_menu -%}
                <div class="earth-mobile-drawer__accordion-item">
                  <button type="button" class="earth-mobile-drawer__accordion-toggle" aria-expanded="false">
                    <span>{{ link.title }}</span>
                    <span class="earth-mobile-drawer__accordion-arrow" aria-hidden="true">{{ 'icon-down.svg' | inline_asset_content }}</span>
                  </button>
                  <div class="earth-mobile-drawer__accordion-content">
                    {%- for childlink in link.links -%}
                      <a href="{{ childlink.url }}" class="earth-mobile-drawer__sublink">{{ childlink.title }}</a>
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
                <a href="{{ link.url }}" class="earth-mobile-drawer__link">{{ link.title }}</a>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <a href="{{ routes.root_url }}" class="earth-mobile-drawer__link">Home</a>
            <a href="{{ routes.all_products_collection_url }}" class="earth-mobile-drawer__link">Shop</a>
            <a href="/blogs/news" class="earth-mobile-drawer__link">Blog</a>
            <a href="/pages/about" class="earth-mobile-drawer__link">About</a>
            <a href="/pages/contact" class="earth-mobile-drawer__link">Contact</a>
          {%- endif -%}
        </nav>
      </div>
    </div>
  </header>
</div>

{% stylesheet %}
  .earth-header-wrapper {
    width: 100%;
    color: var(--header-color, #171717);
    font-family: inherit;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  /* Sticky Header Options */
  .earth-header-wrapper.earth-header--sticky-always {
    position: sticky;
    top: 0;
    z-index: 999;
  }

  .earth-header-wrapper.earth-header--sticky-on_scroll_up {
    position: sticky;
    top: 0;
    z-index: 999;
    transition: transform 0.3s ease;
  }

  .earth-header-wrapper.earth-header--sticky-none {
    position: relative;
  }

  .earth-header-wrapper.earth-header-hidden {
    transform: translateY(-100%);
  }

  /* Main Header Container */
  .earth-main-header {
    background-color: var(--header-bg, #f3f6e4);
    color: var(--header-color, #224E09);
    border-bottom: 1px solid rgba(34, 78, 9, 0.08);
    width: 100%;
    box-sizing: border-box;
    transition: background-color 0.3s ease;
  }

  .earth-header--rounded {
    overflow: hidden;
  }

  .earth-header-container {
    width: 100%;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    min-height: 70px;
    padding-top: var(--header-pt, 0px);
    padding-bottom: var(--header-pb, 0px);
    padding-left: clamp(20px, 3.5vw, 56px);
    padding-right: clamp(20px, 3.5vw, 56px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    box-sizing: border-box;
    gap: 20px;
  }

  .earth-header-container--full {
    max-width: 100% !important;
  }

  /* Logo */
  .earth-header__logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .earth-header__logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .earth-header__logo-img,
  .earth-mobile-drawer__logo-img {
    width: var(--header-logo-width, 85px);
    max-width: 100%;
    height: auto;
    display: inline-flex;
    align-items: center;
    object-fit: contain;
  }
  .earth-header__logo-img svg,
  .earth-mobile-drawer__logo-img svg {
    width: 100%;
    height: auto;
    max-height: 28px;
    display: block;
  }

  /* Nav Links */
  .earth-header__nav-left,
  .earth-header__nav-split-right,
  .earth-header__nav-below {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .earth-header__nav-link {
    color: inherit;
    font-size: var(--font-nav--size, 18px);
    font-weight: var(--font-nav--weight, 600);
    text-decoration: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .earth-header__nav-link:hover {
    opacity: 0.75;
  }

  /* Layout Specific Styles */
  /* Logo Center, Menu Left */
  .earth-header--layout-logo_center_menu_left .earth-header-container {
    justify-content: space-between;
    position: relative;
  }
  .earth-header--layout-logo_center_menu_left .earth-header__logo-wrapper {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .earth-header--layout-logo_center_menu_left .earth-header__nav-left {
    flex: 1;
    justify-content: flex-start;
  }

  /* Logo Left, Menu Left */
  .earth-header--layout-logo_left_menu_left .earth-header-container {
    justify-content: flex-start;
  }
  .earth-header--layout-logo_left_menu_left .earth-header__nav-left {
    margin-left: 32px;
    flex: 1;
  }

  /* Logo Left, Menu Center */
  .earth-header--layout-logo_left_menu_center .earth-header-container {
    justify-content: space-between;
  }
  .earth-header--layout-logo_left_menu_center .earth-header__nav-left {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  /* Right Actions */
  .earth-header__actions-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
    flex-shrink: 0;
  }

  .earth-header__country-selector {
    display: inline-flex;
    align-items: center;
    position: relative;
  }

  .earth-header__localization-form {
    display: inline-flex;
    align-items: center;
    margin: 0;
  }

  .earth-header__select-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }

  .earth-header__country-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: transparent;
    border: none;
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    color: inherit;
    cursor: pointer;
    padding-right: 16px;
    padding-left: 0;
    padding-top: 4px;
    padding-bottom: 4px;
    outline: none;
    line-height: 1.2;
  }

  .earth-header__select-arrow {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .earth-header__select-arrow svg {
    width: 9px;
    height: 6px;
    display: block;
  }

  /* Icon Sizing Modifier Classes */
  .earth-header--icons-small .earth-header__icon-btn svg,
  .earth-header--icons-small .earth-header__icon-btn img,
  .earth-header--icons-small .earth-header__mobile-menu-btn svg,
  .earth-header--icons-small .earth-header__mobile-menu-btn img {
    width: 16px;
    height: 16px;
    max-width: 16px;
    max-height: 16px;
    object-fit: contain;
  }

  .earth-header--icons-medium .earth-header__icon-btn svg,
  .earth-header--icons-medium .earth-header__icon-btn img,
  .earth-header--icons-medium .earth-header__mobile-menu-btn svg,
  .earth-header--icons-medium .earth-header__mobile-menu-btn img {
    width: 20px;
    height: 20px;
    max-width: 20px;
    max-height: 20px;
    object-fit: contain;
  }

  .earth-header--icons-large .earth-header__icon-btn svg,
  .earth-header--icons-large .earth-header__icon-btn img,
  .earth-header--icons-large .earth-header__mobile-menu-btn svg,
  .earth-header--icons-large .earth-header__mobile-menu-btn img {
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
  }

  .earth-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .earth-header__icon-btn:hover {
    transform: translateY(-1px);
    opacity: 0.8;
  }

  .earth-header__cart-icon-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .earth-header__cart-badge {
    position: absolute;
    bottom: -3px;
    right: -7px;
    background-color: var(--color-primary, #224E09);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    border: 1.5px solid var(--header-bg, #f3f6e4);
  }

  /* Mobile Button */
  .earth-header__mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 6px;
    align-items: center;
    gap: 6px;
  }

  /* Mobile Drawer */
  .earth-header-wrapper.has-drawer-open {
    z-index: 999999 !important;
  }

  .earth-mobile-drawer {
    display: none;
  }
  .earth-mobile-drawer.is-open {
    display: block;
  }
  .earth-mobile-drawer__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 100000;
  }
  .earth-mobile-drawer__panel {
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    max-width: 85vw;
    height: 100vh;
    height: 100dvh;
    background-color: var(--header-bg, #f3f6e4);
    color: var(--header-color, #224E09);
    z-index: 100001;
    padding: max(24px, env(safe-area-inset-top)) 24px 24px 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 24px rgba(0,0,0,0.15);
    box-sizing: border-box;
    overflow-y: auto;
  }
  .earth-mobile-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(34, 78, 9, 0.12);
    min-height: 36px;
  }
  .earth-mobile-drawer__top img,
  .earth-mobile-drawer__logo-img {
    width: var(--header-mobile-logo-width, 70px);
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .earth-mobile-drawer__close {
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .earth-mobile-drawer__links {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 24px;
  }
  .earth-mobile-drawer__link {
    color: inherit;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }
  .earth-mobile-drawer__accordion-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: transparent;
    border: none;
    color: inherit;
    font-size: 16px;
    font-weight: 600;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .earth-mobile-drawer__accordion-content {
    display: none;
    flex-direction: column;
    gap: 10px;
    padding-left: 12px;
    margin-top: 10px;
  }
  .earth-mobile-drawer__accordion-item.is-active .earth-mobile-drawer__accordion-content {
    display: flex;
  }
  .earth-mobile-drawer__sublink {
    color: inherit;
    opacity: 0.85;
    font-size: 14px;
    text-decoration: none;
  }

  .earth-header__logo-img--mobile {
    display: none;
  }

  /* Responsive Media Queries */
  @media (max-width: 1024px) {
    .earth-header-container {
      padding-left: 24px;
      padding-right: 24px;
    }
    .earth-header__nav-left {
      gap: 18px;
    }
    .earth-header__country-selector {
      display: none !important;
    }
  }

  @media (max-width: 768px) {
    .earth-header__nav-left {
      display: none !important;
    }
    .earth-header__country-selector {
      display: none !important;
    }
    .earth-header__mobile-menu-btn {
      display: inline-flex !important;
    }
    .earth-header__account-btn {
      display: none !important;
    }
    .earth-header-container {
      padding-left: 20px !important;
      padding-right: 20px !important;
      padding-top: 16px !important;
      padding-bottom: 16px !important;
    }
    .earth-header__logo-img--hide-on-mobile {
      display: none !important;
    }
    .earth-header__logo-img--mobile {
      display: block !important;
      width: var(--header-mobile-logo-width, 70px) !important;
      max-width: 100% !important;
      height: auto !important;
    }
    .earth-header__logo-img {
      width: var(--header-mobile-logo-width, 70px);
      max-width: 100%;
      height: auto;
    }
    .earth-header__logo--mobile-left {
      position: static !important;
      transform: none !important;
      order: 1;
    }
    .earth-header__logo--mobile-center {
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initHeader() {
      var sectionId = '{{ section.id }}';
      var mobileBtn = document.getElementById('earthMobileMenuBtn-' + sectionId);
      var drawer = document.getElementById('earthMobileDrawer-' + sectionId);
      var drawerClose = document.getElementById('earthDrawerCloseBtn-' + sectionId);
      var drawerOverlay = document.getElementById('earthDrawerOverlay-' + sectionId);
      var headerWrapper = document.getElementById('earthHeaderWrapper-' + sectionId);

      function openDrawer() {
        if (drawer) {
          drawer.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          if (headerWrapper) headerWrapper.classList.add('has-drawer-open');
          document.body.style.overflow = 'hidden';
        }
      }
      function closeDrawer() {
        if (drawer) {
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
          if (headerWrapper) headerWrapper.classList.remove('has-drawer-open');
          document.body.style.overflow = '';
        }
      }

      if (mobileBtn) mobileBtn.addEventListener('click', openDrawer);
      if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
      if (drawerOverlay) drawerOverlay.addEventListener('click', closeDrawer);

      // Accordion toggles
      if (drawer) {
        var toggles = drawer.querySelectorAll('.earth-mobile-drawer__accordion-toggle');
        toggles.forEach(function(btn) {
          btn.addEventListener('click', function() {
            var item = btn.closest('.earth-mobile-drawer__accordion-item');
            var isExpanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', !isExpanded);
            if (item) item.classList.toggle('is-active');
          });
        });
      }

      // Sticky on scroll up logic
      if (headerWrapper && headerWrapper.classList.contains('earth-header--sticky-on_scroll_up')) {
        var lastScrollTop = 0;
        window.addEventListener('scroll', function() {
          var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          if (scrollTop > lastScrollTop && scrollTop > 120) {
            headerWrapper.classList.add('earth-header-hidden');
          } else {
            headerWrapper.classList.remove('earth-header-hidden');
          }
          lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }, { passive: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', initHeader);
    }
  })();
</script>

