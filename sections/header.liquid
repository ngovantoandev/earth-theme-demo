{% comment %}
  Header Section - Earth Shopify Theme
  Matching design with Announcement Bar + Pale Cream Nav + Earth Logo + Currency & Icons
{% endcomment %}

<div class="earth-header-wrapper full-width" id="earthHeaderWrapper">
  <!-- 1. Top Announcement Bar -->
  {%- if section.settings.show_announcement -%}
    <div class="earth-announcement" id="earthAnnouncementBar">
      <div class="earth-announcement__content">
        <span>{{ section.settings.announcement_text | default: 'Extra 15% off Sale with code: SUNNYDAY15' }}</span>
      </div>
      <button type="button" class="earth-announcement__close" id="earthAnnouncementClose" aria-label="Close announcement">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M13 1L1 13M1 1L13 13" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  {%- endif -%}

  <!-- 2. Main Navigation Bar -->
  <header class="earth-main-header">
    <div class="earth-header-container">
      <!-- Mobile Hamburger Button -->
      <button type="button" class="earth-header__mobile-menu-btn" id="earthMobileMenuBtn" aria-label="Toggle navigation">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#224E09" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Left Navigation Menu -->
      <nav class="earth-header__nav-left" aria-label="Main Navigation">
        {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
          {%- for link in section.settings.menu.links -%}
            <a href="{{ link.url }}" class="earth-header__nav-link">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ routes.root_url }}" class="earth-header__nav-link">Home</a>
          <a href="{{ routes.all_products_collection_url }}" class="earth-header__nav-link">Shop</a>
          <a href="/blogs/news" class="earth-header__nav-link">Blog</a>
          <a href="/pages/about" class="earth-header__nav-link">About</a>
          <a href="/pages/contact" class="earth-header__nav-link">Contact</a>
        {%- endif -%}
      </nav>

      <!-- Center Logo -->
      <div class="earth-header__logo-wrapper">
        <a href="{{ routes.root_url }}" class="earth-header__logo-link" aria-label="{{ shop.name }}">
          <img src="{{ 'Earth-logo.svg' | asset_url }}" alt="earth" width="82" height="24" class="earth-header__logo-img">
        </a>
      </div>

      <!-- Right Utility Actions -->
      <div class="earth-header__actions-right">
        <!-- Currency / Country Selector -->
        {%- if section.settings.show_country_selector -%}
          <div class="earth-header__country-selector">
            <span class="earth-header__country-label">{{ section.settings.country_label | default: 'United States (USD $)' }}</span>
            <img src="{{ 'icon-down.svg' | asset_url }}" width="11" height="6" alt="" class="earth-header__country-arrow">
          </div>
        {%- endif -%}

        <!-- Search Icon -->
        <a href="{{ routes.search_url }}" class="earth-header__icon-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7.5" stroke="#224E09" stroke-width="1.8"/>
            <path d="M16.5 16.5L21.5 21.5" stroke="#224E09" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </a>

        <!-- Account / User Icon -->
        {%- if shop.customer_accounts_enabled or true -%}
          <a href="{{ routes.account_url }}" class="earth-header__icon-btn earth-header__account-btn" aria-label="Customer Account">
            <img src="{{ 'icon-account.svg' | asset_url }}" width="20" height="21" alt="Account">
          </a>
        {%- endif -%}

        <!-- Cart Bag Icon with Badge -->
        <a href="{{ routes.cart_url }}" class="earth-header__icon-btn earth-header__cart-link" aria-label="Cart">
          <div class="earth-header__cart-icon-wrapper">
            <img src="{{ 'icon-cart.svg' | asset_url }}" width="18" height="23" alt="Cart">
            <span class="earth-header__cart-badge">{{ cart.item_count | default: 2 }}</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div class="earth-mobile-drawer" id="earthMobileDrawer">
      <div class="earth-mobile-drawer__overlay" id="earthDrawerOverlay"></div>
      <div class="earth-mobile-drawer__panel">
        <div class="earth-mobile-drawer__top">
          <img src="{{ 'Earth-logo.svg' | asset_url }}" alt="earth" width="82" height="24">
          <button type="button" class="earth-mobile-drawer__close" id="earthDrawerCloseBtn" aria-label="Close menu">
            <svg width="18" height="18" viewBox="0 0 14 14" fill="none">
              <path d="M13 1L1 13M1 1L13 13" stroke="#224E09" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <nav class="earth-mobile-drawer__links">
          {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
            {%- for link in section.settings.menu.links -%}
              <a href="{{ link.url }}" class="earth-mobile-drawer__link">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="{{ routes.root_url }}" class="earth-mobile-drawer__link">Home</a>
            <a href="{{ routes.all_products_collection_url }}" class="earth-mobile-drawer__link">Shop</a>
            <a href="/blogs/news" class="earth-mobile-drawer__link">Blog</a>
            <a href="/pages/about" class="earth-mobile-drawer__link">About</a>
            <a href="/pages/contact" class="earth-mobile-drawer__link">Contact</a>
          {%- endif -%}
        </nav>

        <div class="earth-mobile-drawer__footer">
          <div class="earth-header__country-selector" style="display: flex; justify-content: space-between; width: 100%;">
            <span>{{ section.settings.country_label | default: 'United States (USD $)' }}</span>
            <img src="{{ 'icon-down.svg' | asset_url }}" width="11" height="6" alt="">
          </div>
        </div>
      </div>
    </div>
  </header>
</div>

{% stylesheet %}
  /* ==========================================================================
     Earth Header Styles
     ========================================================================== */
  .earth-header-wrapper {
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 999;
    font-family: inherit;
  }

  /* 1. Announcement Bar */
  .earth-announcement {
    background-color: #224E09;
    color: #ffffff;
    min-height: 38px;
    padding: 8px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }
  .earth-announcement__content {
    text-align: center;
    padding: 0 30px;
  }
  .earth-announcement__close {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .earth-announcement__close:hover {
    opacity: 1;
  }

  /* 2. Main Navigation Bar */
  .earth-main-header {
    background-color: #f3f6e4;
    border-bottom: 1px solid rgba(34, 78, 9, 0.08);
    width: 100%;
  }
  .earth-header-container {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 clamp(20px, 3.5vw, 56px);
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    box-sizing: border-box;
  }

  /* Left Menu */
  .earth-header__nav-left {
    display: flex;
    align-items: center;
    gap: 32px;
    flex: 1;
  }
  .earth-header__nav-link {
    color: #224E09;
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .earth-header__nav-link:hover {
    opacity: 0.75;
  }

  /* Center Logo */
  .earth-header__logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .earth-header__logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .earth-header__logo-img {
    height: 24px;
    width: auto;
    display: block;
  }

  /* Right Actions */
  .earth-header__actions-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 22px;
    flex: 1;
  }

  /* Country Selector */
  .earth-header__country-selector {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #224E09;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    margin-right: 6px;
    letter-spacing: -0.01em;
  }
  .earth-header__country-arrow {
    display: block;
  }

  /* Icon Buttons */
  .earth-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #224E09;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .earth-header__icon-btn:hover {
    transform: translateY(-1px);
    opacity: 0.8;
  }

  /* Cart Icon with Bottom-Right Badge */
  .earth-header__cart-icon-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .earth-header__cart-badge {
    position: absolute;
    bottom: -3px;
    right: -7px;
    background-color: #224E09;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    border: 1.5px solid #f3f6e4;
  }

  /* Mobile Button */
  .earth-header__mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  /* Mobile Drawer */
  .earth-mobile-drawer {
    display: none;
  }
  .earth-mobile-drawer.is-open {
    display: block;
  }
  .earth-mobile-drawer__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1000;
  }
  .earth-mobile-drawer__panel {
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    height: 100%;
    background-color: #f3f6e4;
    z-index: 1001;
    padding: 24px;
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 20px rgba(0,0,0,0.1);
  }
  .earth-mobile-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(34, 78, 9, 0.12);
  }
  .earth-mobile-drawer__close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .earth-mobile-drawer__links {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 24px;
  }
  .earth-mobile-drawer__link {
    color: #224E09;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }
  .earth-mobile-drawer__footer {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid rgba(34, 78, 9, 0.12);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .earth-header-container {
      padding: 0 20px;
    }
    .earth-header__nav-left {
      gap: 18px;
    }
    .earth-header__country-selector {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .earth-header__nav-left {
      display: none;
    }
    .earth-header__account-btn {
      display: none !important;
    }
    .earth-header__mobile-menu-btn {
      display: block;
    }
    .earth-header-container {
      height: 60px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initHeader() {
      var closeAnnouncement = document.getElementById('earthAnnouncementClose');
      var announcementBar = document.getElementById('earthAnnouncementBar');
      if (closeAnnouncement && announcementBar) {
        closeAnnouncement.addEventListener('click', function() {
          announcementBar.style.display = 'none';
        });
      }

      var mobileBtn = document.getElementById('earthMobileMenuBtn');
      var drawer = document.getElementById('earthMobileDrawer');
      var drawerClose = document.getElementById('earthDrawerCloseBtn');
      var drawerOverlay = document.getElementById('earthDrawerOverlay');

      function openDrawer() {
        if (drawer) drawer.classList.add('is-open');
      }
      function closeDrawer() {
        if (drawer) drawer.classList.remove('is-open');
      }

      if (mobileBtn) mobileBtn.addEventListener('click', openDrawer);
      if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
      if (drawerOverlay) drawerOverlay.addEventListener('click', closeDrawer);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Extra 15% off Sale with code: SUNNYDAY15"
    },
    {
      "type": "header",
      "content": "Navigation & Utility"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country selector",
      "default": true
    },
    {
      "type": "text",
      "id": "country_label",
      "label": "Country / Currency label",
      "default": "United States (USD $)"
    }
  ]
}
{% endschema %}
