      "label": "Button Style Type",
      "options": [
        { "value": "solid", "label": "Solid Fill Button" },
        { "value": "outline", "label": "Outlined Button" },
        { "value": "arrow", "label": "Arrow Pill Button" }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "header_btn_theme",
      "label": "Arrow Button Theme",
      "options": [
        { "value": "light", "label": "Light Theme" },
        { "value": "dark", "label": "Dark Theme" }
      ],
      "default": "light"
    },
    {
      "type": "color",
      "id": "header_btn_bg_color",
      "label": "Button Background Color",
      "default": "#F8F9DC"
    },
    {
      "type": "color",
      "id": "header_btn_text_color",
      "label": "Button Text Color",
      "default": "#003225"
    },
    {
      "type": "color",
      "id": "header_btn_circle_bg",
      "label": "Arrow Circle Background"
    },
    {
      "type": "color",
      "id": "header_btn_circle_color",
      "label": "Arrow Circle Icon Color"
    },
    {
      "type": "color",
      "id": "header_btn_color",
      "label": "Button Custom Accent Color"
    },
    {
      "type": "header",
      "content": "Metrics Settings"
    },
    {
      "type": "color",
      "id": "metric_value_color",
      "label": "Metric Number Color",
      "default": "#003225"
    },
    {
      "type": "color",
      "id": "metric_label_color",
      "label": "Metric Label Color",
      "default": "#003225"
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric Item",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Metric Value",
          "default": "94%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Metric Label",
          "default": "Traceable Origin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Unfiltered Truth",
      "blocks": [
        {
          "type": "metric",
          "settings": {
            "value": "94%",
            "label": "Traceable Origin"
          }
        },
        {
          "type": "metric",
          "settings": {
            "value": "0%",
            "label": "Plastic Packaging"
          }
        },
        {
          "type": "metric",
          "settings": {
            "value": "100+",
            "label": "Fair Wage Artisans"
