        { "value": "top", "label": "Top of Title" },
        { "value": "both_sides", "label": "Both Sides of Title" },
        { "value": "right", "label": "Right of Title" },
        { "value": "none", "label": "None" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "leaf_color",
      "label": "Leaf Icon Color",
      "default": "#71CC3B"
    },
    {
      "type": "range",
      "id": "leaf_size",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Leaf Icon Size",
      "default": 34
    },
    {
      "type": "range",
      "id": "leaf_gap",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Leaf Icon Spacing Gap",
