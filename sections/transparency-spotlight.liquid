{%- comment -%}
  Section: Transparency Spotlight
  Renders sustainability commitments, material sourcing, supply chain transparency,
  hurdles & honesty commitments, and impact verification stats.
  Built using composable theme blocks:
  - Column layout (responsive multi-column and swipeable carousel)
  - Card (custom colors, gradients, background image with overlay, decorative watermark)
  - Stack (flexible vertical and horizontal grouping)
  - Heading group, Heading, Sub-heading, Paragraph, Badge, Button, Icons
{%- endcomment -%}

{%- liquid
  assign make_section_page_width = section.settings.make_section_page_width

  assign section_bg = section.settings.background_color
  assign bg_style = ''
  if section_bg != blank and section_bg != 'rgba(0,0,0,0)' and section_bg != '#00000000'
    assign bg_style = '--vt-bg: ' | append: section_bg | append: ';'
  endif

  assign heading_color = section.settings.heading_color
  assign heading_style = ''
  if heading_color != blank and heading_color != 'rgba(0,0,0,0)' and heading_color != '#00000000'
    assign heading_style = '--vt-heading-color: ' | append: heading_color | append: ';'
  endif

  assign paragraph_color = section.settings.paragraph_color
  assign paragraph_style = ''
  if paragraph_color != blank and paragraph_color != 'rgba(0,0,0,0)' and paragraph_color != '#00000000'
    assign paragraph_style = '--vt-paragraph-color: ' | append: paragraph_color | append: ';'
  endif

  if section.settings.enable_custom_mobile_padding
    assign pad_top_mobile = section.settings.padding_top_mobile
    assign pad_bottom_mobile = section.settings.padding_bottom_mobile
    assign pad_left_mobile = section.settings.padding_horizontal_mobile
  else
    assign pad_top_mobile = section.settings.padding_top | times: 0.75 | round
    assign pad_bottom_mobile = section.settings.padding_bottom | times: 0.75 | round
    assign pad_left_mobile = section.settings.padding_horizontal | times: 0.75 | round
  endif
-%}

<div
  class="vt-transparency-spotlight{% unless make_section_page_width %} vt-page-full-width{% endunless %}"
  id="vtTransparencySpotlight-{{ section.id }}"
  style="
    {{ bg_style }}
    {{ heading_style }}
    {{ paragraph_style }}
    --vt-pt: {% render 'fluid-clamp', min_px: pad_top_mobile, max_px: section.settings.padding_top %};
    --vt-pb: {% render 'fluid-clamp', min_px: pad_bottom_mobile, max_px: section.settings.padding_bottom %};
    --vt-ph: {% render 'fluid-clamp', min_px: pad_left_mobile, max_px: section.settings.padding_horizontal %};
    --vt-ph-desktop: {{ section.settings.padding_horizontal | default: 34 }}px;
    --vt-ph-mobile: {{ pad_left_mobile }}px;
    --vt-page-padding: {{ section.settings.padding_horizontal | default: 34 }}px;
    --vt-page-padding-mobile: {{ pad_left_mobile }}px;
    --vt-block-gap: {% render 'fluid-clamp', min_px: section.settings.gap_mobile, max_px: section.settings.gap %};
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-transparency-spotlight__container{% if make_section_page_width %} vt-page-width{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .vt-transparency-spotlight {
    display: block;
    width: 100%;
    background-color: var(--vt-bg, var(--vt-background-color, var(--color-white, #F8F9DC)));
    color: var(--vt-heading-color, var(--vt-foreground-color, var(--color-black, #003225)));
    padding-top: var(--vt-pt, 80px);
    padding-bottom: var(--vt-pb, 96px);
    box-sizing: border-box;
    overflow-x: clip;
    position: relative;
  }

  .vt-transparency-spotlight__container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--vt-block-gap, 48px);
    padding-left: var(--vt-ph, 34px);
    padding-right: var(--vt-ph, 34px);
  }

  .vt-transparency-spotlight__container:not(.vt-page-width) {
    max-width: 100%;
  }

  @media screen and (max-width: 768px) {
    .vt-transparency-spotlight__container {
      padding-left: var(--vt-ph-mobile, 20px);
      padding-right: var(--vt-ph-mobile, 20px);
    }
  }

  /* Support Theme Editor wrappers without altering block layouts or configs */
  .vt-transparency-spotlight__container > .shopify-block,
  .vt-transparency-spotlight__container > shopify-block {
    display: contents;
  }

  .vt-transparency-spotlight .vt-heading {
    color: var(--vt-heading-color, var(--vt-foreground-color, var(--color-black, #003225)));
  }

  .vt-transparency-spotlight .vt-card .vt-heading {
    color: var(--vt-heading-color);
  }

  .vt-transparency-spotlight .vt-paragraph {
    color: var(--vt-paragraph-color, var(--vt-color-primary, var(--color-primary, #224E09)));
  }

  .vt-transparency-spotlight .vt-card .vt-paragraph {
    color: var(--vt-text-color);
  }
{% endstylesheet %}

