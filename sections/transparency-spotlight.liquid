{% comment %}
  Transparency Spotlight Section (Part 1)
  - Section Header with unified title-styling
  - 2-Column Customizable Cards Grid with Blocks (Material Sourcing Card & Supply Chain Image Card)
  - Configured with Shopify Blocks for easy sidebar tree data input in Theme Customizer.
  - Fully responsive on Desktop, Tablet, and Mobile with Full-Width Layout.
{% endcomment %}

<section 
  class="earth-transparency full-width{% if section.settings.full_width != false %} earth-transparency--full{% else %} earth-transparency--contained{% endif %}" 
  id="earthTransparency-{{ section.id }}"
  style="
    --transparency-bg: {{ section.settings.bg_color | default: '#F8F9DC' }}; 
    --transparency-text: {{ section.settings.text_color | default: '#003225' }};
    --transparency-pt: {{ section.settings.desktop_padding_top | default: 96 }}px;
    --transparency-pb: {{ section.settings.desktop_padding_bottom | default: 40 }}px;
    --transparency-mpt: {{ section.settings.mobile_padding_top | default: 48 }}px;
    --transparency-mpb: {{ section.settings.mobile_padding_bottom | default: 24 }}px;
    --card-min-h-desktop: {{ section.settings.card_min_height_desktop | default: 440 }}px;
    --card-min-h-mobile: {{ section.settings.card_min_height_mobile | default: 380 }}px;
    --card-radius: {{ section.settings.card_border_radius | default: 4 }}px;
    --cards-gap: {{ section.settings.card_gap_desktop | default: 36 }}px;
  "
>
  <div class="earth-transparency__container">

    <!-- 1. Section Header (Title Styling Snippet) -->
    {%- liquid
      assign h_layout = section.settings.header_layout | default: 'split'
      assign h_ratio = section.settings.header_split_ratio | default: '1.4fr_1fr'
      assign h_leaf_pos = section.settings.leaf_position | default: 'left'
      assign h_btn_type = section.settings.header_btn_type | default: 'arrow'
      assign h_btn_theme = section.settings.header_btn_theme | default: 'dark'
    -%}
    <div class="earth-transparency__header-container">
      {% render 'title-styling',
        layout: h_layout,
        split_ratio: h_ratio,
        title: section.settings.title,
        title_color: section.settings.title_color,
        title_size_desktop: section.settings.title_size_desktop,
        title_size_mobile: section.settings.title_size_mobile,
        eyebrow: section.settings.eyebrow,
        show_eyebrow_icon: section.settings.show_eyebrow_icon,
        eyebrow_color: section.settings.eyebrow_color,
        eyebrow_size_desktop: section.settings.eyebrow_size_desktop,
        eyebrow_size_mobile: section.settings.eyebrow_size_mobile,
        subtitle: section.settings.subtitle,
        subtitle_color: section.settings.subtitle_color,
        subtitle_size_desktop: section.settings.subtitle_size_desktop,
        subtitle_size_mobile: section.settings.subtitle_size_mobile,
        show_leaf: section.settings.show_leaf_icons,
        leaf_position: h_leaf_pos,
        leaf_color: section.settings.leaf_color,
        leaf_size: section.settings.leaf_size,
        leaf_gap: section.settings.leaf_gap,
        show_btn: section.settings.show_header_btn,
        btn_text: section.settings.header_btn_text,
        btn_url: section.settings.header_btn_url,
        btn_type: h_btn_type,
        btn_theme: h_btn_theme,
        btn_color: section.settings.header_btn_color,
        btn_bg_color: section.settings.header_btn_bg_color,
        btn_text_color: section.settings.header_btn_text_color,
        btn_arrow_circle_bg: section.settings.header_btn_circle_bg,
        btn_arrow_circle_color: section.settings.header_btn_circle_color
      %}
    </div>

    <!-- 2. Feature Cards Grid (Customizable Proportions from Blocks) -->
    {%- assign cards_ratio = section.settings.cards_split_ratio | default: '1.4fr_1fr' -%}
    <div class="earth-transparency__cards-grid earth-transparency__cards-grid--{{ cards_ratio | replace: '.', '-' }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'material_card' -%}
              <!-- Card 1: Material Sourcing (Accent Card) -->
              <div 
                class="earth-transparency__card earth-transparency__card--materials"
                style="
                  --card1-bg: {{ block.settings.bg_color | default: '#EAE060' }};
                  --card1-text: {{ block.settings.text_color | default: '#003225' }};
                  --card1-title-sz-d: {{ block.settings.title_size_desktop | default: 32 }}px;
                  --card1-title-sz-m: {{ block.settings.title_size_mobile | default: 24 }}px;
                  --card1-desc-sz-d: {{ block.settings.desc_size_desktop | default: 18 }}px;
                  --card1-desc-sz-m: {{ block.settings.desc_size_mobile | default: 16 }}px;
                "
                {{ block.shopify_attributes }}
              >
                <!-- Decorative Watermark Leaf -->
                {%- if block.settings.show_watermark != false -%}
                  <div class="earth-transparency__watermark" style="opacity: {{ block.settings.watermark_opacity | default: 22 | divided_by: 100.0 }};" aria-hidden="true">
                    {{ 'icon-leaf-2.svg' | inline_asset_content }}
                  </div>
                {%- endif -%}

                <div class="earth-transparency__card-top">
                  <!-- Heading with Leaf Icon -->
                  <div class="earth-transparency__card-header">
                    {%- if block.settings.show_icon != false -%}
                      <span class="earth-transparency__card-icon" aria-hidden="true">
                        {%- case block.settings.icon -%}
                          {%- when 'eco' -%}
                            {{ 'icon-eco.svg' | inline_asset_content }}
                          {%- when 'plant' -%}
                            {{ 'icon-plant-based.svg' | inline_asset_content }}
                          {%- when 'quality' -%}
                            {{ 'icon-quality.svg' | inline_asset_content }}
                          {%- else -%}
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                            </svg>
                        {%- endcase -%}
                      </span>
                    {%- endif -%}
                    <h3 class="earth-transparency__card-title">{{ block.settings.title | default: 'Material Sourcing' }}</h3>
                  </div>

                  {%- if block.settings.tagline != blank -%}
                    <p class="earth-transparency__card-tagline">{{ block.settings.tagline }}</p>
                  {%- endif -%}

                  {%- if block.settings.desc != blank -%}
                    <p class="earth-transparency__card-desc">{{ block.settings.desc }}</p>
                  {%- endif -%}

                  <!-- Certification Badges -->
                  <div 
                    class="earth-transparency__badges-group"
                    style="
                      --badge-bg: {{ block.settings.badge_bg | default: '#003225' }};
                      --badge-color: {{ block.settings.badge_color | default: '#EAE060' }};
                      --badge-radius: {{ block.settings.badge_radius | default: 20 }}px;
                    "
                  >
                    {%- if block.settings.badge1_show != false and block.settings.badge1_text != blank -%}
                      <div class="earth-transparency__badge">
                        {%- assign b1_icon = block.settings.badge1_icon | default: 'icon-GOTS-Certified.svg' -%}
                        {%- if b1_icon != 'none' -%}
                          <span class="earth-transparency__badge-icon" aria-hidden="true">{{ b1_icon | inline_asset_content }}</span>
                        {%- endif -%}
                        <span>{{ block.settings.badge1_text }}</span>
                      </div>
                    {%- endif -%}

                    {%- if block.settings.badge2_show != false and block.settings.badge2_text != blank -%}
                      <div class="earth-transparency__badge">
                        {%- assign b2_icon = block.settings.badge2_icon | default: 'icon-Fair-Trade.svg' -%}
                        {%- if b2_icon != 'none' -%}
                          <span class="earth-transparency__badge-icon" aria-hidden="true">{{ b2_icon | inline_asset_content }}</span>
                        {%- endif -%}
                        <span>{{ block.settings.badge2_text }}</span>
                      </div>
                    {%- endif -%}

                    {%- if block.settings.badge3_show and block.settings.badge3_text != blank -%}
                      <div class="earth-transparency__badge">
                        {%- assign b3_icon = block.settings.badge3_icon | default: 'icon-OEKO-TEX.svg' -%}
                        {%- if b3_icon != 'none' -%}
                          <span class="earth-transparency__badge-icon" aria-hidden="true">{{ b3_icon | inline_asset_content }}</span>
                        {%- endif -%}
                        <span>{{ block.settings.badge3_text }}</span>
                      </div>
                    {%- endif -%}
                  </div>
                </div>

                {%- if block.settings.btn_show != false and block.settings.btn_text != blank -%}
                  <div class="earth-transparency__card-action">
                    {%- assign card1_btn_label = block.settings.btn_text -%}
                    {%- assign card1_btn_style = block.settings.btn_style | default: 'arrow' -%}
                    {%- assign card1_btn_theme = block.settings.btn_theme | default: 'dark' -%}
                    {%- if card1_btn_style == 'arrow' -%}
                      {% render 'btn-arrow', text: card1_btn_label, url: block.settings.btn_url, theme: card1_btn_theme %}
                    {%- else -%}
                      {% render 'btn-action', text: card1_btn_label, url: block.settings.btn_url, variant: card1_btn_style, custom_bg: block.settings.btn_bg, custom_color: block.settings.btn_text_color %}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'image_card' -%}
              <!-- Card 2: Supply Chain (Image Card with Smooth Hover Zoom) -->
              {%- assign img_zoom_enabled = block.settings.image_hover_scale -%}
              {%- if img_zoom_enabled == nil -%}{%- assign img_zoom_enabled = true -%}{%- endif -%}
              <div 
                class="earth-transparency__card earth-transparency__card--supply{% if img_zoom_enabled %} earth-transparency__card--hover-zoom{% endif %}"
                style="
                  --card2-text: {{ block.settings.text_color | default: '#F8F9DC' }};
                  --card2-title-sz-d: {{ block.settings.title_size_desktop | default: 32 }}px;
                  --card2-title-sz-m: {{ block.settings.title_size_mobile | default: 24 }}px;
                  --card2-desc-sz-d: {{ block.settings.desc_size_desktop | default: 18 }}px;
                  --card2-desc-sz-m: {{ block.settings.desc_size_mobile | default: 16 }}px;
                  --card2-overlay-bg: {{ block.settings.overlay_color | default: '#001e14' }};
                  --card2-overlay-op: {{ block.settings.overlay_opacity | default: 75 | divided_by: 100.0 }};
                "
                {{ block.shopify_attributes }}
              >
                <div class="earth-transparency__card-media">
                  {%- if block.settings.image != blank -%}
                    <img 
                      src="{{ block.settings.image | image_url: width: 1200 }}" 
                      alt="{{ block.settings.title | default: 'Supply Chain Atelier' }}"
                      class="earth-transparency__bg-img"
                      width="1200"
                      height="800"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img 
                      src="{{ 'atelier-workshop.jpg' | asset_url }}" 
                      alt="Supply Chain Atelier"
                      class="earth-transparency__bg-img"
                      width="1200"
                      height="800"
                      loading="lazy"
                    >
                  {%- endif -%}
                  <div class="earth-transparency__card-overlay" aria-hidden="true"></div>
                </div>

                <div class="earth-transparency__card-content">
                  <h3 class="earth-transparency__supply-title">{{ block.settings.title | default: 'Supply Chain' }}</h3>
                  {%- if block.settings.desc != blank -%}
                    <p class="earth-transparency__supply-desc">{{ block.settings.desc }}</p>
                  {%- endif -%}
                  
                  {%- if block.settings.btn_show != false and block.settings.btn_text != blank -%}
                    <div class="earth-transparency__card-action">
                      {%- assign card2_btn_label = block.settings.btn_text -%}
                      {%- assign card2_btn_style = block.settings.btn_style | default: 'arrow' -%}
                      {%- assign card2_btn_theme = block.settings.btn_theme | default: 'light' -%}
                      {%- if card2_btn_style == 'arrow' -%}
                        {% render 'btn-arrow', text: card2_btn_label, url: block.settings.btn_url, theme: card2_btn_theme %}
                      {%- else -%}
                        {% render 'btn-action', text: card2_btn_label, url: block.settings.btn_url, variant: card2_btn_style, custom_bg: block.settings.btn_bg, custom_color: block.settings.btn_text_color %}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% stylesheet %}
  .earth-transparency {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: var(--transparency-bg, #F8F9DC);
    color: var(--transparency-text, #003225);
    padding-top: var(--transparency-pt, 96px);
    padding-bottom: var(--transparency-pb, 40px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .earth-transparency--full .earth-transparency__container {
    width: 100%;
    max-width: 100%;
    padding: 0 34px;
    box-sizing: border-box;
  }

  .earth-transparency--contained .earth-transparency__container {
    max-width: var(--page-width, 1440px);
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(20px, 3vw, 40px);
    padding-right: clamp(20px, 3vw, 40px);
    box-sizing: border-box;
  }

  /* 1. Header Container */
  .earth-transparency__header-container {
    margin-bottom: clamp(36px, 4vw, 48px);
    width: 100%;
    box-sizing: border-box;
  }

  /* 2. Feature Cards Grid (Customizable Proportions) */
  .earth-transparency__cards-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
    gap: var(--cards-gap, clamp(24px, 3.5vw, 48px));
    width: 100%;
    box-sizing: border-box;
  }
  .earth-transparency__cards-grid--1-4fr_1fr {
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
  }
  .earth-transparency__cards-grid--1fr_1fr {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .earth-transparency__cards-grid--1-2fr_1fr {
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 1fr);
  }
  .earth-transparency__cards-grid--2fr_1fr {
    grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
  }
  .earth-transparency__cards-grid--1fr_1-4fr {
    grid-template-columns: minmax(280px, 1fr) minmax(0, 1.4fr);
  }

  .earth-transparency__card {
    border-radius: var(--card-radius, 4px);
    position: relative;
    overflow: hidden;
    min-height: var(--card-min-h-desktop, 440px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Material Sourcing Card (Yellow) */
  .earth-transparency__card--materials {
    background-color: var(--card1-bg, var(--color-accent, #EAE060));
    color: var(--card1-text, #003225);
    padding: clamp(32px, 3.5vw, 44px);
  }

  .earth-transparency__watermark {
    position: absolute;
    right: 24px;
    bottom: 15px;
    width: 213px;
    height: 195px;
    pointer-events: none;
    user-select: none;
    z-index: 1;
  }

  .earth-transparency__watermark img,
  .earth-transparency__watermark svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .earth-transparency__card-top {
    position: relative;
    z-index: 2;
  }

  .earth-transparency__card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    color: var(--card1-text, #003225);
  }

  .earth-transparency__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .earth-transparency__card-icon svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  .earth-transparency__card-title {
    font-size: clamp(24px, 2.2vw, var(--card1-title-sz-d, 32px));
    font-weight: 800;
    color: var(--card1-text, #003225);
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.2;
  }

  .earth-transparency__card-tagline {
    font-size: 17px;
    font-weight: 700;
    color: var(--card1-text, #003225);
    margin: 0 0 16px 0;
    line-height: 1.4;
  }

  .earth-transparency__card-desc {
    font-size: var(--card1-desc-sz-d, 18px);
    line-height: 1.55;
    color: var(--card1-text, #003225);
    opacity: 0.92;
    margin: 0 0 28px 0;
    max-width: 480px;
  }

  .earth-transparency__badges-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
  }

  .earth-transparency__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--badge-bg, #003225);
    color: var(--badge-color, #EAE060);
    font-size: 15px;
    font-weight: 500;
    padding: 7px 15px;
    border-radius: var(--badge-radius, 20px);
    white-space: nowrap;
  }

  .earth-transparency__badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    object-fit: contain;
    flex-shrink: 0;
  }
  .earth-transparency__badge-icon svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  .earth-transparency__badge-icon svg path,
  .earth-transparency__badge-icon svg * {
    fill: currentColor !important;
  }

  .earth-transparency__card-action {
    position: relative;
    z-index: 2;
    margin-top: auto;
    display: flex;
  }

  /* Supply Chain Card (Image Background with Smooth Hover Zoom) */
  .earth-transparency__card--supply {
    padding: clamp(32px, 3.5vw, 44px);
    color: var(--card2-text, var(--color-white, #F8F9DC));
    justify-content: flex-end;
  }

  .earth-transparency__card-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .earth-transparency__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1);
    transform-origin: center center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  /* Smooth Scale On Hover */
  .earth-transparency__card--hover-zoom:hover .earth-transparency__bg-img {
    transform: scale(1.08);
  }

  .earth-transparency__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 30, 20, 0.15) 0%, var(--card2-overlay-bg, #001e14) 100%);
    opacity: var(--card2-overlay-op, 0.75);
    z-index: 2;
    transition: opacity 0.5s ease;
  }
  .earth-transparency__card--supply:hover .earth-transparency__card-overlay {
    opacity: calc(var(--card2-overlay-op, 0.75) * 0.9);
  }

  .earth-transparency__card-content {
    position: relative;
    z-index: 3;
    margin-top: auto;
  }

  .earth-transparency__supply-title {
    font-size: clamp(24px, 2.2vw, var(--card2-title-sz-d, 32px));
    font-weight: 800;
    color: var(--card2-text, #F8F9DC);
    letter-spacing: -0.015em;
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .earth-transparency__supply-desc {
    font-size: var(--card2-desc-sz-d, 18px);
    line-height: 1.55;
    color: var(--card2-text, #F8F9DC);
    opacity: 0.92;
    margin: 0 0 28px 0;
    max-width: 440px;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .earth-transparency {
      padding-top: calc(var(--transparency-pt, 96px) * 0.7);
      padding-bottom: calc(var(--transparency-pb, 40px) * 0.7);
    }
    .earth-transparency--full .earth-transparency__container,
    .earth-transparency--contained .earth-transparency__container,
    .earth-transparency__container {
      padding-left: 24px;
      padding-right: 24px;
    }
    .earth-transparency__cards-grid {
      grid-template-columns: 1fr !important;
      gap: 24px;
    }
    .earth-transparency__card {
      min-height: 400px;
    }
  }

  @media (max-width: 768px) {
    .earth-transparency {
      padding-top: var(--transparency-mpt, 48px);
      padding-bottom: var(--transparency-mpb, 24px);
    }
    .earth-transparency--full .earth-transparency__container,
    .earth-transparency--contained .earth-transparency__container,
    .earth-transparency__container {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }
    .earth-transparency__header-container {
      margin-bottom: 28px;
    }
    .earth-transparency__cards-grid {
      grid-template-columns: 1fr !important;
      gap: 18px;
    }
    .earth-transparency__card {
      min-height: var(--card-min-h-mobile, 380px);
      padding: 28px 20px 24px 20px;
      border-radius: 0;
    }
    .earth-transparency__card-title {
      font-size: var(--card1-title-sz-m, 24px);
    }
    .earth-transparency__card-tagline {
      font-size: 15.5px;
      margin: 0 0 14px 0;
    }
    .earth-transparency__card-desc {
      font-size: var(--card1-desc-sz-m, 16px);
      line-height: 1.5;
      margin-bottom: 20px;
      max-width: 100%;
    }
    .earth-transparency__badges-group {
      gap: 8px;
      margin-bottom: 24px;
    }
    .earth-transparency__badge {
      font-size: 14px;
      padding: 6px 13px;
    }
    .earth-transparency__watermark {
      width: 175px;
      height: 160px;
      right: 10px;
      bottom: 6px;
    }
    .earth-transparency__supply-title {
      font-size: var(--card2-title-sz-m, 24px);
      margin-bottom: 8px;
    }
    .earth-transparency__supply-desc {
      font-size: var(--card2-desc-sz-m, 16px);
      line-height: 1.45;
      margin-bottom: 22px;
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Transparency Spotlight",
  "tag": "section",
  "class": "section-transparency-spotlight",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors & Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#F8F9DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Section Text Color",
      "default": "#003225"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 96
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
