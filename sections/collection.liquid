{% comment %}
  Earth Theme - Master Collection Template
  - Organic Essentials Header with Breadcrumbs, Badges & Collection Impact Progress Bar
  - Interactive Filter Dropdowns (Availability, Price, Color, etc.) & Sort By Bar
  - Highly Optimized Product Grid (2, 3, or 4 columns) with Product Cards
  - Custom Round/Pill Pagination with SVG Arrow Navigation
  - Full SEO schema, semantic HTML, and multi-device responsive design.
{% endcomment %}

{%- liquid
  assign col_title = collection.title | default: section.settings.fallback_title | default: 'Organic Essentials'
  assign desktop_cols = section.settings.columns_desktop | default: 3
  assign mobile_cols = section.settings.columns_mobile | default: 1
-%}

<section 
  class="earth-collection full-width{% if section.settings.full_width != false %} earth-collection--full{% else %} earth-collection--contained{% endif %}"
  id="earthCollection-{{ section.id }}"
  style="
    --col-bg: {{ section.settings.bg_color | default: '#F8F9DC' }};
    --col-text: {{ section.settings.text_color | default: '#003225' }};
    --col-accent: {{ section.settings.accent_color | default: '#EAE060' }};
    --col-secondary: {{ section.settings.secondary_color | default: '#71CC3B' }};
    --col-pt-desktop: {{ section.settings.desktop_padding_top | default: 48 }}px;
    --col-pb-desktop: {{ section.settings.desktop_padding_bottom | default: 96 }}px;
    --col-pt-mobile: {{ section.settings.mobile_padding_top | default: 28 }}px;
    --col-pb-mobile: {{ section.settings.mobile_padding_bottom | default: 60 }}px;
  "
>
  <div class="earth-collection__container">

    <!-- 1. Breadcrumbs Navigation (SEO & Dynamic Hierarchy) -->
    {%- if section.settings.show_breadcrumbs != false -%}
      <nav class="earth-collection__breadcrumbs" aria-label="Breadcrumbs">
        <a href="{{ routes.collections_url | default: '/collections' }}" class="earth-collection__crumb-back" aria-label="Back to Collections">
          <span class="earth-collection__crumb-back-icon" aria-hidden="true">{{ 'icon-Previous.svg' | inline_asset_content }}</span>
        </a>
        <ol class="earth-collection__crumbs-list" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li class="earth-collection__crumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ routes.collections_url | default: '/collections' }}" class="earth-collection__crumb-link" itemprop="item">
              <span itemprop="name">Collections</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>

          <li class="earth-collection__crumb-sep" aria-hidden="true">
            <span class="earth-collection__crumb-sep-icon">{{ 'icon-Next.svg' | inline_asset_content }}</span>
          </li>

          {%- if section.settings.breadcrumb_parent != blank -%}
            <li class="earth-collection__crumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ section.settings.breadcrumb_parent_url | default: routes.all_products_collection_url }}" class="earth-collection__crumb-link" itemprop="item">
                <span itemprop="name">{{ section.settings.breadcrumb_parent }}</span>
              </a>
              <meta itemprop="position" content="2" />
            </li>
            <li class="earth-collection__crumb-sep" aria-hidden="true">
              <span class="earth-collection__crumb-sep-icon">{{ 'icon-Next.svg' | inline_asset_content }}</span>
            </li>
          {%- endif -%}

          {%- if current_tags -%}
            <li class="earth-collection__crumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="earth-collection__crumb-link" itemprop="item">
                <span itemprop="name">{{ collection.title | default: col_title }}</span>
              </a>
              <meta itemprop="position" content="{% if section.settings.breadcrumb_parent != blank %}3{% else %}2{% endif %}" />
            </li>
            <li class="earth-collection__crumb-sep" aria-hidden="true">
              <span class="earth-collection__crumb-sep-icon">{{ 'icon-Next.svg' | inline_asset_content }}</span>
            </li>
            <li class="earth-collection__crumb-item earth-collection__crumb-item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="earth-collection__crumb-current" itemprop="name" aria-current="page">{{ current_tags | join: " + " }}</span>
              <meta itemprop="position" content="{% if section.settings.breadcrumb_parent != blank %}4{% else %}3{% endif %}" />
            </li>
          {%- else -%}
            <li class="earth-collection__crumb-item earth-collection__crumb-item--current" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="earth-collection__crumb-current" itemprop="name" aria-current="page">{{ collection.title | default: col_title }}</span>
              <meta itemprop="position" content="{% if section.settings.breadcrumb_parent != blank %}3{% else %}2{% endif %}" />
            </li>
          {%- endif -%}
        </ol>
      </nav>
    {%- endif -%}

    <!-- 2. Collection Header Hero Area -->
    <header class="earth-collection__header">
      <div class="earth-collection__header-left">
        <h1 class="earth-collection__title">{{ col_title }}</h1>

        <!-- Badges Under Heading -->
        <div class="earth-collection__badges">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'header_badge' -%}
                <span class="earth-collection__badge-pill" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <span class="earth-collection__badge-icon" aria-hidden="true">{{ block.settings.icon | inline_asset_content }}</span>
                  {%- else -%}
                    <span class="earth-collection__badge-icon" aria-hidden="true">{{ 'icon-GOTS-1.svg' | inline_asset_content }}</span>
                  {%- endif -%}
                  <span>{{ block.settings.text }}</span>
                </span>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <!-- Default Badges from Design -->
            <span class="earth-collection__badge-pill">
              <span class="earth-collection__badge-icon" aria-hidden="true">{{ 'icon-GOTS-1.svg' | inline_asset_content }}</span>
              <span>GOTS Certified</span>
            </span>
            <span class="earth-collection__badge-pill">
              <span class="earth-collection__badge-icon" aria-hidden="true">{{ 'icon-tree-2.svg' | inline_asset_content }}</span>
              <span>50+ Trees Planted</span>
            </span>
          {%- endif -%}
        </div>

        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="earth-collection__description">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>

      <!-- Right Side: Collection Impact Meter -->
      {%- if section.settings.show_collection_impact != false -%}
        <div class="earth-collection__impact-box" aria-label="Collection Sustainability Impact">
          <div class="earth-collection__impact-meta">
            <span class="earth-collection__impact-label">{{ section.settings.impact_label | default: 'Collection Impact' }}</span>
            <span class="earth-collection__impact-val">{{ section.settings.impact_value | default: '2700L Water Saved' }}</span>
          </div>
          <div class="earth-collection__impact-bar">
            <div 
              class="earth-collection__impact-progress" 
              style="width: {{ section.settings.impact_progress | default: 78 }}%;"
              role="progressbar" 
              aria-valuenow="{{ section.settings.impact_progress | default: 78 }}" 
              aria-valuemin="0" 
              aria-valuemax="100"
            ></div>
          </div>
        </div>
      {%- endif -%}
    </header>

    <!-- 3. Filter & Sort Toolbar -->
    {%- paginate collection.products by 12 -%}
      <div class="earth-collection__toolbar" id="earthCollectionToolbar-{{ section.id }}">
        
        <!-- Left Filters Group -->
        <div class="earth-collection__filters-group">
          {%- if section.settings.enable_filtering != false -%}
            <span class="earth-collection__filter-label">
              <span class="earth-collection__filter-icon" aria-hidden="true">
                {{ 'icon-Filters.svg' | inline_asset_content }}
              </span>
              <span>Filters</span>
            </span>

            <!-- Filter Dropdowns Container -->
            <div class="earth-collection__filter-dropdowns">
              <!-- Filter: Availability -->
              <div class="earth-collection__dropdown-wrap" data-dropdown="availability">
                <button type="button" class="earth-collection__dropdown-btn" aria-expanded="false">
                  <span>Availability</span>
                  <span class="earth-collection__dropdown-arrow" aria-hidden="true">{{ 'icon-down.svg' | inline_asset_content }}</span>
                </button>
                <div class="earth-collection__dropdown-menu">
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter.v.availability" value="1" onchange="this.form ? this.form.submit() : null">
                    <span class="earth-collection__check-box"></span>
                    <span>In Stock ({{ collection.products_count | default: 24 }})</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter.v.availability" value="0" onchange="this.form ? this.form.submit() : null">
                    <span class="earth-collection__check-box"></span>
                    <span>Out of Stock (2)</span>
                  </label>
                </div>
              </div>

              <!-- Filter: Price -->
              <div class="earth-collection__dropdown-wrap" data-dropdown="price">
                <button type="button" class="earth-collection__dropdown-btn" aria-expanded="false">
                  <span>Price</span>
                  <span class="earth-collection__dropdown-arrow" aria-hidden="true">{{ 'icon-down.svg' | inline_asset_content }}</span>
                </button>
                <div class="earth-collection__dropdown-menu earth-collection__dropdown-menu--price">
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_price" value="under_50">
                    <span class="earth-collection__check-box"></span>
                    <span>Under $50</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_price" value="50_100">
                    <span class="earth-collection__check-box"></span>
                    <span>$50 - $100</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_price" value="100_200">
                    <span class="earth-collection__check-box"></span>
                    <span>$100 - $200</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_price" value="above_200">
                    <span class="earth-collection__check-box"></span>
                    <span>$200+</span>
                  </label>
                </div>
              </div>

              <!-- Filter: Color -->
              <div class="earth-collection__dropdown-wrap" data-dropdown="color">
                <button type="button" class="earth-collection__dropdown-btn" aria-expanded="false">
                  <span>Color</span>
                  <span class="earth-collection__dropdown-arrow" aria-hidden="true">{{ 'icon-down.svg' | inline_asset_content }}</span>
                </button>
                <div class="earth-collection__dropdown-menu earth-collection__dropdown-menu--color">
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_color" value="denim">
                    <span class="earth-collection__color-swatch" style="background-color: #5b7f95;"></span>
                    <span>Denim Blue</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_color" value="olive">
                    <span class="earth-collection__color-swatch" style="background-color: #4a5d23;"></span>
                    <span>Olive Green</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_color" value="natural">
                    <span class="earth-collection__color-swatch" style="background-color: #f1ebd9; border: 1px solid #ccc;"></span>
                    <span>Natural Ecru</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_color" value="black">
                    <span class="earth-collection__color-swatch" style="background-color: #1a1a1a;"></span>
                    <span>Charcoal</span>
                  </label>
                </div>
              </div>

              <!-- Filter: Material / Sustainability -->
              <div class="earth-collection__dropdown-wrap" data-dropdown="material">
                <button type="button" class="earth-collection__dropdown-btn" aria-expanded="false">
                  <span>Material</span>
                  <span class="earth-collection__dropdown-arrow" aria-hidden="true">{{ 'icon-down.svg' | inline_asset_content }}</span>
                </button>
                <div class="earth-collection__dropdown-menu">
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_mat" value="organic_cotton">
                    <span class="earth-collection__check-box"></span>
                    <span>100% Organic Cotton</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_mat" value="regenerative">
                    <span class="earth-collection__check-box"></span>
                    <span>Regenerative Denim</span>
                  </label>
                  <label class="earth-collection__filter-check">
                    <input type="checkbox" name="filter_mat" value="recycled">
                    <span class="earth-collection__check-box"></span>
                    <span>Recycled Fibers</span>
                  </label>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>

        <!-- Right Sort & Count Group -->
        <div class="earth-collection__sort-group">
          {%- if section.settings.enable_sorting != false -%}
            <div class="earth-collection__sort-wrap">
              <span class="earth-collection__sort-label">Sort by</span>
              <div class="earth-collection__custom-select">
                <select 
                  id="earthCollectionSort-{{ section.id }}" 
                  class="earth-collection__select-native"
                  aria-label="Sort collection products"
                  onchange="location.href = this.value;"
                >
                  {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
                  <option value="{{ collection.url }}?sort_by=best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best selling</option>
                  <option value="{{ collection.url }}?sort_by=manual" {% if current_sort == 'manual' %}selected{% endif %}>Featured</option>
                  <option value="{{ collection.url }}?sort_by=price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
                  <option value="{{ collection.url }}?sort_by=price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
                  <option value="{{ collection.url }}?sort_by=title-ascending" {% if current_sort == 'title-ascending' %}selected{% endif %}>Alphabetically, A-Z</option>
                  <option value="{{ collection.url }}?sort_by=created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Date: New to Old</option>
                </select>
                <span class="earth-collection__select-arrow" aria-hidden="true">{{ 'icon-down.svg' | inline_asset_content }}</span>
              </div>
            </div>
          {%- endif -%}

          <span class="earth-collection__product-count">
            {%- if collection.products_count > 0 -%}
              {{ collection.products_count }} products
            {%- else -%}
              26 products
            {%- endif -%}
          </span>
        </div>

      </div>

      <!-- 4. Product Cards Grid -->
      {%- assign card_ratio = section.settings.card_aspect_ratio | default: 'portrait' -%}
      <div 
        class="earth-collection__grid earth-collection__grid--cols-{{ desktop_cols }} earth-collection__grid--mobile-{{ mobile_cols }}" 
        id="earthCollectionGrid-{{ section.id }}"
      >
        {%- if collection.products.size > 0 -%}
          {%- for product in collection.products -%}
            <div class="earth-collection__grid-item">
              {% render 'product-card',
                product: product,
                aspect_ratio: card_ratio,
                show_impact_badge: section.settings.show_impact_badge,
                show_metrics: section.settings.show_metrics_pills,
                show_quick_view: section.settings.show_quick_view,
                show_material: section.settings.show_material,
                show_tags: section.settings.show_tags,
                show_origin: section.settings.show_origin,
                show_discount: section.settings.show_discount
              %}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Curated Demo Product Showcase matching Design Layout -->
          {%- for i in (1..9) -%}
            {%- case i -%}
              {%- when 2 -%}
                {%- assign demo_title = 'One Shoulder Twisted Wrap Dress' -%}
              {%- else -%}
                {%- assign demo_title = 'Regenerative Denim' -%}
            {%- endcase -%}

            <div class="earth-collection__grid-item">
              {% render 'product-card',
                fallback_image: 'prod-denim.jpg',
                title: demo_title,
                material: '100% Regenerative Organic Cotton',
                impact_score: '97% Impact',
                water_saved: '3,200 L',
                co2_saved: '5.5 kg',
                origin: 'Vietnam',
                price: '110',
                aspect_ratio: card_ratio,
                show_impact_badge: section.settings.show_impact_badge,
                show_metrics: section.settings.show_metrics_pills,
                show_quick_view: section.settings.show_quick_view,
                show_material: section.settings.show_material,
                show_tags: section.settings.show_tags,
                show_origin: section.settings.show_origin,
                show_discount: section.settings.show_discount
              %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <!-- 5. Rounded Pagination Unit -->
      <div class="earth-collection__pagination">
        {%- if paginate.pages > 1 -%}
          <nav class="earth-collection__pagination-nav" aria-label="Pagination Navigation">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="earth-collection__page-btn earth-collection__page-btn--prev" aria-label="Previous page">
                <span class="earth-collection__page-icon" aria-hidden="true">{{ 'icon-arrow-left.svg' | inline_asset_content }}</span>
              </a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="earth-collection__page-btn">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="earth-collection__page-btn earth-collection__page-btn--active" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="earth-collection__page-btn earth-collection__page-btn--dots">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="earth-collection__page-btn earth-collection__page-btn--next" aria-label="Next page">
                <span class="earth-collection__page-icon" aria-hidden="true">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
              </a>
            {%- endif -%}
          </nav>
        {%- else -%}
          <!-- Mock Pagination for preview -->
          <nav class="earth-collection__pagination-nav" aria-label="Pagination">
            <span class="earth-collection__page-btn earth-collection__page-btn--active" aria-current="page">1</span>
            <button type="button" class="earth-collection__page-btn">2</button>
            <button type="button" class="earth-collection__page-btn">3</button>
            <button type="button" class="earth-collection__page-btn earth-collection__page-btn--next" aria-label="Next page">
              <span class="earth-collection__page-icon" aria-hidden="true">{{ 'icon-arrow-right.svg' | inline_asset_content }}</span>
            </button>
          </nav>
        {%- endif -%}
      </div>

    {%- endpaginate -%}

  </div>
</section>

<!-- JSON-LD SEO Schema for Collection Page -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ col_title | json }},
  "url": {{ canonical_url | json }},
  {% if collection.description != blank %}
  "description": {{ collection.description | strip_html | json }},
  {% endif %}
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {%- for product in collection.products limit: 12 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": "{{ shop.url }}{{ product.url }}",
          "name": {{ product.title | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
}
</script>

{% stylesheet %}
  /* Master Collection Styling */
  .earth-collection {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: var(--col-bg, #F8F9DC);
    color: var(--col-text, #003225);
    border-top: 1px solid var(--col-text, #003225);
    padding-top: var(--col-pt-desktop, 48px);
    padding-bottom: var(--col-pb-desktop, 96px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .earth-collection--full .earth-collection__container {
    width: 100%;
    max-width: 100%;
    padding: 0 34px;
    box-sizing: border-box;
  }

  .earth-collection--contained .earth-collection__container {
    max-width: var(--page-width, 1440px);
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(20px, 3vw, 40px);
    padding-right: clamp(20px, 3vw, 40px);
    box-sizing: border-box;
  }

  /* 1. Breadcrumbs */
  .earth-collection__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(16px, 2vw, 24px);
    color: var(--col-text, #003225);
  }
  .earth-collection__crumb-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--col-text, #003225);
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
    opacity: 0.9;
  }
  .earth-collection__crumb-back:hover {
    transform: translateX(-2px);
    opacity: 1;
  }
  .earth-collection__crumb-back-icon {
    width: 10px;
    height: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--col-text, #003225);
  }
  .earth-collection__crumb-back-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .earth-collection__crumbs-list {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 8px;
    font-size: 13.5px;
    color: var(--col-text, #003225);
    flex-wrap: wrap;
  }
  .earth-collection__crumb-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .earth-collection__crumb-link {
    color: var(--col-text, #003225);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .earth-collection__crumb-link:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .earth-collection__crumb-sep {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--col-text, #003225);
    opacity: 0.85;
    line-height: 1;
    flex-shrink: 0;
  }
  .earth-collection__crumb-sep-icon {
    width: 8px;
    height: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--col-text, #003225);
  }
  .earth-collection__crumb-sep-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }
  .earth-collection__crumb-current {
    font-weight: 400;
    color: var(--col-text, #003225);
    opacity: 0.85;
  }

  /* 2. Header Hero Area */
  .earth-collection__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(28px, 3.5vw, 44px);
    flex-wrap: wrap;
  }
  .earth-collection__header-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 720px;
  }
  .earth-collection__title {
    font-size: 64px;
    font-weight: 800;
    color: var(--col-text, #003225);
    margin: 0;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .earth-collection__badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .earth-collection__badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--col-accent, #EAE060);
    color: var(--col-text, #003225);
    font-size: 15px;
    font-weight: 400;
