<script>
  (function() {
    function initCollectionFilters() {
      var section = document.getElementById('earthCollection-{{ section.id }}');
      if (!section) return;

      var dropdownWraps = section.querySelectorAll('.earth-collection__dropdown-wrap');
      
      dropdownWraps.forEach(function(wrap) {
        var btn = wrap.querySelector('.earth-collection__dropdown-btn');
        if (!btn) return;

        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var isOpen = wrap.classList.contains('is-open');
          
          // Close all other dropdowns
          dropdownWraps.forEach(function(w) { 
            w.classList.remove('is-open'); 
            var b = w.querySelector('.earth-collection__dropdown-btn');
            if (b) b.setAttribute('aria-expanded', 'false');
          });

          if (!isOpen) {
            wrap.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });

      // Close when clicking outside
      document.addEventListener('click', function(e) {
        if (!section.contains(e.target)) {
          dropdownWraps.forEach(function(w) { 
            w.classList.remove('is-open'); 
            var b = w.querySelector('.earth-collection__dropdown-btn');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCollectionFilters);
    } else {
      initCollectionFilters();
    }

    // Support Shopify Theme Editor Re-render
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initCollectionFilters();
      }
    });
  })();
</script>

