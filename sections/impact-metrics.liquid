{% comment %}
  Impact Metrics Section - Our Real Impact & Personal Sustainability Impact
  Configurable top section header, middle CTA, and modular metric blocks (Dark Metric Cards + Outlined Stat Cards)
{% endcomment %}

{%- liquid
  assign dark_cards = section.blocks | where: 'type', 'dark_card'
  assign outline_cards = section.blocks | where: 'type', 'outline_card'
-%}

<section 
  class="earth-impact-section full-width{% if section.settings.full_width %} earth-impact-section--full{% endif %}" 
  id="earthImpact-{{ section.id }}"
  style="
    --impact-bg: {{ section.settings.bg_color | default: '#F8F9DC' }};
    --impact-pt: {{ section.settings.top_padding | default: 72 }}px;
    --impact-pb: {{ section.settings.bottom_padding | default: 80 }}px;
    --impact-title-color: {{ section.settings.title_color | default: '#003225' }};
    --impact-subtitle-color: {{ section.settings.subtitle_color | default: '#224E09' }};
    --impact-middle-title-color: {{ section.settings.personal_title_color | default: '#003225' }};
    --impact-middle-subtitle-color: {{ section.settings.personal_subtitle_color | default: '#224E09' }};
  "
>
  <div class="earth-impact__container">
    <!-- 1. Top Section Header -->
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="earth-impact__header">
        {%- if section.settings.title != blank -%}
          <h2 class="earth-impact__main-title">
            {%- if section.settings.show_leaf_icons -%}
              <img src="{{ 'icon-leaf-2.svg' | asset_url }}" width="32" height="32" alt="" class="earth-impact__leaf earth-impact__leaf--left" loading="lazy">
            {%- endif -%}
            <span>{{ section.settings.title }}</span>
            {%- if section.settings.show_leaf_icons -%}
              <img src="{{ 'icon-leaf-2.svg' | asset_url }}" width="32" height="32" alt="" class="earth-impact__leaf earth-impact__leaf--right" loading="lazy">
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="earth-impact__main-subtitle">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- 2. Top Dark Green Cards Grid -->
    <div class="earth-impact__grid-top">
      {%- if dark_cards.size > 0 -%}
        {%- for block in dark_cards -%}
          <div 
            class="earth-impact__dark-card" 
            {{ block.shopify_attributes }}
            style="
              {% if block.settings.card_bg != blank %}background-color: {{ block.settings.card_bg }};{% endif %}
              {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
            "
          >
            {%- if block.settings.show_watermark -%}
              <div class="earth-impact__watermark" aria-hidden="true">
                <img src="{{ 'icon-ecology.svg' | asset_url }}" width="226" height="219" alt="" loading="lazy">
              </div>
            {%- endif -%}
            
            <div class="earth-impact__icon-box">
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 100 }}" width="36" height="36" alt="{{ block.settings.title | default: 'Metric Icon' }}" loading="lazy">
              {%- else -%}
                {%- case block.settings.icon_type -%}
                  {%- when 'tree' -%}
                    <img src="{{ 'icon-tree.svg' | asset_url }}" width="32" height="32" alt="Trees Planted" loading="lazy">
                  {%- when 'co2' -%}
                    <img src="{{ 'icon-zero-emissions.svg' | asset_url }}" width="36" height="36" alt="CO2 Saved" loading="lazy">
                  {%- when 'quality' -%}
                    <img src="{{ 'icon-quality.svg' | asset_url }}" width="36" height="36" alt="Fair Trade" loading="lazy">
                  {%- when 'water' -%}
                    <img src="{{ 'icon-Drop.svg' | asset_url }}" width="28" height="32" alt="Water Saved" loading="lazy">
                  {%- else -%}
                    {%- assign card_idx = forloop.index | modulo: 4 -%}
                    {%- if card_idx == 1 -%}
                      <img src="{{ 'icon-tree.svg' | asset_url }}" width="32" height="32" alt="Trees Planted" loading="lazy">
                    {%- elsif card_idx == 2 -%}
                      <img src="{{ 'icon-zero-emissions.svg' | asset_url }}" width="36" height="36" alt="CO2 Saved" loading="lazy">
                    {%- elsif card_idx == 3 -%}
                      <img src="{{ 'icon-quality.svg' | asset_url }}" width="36" height="36" alt="Fair Trade" loading="lazy">
                    {%- else -%}
                      <img src="{{ 'icon-Drop.svg' | asset_url }}" width="28" height="32" alt="Water Saved" loading="lazy">
                    {%- endif -%}
                {%- endcase -%}
              {%- endif -%}
            </div>

            {%- if block.settings.number != blank -%}
              <span class="earth-impact__dark-number">{{ block.settings.number }}</span>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="earth-impact__dark-title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.note != blank -%}
              <p class="earth-impact__dark-note">{{ block.settings.note }}</p>
            {%- endif -%}

            {%- if block.settings.pills != blank -%}
              <div class="earth-impact__pill-group">
                {%- assign pill_items = block.settings.pills | split: ',' -%}
                {%- for pill in pill_items -%}
                  <span class="earth-impact__pill">{{ pill | strip }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Default 4 Dark Cards -->
        <div class="earth-impact__dark-card">
          <div class="earth-impact__watermark" aria-hidden="true">
            <img src="{{ 'icon-ecology.svg' | asset_url }}" width="226" height="219" alt="" loading="lazy">
          </div>
          <div class="earth-impact__icon-box">
            <img src="{{ 'icon-tree.svg' | asset_url }}" width="32" height="32" alt="Trees Planted" loading="lazy">
          </div>
          <span class="earth-impact__dark-number">100,000+</span>
          <h3 class="earth-impact__dark-title">Trees Planted</h3>
          <p class="earth-impact__dark-note">80% of 2025 goal reached</p>
        </div>

        <div class="earth-impact__dark-card">
          <div class="earth-impact__watermark" aria-hidden="true">
            <img src="{{ 'icon-ecology.svg' | asset_url }}" width="226" height="219" alt="" loading="lazy">
          </div>
          <div class="earth-impact__icon-box">
            <img src="{{ 'icon-zero-emissions.svg' | asset_url }}" width="36" height="36" alt="CO2 Saved" loading="lazy">
          </div>
          <span class="earth-impact__dark-number">500T</span>
          <h3 class="earth-impact__dark-title">CO₂ Saved</h3>
          <p class="earth-impact__dark-note">≠ Equal to 2,500 cars off the road yearly</p>
        </div>

        <div class="earth-impact__dark-card">
          <div class="earth-impact__watermark" aria-hidden="true">
            <img src="{{ 'icon-ecology.svg' | asset_url }}" width="226" height="219" alt="" loading="lazy">
          </div>
          <div class="earth-impact__icon-box">
            <img src="{{ 'icon-quality.svg' | asset_url }}" width="36" height="36" alt="Fair Trade" loading="lazy">
          </div>
          <span class="earth-impact__dark-number">100%</span>
          <h3 class="earth-impact__dark-title">Fair Trade Certified</h3>
          <div class="earth-impact__pill-group">
            <span class="earth-impact__pill">GOTS</span>
            <span class="earth-impact__pill">B Corp</span>
          </div>
        </div>

        <div class="earth-impact__dark-card">
          <div class="earth-impact__watermark" aria-hidden="true">
            <img src="{{ 'icon-ecology.svg' | asset_url }}" width="226" height="219" alt="" loading="lazy">
          </div>
          <div class="earth-impact__icon-box">
            <img src="{{ 'icon-Drop.svg' | asset_url }}" width="28" height="32" alt="Water Saved" loading="lazy">
          </div>
          <span class="earth-impact__dark-number">1,000,159</span>
          <h3 class="earth-impact__dark-title">Liters Water Saved</h3>
          <p class="earth-impact__dark-note">• Live update</p>
        </div>
      {%- endif -%}
    </div>

    <!-- 3. Middle Personal Impact Header & CTA -->
    {%- if section.settings.personal_title != blank or section.settings.personal_subtitle != blank or section.settings.button_text != blank -%}
      <div class="earth-impact__middle">
        {%- if section.settings.personal_title != blank -%}
          <h2 class="earth-impact__middle-title">
            {{ section.settings.personal_title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.personal_subtitle != blank -%}
          <p class="earth-impact__middle-subtitle">
            {{ section.settings.personal_subtitle }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_type != 'none' -%}
          <div class="earth-impact__cta-wrap">
            {%- assign impact_btn_text = section.settings.button_text -%}
            {%- assign impact_btn_url = section.settings.button_link | default: routes.account_url -%}
            {%- assign impact_btn_type = section.settings.button_type | default: 'solid' -%}
            
            {%- if impact_btn_type == 'arrow' -%}
              {% render 'btn-arrow',
                text: impact_btn_text,
                url: impact_btn_url,
                theme: 'dark'
              %}
            {%- else -%}
              {% render 'btn-action',
                text: impact_btn_text,
                url: impact_btn_url,
                variant: impact_btn_type,
                custom_bg: section.settings.button_bg_color,
                custom_color: section.settings.button_text_color
              %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- 4. Bottom Outlined Stats Grid -->
    <div class="earth-impact__grid-bottom">
      {%- if outline_cards.size > 0 -%}
        {%- for block in outline_cards -%}
          <div 
            class="earth-impact__outline-card" 
            {{ block.shopify_attributes }}
            style="
              {% if block.settings.card_border != blank %}border-color: {{ block.settings.card_border }};{% endif %}
              {% if block.settings.card_bg != blank %}background-color: {{ block.settings.card_bg }};{% endif %}
            "
          >
            {%- if block.settings.number != blank -%}
              <span class="earth-impact__outline-number" {% if block.settings.number_color != blank %}style="color: {{ block.settings.number_color }};"{% endif %}>
                {{ block.settings.number }}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="earth-impact__outline-title" {% if block.settings.text_color != blank %}style="color: {{ block.settings.text_color }};"{% endif %}>
                {{ block.settings.title }}
              </h3>
            {%- endif -%}
            {%- if block.settings.note != blank -%}
              <p class="earth-impact__outline-note" {% if block.settings.text_color != blank %}style="color: {{ block.settings.text_color }};"{% endif %}>
                {{ block.settings.note }}
              </p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback Default 4 Outlined Cards -->
        <div class="earth-impact__outline-card">
          <span class="earth-impact__outline-number">95%</span>
          <h3 class="earth-impact__outline-title">Organic Cotton</h3>
          <p class="earth-impact__outline-note">of materials used</p>
        </div>

        <div class="earth-impact__outline-card">
          <span class="earth-impact__outline-number">2,500+</span>
          <h3 class="earth-impact__outline-title">Factory Workers</h3>
          <p class="earth-impact__outline-note">earning fair wages</p>
        </div>

        <div class="earth-impact__outline-card">
          <span class="earth-impact__outline-number">40%</span>
          <h3 class="earth-impact__outline-title">Recycled Materials</h3>
          <p class="earth-impact__outline-note">in our products</p>
        </div>

        <div class="earth-impact__outline-card">
          <span class="earth-impact__outline-number">2026</span>
          <h3 class="earth-impact__outline-title">Carbon Neutral</h3>
          <p class="earth-impact__outline-note">achieved</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* ==========================================================================
     Our Real Impact Section Styles
     ========================================================================== */
  .earth-impact-section {
    grid-column: 1 / -1 !important;
    background-color: var(--impact-bg, #F8F9DC);
    padding-top: var(--impact-pt, 72px);
    padding-bottom: var(--impact-pb, 80px);
    padding-left: clamp(20px, 2.5vw, 34px);
    padding-right: clamp(20px, 2.5vw, 34px);
    width: 100%;
    box-sizing: border-box;
  }
  .earth-impact__container {
    margin: 0 auto;
    width: 100%;
    max-width: var(--page-width, 1320px);
    box-sizing: border-box;
  }
  .earth-impact-section--full .earth-impact__container {
    max-width: 100%;
  }

  /* 1. Top Section Header */
  .earth-impact__header {
    text-align: center;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .earth-impact__main-title {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: var(--type-section-title, 2.625rem);
    font-weight: 800;
    color: var(--impact-title-color, #003225);
    letter-spacing: -0.03em;
    margin: 0 0 16px 0;
    line-height: 1.15;
  }
  .earth-impact__leaf {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: inline-block;
  }
  .earth-impact__main-subtitle {
    font-size: var(--type-section-subtitle, 1.3125rem);
    color: var(--impact-subtitle-color, #224E09);
    max-width: 550px;
    margin: 0 auto;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  /* 2. Top Dark Green Cards Grid */
  .earth-impact__grid-top {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .earth-impact__dark-card {
    background-color: var(--color-primary, #224E09);
    color: #ffffff;
    padding: 38px 20px 34px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
    min-height: 250px;
    box-sizing: border-box;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .earth-impact__dark-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 50, 37, 0.12);
  }
  .earth-impact__watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 220px;
    height: 210px;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .earth-impact__watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .earth-impact__icon-box {
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }
  .earth-impact__icon-box img {
    max-height: 38px;
    width: auto;
    object-fit: contain;
  }
  .earth-impact__dark-number {
    font-size: clamp(1.8rem, 2.4vw, 2.3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-white, #F8F9DC);
    margin-bottom: 6px;
    position: relative;
    z-index: 1;
  }
  .earth-impact__dark-title {
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--color-white, #F8F9DC);
    margin: 0 0 6px 0;
    position: relative;
    z-index: 1;
    letter-spacing: -0.01em;
  }
  .earth-impact__dark-note {
    font-size: 1rem;
    color: var(--color-white, #F8F9DC);
    margin: 0;
    line-height: 1.35;
    position: relative;
    z-index: 1;
    opacity: 0.9;
  }
  .earth-impact__pill-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 6px;
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
  }
  .earth-impact__pill {
    background-color: var(--color-accent, #EAE060);
    color: var(--color-black, #003225);
    font-size: 0.9375rem;
    font-weight: 400;
    padding: 3px 10px;
    border-radius: 12px;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  /* 3. Middle Personal Impact Section */
  .earth-impact__middle {
    text-align: center;
    margin: clamp(48px, 6vw, 72px) 0;
  }
  .earth-impact__middle-title {
    font-size: var(--type-section-title, 2.125rem);
    font-weight: 800;
    color: var(--impact-middle-title-color, #003225);
    letter-spacing: -0.03em;
    margin: 0 0 12px 0;
    line-height: 1.2;
  }
  .earth-impact__middle-subtitle {
    font-size: 1.3125rem;
    color: var(--impact-middle-subtitle-color, #224E09);
    max-width: 504px;
    margin: 0 auto 28px;
    line-height: 1.45;
  }
  .earth-impact__cta-wrap {
    display: flex;
    justify-content: center;
  }

  /* 4. Bottom Outlined Stats Grid */
  .earth-impact__grid-bottom {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .earth-impact__outline-card {
    background-color: transparent;
    border: 1px solid var(--color-primary, #224E09);
    padding: 38px 20px 34px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    box-sizing: border-box;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }
  .earth-impact__outline-card:hover {
    transform: translateY(-4px);
    background-color: rgba(34, 78, 9, 0.03);
  }
  .earth-impact__outline-number {
    font-size: clamp(2rem, 2.8vw, 2.6rem);
    font-weight: 800;
    color: var(--color-black, #003225);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .earth-impact__outline-title {
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--color-primary, #224E09);
    margin: 0 0 6px 0;
    letter-spacing: -0.01em;
  }
  .earth-impact__outline-note {
    font-size: 0.938rem;
    color: var(--color-primary, #224E09);
    margin: 0;
    opacity: 0.85;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .earth-impact-section {
      padding: 64px 28px 72px;
    }
    .earth-impact__grid-top,
    .earth-impact__grid-bottom {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .earth-impact__dark-card {
      padding: 32px 20px 28px;
      min-height: 220px;
    }
  }

  @media (max-width: 768px) {
    .earth-impact-section {
      padding: 56px 20px 64px;
      overflow: hidden;
    }
    .earth-impact__leaf {
      display: none !important;
    }
    .earth-impact__main-title {
      font-size: 2.25rem !important;
    }
    .earth-impact__main-subtitle {
      font-size: 0.9375rem;
    }
    .earth-impact__middle {
      margin: 48px 0 36px;
    }
    .earth-impact__middle-title {
      font-size: 2.25rem !important;
    }
    .earth-impact__middle-subtitle {
      font-size: 1.125rem;
      margin-bottom: 24px;
    }

    /* Horizontal Swipeable Track on Mobile */
    .earth-impact__grid-top,
    .earth-impact__grid-bottom {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
      gap: 14px !important;
      margin-left: -20px !important;
      margin-right: -20px !important;
      padding-left: 20px !important;
      padding-right: 0 !important;
      padding-bottom: 6px !important;
      scroll-padding: 0 20px !important;
    }
    .earth-impact__grid-top::-webkit-scrollbar,
    .earth-impact__grid-bottom::-webkit-scrollbar {
      display: none !important;
    }

    .earth-impact__dark-card {
      flex: 0 0 78% !important;
      min-width: 250px;
      max-width: 300px;
      min-height: 230px;
      padding: 28px 18px 24px;
      scroll-snap-align: start;
      box-sizing: border-box;
    }

    .earth-impact__dark-card:last-child,
    .earth-impact__outline-card:last-child {
      margin-right: 20px !important;
    }

    .earth-impact__outline-card {
      flex: 0 0 78% !important;
      min-width: 250px;
      max-width: 300px;
      padding: 24px 18px;
      scroll-snap-align: start;
      box-sizing: border-box;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Impact Metrics",
  "settings": [
    {
      "type": "header",
      "content": "Section Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F9DC"
    },
    {
      "type": "range",
      "id": "top_padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make Section Full Width",
      "default": true
    },
    {
      "type": "header",
      "content": "Top Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Real Impact"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Transparency is at the heart of everything we do. Track our environmental and social impact in real-time."
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color"
    },
    {
      "type": "checkbox",
      "id": "show_leaf_icons",
      "label": "Show Decorative Leaves in Title",
      "default": true
    },
    {
      "type": "header",
      "content": "Middle Section Header & CTA"
    },
    {
      "type": "text",
      "id": "personal_title",
      "label": "Personal Impact Title",
      "default": "Your Personal Sustainability Impact"
    },
    {
      "type": "color",
      "id": "personal_title_color",
      "label": "Personal Impact Title Color"
    },
    {
      "type": "textarea",
      "id": "personal_subtitle",
      "label": "Personal Impact Subtitle",
      "default": "Connect your account to see how you contribute to sustainability goals."
    },
    {
