{%- comment -%}
  Section: Image with text overlay
  - Full-width background image (section settings, with an optional mobile image)
  - Overlay layer between the image and the content, so the text stays readable
  - Content comes from child blocks (stack, icons, heading, sub-heading, paragraph, button)
{%- endcomment -%}

{%- liquid
  assign make_section_page_width = section.settings.make_section_page_width
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile

  # Outer class list
  assign section_height = section.settings.section_height | default: 'scale'
  assign section_classes = 'vt-section vt-image-overlay vt-image-overlay--' | append: section_height

  # Inner class list: mobile alignment applies at every width, desktop (md:) overrides from 750px
  assign inner_classes = 'vt-section__inner vt-image-overlay__inner'
  assign inner_classes = inner_classes | append: ' ' | append: section.settings.mobile_content_alignment
  assign inner_classes = inner_classes | append: ' md:' | append: section.settings.desktop_content_alignment
  if make_section_page_width
    assign inner_classes = inner_classes | append: ' vt-page-width'
  endif

  # Ratio keyword -> CSS aspect-ratio value
  case section.settings.image_ratio_desktop
    when 'ultra_wide'
      assign ratio_desktop = '21 / 9'
    when 'landscape'    
      assign ratio_desktop = '4 / 3'
    else
      assign ratio_desktop = '16 / 9'
  endcase
  
  case section.settings.image_ratio_mobile
    when 'square'
      assign ratio_mobile = '1 / 1'
    when 'portrait'
      assign ratio_mobile = '3 / 4'
    else
      assign ratio_mobile = '2 / 3'
  endcase

  # The first section on the page is usually the largest paint: don't lazy load it
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif

  assign image_widths = '750, 940, 1080, 1296, 1512, 1728, 1950, 2100, 2560, 3200' | split: ', '
  assign overlay_opacity = section.settings.overlay_opacity | default: 0 | divided_by: 100.0
-%}

{%- comment -%} Reusable section CSS variables (padding, gap, colors) {%- endcomment -%}
{% render 'section-styles', section: section %}

<div
  class="{{ section_classes }}"
  style="
    --vt-image-overlay-ratio-desktop: {{ ratio_desktop }};
    --vt-image-overlay-ratio-mobile: {{ ratio_mobile }};
    --vt-image-overlay-position: {{ section.settings.content_position }};
    --vt-image-overlay-color: {{ section.settings.overlay_color | default: 'var(--vt-color-primary)' }};
    --vt-image-overlay-opacity: {{ overlay_opacity }};
    --vt-section-color: {{ section.settings.heading_color | default: 'var(--vt-background-color)' }};
    --vt-section-paragraph-color: {{ section.settings.paragraph_color | default: 'var(--vt-background-color)' }};
    --vt-image-overlay-radius: {{ section.settings.image_radius | divided_by: 16.0 }}rem;
    --vt-image-overlay-height-desktop: {{ section.settings.height_desktop | divided_by: 16.0 }}rem;
    --vt-image-overlay-height-mobile: {{ section.settings.height_mobile | divided_by: 16.0 }}rem;
    {%- if image != blank %}
    --vt-image-overlay-focal: {{ image.presentation.focal_point }};
    --vt-image-overlay-focal-mobile: {{ image_mobile.presentation.focal_point | default: image.presentation.focal_point }};
    {%- endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-image-overlay__media">
    {%- if image != blank -%}
      <picture>
        {%- if image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{% for w in image_widths %}{{ image_mobile | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
            sizes="100vw"
            width="{{ image_mobile.width }}"
            height="{{ image_mobile.height }}"
          >
        {%- endif -%}
        <img
          src="{{ image | image_url: width: 1950 }}"
          srcset="{% for w in image_widths %}{{ image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
          sizes="100vw"
          width="{{ image.width }}"
          height="{{ image.height }}"
          alt="{{ image.alt | escape }}"
          loading="{{ image_loading }}"
          fetchpriority="{{ image_priority }}"
          class="vt-image-overlay__img"
        >
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'vt-image-overlay__img vt-image-overlay__img--placeholder' }}
    {%- endif -%}
  </div>

  <div class="vt-image-overlay__scrim" aria-hidden="true"></div>

  <div class="{{ inner_classes }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  /* Every height is a minimum: a taller content block makes the section grow */
  .vt-image-overlay {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    box-sizing: border-box;
    --vt-sub-heading-text-transform: none;
  }

  .vt-image-overlay--scale {
    aspect-ratio: var(--vt-image-overlay-ratio-mobile, 2 / 3);
  }

  .vt-image-overlay--fixed {
    min-height: var(--vt-image-overlay-height-mobile);
  }

  .vt-image-overlay--screen {
    min-height: 100vh;
    min-height: 100svh;
  }

  .vt-image-overlay__media,
  .vt-image-overlay__scrim {
    position: absolute;
    inset: 0;
    border-radius: var(--vt-image-overlay-radius, 0);
  }

  .vt-image-overlay__media {
    z-index: -2;
    overflow: hidden;
    background-color: var(--vt-color-primary);
  }

  .vt-image-overlay__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--vt-image-overlay-focal-mobile, center);
  }

  .vt-image-overlay__img--placeholder {
    color: var(--vt-background-color);
    opacity: 0.25;
  }

  .vt-image-overlay__scrim {
    z-index: -1;
    background-color: var(--vt-image-overlay-color);
    opacity: var(--vt-image-overlay-opacity, 0);
    pointer-events: none;
  }

  /* Unlayered, so it wins over Tailwind's justify-* on this column: those classes only set the alignment here */
  .vt-image-overlay__inner {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    justify-content: var(--vt-image-overlay-position, center);
  }

  @media screen and (min-width: 750px) {
    .vt-image-overlay--scale {
      aspect-ratio: var(--vt-image-overlay-ratio-desktop, 16 / 9);
    }

    .vt-image-overlay--fixed {
      min-height: var(--vt-image-overlay-height-desktop);
    }

    .vt-image-overlay__img {
      object-position: var(--vt-image-overlay-focal, center);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text overlay",
  "tag": "section",
  "class": "image-with-text-overlay-section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Uses the image above when empty."
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "Corner radius"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Height",
      "options": [
        { "value": "scale", "label": "Scale proportionally" },
        { "value": "fixed", "label": "Fixed height" },
        { "value": "screen", "label": "Fit to screen" }
      ],
      "default": "scale"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 700,
      "label": "Height (desktop)",
      "visible_if": "{{ section.settings.section_height == 'fixed' }}"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 560,
      "label": "Height (mobile)",
      "visible_if": "{{ section.settings.section_height == 'fixed' }}"
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "label": "Ratio (desktop)",
      "options": [
        { "value": "wide", "label": "Wide (16:9)" },
        { "value": "ultra_wide", "label": "Ultra wide (21:9)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "wide",
      "visible_if": "{{ section.settings.section_height == 'scale' }}"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Ratio (mobile)",
      "options": [
        { "value": "classic_portrait", "label": "Tall portrait (2:3)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" }        
      ],
      "default": "classic_portrait",
      "visible_if": "{{ section.settings.section_height == 'scale' }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000",
      "info": "Leave blank to inherit from color palette"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 10,
      "label": "Overlay opacity"      
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        { "value": "justify-start", "label": "t:sections.rich_text.settings.content_alignment.options__1.label" },
        { "value": "justify-center", "label": "t:sections.rich_text.settings.content_alignment.options__2.label" },
        { "value": "justify-end", "label": "t:sections.rich_text.settings.content_alignment.options__3.label" }
      ],
      "default": "justify-center",
      "label": "t:sections.rich_text.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "justify-start", "label": "t:sections.rich_text.settings.content_alignment.options__1.label" },
        { "value": "justify-center", "label": "t:sections.rich_text.settings.content_alignment.options__2.label" },
        { "value": "justify-end", "label": "t:sections.rich_text.settings.content_alignment.options__3.label" }
      ],
      "default": "justify-center",
      "label": "t:sections.rich_text.settings.mobile_content_alignment.label"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30,      
      "label": "Gap (desktop)"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Gap (mobile)"      
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "info": "Leave blank to inherit from color palette"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph",
      "info": "Leave blank to inherit from color palette"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60,
      "label": "Top (desktop)"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60,
      "label": "Bottom (desktop)"
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Left (desktop)"
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Right (desktop)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_padding",
      "default": true,
      "label": "Custom for mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "label": "Top (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "label": "Bottom (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Left (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Right (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "checkbox",
      "id": "make_section_page_width",
      "default": false,
      "label": "Apply max width"
    }
  ],
  "blocks": [
    { "type": "stack" },
    { "type": "icons" },
    { "type": "heading" },
    { "type": "sub-heading" },
    { "type": "paragraph" },
    { "type": "button" }
  ],
  "presets": [
    {
      "name": "Image with text overlay",
      "settings": {
        "image_radius": 0,
        "section_height": "scale",
        "height_desktop": 700,
        "height_mobile": 560,
        "image_ratio_desktop": "wide",
        "image_ratio_mobile": "classic_portrait",
        "overlay_color": "#000000",
        "overlay_opacity": 10,
        "content_position": "center",
        "desktop_content_alignment": "justify-center",
        "mobile_content_alignment": "justify-center",
        "gap": 30,
        "gap_mobile": 20,
        "padding_top_desktop": 60,
        "padding_bottom_desktop": 60,
        "padding_left_desktop": 34,
        "padding_right_desktop": 34,
        "enable_custom_mobile_padding": true,
        "padding_top_mobile": 40,
        "padding_bottom_mobile": 40,
        "padding_left_mobile": 20,
        "padding_right_mobile": 20,
        "make_section_page_width": false
      },
      "blocks": [
        {
          "type": "stack",
          "settings": {
            "layout_direction_desktop": "vt-stack--horizontal",
            "layout_direction_tablet": "vt-stack--horizontal",
            "layout_direction_mobile": "vt-stack--horizontal",
            "alignment": "center",
            "position": "center",
            "position_type": "default",
            "wrap_content": "nowrap",
            "width": "fit",
            "height": "fit",
            "gap_desktop": 8,
            "gap_mobile": 8,
            "enable_padding": false
          },
          "blocks": [
            {
              "type": "icons",
              "settings": {
                "icon": "sparkle",
                "icon_color": "#EAE060",
                "icon_size_desktop": 16,
                "icon_size_mobile": 16,
                "show_box": false,
                "animation_type": "slide",
                "animation_direction": "from-bottom",
                "animation_duration": 1,
                "animation_delay": 0.2,
                "animation_easing": "ease-out-sine"
              }
            },
            {
              "type": "sub-heading",
              "settings": {
                "sub_heading": "Add a short label",
                "subheading_tag": "p",
                "subheading_alignment": "text-center",
                "animation_type": "slide",
                "animation_direction": "from-bottom",
                "animation_duration": 1,
                "animation_delay": 0.2,
                "animation_easing": "ease-out-sine"
              }
            }
          ]
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Add a heading about your image",
            "heading_size": "vt-heading-h1",
            "heading_alignment": "text-inherit",
            "heading_tag": "h2",
            "enable_max_width": true,
            "heading_max_width": 560,
            "animation_type": "slide",
            "animation_direction": "from-bottom",
            "animation_duration": 1,
            "animation_delay": 0.4,
            "animation_easing": "ease-out-sine"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Add a button label",
            "button_style": "link-light",
            "animation_type": "slide",
            "animation_direction": "from-bottom",
            "animation_duration": 1,
            "animation_delay": 0.6,
            "animation_easing": "ease-out-sine"
          }
        }
      ]
    }
  ]
}
{% endschema %}
