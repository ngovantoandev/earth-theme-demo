{% comment %}
  Sustainable Fashion Hero Banner Section
  Configurable directly via section settings or modular blocks.
{% endcomment %}

<div 
  class="earth-hero-banner-section full-width{% if section.settings.full_width %} earth-hero-banner-section--full{% endif %}" 
  id="earthHeroBanner-{{ section.id }}"
  style="
    --hero-bg: {{ section.settings.bg_color | default: '#F8F9DC' }};
    --hero-pt: {{ section.settings.top_padding | default: 36 }}px;
    --hero-pb: {{ section.settings.bottom_padding | default: 36 }}px;
  "
>
  <div class="earth-hero__content-area">
    <div class="earth-hero__content-inner">
      {%- if section.settings.badge_text != blank -%}
        <div 
          class="earth-hero__badge" 
          style="
            --badge-bg: {{ section.settings.badge_bg | default: '#224E09' }};
            --badge-color: {{ section.settings.badge_text_color | default: '#F8F9DC' }};
          "
        >
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
        <h1 
          class="earth-hero__heading earth-hero__heading--{{ section.settings.heading_size | default: 'default' }}"
          {% if section.settings.heading_color != blank %}style="color: {{ section.settings.heading_color }};"{% endif %}
        >
          {%- if section.settings.heading_line_1 != blank -%}
            <span class="earth-hero__heading-line">{{ section.settings.heading_line_1 }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}
            <span class="earth-hero__heading-line">{{ section.settings.heading_line_2 }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p 
          class="earth-hero__subtitle"
          style="
            {% if section.settings.subtitle_color != blank %}color: {{ section.settings.subtitle_color }};{% endif %}
            {% if section.settings.subtitle_font_size != blank and section.settings.subtitle_font_size > 0 %}font-size: {{ section.settings.subtitle_font_size }}px;{% endif %}
          "
        >
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_text != blank and section.settings.button_type != 'none' -%}
        <div class="earth-hero__btn-wrapper">
          {%- if section.settings.button_type == 'arrow' -%}
            {%- assign arrow_theme = section.settings.arrow_theme | default: 'dark' -%}
            {% render 'btn-arrow',
              text: section.settings.button_text,
              url: section.settings.button_link,
              theme: arrow_theme,
              color: section.settings.arrow_text_color,
              circle_bg: section.settings.arrow_circle_bg,
              circle_color: section.settings.arrow_circle_icon,
              font_size: section.settings.btn_font_size,
              padding_vertical: section.settings.btn_padding_vertical,
              padding_horizontal: section.settings.btn_padding_horizontal
            %}
          {%- else -%}
            {%- assign sec_btn_variant = section.settings.button_type | default: 'solid' -%}
            {% render 'btn-action',
              text: section.settings.button_text,
              url: section.settings.button_link,
              variant: sec_btn_variant,
              custom_bg: section.settings.button_bg_color,
              custom_color: section.settings.button_text_color,
              font_size: section.settings.btn_font_size,
              padding_vertical: section.settings.btn_padding_vertical,
              padding_horizontal: section.settings.btn_padding_horizontal
            %}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="earth-hero__blocks-wrapper">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'badge' -%}
                <div 
                  class="earth-hero__badge" 
                  {{ block.shopify_attributes }}
                  style="
                    --badge-bg: {{ block.settings.badge_bg | default: '#224E09' }};
                    --badge-color: {{ block.settings.badge_text_color | default: '#F8F9DC' }};
                  "
                >
                  <span>{{ block.settings.badge_text | default: '100% ORGANIC & ETHICAL' }}</span>
                </div>

              {%- when 'heading' -%}
                <h2 
                  class="earth-hero__heading earth-hero__heading--{{ block.settings.heading_size | default: 'default' }}" 
                  {{ block.shopify_attributes }}
                  {% if block.settings.heading_color != blank %}style="color: {{ block.settings.heading_color }};"{% endif %}
                >
                  {%- if block.settings.heading_line_1 != blank -%}
                    <span class="earth-hero__heading-line">{{ block.settings.heading_line_1 }}</span>
                  {%- endif -%}
                  {%- if block.settings.heading_line_2 != blank -%}
                    <span class="earth-hero__heading-line">{{ block.settings.heading_line_2 }}</span>
                  {%- endif -%}
                </h2>

              {%- when 'subtitle' -%}
                <p 
                  class="earth-hero__subtitle" 
                  {{ block.shopify_attributes }}
                  style="
                    {% if block.settings.color != blank %}color: {{ block.settings.color }};{% endif %}
                    {% if block.settings.font_size != blank and block.settings.font_size > 0 %}font-size: {{ block.settings.font_size }}px;{% endif %}
                  "
                >
                  {{ block.settings.text }}
                </p>

              {%- when 'text' -%}
                <div class="earth-hero__text-wrapper" {{ block.shopify_attributes }}>
                  {% render 'text', block: block %}
                </div>

              {%- when 'button' -%}
                {%- if block.settings.button_text != blank -%}
                  {%- assign btn_variant = block.settings.variant | default: 'solid' -%}
                  <div class="earth-hero__btn-wrapper" {{ block.shopify_attributes }}>
                    {% render 'btn-action',
                      text: block.settings.button_text,
                      url: block.settings.button_link,
                      variant: btn_variant,
                      custom_bg: block.settings.button_bg_color,
                      custom_color: block.settings.button_text_color,
                      font_size: block.settings.font_size,
                      padding_vertical: block.settings.padding_vertical,
                      padding_horizontal: block.settings.padding_horizontal
                    %}
                  </div>
                {%- endif -%}

              {%- when 'button_arrow' -%}
                {%- if block.settings.button_text != blank -%}
                  {%- assign arrow_theme = block.settings.theme | default: 'dark' -%}
                  <div class="earth-hero__btn-wrapper" {{ block.shopify_attributes }}>
                    {% render 'btn-arrow',
                      text: block.settings.button_text,
                      url: block.settings.button_link,
                      theme: arrow_theme,
                      color: block.settings.text_color,
                      circle_bg: block.settings.circle_bg_color,
                      circle_color: block.settings.circle_icon_color,
                      font_size: block.settings.font_size,
                      padding_vertical: block.settings.padding_vertical,
                      padding_horizontal: block.settings.padding_horizontal
                    %}
                  </div>
                {%- endif -%}

              {%- when 'spacer' -%}
                <div 
                  class="earth-hero__spacer" 
                  {{ block.shopify_attributes }} 
                  style="height: {{ block.settings.height | default: 24 }}px; width: 100%;"
                ></div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .earth-hero-banner-section {
    grid-column: 1 / -1 !important;
    width: 100%;
    background-color: var(--hero-bg, #F8F9DC);
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
    border-bottom: 1px solid var(--color-primary, #224E09);
  }

  .earth-hero__content-area {
    background-color: var(--hero-bg, #F8F9DC);
    padding-top: var(--hero-pt, 36px);
    padding-bottom: var(--hero-pb, 36px);
    padding-left: clamp(20px, 4vw, 48px);
    padding-right: clamp(20px, 4vw, 48px);
    text-align: center;
    box-sizing: border-box;
    width: 100%;
  }

  .earth-hero__content-inner {
    max-width: var(--page-width, 1200px);
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }
  .earth-hero-banner-section--full .earth-hero__content-inner {
    max-width: 100%;
  }

  /* Badge Block */
  .earth-hero__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 16px;
    border-radius: 999px;
    background-color: var(--badge-bg, #224E09);
    color: var(--badge-color, #F8F9DC);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  /* Heading */
  .earth-hero__heading {
    width: 100%;
    font-size: 119px;
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: #003225;
    margin: 0 0 20px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .earth-hero__heading--large {
    font-size: clamp(48px, 9vw, 136px);
  }
  .earth-hero__heading--medium {
    font-size: clamp(36px, 6.5vw, 92px);
  }
  .earth-hero__heading--small {
    font-size: clamp(28px, 4.5vw, 64px);
  }

  .earth-hero__heading-line {
    display: block;
    white-space: normal;
  }

  /* Subtitle */
  .earth-hero__subtitle {
    font-size: var(--type-section-subtitle, 1.3125rem);
    font-weight: 500;
    color: #1a420b;
    margin: 0 0 32px 0;
    letter-spacing: -0.01em;
    line-height: 1.4;
    max-width: 800px;
  }

  /* Button Wrapper */
  .earth-hero__btn-wrapper {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .earth-hero__heading {
      font-size: clamp(3.2rem, 8vw, 5.5rem);
    }
  }

  /* Text Block Styles */
  .earth-block-text {
    margin: 0 0 24px 0;
    line-height: 1.5;
    max-width: 800px;
    width: 100%;
    box-sizing: border-box;
    color: #1a420b;
  }
  .earth-block-text p {
    margin: 0 0 0.8em 0;
  }
  .earth-block-text p:last-child {
    margin-bottom: 0;
  }

  .earth-block-text--font-body {
    font-family: inherit;
    font-weight: 400;
  }
  .earth-block-text--font-heading {
    font-family: inherit;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .earth-block-text--font-subheading {
    font-family: inherit;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .earth-block-text--size-small {
    font-size: 0.875rem !important;
  }
  .earth-block-text--size-medium {
    font-size: 1rem !important;
  }
  .earth-block-text--size-large {
    font-size: 1.3125rem !important;
  }
  .earth-block-text--size-extra-large,
  .earth-block-text--size-x-large {
    font-size: 1.75rem !important;
  }
  .earth-block-text--size-custom {
    font-size: var(--block-text-size, var(--custom-text-size, 1rem)) !important;
  }

  .earth-block-text--secondary {
    color: var(--color-primary, #224E09) !important;
  }

  @media (max-width: 768px) {
    .earth-hero__content-area {
      padding: 36px 20px 48px;
    }
    .earth-hero__heading {
      font-size: clamp(2.4rem, 11vw, 3.8rem);
      line-height: 1.08;
      margin-bottom: 16px;
    }
    .earth-hero__subtitle {
      font-size: 1.125rem !important;
      line-height: 1.45;
      margin-bottom: 24px;
    }
    .earth-block-text--size-large,
    .earth-block-text--size-x-large {
      font-size: 1.125rem !important;
    }
  }
{% endstylesheet %}

