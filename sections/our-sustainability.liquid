{%- comment -%}
  Section: Our Sustainability Journey
  Renders a visual sustainability milestone timeline and a call-to-action block.
  Built with composable atomic theme blocks:
  - Stack (vertical & horizontal flex containers)
  - Heading Group (heading with leaf icons)
  - Column Layout (responsive 5-column timeline with mobile swipe carousel)
  - Card (bordered milestone cards and container card)
  - Heading, Sub-heading, Paragraph
  - Button (primary and outline action buttons)
  - Icons (vector icons with circular badge containers)
  Includes visual preview mode for Shopify Theme Editor.
{%- endcomment -%}

{%- liquid
  assign make_section_page_width = section.settings.make_section_page_width

  assign section_bg = section.settings.background_color
  assign bg_style = ''
  if section_bg != blank and section_bg != 'rgba(0,0,0,0)' and section_bg != '#00000000'
    assign bg_style = '--vt-bg: ' | append: section_bg | append: ';'
  endif

  assign heading_color = section.settings.heading_color
  assign heading_style = ''
  if heading_color != blank and heading_color != 'rgba(0,0,0,0)' and heading_color != '#00000000'
    assign heading_style = '--vt-heading-color: ' | append: heading_color | append: ';'
  endif

  assign paragraph_color = section.settings.paragraph_color
  assign paragraph_style = ''
  if paragraph_color != blank and paragraph_color != 'rgba(0,0,0,0)' and paragraph_color != '#00000000'
    assign paragraph_style = '--vt-paragraph-color: ' | append: paragraph_color | append: ';'
  endif

  assign border_color = section.settings.border_color
  assign border_style = ''
  if border_color != blank and border_color != 'rgba(0,0,0,0)' and border_color != '#00000000'
    assign border_style = '--vt-border-color: ' | append: border_color | append: ';'
  endif

  assign pad_top_mobile = section.settings.padding_top_mobile | default: 48
  assign pad_bottom_mobile = section.settings.padding_bottom_mobile | default: 48
  assign pad_left_mobile = section.settings.padding_horizontal_mobile | default: 20

  assign line_auto_align = section.settings.timeline_line_auto_align
  if line_auto_align == nil
    assign line_auto_align = true
  endif
  assign line_top_desktop = section.settings.timeline_line_top | default: 32
  assign line_top_mobile = section.settings.timeline_line_top_mobile | default: 24
  assign line_thickness = section.settings.timeline_line_thickness | default: 2
-%}

<vt-sustainability-timeline
  class="vt-our-sustainability{% unless make_section_page_width %} vt-page-full-width{% endunless %}"
  id="vtOurSustainability-{{ section.id }}"
  data-auto-align="{{ line_auto_align }}"
  style="
    {{ bg_style }}
    {{ heading_style }}
    {{ paragraph_style }}
    {{ border_style }}
    --vt-pt: {% render 'fluid-clamp', min_px: pad_top_mobile, max_px: section.settings.padding_top %};
    --vt-pb: {% render 'fluid-clamp', min_px: pad_bottom_mobile, max_px: section.settings.padding_bottom %};
    --vt-ph: {% render 'fluid-clamp', min_px: pad_left_mobile, max_px: section.settings.padding_horizontal %};
    --vt-ph-desktop: {{ section.settings.padding_horizontal | default: 34 }}px;
    --vt-ph-mobile: {{ pad_left_mobile }}px;
    --vt-page-padding: {{ section.settings.padding_horizontal | default: 34 }}px;
    --vt-page-padding-mobile: {{ pad_left_mobile }}px;
    --vt-block-gap: {% render 'fluid-clamp', min_px: section.settings.block_gap_mobile, max_px: section.settings.block_gap %};
    --vt-timeline-line-top-desktop: {{ line_top_desktop }}px;
    --vt-timeline-line-top-mobile: {{ line_top_mobile }}px;
    --vt-timeline-line-height: {{ line_thickness }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-our-sustainability__container{% if make_section_page_width %} vt-page-width{% endif %}">
    {%- if section.blocks.size > 0 -%}
      {% content_for 'blocks' %}
    {%- elsif request.visual_preview_mode or request.design_mode -%}
      <div class="vt-our-sustainability__preview" aria-hidden="true">
        <!-- Header Preview -->
        <div class="vt-our-sustainability__preview-header">
          <div class="vt-our-sustainability__preview-heading-group">
            <span class="vt-our-sustainability__preview-leaf vt-our-sustainability__preview-leaf--left">
              {% render 'icons', icon: 'leaf' %}
            </span>
            <h2 class="vt-heading vt-heading-h2">Our Sustainability Journey</h2>
            <span class="vt-our-sustainability__preview-leaf vt-our-sustainability__preview-leaf--right">
              {% render 'icons', icon: 'leaf' %}
            </span>
          </div>
          <p class="vt-paragraph vt-paragraph-medium vt-our-sustainability__preview-sub">
            From a small organic farm to global impact – our story unfolds through transparent milestones and unwavering commitment to the planet
          </p>
        </div>

        <!-- Timeline Preview -->
        <div class="vt-our-sustainability__preview-timeline">
          <div class="vt-our-sustainability__preview-line"></div>
          <div class="vt-our-sustainability__preview-steps">
            <!-- Step 1: 2018 -->
            <div class="vt-our-sustainability__preview-step">
              <div class="vt-our-sustainability__preview-node">
                {% render 'icons', icon: 'quality' %}
              </div>
              <div class="vt-our-sustainability__preview-year">2018</div>
              <div class="vt-our-sustainability__preview-card">
                <h3 class="vt-heading vt-heading-h4">The Beginning</h3>
                <p class="vt-paragraph vt-paragraph-small">
                  Founded in Hanoi with mission to source 100% organic cotton from local farms
                </p>
              </div>
            </div>

            <!-- Step 2: 2020 -->
            <div class="vt-our-sustainability__preview-step">
              <div class="vt-our-sustainability__preview-node">
                {% render 'icons', icon: 'ecology' %}
              </div>
              <div class="vt-our-sustainability__preview-year">2020</div>
              <div class="vt-our-sustainability__preview-card">
                <h3 class="vt-heading vt-heading-h4">Fair Trade Partnership</h3>
                <p class="vt-paragraph vt-paragraph-small">
                  Partnered with first Fair Trade factories, ensuring ethical labor for 500 artisans
                </p>
              </div>
            </div>

            <!-- Step 3: 2022 -->
            <div class="vt-our-sustainability__preview-step">
              <div class="vt-our-sustainability__preview-node">
                {% render 'icons', icon: 'tree' %}
              </div>
              <div class="vt-our-sustainability__preview-year">2022</div>
              <div class="vt-our-sustainability__preview-card">
                <h3 class="vt-heading vt-heading-h4">Reforestation Initiative</h3>
                <p class="vt-paragraph vt-paragraph-small">
                  Launched "1 Tree Per Product" – planted 50K trees in Vietnam reforestation
                </p>
              </div>
            </div>

            <!-- Step 4: 2024 -->
            <div class="vt-our-sustainability__preview-step">
              <div class="vt-our-sustainability__preview-node">
                {% render 'icons', icon: 'quality' %}
              </div>
              <div class="vt-our-sustainability__preview-year">2024</div>
              <div class="vt-our-sustainability__preview-card">
                <h3 class="vt-heading vt-heading-h4">Carbon Neutral</h3>
                <p class="vt-paragraph vt-paragraph-small">
                  Achieved B Corp certification and full carbon-neutral shipping
                </p>
              </div>
            </div>

            <!-- Step 5: 2026 -->
            <div class="vt-our-sustainability__preview-step">
              <div class="vt-our-sustainability__preview-node">
                {% render 'icons', icon: 'zero-emissions' %}
              </div>
              <div class="vt-our-sustainability__preview-year">2026</div>
              <div class="vt-our-sustainability__preview-card">
                <h3 class="vt-heading vt-heading-h4">Circular Economy</h3>
                <p class="vt-paragraph vt-paragraph-small">
                  Closed-loop recycling: turn old clothes into new collections
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom CTA Box Preview -->
        <div class="vt-our-sustainability__preview-cta-box">
          <h2 class="vt-heading vt-heading-h2">Be part of our story</h2>
          <p class="vt-paragraph vt-paragraph-medium vt-our-sustainability__preview-cta-text">
            Your choices define the future of fashion. Join a movement that celebrates beauty without compromise.
          </p>
          <div class="vt-our-sustainability__preview-cta-buttons">
            <span class="vt-button vt-button--primary">SHOP COLLECTION</span>
            <span class="vt-button vt-button--outline">EXPLORE JOURNAL</span>
          </div>
          <div class="vt-our-sustainability__preview-cta-badges">
            <div class="vt-our-sustainability__preview-badge-item">
              <div class="vt-our-sustainability__preview-badge-icon">
                {% render 'icons', icon: 'leaf' %}
              </div>
              <h4 class="vt-heading vt-heading-h5">100% ORGANIC</h4>
            </div>
            <div class="vt-our-sustainability__preview-badge-item">
              <div class="vt-our-sustainability__preview-badge-icon">
                {% render 'icons', icon: 'carbon' %}
              </div>
              <h4 class="vt-heading vt-heading-h5">CARBON NEUTRAL</h4>
            </div>
            <div class="vt-our-sustainability__preview-badge-item">
              <div class="vt-our-sustainability__preview-badge-icon">
                {% render 'icons', icon: 'quality' %}
              </div>
              <h4 class="vt-heading vt-heading-h5">FAIR WAGES</h4>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</vt-sustainability-timeline>

{% stylesheet %}
  vt-sustainability-timeline,
  .vt-our-sustainability {
    display: block;
    width: 100%;
    background-color: var(--vt-bg, var(--vt-background-color));
    color: var(--vt-heading-color, var(--vt-foreground-color));
    padding-top: var(--vt-pt, 80px);
    padding-bottom: var(--vt-pb, 96px);
    box-sizing: border-box;
    overflow-x: clip;
    position: relative;
  }

  .vt-our-sustainability__container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: var(--vt-block-gap, 24px);
    padding-left: var(--vt-ph, 34px);
    padding-right: var(--vt-ph, 34px);
  }

  .vt-our-sustainability__container:not(.vt-page-width) {
    max-width: 100%;
  }

  @media screen and (max-width: 768px) {
    .vt-our-sustainability__container {
      padding-left: var(--vt-ph-mobile, 20px);
      padding-right: var(--vt-ph-mobile, 20px);
    }
  }

  .vt-our-sustainability__container > .shopify-block,
  .vt-our-sustainability__container > shopify-block {
    display: contents;
  }

  /* Section global-first variable defaults */
  .vt-our-sustainability {
    --vt-border-color: var(--vt-foreground-color);
  }

  /* Timeline enhancements for column-layout block inside this section */
  .vt-our-sustainability .vt-column-layout {
    position: relative;
    width: 100%;
  }

  .vt-our-sustainability .vt-column-layout__viewport {
    overflow: visible;
  }

  .vt-our-sustainability .vt-column-layout__list {
    position: relative;
    width: 100%;
  }

  /* Continuous horizontal line running through the timeline */
  .vt-our-sustainability .vt-column-layout__list::before {
    content: '';
    position: absolute;
    top: var(--vt-timeline-line-top, var(--vt-timeline-line-top-desktop, 32px));
    left: 0;
    right: 0;
    height: var(--vt-timeline-line-height, 2px);
    background-color: var(--vt-border-color, var(--vt-foreground-color));
    transform: translateY(-50%);
    z-index: 0;
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    .vt-our-sustainability .vt-column-layout__viewport {
      overflow: hidden;
      padding-top: 12px;
      margin-top: -12px;
    }

    .vt-our-sustainability .vt-column-layout__list::before {
      top: var(--vt-timeline-line-top, var(--vt-timeline-line-top-mobile, 24px));
      left: 0;
      width: 1600px;
    }
  }

  /* Ensure milestone circle icons sit above the continuous horizontal line */
  .vt-our-sustainability .vt-column-layout__list .vt-icon {
    position: relative;
    z-index: 1;
    transition: margin-top 0.2s ease-out;
  }

  /* Preview mode styles */
  .vt-our-sustainability__preview {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    align-items: center;
    text-align: center;
  }

  .vt-our-sustainability__preview-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 720px;
    margin: 0 auto 12px auto;
  }

  .vt-our-sustainability__preview-heading-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .vt-our-sustainability__preview-leaf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--vt-color-secondary, #71CC3B);
  }

  .vt-our-sustainability__preview-leaf svg {
    width: 36px;
    height: 36px;
  }

  @media (max-width: 768px) {
    .vt-our-sustainability__preview-leaf {
      display: none;
    }
  }

  .vt-our-sustainability__preview-sub {
    max-width: 680px;
    margin: 0 auto;
    color: var(--vt-paragraph-color, var(--vt-color-primary, #224E09));
  }

  /* Timeline preview */
  .vt-our-sustainability__preview-timeline {
    position: relative;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
  }

  .vt-our-sustainability__preview-line {
    position: absolute;
    top: 32px;
    left: 0;
    right: 0;
    height: 1.5px;
    background-color: var(--vt-border-color, var(--vt-foreground-color, #003225));
    z-index: 0;
  }

  .vt-our-sustainability__preview-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  @media (max-width: 1023px) {
    .vt-our-sustainability__preview-steps {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 16px;
      gap: 16px;
    }

    .vt-our-sustainability__preview-step {
      flex: 0 0 240px;
      scroll-snap-align: start;
    }

    .vt-our-sustainability__preview-line {
      top: 24px;
      left: 0;
      width: 1200px;
    }
  }

  .vt-our-sustainability__preview-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .vt-our-sustainability__preview-node {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--vt-foreground-color, #003225);
    color: var(--vt-background-color, #F8F9DC);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .vt-our-sustainability__preview-node svg {
    width: 28px;
    height: 28px;
    color: var(--vt-background-color, #F8F9DC);
  }

  @media (max-width: 1023px) {
    .vt-our-sustainability__preview-node {
      width: 48px;
      height: 48px;
    }

    .vt-our-sustainability__preview-node svg {
      width: 22px;
      height: 22px;
    }
  }

  .vt-our-sustainability__preview-year {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--vt-heading-color, var(--vt-foreground-color, #003225));
  }

  .vt-our-sustainability__preview-card {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 18px;
    border: 1px solid var(--vt-border-color, var(--vt-foreground-color, #003225));
    border-radius: 0;
    background-color: transparent;
    text-align: center;
    box-sizing: border-box;
    min-height: 190px;
  }

  @media (min-width: 1024px) {
    .vt-our-sustainability__preview-step + .vt-our-sustainability__preview-step .vt-our-sustainability__preview-card {
      border-left: none;
    }
  }

  .vt-our-sustainability__preview-card .vt-heading {
    margin: 0;
    line-height: 1.3;
    color: var(--vt-heading-color, var(--vt-foreground-color, #003225));
  }

  .vt-our-sustainability__preview-card .vt-paragraph {
    margin: 0;
    line-height: 1.5;
    color: var(--vt-paragraph-color, var(--vt-color-primary, #224E09));
  }

  /* Bottom CTA box preview */
  .vt-our-sustainability__preview-cta-box {
    width: 100%;
    border: 1px solid var(--vt-border-color, var(--vt-foreground-color, #003225));
    border-radius: 0;
    padding: 48px 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    box-sizing: border-box;
    background-color: transparent;
  }

  .vt-our-sustainability__preview-cta-box .vt-heading {
    margin: 0;
  }

  .vt-our-sustainability__preview-cta-text {
    max-width: 580px;
    margin: 0 auto;
    text-align: center;
  }

  .vt-our-sustainability__preview-cta-buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .vt-our-sustainability__preview-cta-badges {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    margin-top: 16px;
  }

  .vt-our-sustainability__preview-badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .vt-our-sustainability__preview-badge-icon {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background-color: var(--vt-color-secondary, #71CC3B);
    color: var(--vt-foreground-color, #003225);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .vt-our-sustainability__preview-badge-icon svg {
    width: 28px;
    height: 28px;
  }

  .vt-our-sustainability__preview-badge-item .vt-heading {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--vt-heading-color, var(--vt-foreground-color, #003225));
    text-transform: uppercase;
    margin: 0;
  }

  @media (max-width: 768px) {
    .vt-our-sustainability__preview-cta-box {
      padding: 36px 20px;
      gap: 20px;
    }

    .vt-our-sustainability__preview-cta-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .vt-our-sustainability__preview-cta-buttons .vt-button {
      width: 100%;
      text-align: center;
      justify-content: center;
    }

    .vt-our-sustainability__preview-cta-badges {
      flex-direction: column;
      gap: 20px;
    }
  }
{% endstylesheet %}

<script>
  if (!customElements.get('vt-sustainability-timeline')) {
    class VtSustainabilityTimeline extends HTMLElement {
      static get observedAttributes() {
        return ['data-auto-align'];
      }

      constructor() {
        super();
        this.updateTimelineLine = this.updateTimelineLine.bind(this);
        this.resizeObserver = null;
        this.mutationObserver = null;
        this.isUpdating = false;
      }

      connectedCallback() {
        this.init();
      }

      attributeChangedCallback(name, oldValue, newValue) {
        if (oldValue !== newValue) {
          this.updateTimelineLine();
        }
      }

      disconnectedCallback() {
        if (this.resizeObserver) {
          this.resizeObserver.disconnect();
          this.resizeObserver = null;
        }
        if (this.mutationObserver) {
          this.mutationObserver.disconnect();
          this.mutationObserver = null;
        }
        window.removeEventListener('resize', this.updateTimelineLine);
        document.removeEventListener('shopify:section:load', this.updateTimelineLine);
      }

      init() {
        this.updateTimelineLine();

        if (typeof ResizeObserver !== 'undefined') {
          this.resizeObserver = new ResizeObserver(() => {
            this.updateTimelineLine();
          });
          const list = this.querySelector('.vt-column-layout__list');
          if (list) {
            this.resizeObserver.observe(list);
            const icons = list.querySelectorAll('.vt-icon');
            icons.forEach(icon => this.resizeObserver.observe(icon));
          }
        }

        if (typeof MutationObserver !== 'undefined') {
          this.mutationObserver = new MutationObserver(() => {
            this.updateTimelineLine();
          });
          const list = this.querySelector('.vt-column-layout__list');
          if (list) {
            this.mutationObserver.observe(list, {
              childList: true,
              subtree: true,
              attributes: true,
              attributeFilter: ['style', 'class']
            });
          }
        }

        window.addEventListener('resize', this.updateTimelineLine, { passive: true });
        document.addEventListener('shopify:section:load', this.updateTimelineLine);

        requestAnimationFrame(() => this.updateTimelineLine());
      }

      updateTimelineLine() {
        if (this.isUpdating) return;

        const isAutoAlign = this.getAttribute('data-auto-align') !== 'false';
        const list = this.querySelector('.vt-column-layout__list');
        if (!list) return;

        if (!isAutoAlign) {
          list.style.removeProperty('--vt-timeline-line-top');
          const icons = list.querySelectorAll('.vt-icon');
          icons.forEach(icon => {
            icon.style.removeProperty('margin-top');
          });
          return;
        }

        // Auto-align mode:
        // Find milestone icons (top icon in each milestone column)
        const columns = Array.from(list.children).map(child => {
          if (child.tagName === 'SHOPIFY-BLOCK' || child.classList.contains('shopify-block')) {
            return child.firstElementChild || child;
          }
          return child;
        });

        let milestoneIcons = columns.map(col => col.querySelector('.vt-icon.has-box')).filter(Boolean);
        if (milestoneIcons.length === 0) {
          milestoneIcons = columns.map(col => col.querySelector('.vt-icon')).filter(Boolean);
        }
        if (milestoneIcons.length === 0) {
          milestoneIcons = Array.from(list.querySelectorAll('.vt-icon'));
        }
        if (milestoneIcons.length === 0) return;

        const iconHeights = milestoneIcons.map(icon => icon.offsetHeight).filter(h => h > 0);
        if (iconHeights.length === 0) return;

        const maxHeight = Math.max(...iconHeights);
        const targetLineTop = Math.round(maxHeight / 2);

        this.isUpdating = true;

        const currentLineTop = list.style.getPropertyValue('--vt-timeline-line-top');
        const newLineTop = `${targetLineTop}px`;
        if (currentLineTop !== newLineTop) {
          list.style.setProperty('--vt-timeline-line-top', newLineTop);
        }

        milestoneIcons.forEach(icon => {
          const h = icon.offsetHeight;
          if (h > 0) {
            const offset = Math.round(targetLineTop - (h / 2));
            const newMargin = `${offset}px`;
            if (icon.style.marginTop !== newMargin) {
              icon.style.marginTop = newMargin;
            }
          }
        });

        requestAnimationFrame(() => {
          this.isUpdating = false;
        });
      }
    }

    customElements.define('vt-sustainability-timeline', VtSustainabilityTimeline);
  }
</script>

{% schema %}
{
  "name": "Our Sustainability",
  "tag": "section",
  "class": "our-sustainability-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "checkbox",
