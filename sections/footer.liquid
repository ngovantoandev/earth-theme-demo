{% comment %}
  Footer section wrapper.
  Manages background color, text color, page padding, responsive fluid spacing,
  and renders modular theme blocks via content_for 'blocks'.
  Prioritizes global theme palette tokens for Background and Text color.
{% endcomment %}

{%- liquid
  assign apply_max_width = section.settings.apply_max_width
  if apply_max_width == nil
    assign apply_max_width = true
  endif

  # Color: inherit from global theme palette by default, custom override when specified
  assign section_bg = section.settings.background_color
  assign bg_style = ''
  if section_bg != blank and section_bg != 'rgba(0,0,0,0)' and section_bg != '#00000000' and section_bg != 'transparent'
    assign bg_style = '--vt-footer-bg: ' | append: section_bg | append: ';'
  endif

  assign section_text = section.settings.text_color
  assign text_style = ''
  if section_text != blank and section_text != 'rgba(0,0,0,0)' and section_text != '#00000000' and section_text != 'transparent'
    assign text_style = '--vt-footer-color: ' | append: section_text | append: ';' | append: ' --vt-heading-color: ' | append: section_text | append: ';' | append: ' --vt-paragraph-color: ' | append: section_text | append: ';'
  endif

  # Desktop padding
  assign pad_top = section.settings.padding_top_desktop | default: section.settings.padding_top | default: 60
  assign pad_bottom = section.settings.padding_bottom_desktop | default: section.settings.padding_bottom | default: 48
  assign pad_left = section.settings.padding_left_desktop | default: section.settings.padding_horizontal | default: 34
  assign pad_right = section.settings.padding_right_desktop | default: section.settings.padding_horizontal | default: 34

  # Mobile padding: explicit if enabled, otherwise default 32/20
  if section.settings.enable_custom_mobile_padding
    assign pad_top_mobile = section.settings.padding_top_mobile | default: 32
    assign pad_bottom_mobile = section.settings.padding_bottom_mobile | default: 32
    assign pad_left_mobile = section.settings.padding_left_mobile | default: 20
    assign pad_right_mobile = section.settings.padding_right_mobile | default: 20
  else
    assign pad_top_mobile = section.settings.padding_top_mobile | default: pad_top | times: 0.75 | round
    assign pad_bottom_mobile = section.settings.padding_bottom_mobile | default: pad_bottom | times: 0.75 | round
    assign pad_left_mobile = section.settings.padding_left_mobile | default: pad_left | times: 0.75 | round
    assign pad_right_mobile = section.settings.padding_right_mobile | default: pad_right | times: 0.75 | round
  endif

  # Gap
  assign gap_desktop = section.settings.gap | default: 36
  assign gap_mobile = section.settings.gap_mobile | default: 32
-%}

<footer
  id="footer-{{ section.id }}"
  class="vt-footer{% unless apply_max_width %} vt-page-full-width{% endunless %}"
  style="
    {{ bg_style }}
    {{ text_style }}
    --vt-footer-pt: {% render 'fluid-clamp', min_px: pad_top_mobile, max_px: pad_top %};
    --vt-footer-pb: {% render 'fluid-clamp', min_px: pad_bottom_mobile, max_px: pad_bottom %};
    --vt-footer-pl: {% render 'fluid-clamp', min_px: pad_left_mobile, max_px: pad_left %};
    --vt-footer-pr: {% render 'fluid-clamp', min_px: pad_right_mobile, max_px: pad_right %};
    --vt-footer-gap: {% render 'fluid-clamp', min_px: gap_mobile, max_px: gap_desktop %};
  "
  {{ section.shopify_attributes }}
>
  <div class="vt-footer__inner{% if apply_max_width %} vt-page-width{% endif %}">
    {% content_for 'blocks' %}
  </div>
</footer>

{% stylesheet %}
  .vt-footer {
    background-color: var(--vt-footer-bg, var(--vt-background-color, #F8F9DC));
    color: var(--vt-footer-color, var(--vt-foreground-color, #003225));
    --vt-heading-color: var(--vt-footer-color, var(--vt-foreground-color, #003225));
    --vt-paragraph-color: var(--vt-footer-color, var(--vt-foreground-color, #003225));
    padding-top: var(--vt-footer-pt);
    padding-bottom: var(--vt-footer-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .vt-footer__inner {
    width: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--vt-footer-gap);
    box-sizing: border-box;
    padding-left: var(--vt-footer-pl, 34px);
    padding-right: var(--vt-footer-pr, 34px);
  }

  .vt-footer__inner:not(.vt-page-width) {
    max-width: 100%;
  }

  .vt-footer__inner.vt-page-width {
    max-width: calc(var(--vt-page-width, 1170px) + var(--vt-footer-pl, 34px) + var(--vt-footer-pr, 34px));
    padding-inline: var(--vt-footer-pl, 34px) var(--vt-footer-pr, 34px);
  }

  .vt-footer__inner > .shopify-block,
  .vt-footer__inner > shopify-block {
    display: contents;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "vt-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to inherit from color palette"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to inherit from color palette"
    },
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36,
      "label": "Gap (desktop)"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Gap (mobile)"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60,
      "label": "Top (desktop)"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "Bottom (desktop)"
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Left (desktop)"
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Right (desktop)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_padding",
      "default": true,
      "label": "Custom for mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Top (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Bottom (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Left (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Right (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "checkbox",
      "id": "apply_max_width",
      "label": "Apply max width",
      "default": true
    }
  ],
  "blocks": [
    { "type": "logo" },
    { "type": "paragraph" },
    { "type": "heading" },
    { "type": "sub-heading" },
    { "type": "column-layout" },
    { "type": "stack" },
    { "type": "menu" },
    { "type": "divider" },
    { "type": "social-icons" },
    { "type": "trust-badges" },
    { "type": "payment-icons" },
    { "type": "localization" },
    { "type": "policy-links" },
    { "type": "button" },
    { "type": "icons" },
    { "type": "image" }
  ],
  "presets": [
    {
      "name": "Footer",
      "settings": {
        "apply_max_width": true,
        "padding_top_desktop": 60,
        "padding_bottom_desktop": 48,
        "padding_left_desktop": 34,
        "padding_right_desktop": 34,
        "enable_custom_mobile_padding": true,
        "padding_top_mobile": 32,
        "padding_bottom_mobile": 32,
        "padding_left_mobile": 20,
        "padding_right_mobile": 20,
        "gap": 36,
        "gap_mobile": 32
      },
      "blocks": [
        {
          "type": "stack",
          "settings": {
            "layout_direction_desktop": "vt-stack--vertical",
            "layout_direction_tablet": "vt-stack--vertical",
            "layout_direction_mobile": "vt-stack--vertical",
            "gap_desktop": 20,
            "gap_mobile": 14
          },
          "blocks": [
            {
              "type": "logo"
            },
            {
              "type": "paragraph",
              "settings": {
                "text": "<p>Brand mission statement or tagline goes here.</p>",
