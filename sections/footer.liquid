    </div>
  </div>
</footer>

<script>
  (function () {
    function initFooterAccordions() {
      if (window.innerWidth > 768) return;

      const cols = document.querySelectorAll('.earth-footer__nav-col');
      cols.forEach((col) => {
        const btn = col.querySelector('.earth-footer__col-heading');
        if (!btn || btn.__accordionBound) return;
        btn.__accordionBound = true;

        btn.addEventListener('click', function (e) {
          e.preventDefault();
          const isOpen = col.classList.contains('earth-footer__nav-col--open');
          
          if (isOpen) {
            col.classList.remove('earth-footer__nav-col--open');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            col.classList.add('earth-footer__nav-col--open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initFooterAccordions);
    window.addEventListener('resize', initFooterAccordions);
    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', initFooterAccordions);
    }
  })();
</script>

