{% comment %}
  Footer: the store's closing area, built from theme blocks (logo, menus, social
  media icons, country and language, payment icons...) and a static Bottom bar
  for the copyright line and legal links.

  The <footer> landmark comes from the schema "tag". Colors, padding and the gap
  between blocks come from the shared section settings (snippets/section-styles.liquid);
  the Bottom bar reuses them so both parts read as one footer.
{% endcomment %}

{%- liquid
  assign inner_class = 'vt-section__inner'
  if section.settings.make_section_page_width
    assign inner_class = inner_class | append: ' vt-page-width'
  endif
-%}

{% render 'section-styles', section: section %}

<div class="vt-section vt-footer">
  <div class="{{ inner_class }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% content_for 'block', type: '_footer-bottom', id: 'footer-bottom' %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "footer",
  "class": "section-footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 80,
      "label": "Gap (desktop)"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48,
      "label": "Gap (mobile)"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "select",
      "id": "color_style",
      "label": "Color style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "primary",
          "label": "Primary"
        }
      ],
      "default": "default",
      "info": "Primary is a dark section with light text. Empty colors below follow this style."
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the color palette.",
      "visible_if": "{{ section.settings.background_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "info": "Leave empty to use colors from the color palette.",
      "visible_if": "{{ section.settings.background_style == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "info": "Leave empty to use the color palette."
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph",
      "info": "Leave empty to use the color palette."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 110,
      "label": "Top (desktop)"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 90,
      "label": "Bottom (desktop)"
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Left (desktop)"
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34,
      "label": "Right (desktop)"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_mobile_padding",
      "default": true,
      "label": "Custom for mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 64,
      "label": "Top (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48,
      "label": "Bottom (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Left (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Right (mobile)",
      "visible_if": "{{ section.settings.enable_custom_mobile_padding }}"
    },
    {
      "type": "checkbox",
      "id": "make_section_page_width",
      "default": true,
      "label": "Apply max width"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "menu": "footer"
          }
        },
        {
          "type": "_footer-bottom",
          "id": "footer-bottom",
          "static": true,
          "blocks": [
            {
              "type": "copyright"
            },
            {
              "type": "menu",
              "settings": {
                "show_heading": false,
                "layout": "horizontal",
                "separator": "dot",
                "link_gap_desktop": 16,                
                "link_gap_mobile": 12
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
