              }
            }
          ]
        },
        {
          "type": "column-layout",
          "settings": {
            "desktop_column_count": 4,
            "tablet_column_count": 2,
            "mobile_column_count": 1,
            "desktop_column_1_width": "lg:w-1/4|25",
            "desktop_column_2_width": "lg:w-1/4|25",
            "desktop_column_3_width": "lg:w-1/4|25",
            "desktop_column_4_width": "lg:w-1/4|25",
            "swipe_columns_mobile": false
          },
          "blocks": [
            { "type": "menu", "settings": { "title": "Company" } },
            { "type": "menu", "settings": { "title": "Shop" } },
            { "type": "menu", "settings": { "title": "Sustainability" } },
            { "type": "menu", "settings": { "title": "Support" } }
          ]
        },
        {
          "type": "column-layout",
          "settings": {
            "desktop_column_count": 2,
            "tablet_column_count": 2,
            "mobile_column_count": 1,
            "desktop_column_1_width": "lg:w-1/2|50",
            "desktop_column_2_width": "lg:w-1/2|50",
            "swipe_columns_mobile": false
          },
          "blocks": [
            {
              "type": "stack",
              "settings": {
                "layout_direction_desktop": "vt-stack--vertical",
                "layout_direction_tablet": "vt-stack--vertical",
                "layout_direction_mobile": "vt-stack--vertical",
                "gap_desktop": 16,
                "gap_mobile": 14
              },
              "blocks": [
                { "type": "heading", "settings": { "heading": "Follow Us", "heading_size": "vt-heading-h6", "heading_tag": "h3" } },
                { "type": "social-icons" },
                { "type": "paragraph", "settings": { "text": "<p>Share your style with our community</p>", "paragraph_size": "vt-paragraph-small" } },
                { "type": "localization" }
              ]
            },
            {
              "type": "stack",
              "settings": {
                "layout_direction_desktop": "vt-stack--vertical",
                "layout_direction_tablet": "vt-stack--vertical",
                "layout_direction_mobile": "vt-stack--vertical",
                "gap_desktop": 16,
                "gap_mobile": 14
              },
              "blocks": [
                { "type": "heading", "settings": { "heading": "Trust & Security", "heading_size": "vt-heading-h6", "heading_tag": "h3" } },
                { "type": "paragraph", "settings": { "text": "<p><strong>CERTIFIED BY</strong></p>", "paragraph_size": "vt-paragraph-extra-small" } },
                { "type": "trust-badges" },
                { "type": "paragraph", "settings": { "text": "<p><strong>SECURE PAYMENT</strong></p>", "paragraph_size": "vt-paragraph-extra-small" } },
                { "type": "payment-icons" }
              ]
            }
          ]
        },
        {
          "type": "divider"
        },
        {
          "type": "column-layout",
          "settings": {
            "desktop_column_count": 2,
            "tablet_column_count": 2,
            "mobile_column_count": 1,
            "desktop_column_1_width": "lg:w-1/2|50",
            "desktop_column_2_width": "lg:w-1/2|50",
            "swipe_columns_mobile": false
          },
          "blocks": [
            {
              "type": "paragraph",
              "settings": {
                "text": "<p>© 2026 Earth. All rights reserved | Powered by Shopify</p>",
                "paragraph_size": "vt-paragraph-extra-small",
                "paragraph_alignment": "text-left"
              }
            },
            {
              "type": "policy-links",
              "settings": {
                "alignment": "right"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
